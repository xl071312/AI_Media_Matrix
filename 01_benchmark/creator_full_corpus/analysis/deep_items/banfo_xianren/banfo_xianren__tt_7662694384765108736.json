{
  "creator_id": "banfo_xianren",
  "work_id": "banfo_xianren__tt_7662694384765108736",
  "modality": "COMPLETE_TEXT",
  "source_url": "https://www.toutiao.com/article/7662694384765108736/",
  "source_sha256": "bea0fac6b5808fa9a583755f2b5f9539dc61255f9820209dd655de76a73f5387",
  "performance_tier": "HIGH",
  "spoken_marker_eligible": "N/A_TEXT",
  "analysis_status": "OK",
  "analyzer_version": "phase_c_v1",
  "sentence_count": 114,
  "sentences_index": [
    {
      "sentence_id": "s1",
      "char_len": 18,
      "snippet": "图片截取自: 老乡鸡，不能再扒下去了"
    },
    {
      "sentence_id": "s2",
      "char_len": 1,
      "snippet": "1"
    },
    {
      "sentence_id": "s3",
      "char_len": 11,
      "snippet": "最近老乡鸡给我看傻啦。"
    },
    {
      "sentence_id": "s4",
      "char_len": 28,
      "snippet": "线下是它，线上是它，电梯里是它，看个段子评论区里还是它。"
    },
    {
      "sentence_id": "s5",
      "char_len": 18,
      "snippet": "图片截取自: 老乡鸡，不能再扒下去了"
    },
    {
      "sentence_id": "s6",
      "char_len": 49,
      "snippet": "我看它在老家安徽嘎嘎乱杀，在我家杭州嘎嘎乱杀，到了上海还是嘎嘎乱杀，鸭子看了它都要说还是你会嘎嘎。"
    },
    {
      "sentence_id": "s7",
      "char_len": 19,
      "snippet": "甚至它这几年不是总在网上发溯源报告吗？"
    },
    {
      "sentence_id": "s8",
      "char_len": 38,
      "snippet": "每次跟洋柿子连载一样甩完几十万字，线下就有巨大的乐子，门店排队比游乐园还长。"
    },
    {
      "sentence_id": "s9",
      "char_len": 18,
      "snippet": "图片截取自: 老乡鸡，不能再扒下去了"
    },
    {
      "sentence_id": "s10",
      "char_len": 49,
      "snippet": "我本以为发完几十万字的报告就够到位了，万万没想到，这几天它们又邀请游泳世界冠军汪顺来参观产业链啦。"
    },
    {
      "sentence_id": "s11",
      "char_len": 7,
      "snippet": "参观的有多细？"
    },
    {
      "sentence_id": "s12",
      "char_len": 18,
      "snippet": "图片截取自: 老乡鸡，不能再扒下去了"
    },
    {
      "sentence_id": "s13",
      "char_len": 51,
      "snippet": "可以说从地头到灶头，从原料到小料，老乡鸡让汪顺这个老乡看得一清二楚，恨不得土里蚯蚓都让汪老师分个公母。"
    },
    {
      "sentence_id": "s14",
      "char_len": 8,
      "snippet": "这事儿妙在哪儿？"
    },
    {
      "sentence_id": "s15",
      "char_len": 20,
      "snippet": "乍一看，这就是个正常的老乡鸡风格的宣发。"
    },
    {
      "sentence_id": "s16",
      "char_len": 27,
      "snippet": "但再细细一琢磨，这已经不是干不干净，自不自证的事儿啦。"
    },
    {
      "sentence_id": "s17",
      "char_len": 12,
      "snippet": "是就像汪顺在视频里说的，"
    },
    {
      "sentence_id": "s18",
      "char_len": 16,
      "snippet": "听别人说，不如自己亲眼来看一看。"
    },
    {
      "sentence_id": "s19",
      "char_len": 18,
      "snippet": "老乡鸡一手明牌，要送行业一场春天了。"
    },
    {
      "sentence_id": "s20",
      "char_len": 1,
      "snippet": "2"
    },
    {
      "sentence_id": "s21",
      "char_len": 15,
      "snippet": "友友们，细品，这事儿挺可乐的。"
    },
    {
      "sentence_id": "s22",
      "char_len": 25,
      "snippet": "说白了，就是一个老生常谈极其简单的问题，食品安全。"
    },
    {
      "sentence_id": "s23",
      "char_len": 48,
      "snippet": "这几年品牌们都在讲安全，都在讲供应链，都号称纯天然0添加放心吃，就像只要不奔现，个个都是纯素颜。"
    },
    {
      "sentence_id": "s24",
      "char_len": 25,
      "snippet": "只要不出声，品牌个个都拿捏供应链，捏得火花带闪电。"
    },
    {
      "sentence_id": "s25",
      "char_len": 50,
      "snippet": "消费者别说听麻了，更是被品牌暴雷时劈麻了，这供应链你们到底捏哪儿了，怎么最后总是我们在徒手摸三相电。"
    },
    {
      "sentence_id": "s26",
      "char_len": 52,
      "snippet": "这种感觉很窝火啊，我上班要被甲方挑战大脑的极限，吃个饭还要被你们这些乙方探索人体的奥秘，合着我是朵拉吗？"
    },
    {
      "sentence_id": "s27",
      "char_len": 12,
      "snippet": "人生注定要充满了大冒险?"
    },
    {
      "sentence_id": "s28",
      "char_len": 10,
      "snippet": "这种情绪，老乡鸡懂。"
    },
    {
      "sentence_id": "s29",
      "char_len": 20,
      "snippet": "甚至再看老乡鸡找汪老师代言这一手，绝了。"
    },
    {
      "sentence_id": "s30",
      "char_len": 18,
      "snippet": "图片截取自: 老乡鸡，不能再扒下去了"
    },
    {
      "sentence_id": "s31",
      "char_len": 14,
      "snippet": "（截图来自小红书账号老乡鸡）"
    },
    {
      "sentence_id": "s32",
      "char_len": 26,
      "snippet": "明面上看，老乡鸡代言人选的，肌肉跟鸡肉一样活色生香。"
    },
    {
      "sentence_id": "s33",
      "char_len": 47,
      "snippet": "现实的是，比起随便签个流量明星，老乡鸡直接用游泳世界冠军的水准衬托，对着行业的麻筋就是一顿掏。"
    },
    {
      "sentence_id": "s34",
      "char_len": 27,
      "snippet": "说白了，所有人都没想明白一个事儿，谁对食品安全最敏感？"
    },
    {
      "sentence_id": "s35",
      "char_len": 6,
      "snippet": "是小朋友吗？"
    },
    {
      "sentence_id": "s36",
      "char_len": 10,
      "snippet": "是，但他们不善表达。"
    },
    {
      "sentence_id": "s37",
      "char_len": 13,
      "snippet": "更敏感的群体，是运动员们。"
    },
    {
      "sentence_id": "s38",
      "char_len": 57,
      "snippet": "他们真的有专业精准的营养需求，那个身体就是最精确的机器，并且隔三岔五就有严格仔细的检验检查，就为了洞察各项指标变化"
    },
    {
      "sentence_id": "s39",
      "char_len": 48,
      "snippet": "老乡鸡主动找他们做代言，属于写了作业的孩子最期待老师检查，刷着碗的孩子最期待爸爸妈妈打视频电话。"
    },
    {
      "sentence_id": "s40",
      "char_len": 45,
      "snippet": "说白了，以汪老师为代表的运动员们都敢放心吃，他们的健康需求都能满足的品牌，怎么可能不安全？"
    },
    {
      "sentence_id": "s41",
      "char_len": 34,
      "snippet": "要是你的健康需求老乡鸡都跟不上，那下次决赛换你上，轮到你给人类争光。"
    },
    {
      "sentence_id": "s42",
      "char_len": 47,
      "snippet": "甚至老乡鸡对着这个痛点疯狂暴击，直接进入了这个领域，你就说这个水准，普通人餐饮还有没有保障吧。"
    },
    {
      "sentence_id": "s43",
      "char_len": 18,
      "snippet": "图片截取自: 老乡鸡，不能再扒下去了"
    },
    {
      "sentence_id": "s44",
      "char_len": 10,
      "snippet": "但，这，还，不，够。"
    },
    {
      "sentence_id": "s45",
      "char_len": 10,
      "snippet": "老乡鸡更绝的是什么？"
    },
    {
      "sentence_id": "s46",
      "char_len": 25,
      "snippet": "它知道终归是耳听为虚，眼见为实，最大的王炸是什么？"
    },
    {
      "sentence_id": "s47",
      "char_len": 29,
      "snippet": "是让客观的第三方到老乡鸡的供应链上看看，把发言权交给镜头。"
    },
    {
      "sentence_id": "s48",
      "char_len": 37,
      "snippet": "所以从汪老师的第一站到老乡农场，下地转悠转悠的那一刻，老乡鸡就已经赢了啊。"
    },
    {
      "sentence_id": "s49",
      "char_len": 18,
      "snippet": "图片截取自: 老乡鸡，不能再扒下去了"
    },
    {
      "sentence_id": "s50",
      "char_len": 21,
      "snippet": "别的品牌喊着投入大，我老乡农场亩数一万八。"
    },
    {
      "sentence_id": "s51",
      "char_len": 22,
      "snippet": "别的品牌喊什么纯天然，我老乡农场亩数一万八。"
    },
    {
      "sentence_id": "s52",
      "char_len": 31,
      "snippet": "别的品牌喊什么新鲜菜，我老乡农场亩数一万八，哦刚从地里摘俩瓜。"
    },
    {
      "sentence_id": "s53",
      "char_len": 92,
      "snippet": "说白了，在别的品牌原料还在跟你躲猫猫的时刻，老乡鸡晃悠着地里刚摘的茄子，告诉你自己在溯源报告里公开过食材的风险等级，高风险的容易有病虫害的食材就是得特定措施管控"
    },
    {
      "sentence_id": "s54",
      "char_len": 43,
      "snippet": "你喊一万遍品控严，老乡鸡会告诉你不标准化数字化种植，你都不知道哪块地种了啥蔬菜有多大。"
    },
    {
      "sentence_id": "s55",
      "char_len": 84,
      "snippet": "甚至就这农场本身，它都不需要解释自己好山好水好地，少用了化肥和农药，就那个水池漂着藻类，鸡粪有机堆肥出现在镜头里的一刹那，消费者过往的人生经验都会告诉它，这可做"
    },
    {
      "sentence_id": "s56",
      "char_len": 30,
      "snippet": "老乡鸡这都能造假，它通关的都不是产业链，是生物链，是科技链。"
    },
    {
      "sentence_id": "s57",
      "char_len": 16,
      "snippet": "这技术含量做的不是三餐，是三体。"
    },
    {
      "sentence_id": "s58",
      "char_len": 45,
      "snippet": "这样一个品牌跟你谈安全，说你就放心吃这里没狠活，你才会相信它不跟你搞心理，而是跟你讲物理。"
    },
    {
      "sentence_id": "s59",
      "char_len": 19,
      "snippet": "它只会求着你快点吃，下茬菜又要上市啦。"
    },
    {
      "sentence_id": "s60",
      "char_len": 1,
      "snippet": "3"
    },
    {
      "sentence_id": "s61",
      "char_len": 19,
      "snippet": "然后到了老乡鸡溯源的第二站，中央厨房。"
    },
    {
      "sentence_id": "s62",
      "char_len": 18,
      "snippet": "图片截取自: 老乡鸡，不能再扒下去了"
    },
    {
      "sentence_id": "s63",
      "char_len": 8,
      "snippet": "这一站，更是妙。"
    },
    {
      "sentence_id": "s64",
      "char_len": 5,
      "snippet": "妙在哪儿？"
    },
    {
      "sentence_id": "s65",
      "char_len": 56,
      "snippet": "没有几个消费者没听说过它，但又没有几个消费者真进去过，甚至用上央厨到底是行业进步还是行业的后撤步，大家都不清楚。"
    },
    {
      "sentence_id": "s66",
      "char_len": 32,
      "snippet": "但老乡鸡就让你看，甚至别说拍给你看了，它都恨不得带你进去逛两圈。"
    },
    {
      "sentence_id": "s67",
      "char_len": 47,
      "snippet": "毕竟光建央厨就花了那么多钱，这是给产业链制备了大件，它更是用切实的标准，替代了很多玄学的概念。"
    },
    {
      "sentence_id": "s68",
      "char_len": 23,
      "snippet": "就比如说，要干净卫生，那什么标准才叫干净卫生？"
    },
    {
      "sentence_id": "s69",
      "char_len": 23,
      "snippet": "每一个不讲卫生的人，可都认为自己这么做很卫生。"
    },
    {
      "sentence_id": "s70",
      "char_len": 47,
      "snippet": "那老乡鸡告诉你，每个人进入生产区之前，要换鞋，粘毛，穿操作服，风淋消毒等等，不消毒就开不了门。"
    },
    {
      "sentence_id": "s71",
      "char_len": 18,
      "snippet": "图片截取自: 老乡鸡，不能再扒下去了"
    },
    {
      "sentence_id": "s72",
      "char_len": 30,
      "snippet": "上了厕所以后还要再洗手再消毒，不然还是开不了门，这才叫卫生。"
    },
    {
      "sentence_id": "s73",
      "char_len": 24,
      "snippet": "下了班操作服还会再清洗消毒，每天都干净才叫卫生。"
    },
    {
      "sentence_id": "s74",
      "char_len": 27,
      "snippet": "别问为什么这么严，是只有这样，才有资格谈接下来的新鲜。"
    },
    {
      "sentence_id": "s75",
      "char_len": 9,
      "snippet": "同样，什么叫新鲜？"
    },
    {
      "sentence_id": "s76",
      "char_len": 63,
      "snippet": "老乡鸡现在做到了两个非常棒的点，一个是中央厨房或当地仓库到餐厅，只有一日一配送和两日一配送，这还在持续往每日配送的方向上优化。"
    },
    {
      "sentence_id": "s77",
      "char_len": 43,
      "snippet": "另一个是，中央厨房里还有电子大屏，冷链车的温度、路线全都实时看清楚，有异常就会有警报。"
    },
    {
      "sentence_id": "s78",
      "char_len": 18,
      "snippet": "图片截取自: 老乡鸡，不能再扒下去了"
    },
    {
      "sentence_id": "s79",
      "char_len": 17,
      "snippet": "就这两步，很多品牌都要骂老乡鸡傻。"
    },
    {
      "sentence_id": "s80",
      "char_len": 40,
      "snippet": "有这钱连锁店又能开好几家，把这个效率用在资金周转效率上，股东余额又能多出一个8。"
    },
    {
      "sentence_id": "s81",
      "char_len": 45,
      "snippet": "但我是消费者啊，我怎么会讨厌看这个东西呢，我只会嫌他们的警报声还不够大，传不到我杭州的家。"
    },
    {
      "sentence_id": "s82",
      "char_len": 49,
      "snippet": "所以到今年4月，老乡鸡央厨已实现蔬菜当日0库存，面点产品平均周转期2天，冷藏和成品平均周转期3天。"
    },
    {
      "sentence_id": "s83",
      "char_len": 31,
      "snippet": "说到中式快餐，数字化全产业链，老乡鸡不用说话，自然会有人说话。"
    },
    {
      "sentence_id": "s84",
      "char_len": 22,
      "snippet": "到了最后一站，这才到了消费者能接触到的餐厅。"
    },
    {
      "sentence_id": "s85",
      "char_len": 20,
      "snippet": "这更不用解释了，消费者自己都能说个七八。"
    },
    {
      "sentence_id": "s86",
      "char_len": 41,
      "snippet": "比如说一个是从前几年开始，根据食材加工方式把菜品分为:餐厅现做、半预制、复热预制。"
    },
    {
      "sentence_id": "s87",
      "char_len": 29,
      "snippet": "这些内容甚至在餐厅里还分别用绿色、黄色、红色作了标识区分。"
    },
    {
      "sentence_id": "s88",
      "char_len": 53,
      "snippet": "而且小程序也能线上溯源，看各种食材检测报告，菜品溯源卡能看到营养成分表、食材来源、供应商信息乃至制作工艺。"
    },
    {
      "sentence_id": "s89",
      "char_len": 18,
      "snippet": "图片截取自: 老乡鸡，不能再扒下去了"
    },
    {
      "sentence_id": "s90",
      "char_len": 15,
      "snippet": "你别说能照着吃，甚至能照着炒。"
    },
    {
      "sentence_id": "s91",
      "char_len": 73,
      "snippet": "比如另一个是，老乡鸡现在菜品的营养成分也在公示，老乡鸡里的每道菜有多少热量，蛋白质脂肪含量高不高，也逐渐清晰起来，自己合理搭配起来也可以是营养餐。"
    },
    {
      "sentence_id": "s92",
      "char_len": 25,
      "snippet": "这就更不用说了，吃老乡鸡增老乡肌，已经是流量密码。"
    },
    {
      "sentence_id": "s93",
      "char_len": 66,
      "snippet": "这些再加上透明厨房，几十万字的溯源报告，以及老乡鸡时时刻刻在自查自纠的操作，这会让老乡鸡的形象更加立体，更会让消费者的五官更加立体。"
    },
    {
      "sentence_id": "s94",
      "char_len": 18,
      "snippet": "图片截取自: 老乡鸡，不能再扒下去了"
    },
    {
      "sentence_id": "s95",
      "char_len": 32,
      "snippet": "所以老乡鸡董事长在总部发布健康战略发布会时，说自己的健康战略是，"
    },
    {
      "sentence_id": "s96",
      "char_len": 26,
      "snippet": "【食材安全、菜品新鲜、营养量化、透明溯源、冠军推荐】"
    },
    {
      "sentence_id": "s97",
      "char_len": 17,
      "snippet": "没有人会有异议，怎么会有人有异议。"
    },
    {
      "sentence_id": "s98",
      "char_len": 28,
      "snippet": "再质疑老乡鸡，老乡鸡闹不好就拉着我看它怎么抡镐头种菜了。"
    },
    {
      "sentence_id": "s99",
      "char_len": 16,
      "snippet": "马上秋收了，咱可不能中这种诡计。"
    },
    {
      "sentence_id": "s100",
      "char_len": 34,
      "snippet": "也还得是老乡鸡，如果他们都不敢说这几个词，那行业才是真正的黑暗森林。"
    },
    {
      "sentence_id": "s101",
      "char_len": 12,
      "snippet": "我怕黑，咯咯哒，咯咯哒。"
    },
    {
      "sentence_id": "s102",
      "char_len": 1,
      "snippet": "4"
    },
    {
      "sentence_id": "s103",
      "char_len": 47,
      "snippet": "最后也是最现实的一点是，实际上老乡鸡一直在强调，自己也有外采供应商，自己也会外采一些鸡肉食材。"
    },
    {
      "sentence_id": "s104",
      "char_len": 47,
      "snippet": "但这些供应商是谁，怎么联系，不合格的被淘汰，评级较低的要亲自驻点帮扶，这些报告里写的也很清楚。"
    },
    {
      "sentence_id": "s105",
      "char_len": 44,
      "snippet": "毕竟以它的规模来看，全自有自产自销也不现实，自己农场建得再大，也不如全国消费者的需求大。"
    },
    {
      "sentence_id": "s106",
      "char_len": 17,
      "snippet": "但还是那句话，功夫，都是磨出来的。"
    },
    {
      "sentence_id": "s107",
      "char_len": 19,
      "snippet": "就像冠军也是在一次次训练后，才赢来的。"
    },
    {
      "sentence_id": "s108",
      "char_len": 44,
      "snippet": "老乡鸡不可能一口气吃成个胖子，但就是它这时刻报备，反复精进的过程，才是我们选择它的原因。"
    },
    {
      "sentence_id": "s109",
      "char_len": 17,
      "snippet": "生活够累了，大家坦诚一点，都挺好。"
    },
    {
      "sentence_id": "s110",
      "char_len": 32,
      "snippet": "老乡鸡不需要跟任何品牌比，只需要做自己，胜过前一天的自己都够了。"
    },
    {
      "sentence_id": "s111",
      "char_len": 27,
      "snippet": "它自己会写报告，消费者心中也会有报告，对错都看着眼里。"
    },
    {
      "sentence_id": "s112",
      "char_len": 8,
      "snippet": "我们日子长着呢。"
    },
    {
      "sentence_id": "s113",
      "char_len": 8,
      "snippet": "在下一个明天见。"
    },
    {
      "sentence_id": "s114",
      "char_len": 4,
      "snippet": "天天见。"
    }
  ],
