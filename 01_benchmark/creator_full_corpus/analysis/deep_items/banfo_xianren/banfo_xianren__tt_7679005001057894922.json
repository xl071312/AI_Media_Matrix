  "performance_tier": "MEDIAN",
  "spoken_marker_eligible": "N/A_TEXT",
  "analysis_status": "OK",
  "analyzer_version": "phase_c_v1",
  "sentence_count": 88,
  "sentences_index": [
    {
      "sentence_id": "s1",
      "char_len": 1,
      "snippet": "1"
    },
    {
      "sentence_id": "s2",
      "char_len": 29,
      "snippet": "当最近瑞幸开始送垃圾袋的时候，我开始担心他们的精神状态了。"
    },
    {
      "sentence_id": "s3",
      "char_len": 18,
      "snippet": "这么多年，他们居然整了点有用的东西。"
    },
    {
      "sentence_id": "s4",
      "char_len": 12,
      "snippet": "但这个东西，还不够神经。"
    },
    {
      "sentence_id": "s5",
      "char_len": 23,
      "snippet": "你试过在喝瑞幸的时候，多点一根百亿活菌吸管吗？"
    },
    {
      "sentence_id": "s6",
      "char_len": 7,
      "snippet": "就是这个东西。"
    },
    {
      "sentence_id": "s7",
      "char_len": 22,
      "snippet": "是，我知道生吃活菌这种事情听起来有点毛毛的。"
    },
    {
      "sentence_id": "s8",
      "char_len": 18,
      "snippet": "一开始我也觉得瑞幸弄这个东西是疯了。"
    },
    {
      "sentence_id": "s9",
      "char_len": 38,
      "snippet": "活菌这个词搭配的应该是胶头滴管而不是吸管，往嘴里放这个我真是要给自己壮壮胆。"
    },
    {
      "sentence_id": "s10",
      "char_len": 31,
      "snippet": "但这几天，我买了好多杯瑞幸，每次都要多点一根这个百亿活菌吸管。"
    },
    {
      "sentence_id": "s11",
      "char_len": 6,
      "snippet": "我吸了一口。"
    },
    {
      "sentence_id": "s12",
      "char_len": 20,
      "snippet": "活菌刺溜一下笑了，它说肠子啊，人生苦短。"
    },
    {
      "sentence_id": "s13",
      "char_len": 20,
      "snippet": "来呀，快活呀，反正我，总拿外卖敷衍三餐。"
    },
    {
      "sentence_id": "s14",
      "char_len": 12,
      "snippet": "我为什么沉迷跟菌群接吻？"
    },
    {
      "sentence_id": "s15",
      "char_len": 14,
      "snippet": "因为我的肠子早已被外卖折损。"
    },
    {
      "sentence_id": "s16",
      "char_len": 39,
      "snippet": "我每天吃吃吃，吃到大肠让我滚，小肠问我为何如此心狠，为何对自己的肠胃如此残忍。"
    },
    {
      "sentence_id": "s17",
      "char_len": 43,
      "snippet": "我咬着活菌吸管猛吸，仿佛要吸回被辜负的岁月点滴，雪白明月照在大地，藏着我最深处的秘密。"
    },
    {
      "sentence_id": "s18",
      "char_len": 35,
      "snippet": "大肠嚼嚼嚼，小肠嘬嘬嘬，它们争抢起活菌火锅，它们把我的身体变成了餐桌。"
    },
    {
      "sentence_id": "s19",
      "char_len": 21,
      "snippet": "大肠掐住小肠，小肠袭击大脑，大脑放弃思考。"
    },
    {
      "sentence_id": "s20",
      "char_len": 23,
      "snippet": "大脑缺氧了，崩溃了，海马体和松果体一起爆炸了。"
    },
    {
      "sentence_id": "s21",
      "char_len": 8,
      "snippet": "大脑说我要活菌！"
    },
    {
      "sentence_id": "s22",
      "char_len": 5,
      "snippet": "我要活菌！"
    },
    {
      "sentence_id": "s23",
      "char_len": 5,
      "snippet": "我要活菌！"
    },
    {
      "sentence_id": "s24",
      "char_len": 17,
      "snippet": "这不是活菌，这是我给身体交的赎金。"
    },
    {
      "sentence_id": "s25",
      "char_len": 8,
      "snippet": "百亿活菌很多吗？"
    },
    {
      "sentence_id": "s26",
      "char_len": 9,
      "snippet": "这点赎金就够了吗？"
    },
    {
      "sentence_id": "s27",
      "char_len": 6,
      "snippet": "还远远不够。"
    },
    {
      "sentence_id": "s28",
      "char_len": 21,
      "snippet": "哪怕百亿活菌，也救不了肠子消化外卖的工伤；"
    },
    {
      "sentence_id": "s29",
      "char_len": 21,
      "snippet": "哪怕百亿活菌，也换不回我从屁股溜走的健康。"
    },
    {
      "sentence_id": "s30",
      "char_len": 13,
      "snippet": "屁股对我说，崽种，直视我！"
    },
    {
      "sentence_id": "s31",
      "char_len": 7,
      "snippet": "直视我的眼睛！"
    },
    {
      "sentence_id": "s32",
      "char_len": 14,
      "snippet": "桀桀桀，知道你为什么便秘吗？"
    },
    {
      "sentence_id": "s33",
      "char_len": 15,
      "snippet": "桀桀桀，知道你为什么得痔疮吗？"
    },
    {
      "sentence_id": "s34",
      "char_len": 15,
      "snippet": "桀桀桀，知道谁是身体的主人吗？"
    },
    {
      "sentence_id": "s35",
      "char_len": 24,
      "snippet": "是大肠小肠，是踉踉跄跄，是牛马鸡羊，是匆匆忙忙。"
    },
    {
      "sentence_id": "s36",
      "char_len": 12,
      "snippet": "是天道有常，是人生无常。"
    },
    {
      "sentence_id": "s37",
      "char_len": 56,
      "snippet": "原来疯的不是瑞幸，是绝望的人类食品和外卖工业，是我对浪费时间的胆怯，是每天接起电话条件反射的【外卖放门口谢谢】。"
    },
    {
      "sentence_id": "s38",
      "char_len": 14,
      "snippet": "谢谢谢谢谢谢，感谢宇宙毁灭。"
    },
    {
      "sentence_id": "s39",
      "char_len": 38,
      "snippet": "我突然想吃大粪浇灌的青菜了，但那可能不是大粪而是狗屎，我吃了的话狗吃什么呢？"
    },
    {
      "sentence_id": "s40",
      "char_len": 38,
      "snippet": "我怀念走地鸡了可我还不如走地鸡呢，我是笼养鸡，我只有显示屏那么大的方寸天地。"
    },
    {
      "sentence_id": "s41",
      "char_len": 21,
      "snippet": "爪子踩在键盘上，在word里下出一个个蛋。"
    },
    {
      "sentence_id": "s42",
      "char_len": 26,
      "snippet": "咯咯哒，咯咯哒，咯咯咯咯咯咯咯咯咯咯咯咯咯咯咯咯哒。"
    },
    {
      "sentence_id": "s43",
      "char_len": 7,
      "snippet": "我又吸了一口。"
    },
    {
      "sentence_id": "s44",
      "char_len": 19,
      "snippet": "这块活菌比较大颗，在我嘴里没马上化开。"
    },
    {
      "sentence_id": "s45",
      "char_len": 20,
      "snippet": "我嚼了一下，菌群哗啦哗啦，灵魂顺流而下。"
    },
    {
      "sentence_id": "s46",
      "char_len": 32,
      "snippet": "亿万年前，恐龙相互撕咬，洞穴里鼠鼠细细小小，天上飞着九头的怪鸟。"
    },
    {
      "sentence_id": "s47",
      "char_len": 13,
      "snippet": "我说鼠鼠你就是我的祖先吗？"
    },
    {
      "sentence_id": "s48",
      "char_len": 34,
      "snippet": "你不要出洞了好不好……我们哺乳动物……究竟会变成什么样子啊（哽咽）。"
    },
    {
      "sentence_id": "s49",
      "char_len": 26,
      "snippet": "百万年前，野牛迁徙狮子咆哮，南方古猿在大草原上奔跑。"
    },
    {
      "sentence_id": "s50",
      "char_len": 33,
      "snippet": "彼时它们还不知道，自己奔向的不是星辰大海，而是国潮外卖和狠活饭菜。"
    },
    {
      "sentence_id": "s51",
      "char_len": 5,
      "snippet": "不要进化！"
    },
    {
      "sentence_id": "s52",
      "char_len": 5,
      "snippet": "不要进化！"
    },
    {
      "sentence_id": "s53",
      "char_len": 5,
      "snippet": "不要进化！"
    },
    {
      "sentence_id": "s54",
      "char_len": 7,
      "snippet": "这里，不是家。"
    },
    {
      "sentence_id": "s55",
      "char_len": 27,
      "snippet": "我睁开眼，一群裸猿爬上食物链顶端，顶端放着一个外卖架。"
    },
    {
      "sentence_id": "s56",
      "char_len": 22,
      "snippet": "三排第四个外卖盒，就是你们努力几万年的奖赏。"
    },
    {
      "sentence_id": "s57",
      "char_len": 23,
      "snippet": "裸猿挠挠头，顶端就吃这种东西啊，早知道不爬了。"
    },
    {
      "sentence_id": "s58",
      "char_len": 20,
      "snippet": "我哭了，我说人类在进化史上从未如此失败。"
    },
    {
      "sentence_id": "s59",
      "char_len": 16,
      "snippet": "活菌笑了，谁告诉你们越顶端越好？"
    },
    {
      "sentence_id": "s60",
      "char_len": 23,
      "snippet": "别逗你菌哥笑了，菌哥在地球上出现得不比你们早？"
    },
    {
      "sentence_id": "s61",
      "char_len": 8,
      "snippet": "资历不比你们老？"
    },
    {
      "sentence_id": "s62",
      "char_len": 12,
      "snippet": "食物链是你菌哥不想爬吗？"
    },
    {
      "sentence_id": "s63",
      "char_len": 8,
      "snippet": "是你菌哥看不上。"
    },
    {
      "sentence_id": "s64",
      "char_len": 36,
      "snippet": "金字塔的顶端只有针尖大，爬得越高压力就越大，容错就越低，生存空间就越小。"
    },
    {
      "sentence_id": "s65",
      "char_len": 11,
      "snippet": "傻了吧，吃上人粮了吧。"
    },
    {
      "sentence_id": "s66",
      "char_len": 21,
      "snippet": "人现在混得还不如羊，起码羊真的可以吃到草。"
    },
    {
      "sentence_id": "s67",
      "char_len": 30,
      "snippet": "而你们吃的是钢铁畜牧场里的钢铁饲料，深夜有社畜的灵魂在惨叫。"
    },
    {
      "sentence_id": "s68",
      "char_len": 6,
      "snippet": "是谁在惨叫？"
    },
    {
      "sentence_id": "s69",
      "char_len": 15,
      "snippet": "哦，原来是我被生活抽出了牛叫。"
    },
    {
      "sentence_id": "s70",
      "char_len": 36,
      "snippet": "牛说我要吃草，我说来我这里我的生活全是草，全是草，草草草草草草草草草草。"
    },
    {
      "sentence_id": "s71",
      "char_len": 37,
      "snippet": "牛说我的生活真奇妙，于是牛成了我，我成了牛，我们在大草原上淋雨变得滑溜溜。"
    },
    {
      "sentence_id": "s72",
      "char_len": 35,
      "snippet": "滑溜溜，原来是菌群在出溜，菌群说我们六六六，六六六，六六六六六六六六。"
    },
    {
      "sentence_id": "s73",
      "char_len": 7,
      "snippet": "我又吸了一口。"
    },
    {
      "sentence_id": "s74",
      "char_len": 28,
      "snippet": "活菌吸管空了，瑞幸的杯子空了，马桶空了，我的肠子也空了。"
    },
    {
      "sentence_id": "s75",
      "char_len": 8,
      "snippet": "肠子终于满意了。"
    },
    {
      "sentence_id": "s76",
      "char_len": 18,
      "snippet": "肠子说下不为例，以后要对自己好一点。"
    },
    {
      "sentence_id": "s77",
      "char_len": 14,
      "snippet": "我点点头，可我知道我做不到。"
    },
    {
      "sentence_id": "s78",
      "char_len": 24,
      "snippet": "喝完这杯瑞幸，和菌群说完拜拜，我还是会一切如故。"
    },
    {
      "sentence_id": "s79",
      "char_len": 24,
      "snippet": "因为我没有退路，我太忙了我不可能想吃什么自己煮。"
    },
    {
      "sentence_id": "s80",
      "char_len": 24,
      "snippet": "外卖就是我唯一的出路，哪怕我早已吃吃吃吃到想吐。"
    },
    {
      "sentence_id": "s81",
      "char_len": 11,
      "snippet": "可是我，没有资格说不。"
    },
    {
      "sentence_id": "s82",
      "char_len": 11,
      "snippet": "马桶里，活菌叹了口气。"
    },
    {
      "sentence_id": "s83",
      "char_len": 15,
      "snippet": "叹世人纷纷入歧途，总把浮生误。"
    },
    {
      "sentence_id": "s84",
      "char_len": 8,
      "snippet": "这时，电话响了。"
    },
    {
      "sentence_id": "s85",
      "char_len": 10,
      "snippet": "你好，你的外卖到了。"
    },
    {
      "sentence_id": "s86",
      "char_len": 6,
      "snippet": "我打开了门。"
    },
    {
      "sentence_id": "s87",
      "char_len": 6,
      "snippet": "也关上了门。"
    },
    {
      "sentence_id": "s88",
      "char_len": 15,
      "snippet": "这大概，也就是瑞幸的精神状态。"
    }
  ],
