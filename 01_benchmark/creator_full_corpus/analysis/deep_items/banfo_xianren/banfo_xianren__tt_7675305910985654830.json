  "source_sha256": "e62293221631cc7cece8c62acd3d3b60859486c75b8964b706f6fb090ba8f899",
  "performance_tier": "CONTROL",
  "spoken_marker_eligible": "N/A_TEXT",
  "analysis_status": "OK",
