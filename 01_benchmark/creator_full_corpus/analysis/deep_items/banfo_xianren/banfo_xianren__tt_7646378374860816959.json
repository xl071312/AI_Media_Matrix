  "analyzer_version": "phase_c_v1",
  "sentence_count": 81,
  "sentences_index": [
    {
      "sentence_id": "s1",
      "char_len": 21,
      "snippet": "图片截取自: 亚朵这是要跟偷拍摄像头拼了？"
    },
    {
      "sentence_id": "s2",
      "char_len": 1,
      "snippet": "1"
    },
    {
      "sentence_id": "s3",
      "char_len": 10,
      "snippet": "周末不卷，随便写点。"
    },
    {
      "sentence_id": "s4",
      "char_len": 37,
      "snippet": "前几天住亚朵，选客房服务时，发现一个非常赛博朋克的东西，隐藏摄像头检测仪。"
    },
    {
      "sentence_id": "s5",
      "char_len": 21,
      "snippet": "图片截取自: 亚朵这是要跟偷拍摄像头拼了？"
    },
    {
      "sentence_id": "s6",
      "char_len": 23,
      "snippet": "当然，不是卖也不是送，是免费借，用完了要还的。"
    },
    {
      "sentence_id": "s7",
      "char_len": 35,
      "snippet": "但不重要，看到这玩意的瞬间，我突然担心大家以后在别的地方刷到我的视频。"
    },
    {
      "sentence_id": "s8",
      "char_len": 17,
      "snippet": "因为怕丑到你们，于是赶紧下了一个。"
    },
    {
      "sentence_id": "s9",
      "char_len": 22,
      "snippet": "这东西有镜头、红外、无线、触动四种检测模式。"
    },
    {
      "sentence_id": "s10",
      "char_len": 21,
      "snippet": "图片截取自: 亚朵这是要跟偷拍摄像头拼了？"
    },
    {
      "sentence_id": "s11",
      "char_len": 20,
      "snippet": "拿到之后，我满屋巡逻，连马桶都要绕一圈。"
    },
    {
      "sentence_id": "s12",
      "char_len": 17,
      "snippet": "谁知道会不会有人把摄像头藏在那呢。"
    },
    {
      "sentence_id": "s13",
      "char_len": 21,
      "snippet": "图片截取自: 亚朵这是要跟偷拍摄像头拼了？"
    },
    {
      "sentence_id": "s14",
      "char_len": 24,
      "snippet": "在确认应该没人偷窥我的曼妙身材后，我长舒一口气。"
    },
    {
      "sentence_id": "s15",
      "char_len": 18,
      "snippet": "然后我突然意识到，亚朵这一招太6了。"
    },
    {
      "sentence_id": "s16",
      "char_len": 22,
      "snippet": "这东西最牛的地方，不在于它能不能查出摄像头。"
    },
    {
      "sentence_id": "s17",
      "char_len": 13,
      "snippet": "而在于它同时解决了两件事："
    },
    {
      "sentence_id": "s18",
      "char_len": 9,
      "snippet": "给好人提供安全感。"
    },
    {
      "sentence_id": "s19",
      "char_len": 10,
      "snippet": "给坏人提高作恶成本。"
    },
    {
      "sentence_id": "s20",
      "char_len": 14,
      "snippet": "前者叫安慰剂，后者叫核威慑。"
    },
    {
      "sentence_id": "s21",
      "char_len": 19,
      "snippet": "而这两个东西叠在一起，就是稀缺的能力。"
    },
    {
      "sentence_id": "s22",
      "char_len": 1,
      "snippet": "2"
    },
    {
      "sentence_id": "s23",
      "char_len": 21,
      "snippet": "现在很多年轻人住酒店，已经形成了条件反射。"
    },
    {
      "sentence_id": "s24",
      "char_len": 23,
      "snippet": "进门插卡拉窗帘，打开手机摄像头，就开始反侦察。"
    },
    {
      "sentence_id": "s25",
      "char_len": 14,
      "snippet": "扫电视，扫插座，烟雾报警器。"
    },
    {
      "sentence_id": "s26",
      "char_len": 23,
      "snippet": "你明知道自己大概率啥也查不出来，但你还是会查。"
    },
    {
      "sentence_id": "s27",
      "char_len": 4,
      "snippet": "为什么？"
    },
    {
      "sentence_id": "s28",
      "char_len": 10,
      "snippet": "因为人类需要安全感。"
    },
    {
      "sentence_id": "s29",
      "char_len": 23,
      "snippet": "安全感不一定来自于安全，有时候只需要做点什么。"
    },
    {
      "sentence_id": "s30",
      "char_len": 14,
      "snippet": "就像有人坐飞机必须摸护身符；"
    },
    {
      "sentence_id": "s31",
      "char_len": 9,
      "snippet": "睡觉时必开小夜灯；"
    },
    {
      "sentence_id": "s32",
      "char_len": 36,
      "snippet": "电脑卡了一下，立刻下载各种电脑管家全家，恨不得再给CPU请个人士来驱邪。"
    },
    {
      "sentence_id": "s33",
      "char_len": 32,
      "snippet": "都知道没啥用，但觉得自己【已经做了点什么】，就是能让你安心一点。"
    },
    {
      "sentence_id": "s34",
      "char_len": 11,
      "snippet": "安全感，来源于可控性。"
    },
    {
      "sentence_id": "s35",
      "char_len": 14,
      "snippet": "哪怕这种可控性只是个安慰剂。"
    },
    {
      "sentence_id": "s36",
      "char_len": 16,
      "snippet": "亚朵这个检测仪，本质上也是一样。"
    },
    {
      "sentence_id": "s37",
      "char_len": 18,
      "snippet": "因为只能防住最简单基础的那些摄像头。"
    },
    {
      "sentence_id": "s38",
      "char_len": 35,
      "snippet": "以及从逻辑上讲，消费者自己拿个检测仪到处扫，已经有点付费上班那意思了。"
    },
    {
      "sentence_id": "s39",
      "char_len": 13,
      "snippet": "可现实不讲逻辑，只讲人性。"
    },
    {
      "sentence_id": "s40",
      "char_len": 23,
      "snippet": "你拿着个小方盒，扫插座、扫路由、扫空调出风口。"
    },
    {
      "sentence_id": "s41",
      "char_len": 26,
      "snippet": "扫完一圈，指示灯没报警，你才会觉得今晚能安心脱裤子。"
    },
    {
      "sentence_id": "s42",
      "char_len": 22,
      "snippet": "哪怕它只是个安慰剂，哪怕你知道它是个安慰剂。"
    },
    {
      "sentence_id": "s43",
      "char_len": 5,
      "snippet": "但你需要。"
    },
    {
      "sentence_id": "s44",
      "char_len": 26,
      "snippet": "这种理解需求并解决需求的能力，本身就是一种稀缺资源。"
    },
    {
      "sentence_id": "s45",
      "char_len": 1,
      "snippet": "3"
    },
    {
      "sentence_id": "s46",
      "char_len": 28,
      "snippet": "更重要的是，这个检测仪还承担了一个隐藏作用，心理核威慑。"
    },
    {
      "sentence_id": "s47",
      "char_len": 13,
      "snippet": "不是对消费者，是对偷拍者。"
    },
    {
      "sentence_id": "s48",
      "char_len": 36,
      "snippet": "很多人理解问题方案时，总抱有一种天真的幻想，觉得问题就应该【彻底解决】。"
    },
    {
      "sentence_id": "s49",
      "char_len": 24,
      "snippet": "这是不现实的，只要憋着心思搞坏，人有无数种方法。"
    },
    {
      "sentence_id": "s50",
      "char_len": 30,
      "snippet": "现实世界里，大部分策略逻辑的核心不是消灭，而是【提高成本】。"
    },
    {
      "sentence_id": "s51",
      "char_len": 23,
      "snippet": "便利店门口天天贴着一张没人看的【监控已覆盖】。"
    },
    {
      "sentence_id": "s52",
      "char_len": 9,
      "snippet": "能完全杜绝犯罪吗？"
    },
    {
      "sentence_id": "s53",
      "char_len": 3,
      "snippet": "不能。"
    },
    {
      "sentence_id": "s54",
      "char_len": 11,
      "snippet": "但它能让作恶变得麻烦。"
    },
    {
      "sentence_id": "s55",
      "char_len": 17,
      "snippet": "犯罪是为了获利，不是为了挑战自己。"
    },
    {
      "sentence_id": "s56",
      "char_len": 26,
      "snippet": "绝大多数坏人都不是joker，没人跟你玩犯罪的艺术。"
    },
    {
      "sentence_id": "s57",
      "char_len": 72,
      "snippet": "你让一个偷拍者发现这酒店的人天天拿着个检测仪搁那cos名侦探柯南，他的第一反应一定不是【挑战我吗有点意思，这个偷拍王我当定了】，而是【换一家】。"
    },
    {
      "sentence_id": "s58",
      "char_len": 20,
      "snippet": "这就像很多小偷为什么不偷装方向盘锁的车。"
    },
    {
      "sentence_id": "s59",
      "char_len": 6,
      "snippet": "不是打不开。"
    },
    {
      "sentence_id": "s60",
      "char_len": 5,
      "snippet": "是懒得开。"
    },
    {
      "sentence_id": "s61",
      "char_len": 30,
      "snippet": "初中生搞霸凌都没有逮着体育生大肌霸欺负的，人家是坏又不是蠢。"
    },
    {
      "sentence_id": "s62",
      "char_len": 32,
      "snippet": "犯罪行为的底层逻辑是【低成本获利】，是【谁好欺负，我就欺负谁】。"
    },
    {
      "sentence_id": "s63",
      "char_len": 30,
      "snippet": "所以，真正有效的威慑，不是绝对防御，是让坏人觉得【没必要】。"
    },
    {
      "sentence_id": "s64",
      "char_len": 15,
      "snippet": "亚朵搞免费检测仪就是这个道理。"
    },
    {
      "sentence_id": "s65",
      "char_len": 18,
      "snippet": "它不一定能从技术上彻底解决偷拍问题。"
    },
    {
      "sentence_id": "s66",
      "char_len": 31,
      "snippet": "但它会让偷拍的成本变得更高，因为你弄不好还要赔一个摄像头进去。"
    },
    {
      "sentence_id": "s67",
      "char_len": 13,
      "snippet": "再弄不好，人也要跟着进去。"
    },
    {
      "sentence_id": "s68",
      "char_len": 33,
      "snippet": "当每个潜在偷拍者都这么想时，亚朵自然就从他们的目标清单里被划掉了。"
    },
    {
      "sentence_id": "s69",
      "char_len": 15,
      "snippet": "酒店那么多呢，干嘛非得找亚朵？"
    },
    {
      "sentence_id": "s70",
      "char_len": 10,
      "snippet": "对消费者，给安全感；"
    },
    {
      "sentence_id": "s71",
      "char_len": 9,
      "snippet": "对坏人，给压迫感。"
    },
    {
      "sentence_id": "s72",
      "char_len": 21,
      "snippet": "这不止是洞察了人性，还同时拿捏了两种人性。"
    },
    {
      "sentence_id": "s73",
      "char_len": 13,
      "snippet": "甚至，都不需要百分百有效。"
    },
    {
      "sentence_id": "s74",
      "char_len": 47,
      "snippet": "只要亚朵有隐藏摄像头检测仪这件事传开，消费者自然会拿着检测仪到处扫，偷拍者自然会远离这个品牌。"
    },
    {
      "sentence_id": "s75",
      "char_len": 14,
      "snippet": "问题自然而然的就会被解决掉。"
    },
    {
      "sentence_id": "s76",
      "char_len": 20,
      "snippet": "再次强调，这并不能杜绝一切偷拍，不现实。"
    },
    {
      "sentence_id": "s77",
      "char_len": 17,
      "snippet": "但这绝对可以让消费者简单求个心安。"
    },
    {
      "sentence_id": "s78",
      "char_len": 51,
      "snippet": "相当于你说你怕鬼，别的酒店还在说【我们这里没有鬼】，亚朵前台直接站着两个coser扮演英叔给你整点活。"
    },
    {
      "sentence_id": "s79",
      "char_len": 18,
      "snippet": "前者是教育消费者，后者是理解消费者。"
    },
    {
      "sentence_id": "s80",
      "char_len": 14,
      "snippet": "所以亚朵这一波不是6，是9。"
    },
    {
      "sentence_id": "s81",
      "char_len": 6,
      "snippet": "直接6翻了。"
    }
  ],
