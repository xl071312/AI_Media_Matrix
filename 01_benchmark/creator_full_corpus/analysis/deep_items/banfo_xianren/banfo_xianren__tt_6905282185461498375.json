  "source_sha256": "c2eb7eb1f0dbe7a09e7f1c5907dddefb1f8735422e7992243f5206dba7c66904",
  "performance_tier": "HIGH",
  "spoken_marker_eligible": "N/A_TEXT",
  "analysis_status": "OK",
  "analyzer_version": "phase_c_v1",
  "sentence_count": 120,
  "sentences_index": [
    {
      "sentence_id": "s1",
      "char_len": 20,
      "snippet": "图片截取自: 陈鹤皋，疯癫宗师的冷静江湖"
    },
    {
      "sentence_id": "s2",
      "char_len": 16,
      "snippet": "这是仙人JUMP的第302篇原创"
    },
    {
      "sentence_id": "s3",
      "char_len": 1,
      "snippet": "1"
    },
    {
      "sentence_id": "s4",
      "char_len": 24,
      "snippet": "上世纪九十年代，大家可以选择的娱乐方式非常有限。"
    },
    {
      "sentence_id": "s5",
      "char_len": 74,
      "snippet": "除了打自己孩子，看邻居打邻居孩子，看邻居打自己孩子，以及自己打邻居之外，报纸杂志"
    },
    {
      "sentence_id": "s6",
      "char_len": 88,
      "snippet": "那时武术杂志的中缝广告画风非常独特，在其他报纸杂志的广告以透视眼镜，魔术扑克教学"
    },
    {
      "sentence_id": "s7",
      "char_len": 50,
      "snippet": "这些自创门派绝大多数活不过3个月，一般来说掌门人把从亲戚那里借来的钱祸祸完了以后"
    },
    {
      "sentence_id": "s8",
      "char_len": 24,
      "snippet": "从这个角度讲，祸害投资人这事儿前辈们早就干过了。"
    },
    {
      "sentence_id": "s9",
      "char_len": 44,
      "snippet": "陈鹤皋的无限制格斗也是这股自创门派潮中的一支，并且画风和其他大师完全不同，大家感"
    },
    {
      "sentence_id": "s10",
      "char_len": 20,
      "snippet": "图片截取自: 陈鹤皋，疯癫宗师的冷静江湖"
    },
    {
      "sentence_id": "s11",
      "char_len": 22,
      "snippet": "（图片中的字，是陈老师自己写的，不是我写的）"
    },
    {
      "sentence_id": "s12",
      "char_len": 41,
      "snippet": "除了画风之外，陈老师还和其他掌门人不同的是，他的无限制格斗得到了当地电视台的报道"
    },
    {
      "sentence_id": "s13",
      "char_len": 30,
      "snippet": "那还是上世纪九十年代，能够在屏幕上露脸，代表的是极大的认可。"
    },
    {
      "sentence_id": "s14",
      "char_len": 41,
      "snippet": "报道给他带来了更多的学员和更大的影响力，随之而来的又是更多的报道，武学实现了闭环"
    },
    {
      "sentence_id": "s15",
      "char_len": 26,
      "snippet": "在无限制格斗创立前，陈鹤皋在杭州的约架界就小有名气。"
    },
    {
      "sentence_id": "s16",
      "char_len": 35,
      "snippet": "那个时候的习武爱好者喜欢在杭州武林广场和人单挑，陈鹤皋在里面卓尔不凡。"
    },
    {
      "sentence_id": "s17",
      "char_len": 31,
      "snippet": "主要特点是，每次和人比武，必以迅雷不及掩耳之势猛踢对手的下身。"
    },
    {
      "sentence_id": "s18",
      "char_len": 10,
      "snippet": "猛地一脚，一脚双响。"
    },
    {
      "sentence_id": "s19",
      "char_len": 16,
      "snippet": "场面用成语来形容，就是鹤立鸡群。"
    },
    {
      "sentence_id": "s20",
      "char_len": 20,
      "snippet": "图片截取自: 陈鹤皋，疯癫宗师的冷静江湖"
    },
    {
      "sentence_id": "s21",
      "char_len": 20,
      "snippet": "图片来源：《极厉害、实用的无限制格斗术！"
    },
    {
      "sentence_id": "s22",
      "char_len": 1,
      "snippet": "》"
    },
    {
      "sentence_id": "s23",
      "char_len": 6,
      "snippet": "作者：陈鹤皋"
    },
    {
      "sentence_id": "s24",
      "char_len": 16,
      "snippet": "（字是他自己手写的，不是我干的）"
    },
    {
      "sentence_id": "s25",
      "char_len": 32,
      "snippet": "关于这些人的反应，在2020年的无限制格斗官网上有这样一段描述："
    },
    {
      "sentence_id": "s26",
      "char_len": 41,
      "snippet": "“那么多年过去了，个别当年被陈鹤皋击中丸子者，至今千方百计的贬低他及无限制武道”"
    },
    {
      "sentence_id": "s27",
      "char_len": 20,
      "snippet": "图片截取自: 陈鹤皋，疯癫宗师的冷静江湖"
    },
    {
      "sentence_id": "s28",
      "char_len": 12,
      "snippet": "图片来源：无限制格斗官网"
    },
    {
      "sentence_id": "s29",
      "char_len": 40,
      "snippet": "说实话，我觉得蛋裂之仇只是让他们变成黑子而没有直接黑化，已经是很有修养的表现了。"
    },
    {
      "sentence_id": "s30",
      "char_len": 45,
      "snippet": "我猜他们之所以只是在口头上和在网上黑陈鹤皋，而不是报复回去，可能是因为后来陈鹤皋"
    },
    {
      "sentence_id": "s31",
      "char_len": 23,
      "snippet": "一开始的时候，陈鹤皋老师是穿运动鞋和人打架的。"
    },
    {
      "sentence_id": "s32",
      "char_len": 13,
      "snippet": "后来，陈老师只穿尖头皮鞋。"
    },
    {
      "sentence_id": "s33",
      "char_len": 15,
      "snippet": "这种鞋不但能踢碎，还能踢进去。"
    },
    {
      "sentence_id": "s34",
      "char_len": 5,
      "snippet": "失蛋事小。"
    },
    {
      "sentence_id": "s35",
      "char_len": 5,
      "snippet": "失节事大。"
    },
    {
      "sentence_id": "s36",
      "char_len": 20,
      "snippet": "图片截取自: 陈鹤皋，疯癫宗师的冷静江湖"
    },
    {
      "sentence_id": "s37",
      "char_len": 1,
      "snippet": "2"
    },
    {
      "sentence_id": "s38",
      "char_len": 27,
      "snippet": "1993年创立无限制格斗后，陈鹤皋在民间武术界出名了。"
    },
    {
      "sentence_id": "s39",
      "char_len": 49,
      "snippet": "这一次出名的范围是全省乃至全国，他的无限制格斗和邵发明老师的野山武道一起成为了武"
    },
    {
      "sentence_id": "s40",
      "char_len": 47,
      "snippet": "在论资排辈的武术界，陈鹤皋无师无祖，没有传承，格斗经验主要来自打架斗殴以及浓痰喷"
    },
    {
      "sentence_id": "s41",
      "char_len": 34,
      "snippet": "21世纪初，网络论武的风气渐起，陈鹤皋被人从武术论坛嘲笑到百度贴吧。"
    },
    {
      "sentence_id": "s42",
      "char_len": 10,
      "snippet": "主要是因为画风问题。"
    },
    {
      "sentence_id": "s43",
      "char_len": 12,
      "snippet": "陈老师的画风，是这样的。"
    },
    {
      "sentence_id": "s44",
      "char_len": 20,
      "snippet": "图片截取自: 陈鹤皋，疯癫宗师的冷静江湖"
    },
    {
      "sentence_id": "s45",
      "char_len": 84,
      "snippet": "那个时候还没有“沙雕”这种偏中性的形容词，所有人都在探讨他到底是什么神经病，他的"
    },
    {
      "sentence_id": "s46",
      "char_len": 43,
      "snippet": "这样的质疑并不能够击溃陈鹤皋老师，陈老师不但每日勤加练习，还打算用书为全国人民赋"
    },
    {
      "sentence_id": "s47",
      "char_len": 32,
      "snippet": "他手书手绘的《无限制格斗术》里，记录了他发明的各种“格斗技巧”。"
    },
    {
      "sentence_id": "s48",
      "char_len": 17,
      "snippet": "这本书非常强大，大家可以感受一下。"
    },
    {
      "sentence_id": "s49",
      "char_len": 20,
      "snippet": "图片截取自: 陈鹤皋，疯癫宗师的冷静江湖"
    },
    {
      "sentence_id": "s50",
      "char_len": 46,
      "snippet": "插画的画风也非常生动形象，有点像低配版德国漫画《父与子》，插画的内容更鬼畜，招招"
    },
    {
      "sentence_id": "s145",
      "char_len": 31,
      "snippet": "你说无限制格斗不讲武德，可能只是这个门派的武德和别人不太一样。"
    },
    {
      "sentence_id": "s146",
      "char_len": 14,
      "snippet": "武德，无非就是一种行事准则。"
    },
    {
      "sentence_id": "s147",
      "char_len": 55,
      "snippet": "我都无限制了，那我的武德就是能偷袭就绝不刚正面，能暗算就绝不光明磊落，能围攻就绝"
    },
    {
      "sentence_id": "s148",
      "char_len": 25,
      "snippet": "什么叫无限制格斗，就是敌人负责格斗，我负责无限制。"
    },
    {
      "sentence_id": "s149",
      "char_len": 31,
      "snippet": "战术上，无限制格斗是通过对工具和环境的选择，把格斗变得不对称。"
    },
    {
      "sentence_id": "s150",
      "char_len": 41,
      "snippet": "有限制的格斗，比如柔道，拳击，散打，强调竞技的公平性，要分出重量级，双方都要徒手"
    },
    {
      "sentence_id": "s151",
      "char_len": 19,
      "snippet": "但我为什么要在你的体系中跟你公平格斗？"
    },
    {
      "sentence_id": "s152",
      "char_len": 13,
      "snippet": "为什么要跟你打文明礼貌仗?"
    },
    {
      "sentence_id": "s153",
      "char_len": 13,
      "snippet": "正常的情况下，我们不打架。"
    },
    {
      "sentence_id": "s154",
      "char_len": 19,
      "snippet": "我们要守法， Love &Peace。"
    },
    {
      "sentence_id": "s155",
      "char_len": 20,
      "snippet": "图片截取自: 陈鹤皋，疯癫宗师的冷静江湖"
    },
    {
      "sentence_id": "s156",
      "char_len": 40,
      "snippet": "陈老师要求学生们日常绝不跟人动手，以逃跑为主，关键时刻，遇到歹徒时，才允许出手。"
    },
    {
      "sentence_id": "s157",
      "char_len": 11,
      "snippet": "所以，出手，不可留手。"
    },
    {
      "sentence_id": "s158",
      "char_len": 25,
      "snippet": "既然不可留手，为什么不能够在对我有利的环境下格斗？"
    },
    {
      "sentence_id": "s159",
      "char_len": 19,
      "snippet": "我练武是为了在公平的情况下打赢别人吗？"
    },
    {
      "sentence_id": "s160",
      "char_len": 27,
      "snippet": "不，我是为了在遇到歹徒的时候能够自保，能够保护无辜者。"
    },
    {
      "sentence_id": "s161",
      "char_len": 22,
      "snippet": "歹徒本身就不讲底线，所以我不会跟歹徒讲公平。"
    },
    {
      "sentence_id": "s162",
      "char_len": 16,
      "snippet": "让歹徒躺下，才是世界最大的公平。"
    },
    {
      "sentence_id": "s163",
      "char_len": 6,
      "snippet": "Peace？"
    },
    {
      "sentence_id": "s164",
      "char_len": 8,
      "snippet": "你想peach！"
    },
    {
      "sentence_id": "s165",
      "char_len": 20,
      "snippet": "图片截取自: 陈鹤皋，疯癫宗师的冷静江湖"
    },
    {
      "sentence_id": "s166",
      "char_len": 1,
      "snippet": "4"
    },
    {
      "sentence_id": "s167",
      "char_len": 23,
      "snippet": "在无限制格斗的官网上，藏着一个很有趣的小细节。"
    },
    {
      "sentence_id": "s168",
      "char_len": 15,
      "snippet": "有两个栏目，一上一下靠得很近。"
    },
    {
      "sentence_id": "s169",
      "char_len": 37,
      "snippet": "一个叫“深深痛惜”，拿来搜集各路拳王、格斗高手在擂台外被普通人阴死的案例。"
    },
    {
      "sentence_id": "s170",
      "char_len": 20,
      "snippet": "图片截取自: 陈鹤皋，疯癫宗师的冷静江湖"
    },
    {
      "sentence_id": "s171",
      "char_len": 39,
      "snippet": "另一个叫“正当防卫”，专门记录无限制格斗的弟子是怎么以一敌多，暴锤各路歹徒的。"
    },
    {
      "sentence_id": "s172",
      "char_len": 19,
      "snippet": "潜台词是什么，生死搏杀，擂台那套不行。"
    },
    {
      "sentence_id": "s173",
      "char_len": 6,
      "snippet": "我那套，行。"
    },
    {
      "sentence_id": "s174",
      "char_len": 15,
      "snippet": "所以，大家要爱我的无限制格斗。"
    },
    {
      "sentence_id": "s175",
      "char_len": 35,
      "snippet": "论初心，陈鹤皋并非天生就是陈海皇，他其实是爱过武术的，也正经练过武术。"
    },
    {
      "sentence_id": "s176",
      "char_len": 24,
      "snippet": "当年刚开始练武的时候，他也不是奔着杀人术去练的。"
    },
    {
      "sentence_id": "s177",
      "char_len": 14,
      "snippet": "那年，他还是一个普通的少年。"
    },
    {
      "sentence_id": "s178",
      "char_len": 20,
      "snippet": "图片截取自: 陈鹤皋，疯癫宗师的冷静江湖"
    },
    {
      "sentence_id": "s179",
      "char_len": 26,
      "snippet": "陈鹤皋的武术画风之所以越来越诡异，主要源于两次冲击。"
    },
    {
      "sentence_id": "s180",
      "char_len": 36,
      "snippet": "小学的时候，陈鹤皋因为身体瘦弱，在学校经常被校霸欺负，饱受校园暴力之苦。"
    },
    {
      "sentence_id": "s181",
      "char_len": 25,
      "snippet": "为了保护自己，他加入了学校的体育老师组织的武术队。"
    },
    {
      "sentence_id": "s182",
      "char_len": 33,
      "snippet": "结果九岁那年，他听说武功高强的体育老师在校外被三个高中生打成重伤."
    },
    {
      "sentence_id": "s183",
      "char_len": 52,
      "snippet": "这件事情给了年幼的陈鹤皋极大的冲击，他发现学武好像还是要挨打，而且因为比较耐揍，"
    },
    {
      "sentence_id": "s184",
      "char_len": 14,
      "snippet": "不是所有事情都是越久越爽的。"
    },
    {
      "sentence_id": "s299",
      "char_len": 62,
      "snippet": "当年罗神贵捅死小偷以后上电视，剪刀上的血迹都还在，他一脸老实地对镜头说这次事件给"
    },
    {
      "sentence_id": "s300",
      "char_len": 33,
      "snippet": "剩下两个幸存的小偷在监狱听了更慌了，你走出来了，我们就准备上菜了。"
    },
    {
      "sentence_id": "s301",
      "char_len": 18,
      "snippet": "那天唢呐吹的很响，村里的菜真的很香。"
    },
    {
      "sentence_id": "s302",
      "char_len": 20,
      "snippet": "图片截取自: 陈鹤皋，疯癫宗师的冷静江湖"
    },
    {
      "sentence_id": "s303",
      "char_len": 1,
      "snippet": "7"
    },
    {
      "sentence_id": "s304",
      "char_len": 37,
      "snippet": "要系统地理解陈鹤皋这个人，以及他的无限制格斗术，就不能脱离那个时代去理解。"
    },
    {
      "sentence_id": "s305",
      "char_len": 29,
      "snippet": "无限制格斗术成型于上世纪90年代，那是一个比较狂野的年代。"
    },
    {
      "sentence_id": "s306",
      "char_len": 19,
      "snippet": "最典型的一个现象，就是车匪路霸的横行。"
    },
    {
      "sentence_id": "s307",
      "char_len": 26,
      "snippet": "歹徒掏出刀来砍断人手，只为了取下女孩子手上的金戒指。"
    },
    {
      "sentence_id": "s308",
      "char_len": 22,
      "snippet": "长途客车上几个人围住你，就是为了抢你的背包。"
    },
    {
      "sentence_id": "s309",
      "char_len": 26,
      "snippet": "很多乡镇都打出了标语，车匪路霸，打伤无罪，打死有奖。"
    },
    {
      "sentence_id": "s310",
      "char_len": 38,
      "snippet": "当时学习无限制格斗术的，很多都是大车司机和的哥，这些人本身就是风险高发群体。"
    },
    {
      "sentence_id": "s311",
      "char_len": 64,
      "snippet": "大车需要开车跑长途，的哥每天要和大量陌生人打交道，在一个不安定的社会环境下，他们"
    },
    {
      "sentence_id": "s312",
      "char_len": 62,
      "snippet": "2002年，杭州出现了几起劫杀出租车司机的恶性案件，陈鹤皋被杭州市公安局交通治安"
    },
    {
      "sentence_id": "s313",
      "char_len": 37,
      "snippet": "2004年，针对监狱犯人袭警的事件，陈鹤皋被邀请去警官学院教授徒手制暴术。"
    },
    {
      "sentence_id": "s314",
      "char_len": 39,
      "snippet": "这些对无限制格斗术来说，是属于旧时代的余晖，但也是这门武术思想最后的高光时刻。"
    },
    {
      "sentence_id": "s315",
      "char_len": 29,
      "snippet": "2009年，陈鹤皋的天龙武馆关闭，对外的说法，是退隐江湖。"
    },
    {
      "sentence_id": "s316",
      "char_len": 15,
      "snippet": "但即使是现在，陈老师也是教官。"
    },
    {
      "sentence_id": "s317",
      "char_len": 10,
      "snippet": "这是真正的实战大师。"
    },
    {
      "sentence_id": "s318",
      "char_len": 20,
