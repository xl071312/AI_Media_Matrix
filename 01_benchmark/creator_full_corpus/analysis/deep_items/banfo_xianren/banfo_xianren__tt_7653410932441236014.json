  "source_sha256": "1917fed5c05f1ce2c5e192f197fac850a12c7d0af917eea8f25286f8d73b0169",
  "performance_tier": "MEDIAN",
  "spoken_marker_eligible": "N/A_TEXT",
  "analysis_status": "OK",
  "analyzer_version": "phase_c_v1",
  "sentence_count": 84,
  "sentences_index": [
    {
      "sentence_id": "s1",
      "char_len": 18,
      "snippet": "图片截取自: 星聚会KTV救了我的命"
    },
    {
      "sentence_id": "s2",
      "char_len": 1,
      "snippet": "1"
    },
    {
      "sentence_id": "s3",
      "char_len": 21,
      "snippet": "每当我不开心时，就会刷新在星聚会KTV里。"
    },
    {
      "sentence_id": "s4",
      "char_len": 18,
      "snippet": "图片截取自: 星聚会KTV救了我的命"
    },
    {
      "sentence_id": "s5",
      "char_len": 34,
      "snippet": "生活的苦我一个凡人实在摆弄不明白，所以我拿起麦克风，cos魔法少女。"
    },
    {
      "sentence_id": "s6",
      "char_len": 28,
      "snippet": "小小的包厢是大大的舞台，音乐响起以前，我要跟俗世告个别。"
    },
    {
      "sentence_id": "s7",
      "char_len": 38,
      "snippet": "等BGM响起的那一刻，所有烦啊，燥啊，愁啊，闹啊，都结算成了我升级的EXP。"
    },
    {
      "sentence_id": "s8",
      "char_len": 47,
      "snippet": "我怎么会跟俗人生气呢，他们可都是我冒险路上的NPC，刁难我的大道理，全是增加我趣味性的小把戏。"
    },
    {
      "sentence_id": "s9",
      "char_len": 56,
      "snippet": "我唱啊，舞啊，扭啊，叫啊，西施未必有我妖娆，妲己未必有我风趣，等哥们攒好了读档的HP，再来将这群傻子们全部朵蜜。"
    },
    {
      "sentence_id": "s10",
      "char_len": 26,
      "snippet": "谢谢星聚会，谢谢你作为我的复活泉水，谢谢你，谢谢你。"
    },
    {
      "sentence_id": "s11",
      "char_len": 1,
      "snippet": "2"
    },
    {
      "sentence_id": "s12",
      "char_len": 19,
      "snippet": "你说我在开玩笑，星聚会哪有那么大魅力。"
    },
    {
      "sentence_id": "s13",
      "char_len": 15,
      "snippet": "朋友，说你不懂星聚会这个东西。"
    },
    {
      "sentence_id": "s14",
      "char_len": 25,
      "snippet": "明面上看，它就是个十五年的老KTV品牌，历久弥坚。"
    },
    {
      "sentence_id": "s15",
      "char_len": 35,
      "snippet": "私下来看呢，它就跟打地鼠一样，一不留神就偷偷在你身边的商业区里开一家。"
    },
    {
      "sentence_id": "s16",
      "char_len": 50,
      "snippet": "如果你再凝视它，你会发现它在全球，注意是【全球】，在KTV大环境越来越稀烂的情况下，开了超千家门店。"
    },
    {
      "sentence_id": "s17",
      "char_len": 20,
      "snippet": "当然，这还不是最刺激的，最刺激的是什么？"
    },
    {
      "sentence_id": "s18",
      "char_len": 11,
      "snippet": "KTV是日本发明的吧？"
    },
    {
      "sentence_id": "s19",
      "char_len": 19,
      "snippet": "理论上讲日本人应该对这个东西不陌生吧？"
    },
    {
      "sentence_id": "s20",
      "char_len": 57,
      "snippet": "但星聚会硬是在日本涩谷开了店，那个纯粉涂装的四层小楼立起来的那一刻，别说日本消费者傻了，看到那火爆的程度我也傻了。"
    },
    {
      "sentence_id": "s21",
      "char_len": 40,
      "snippet": "因为日本KTV还保留着90年代的装修感，全新声光电的星聚会一过去，这不是碾压吗。"
    },
    {
      "sentence_id": "s22",
      "char_len": 7,
      "snippet": "它像KTV吗？"
    },
    {
      "sentence_id": "s23",
      "char_len": 31,
      "snippet": "这像是给KTV界盖了个教学楼，全亚洲的消费者都要来这儿办走读。"
    },
    {
      "sentence_id": "s24",
      "char_len": 44,
      "snippet": "可等你真体会一次后，你会发现的确不一样，星聚会它不光给KTV玩明白了，更给人性玩明白了。"
    },
    {
      "sentence_id": "s25",
      "char_len": 12,
      "snippet": "过去KTV为什么式微了？"
    },
    {
      "sentence_id": "s26",
      "char_len": 6,
      "snippet": "是人的事儿。"
    },
    {
      "sentence_id": "s27",
      "char_len": 46,
      "snippet": "过去你没那么多烦恼，自然会想到KTV里闹一闹，哪怕KTV里没轮到你唱歌，你也会看着MV傻笑。"
    },
    {
      "sentence_id": "s28",
      "char_len": 4,
      "snippet": "现在呢？"
    },
    {
      "sentence_id": "s29",
      "char_len": 52,
      "snippet": "每天一睁眼海量的信息就往你脑子里跑，大脑皮层都要被撑平了，有空你只想一个人消失一会儿，静一静，再静一静。"
    },
    {
      "sentence_id": "s30",
      "char_len": 93,
      "snippet": "你这时再让我去传统KTV，哇我上班被甲方老板玩，下班被生活家庭玩，工作时同事抢我活儿，唱歌时朋友抢我麦，我是什么必玩榜第一名吗，要在KTV里罚着最久的站，A着最"
    },
    {
      "sentence_id": "s31",
      "char_len": 23,
      "snippet": "但在星聚会不一样，它真不一样，它能让你静一静。"
    },
    {
      "sentence_id": "s32",
      "char_len": 28,
      "snippet": "小门一关，大家互不打扰，不一定要唱歌，娱乐活动纷纷扰扰。"
    },
    {
      "sentence_id": "s33",
      "char_len": 41,
      "snippet": "这种感觉像孙悟空逃了五指山，薛平贵离了西凉界，周文王放马归西岐，李太白独酌花月夜。"
    },
    {
      "sentence_id": "s34",
      "char_len": 37,
      "snippet": "你是你自己，又不是你自己，社会学的你自己付了费，就为了找回生物学的你自己。"
    },
    {
      "sentence_id": "s35",
      "char_len": 31,
      "snippet": "看似是KTV，但又不一样，没人用异样的眼光看着你，大家都很忙。"
    },
    {
      "sentence_id": "s36",
      "char_len": 40,
      "snippet": "中年人在团建和应酬，老年人在念诗和合唱，青年人在打游戏玩桌游，跳帕梅拉和刘耕宏。"
    },
    {
      "sentence_id": "s37",
      "char_len": 21,
      "snippet": "甚至还有少年人，开上一个包间，备考上自习。"
    },
    {
      "sentence_id": "s38",
      "char_len": 23,
      "snippet": "图书馆和自习室当然好，但要抢，蜷缩着，不自在。"
    },
    {
      "sentence_id": "s39",
      "char_len": 30,
      "snippet": "但在这里，你可以肆无忌惮的跷二郎腿，如同八爪鱼一样虎踞龙蟠。"
    },
    {
      "sentence_id": "s40",
      "char_len": 67,
      "snippet": "也别问能不能学下去，那房费一交，一分一秒都有了价格，必然会有动力，别人的鬼哭狼嚎就是你最好的白噪音，沙沙的写字声就是知识进脑的协奏曲。"
    },
    {
      "sentence_id": "s41",
      "char_len": 40,
      "snippet": "根本不可能大脑卡壳，嚎两嗓子就完事儿了，小时候在电视机前写作业，不也是这样的嘛。"
    },
    {
      "sentence_id": "s42",
      "char_len": 40,
      "snippet": "甚至我见到最抽象的，是在星聚会里练WOTA艺的，那个包间一闪一闪跟要出金了一样。"
    },
    {
      "sentence_id": "s43",
      "char_len": 7,
      "snippet": "我为什么知道？"
    },
    {
      "sentence_id": "s44",
      "char_len": 53,
      "snippet": "因为我上完厕所走错房间了，推开门的一瞬间一应援棒差点抡我脸上了，沙发上还有一大哥在给另一个大哥腰上贴膏药。"
    },
    {
      "sentence_id": "s45",
      "char_len": 12,
      "snippet": "太自由了，真是太自由了。"
    },
    {
      "sentence_id": "s46",
      "char_len": 1,
      "snippet": "3"
    },
    {
      "sentence_id": "s47",
      "char_len": 18,
      "snippet": "更6的是，星聚会有了钱，它花明白了。"
    },
    {
      "sentence_id": "s48",
      "char_len": 63,
      "snippet": "像去年，它就冠名了第32届东方音乐风云榜，今年又继续冠名第33届东方音乐风云榜，上海梅奔体育场万人演唱会，给歌迷整得热血沸腾。"
    },
    {
      "sentence_id": "s49",
      "char_len": 30,
      "snippet": "此外，三年投入近亿研究AI，它也研究明白了，让你用，爽，了。"
    },
    {
      "sentence_id": "s50",
      "char_len": 18,
      "snippet": "图片截取自: 星聚会KTV救了我的命"
    },
    {
      "sentence_id": "s51",
      "char_len": 44,
      "snippet": "你说AI能够帮人类更好的进步，为我的工作赋能，为文娱活动提供更丰富的方式，这我不屑一顾。"
    },
    {
      "sentence_id": "s52",
      "char_len": 44,
      "snippet": "但你说这玩意能修音，很自然，还能智能推荐歌曲，让你在舒适区里唱个痛快，那我必将好好分析。"
    },
    {
      "sentence_id": "s53",
      "char_len": 13,
      "snippet": "我觉得它们的AI很尊重我。"
    },
    {
      "sentence_id": "s54",
      "char_len": 25,
      "snippet": "因为我经历了华语乐坛黄金年代，所以才有了周王陶林。"
    },
    {
      "sentence_id": "s55",
      "char_len": 23,
      "snippet": "华语乐坛停滞了二十年，跟我不在很难说没有关系。"
    },
    {
      "sentence_id": "s56",
      "char_len": 57,
      "snippet": "我拿起这个麦，就是为了将这失去的二十年找回来，难度不可谓不高，责任不可谓不大，但我无所畏惧，这就是AI给我的底气。"
    },
    {
      "sentence_id": "s57",
      "char_len": 31,
      "snippet": "这一刻，别叫我佛子，叫我清冷佛子，不是我累了，是华语乐坛醉了。"
    },
    {
      "sentence_id": "s58",
      "char_len": 60,
      "snippet": "那一刻我听着余音绕梁，小小的包间里有大大的回响，我突然想到二十年前我不是今天这样，那时我说我要读很多书，要做社会的栋梁。"
    },
    {
      "sentence_id": "s59",
      "char_len": 28,
      "snippet": "可如今我长大了，也变宽了，没成了栋梁，成了家庭的承重墙。"
    },
    {
      "sentence_id": "s60",
      "char_len": 35,
      "snippet": "最妙的，它还会给你同步出个MV，准确地解决了人类需要发朋友圈这一刚需。"
    },
    {
      "sentence_id": "s61",
      "char_len": 25,
      "snippet": "虽然我并不会发朋友圈，我也不想让人知道我去了哪里。"
    },
    {
      "sentence_id": "s62",
      "char_len": 21,
      "snippet": "这一片清净地，是我要闭口不谈的避世小秘密。"
    },
    {
      "sentence_id": "s63",
      "char_len": 68,
      "snippet": "但在我不方便去星聚会的时刻，我会打开慢慢看，那些快乐的时光也有能量，过去的我穿越时空开解着未来的我，提醒着我不该属于这里，我该属于那里。"
    },
    {
      "sentence_id": "s64",
      "char_len": 38,
      "snippet": "以后再聚会根本不可能离开星聚会，因为就这家最懂你的实力，能更好的还原我的美。"
    },
    {
      "sentence_id": "s65",
      "char_len": 36,
      "snippet": "以后唱歌也不可能不开AI评分功能，只有这个功能，才能最好的量化我的实力。"
    },
    {
      "sentence_id": "s66",
      "char_len": 45,
      "snippet": "在这儿不但能花钱，弄不好还能同唱一首歌赢到奖励，实力够强，一下午闹不好还能给包厢费赢出来。"
    },
    {
      "sentence_id": "s67",
      "char_len": 88,
      "snippet": "而且再强一点，因为星聚会里还能全国异地PK，你可以跟异地的歌友对决同一首歌，你这边刚获胜，服务员就实时把奖品（比如果盘）给端过来了，秋名山飙车，败者留下车标的感"
    },
    {
      "sentence_id": "s68",
      "char_len": 47,
      "snippet": "只是要小心站内信，总会有网友抱歌神大腿，以后你有了羁绊了，话筒拿不稳了，就再也不好意思赢他了。"
    },
    {
      "sentence_id": "s69",
      "char_len": 43,
      "snippet": "以后你们就是有杜甫和李白，张飞和关羽，伯牙和子期，没有勾心斗角，只有英雄间的惺惺相惜。"
    },
    {
      "sentence_id": "s70",
      "char_len": 28,
      "snippet": "唱完我们接着静一静，把多巴胺送给对方，把内啡肽留给自己。"
    },
    {
      "sentence_id": "s71",
      "char_len": 1,
      "snippet": "4"
    },
    {
      "sentence_id": "s72",
      "char_len": 22,
      "snippet": "最抽象的是，现在星聚会不光卖周边，星仔玩偶。"
    },
    {
      "sentence_id": "s73",
      "char_len": 18,
      "snippet": "图片截取自: 星聚会KTV救了我的命"
    },
    {
      "sentence_id": "s74",
      "char_len": 29,
      "snippet": "每当我看到这小子全神贯注的样子时，我的嘴巴也痒，想来两句。"
    },
    {
      "sentence_id": "s75",
      "char_len": 57,
      "snippet": "它还出了智能卡拉OK机，直接把KTV搬进了你的家里，HIFI遇上WIFI，大曲库遇上小歌王，移动的它遇上曼妙的我。"
    },
    {
      "sentence_id": "s76",
      "char_len": 25,
      "snippet": "好比赤兔遇吕布，哈利波特摸到扫帚，德彪骑上自行车。"
    },
    {
      "sentence_id": "s77",
      "char_len": 34,
      "snippet": "就是我妈在家看到这机器都双眼雪亮，以后广场舞上注定要多一个桑巴女王。"
    },
    {
      "sentence_id": "s78",
      "char_len": 40,
      "snippet": "自此每当烦躁的时刻，每当无奈的时刻，每当疲惫的时刻，每当身不由己漂泊江湖的时刻。"
    },
    {
      "sentence_id": "s79",
      "char_len": 26,
      "snippet": "我都能感受到冥冥之中有个麦克风在喊我，上号，快上号。"
    },
    {
      "sentence_id": "s80",
      "char_len": 49,
      "snippet": "桌子上的外卖突然变成了果盘，白开水变成了果汁，皱皱巴巴的T恤也变成了百褶裙，我要变，变回魔法少女。"
    },
    {
      "sentence_id": "s81",
      "char_len": 42,
      "snippet": "跟所有的卡稿说拜拜，跟所有的快乐说嗨嗨，亲爱的亲爱的这副本太难打了，我升个级就回来。"
    },
    {
      "sentence_id": "s82",
      "char_len": 25,
      "snippet": "是非对错我已无心分辨，能让我不开心的，统统是大辩。"
    },
    {
      "sentence_id": "s83",
      "char_len": 12,
      "snippet": "我将去去就来，去去就来。"
    },
    {
      "sentence_id": "s84",
      "char_len": 13,
      "snippet": "这，就是我奖励自己的时间。"
    }
  ],
