  "source_sha256": "f24916c5437dde9d85bc35eed7e20ebb164ab9dd3d9fc637877b48201ee20e96",
  "performance_tier": "CONTROL",
  "spoken_marker_eligible": "N/A_TEXT",
  "analysis_status": "OK",
