  "sentence_count": 71,
  "sentences_index": [
    {
      "sentence_id": "s1",
      "char_len": 1,
      "snippet": "1"
    },
    {
      "sentence_id": "s2",
      "char_len": 10,
      "snippet": "一个非常炸裂的新闻。"
    },
    {
      "sentence_id": "s3",
      "char_len": 14,
      "snippet": "增程车，似乎卖不过纯电车了。"
    },
    {
      "sentence_id": "s4",
      "char_len": 22,
      "snippet": "图片截取自: 纯电车应该给问界和理想再磕个头"
    },
    {
      "sentence_id": "s5",
      "char_len": 12,
      "snippet": "（新闻来自每日经济新闻）"
    },
    {
      "sentence_id": "s6",
      "char_len": 16,
      "snippet": "看起来很反直觉，但一点也不奇怪。"
    },
    {
      "sentence_id": "s7",
      "char_len": 29,
      "snippet": "2年前我就写过，纯电车要给增程车，尤其是问界和理想，磕头。"
    },
    {
      "sentence_id": "s8",
      "char_len": 25,
      "snippet": "因为他们这种增程车的存在，会让纯电车有更好的未来。"
    },
    {
      "sentence_id": "s9",
      "char_len": 18,
      "snippet": "你的网络好友佛子哥，从来不玩马后炮。"
    },
    {
      "sentence_id": "s10",
      "char_len": 22,
      "snippet": "图片截取自: 纯电车应该给问界和理想再磕个头"
    },
    {
      "sentence_id": "s11",
      "char_len": 38,
      "snippet": "很多人觉得增程车会阻碍纯电，恰恰相反，增程车不是纯电车的竞争对手，而是奶妈。"
    },
    {
      "sentence_id": "s12",
      "char_len": 17,
      "snippet": "纯电车要感谢增程车，要大力的感谢。"
    },
    {
      "sentence_id": "s13",
      "char_len": 15,
      "snippet": "增程车卖得好，纯电车才有未来。"
    },
    {
      "sentence_id": "s14",
      "char_len": 37,
      "snippet": "大家嘲讽增程的那些原因，纯电续航短，关键时刻还得靠油，用油发电脱裤子放屁。"
    },
    {
      "sentence_id": "s15",
      "char_len": 22,
      "snippet": "图片截取自: 纯电车应该给问界和理想再磕个头"
    },
    {
      "sentence_id": "s16",
      "char_len": 20,
      "snippet": "就是这些黑点，才是纯电的大救星，引路人。"
    },
    {
      "sentence_id": "s17",
      "char_len": 11,
      "snippet": "为啥，你思考一个问题。"
    },
    {
      "sentence_id": "s18",
      "char_len": 21,
      "snippet": "阻碍一个油车用户买电车的最核心的原因是啥？"
    },
    {
      "sentence_id": "s19",
      "char_len": 9,
      "snippet": "其实就是续航焦虑。"
    },
    {
      "sentence_id": "s20",
      "char_len": 54,
      "snippet": "很多没买过纯电的人，真就是害怕车在半路趴窝，还会给自己脑补一堆极端的情况下自己车开不走只能被世界暴打的狼狈。"
    },
    {
      "sentence_id": "s21",
      "char_len": 30,
      "snippet": "不过他们又馋绿牌，所以，增程符合了他们的需求，算是过渡方案。"
    },
    {
      "sentence_id": "s22",
      "char_len": 22,
      "snippet": "图片截取自: 纯电车应该给问界和理想再磕个头"
    },
    {
      "sentence_id": "s23",
      "char_len": 71,
      "snippet": "当他们开上增程，开上这种纯电续航不到200公里（甚至100左右），超过了就要开始烧油并且驾驶感觉出现明显变化的车的时候，他们意识到了一个问题。"
    },
    {
      "sentence_id": "s24",
      "char_len": 26,
      "snippet": "200公里的纯电续航，基本覆盖了生活中99%的状况。"
    },
    {
      "sentence_id": "s25",
      "char_len": 21,
      "snippet": "以及没电的时候这车烧油发电开起来有点没劲。"
    },
    {
      "sentence_id": "s26",
      "char_len": 62,
      "snippet": "于是，会发现一个很诡异的现象，一到高速充电站，在那排队充电的很多都是能烧油的增程车，他们根本不乐意烧油继续跑，都在那补电呢。"
    },
    {
      "sentence_id": "s27",
      "char_len": 40,
      "snippet": "问了他们，还振振有词，说能抽根烟休息一下，毕竟加油站不能抽烟，只能看着油价抽搐。"
    },
    {
      "sentence_id": "s28",
      "char_len": 22,
      "snippet": "图片截取自: 纯电车应该给问界和理想再磕个头"
    },
    {
      "sentence_id": "s29",
      "char_len": 21,
      "snippet": "你别管车是怎么设计的，能充电我就充我就充！"
    },
    {
      "sentence_id": "s30",
      "char_len": 40,
      "snippet": "现实中，买了增程的人，很多时候真是能充电就充电，能纯电就纯电，能不加油就不加油。"
    },
    {
      "sentence_id": "s31",
      "char_len": 54,
      "snippet": "别说高速了，就我家小区地下车库停了一整排新能源，纯电车还真不一定有充电桩，但是增程的车，就没有不装充电桩的。"
    },
    {
      "sentence_id": "s32",
      "char_len": 19,
      "snippet": "只要装了充电器，就没有一天是不充电的。"
    },
    {
      "sentence_id": "s33",
      "char_len": 16,
      "snippet": "我问隔壁大哥你这车纯电续航多少。"
    },
    {
      "sentence_id": "s34",
      "char_len": 8,
      "snippet": "大哥说一百上下。"
    },
    {
      "sentence_id": "s35",
      "char_len": 35,
      "snippet": "然后兴致勃勃地给我详细讲述了他是如何和这一百公里的电池斗智斗勇的故事。"
    },
    {
      "sentence_id": "s36",
      "char_len": 22,
      "snippet": "图片截取自: 纯电车应该给问界和理想再磕个头"
    },
    {
      "sentence_id": "s37",
      "char_len": 16,
      "snippet": "可以说那点电算是被他给玩明白了。"
    },
    {
      "sentence_id": "s38",
      "char_len": 25,
      "snippet": "至于车里的油，还是提车那天去家的，算是资深老油了。"
    },
    {
      "sentence_id": "s39",
      "char_len": 10,
      "snippet": "我问大哥为啥不加油。"
    },
    {
      "sentence_id": "s40",
      "char_len": 12,
      "snippet": "大哥一句话给我干沉默了。"
    },
    {
      "sentence_id": "s41",
      "char_len": 13,
      "snippet": "我有电池啊，我为啥要加油。"
    },
    {
      "sentence_id": "s42",
      "char_len": 22,
      "snippet": "图片截取自: 纯电车应该给问界和理想再磕个头"
    },
    {
      "sentence_id": "s43",
      "char_len": 25,
      "snippet": "我一直以为买增程的人是长途需求很多，电池只是送的。"
    },
    {
      "sentence_id": "s44",
      "char_len": 28,
      "snippet": "聊了周围一圈才发现，原来电池才是硬需求，发动机才是送的。"
    },
    {
      "sentence_id": "s45",
      "char_len": 44,
      "snippet": "而这些人，在过去，都是绝对的油车支持者，绝对的担心自己车的续航问题，绝对的担心高速问题。"
    },
    {
      "sentence_id": "s46",
      "char_len": 22,
      "snippet": "图片截取自: 纯电车应该给问界和理想再磕个头"
    },
    {
      "sentence_id": "s47",
      "char_len": 70,
      "snippet": "结果增程车帮他们迈出第一步之后，他们感受了电的威力以及自己的实际需求后，下一辆车都表示要纯电，毕竟天天充电还是麻烦了，干脆弄个大电池的纯电。"
    },
    {
      "sentence_id": "s48",
      "char_len": 22,
      "snippet": "讲真很多买混动/增程的人可能都是这样的想的。"
    },
    {
      "sentence_id": "s49",
      "char_len": 13,
      "snippet": "一开始是为了解决里程焦虑。"
    },
    {
      "sentence_id": "s50",
      "char_len": 35,
      "snippet": "可一旦习惯了纯电模式后，就发现自己根本用不上发动机，甚至不想用发动机。"
    },
    {
      "sentence_id": "s51",
      "char_len": 17,
      "snippet": "只能对着本就不富裕的电池重拳出击。"
    },
    {
      "sentence_id": "s52",
      "char_len": 16,
      "snippet": "就是电池包保护得太好，没办法搞。"
    },
    {
      "sentence_id": "s53",
      "char_len": 20,
      "snippet": "我们小时候，都是对着四驱车的电池用牙咬。"
    },
    {
      "sentence_id": "s54",
      "char_len": 13,
      "snippet": "只要能榨干它最后一丝电量。"
    },
    {
      "sentence_id": "s55",
      "char_len": 9,
      "snippet": "什么招都用得出来。"
    },
    {
      "sentence_id": "s56",
      "char_len": 22,
      "snippet": "图片截取自: 纯电车应该给问界和理想再磕个头"
    },
    {
      "sentence_id": "s57",
      "char_len": 30,
      "snippet": "到最后就发现，与其这么折腾，还不如一步到位，直接上辆纯电车。"
    },
    {
      "sentence_id": "s58",
      "char_len": 30,
      "snippet": "增程的用户再换车的时候，大概率会因为不跑长途直接买一台电车。"
    },
    {
      "sentence_id": "s59",
      "char_len": 9,
      "snippet": "这就是人类的特性。"
    },
    {
      "sentence_id": "s60",
      "char_len": 23,
      "snippet": "总是给自己预设一堆极端情况，实际上发现用不到。"
    },
    {
      "sentence_id": "s61",
      "char_len": 40,
      "snippet": "而如果没有增程这种过渡方案，他们或许从头到尾都不会买一辆新能源车，会自己吓自己。"
    },
    {
      "sentence_id": "s62",
      "char_len": 22,
      "snippet": "图片截取自: 纯电车应该给问界和理想再磕个头"
    },
    {
      "sentence_id": "s63",
      "char_len": 15,
      "snippet": "增程看起来是一种技术上的过渡。"
    },
    {
      "sentence_id": "s64",
      "char_len": 11,
      "snippet": "实际上是营销上的过渡。"
    },
    {
      "sentence_id": "s65",
      "char_len": 34,
      "snippet": "深度体验增程之后，就会发现纯电的香，以及生活中实际不需要担心的续航。"
    },
    {
      "sentence_id": "s66",
      "char_len": 26,
      "snippet": "每一个增程用户，都大概率在未来有可能转化为纯电用户。"
    },
    {
      "sentence_id": "s67",
      "char_len": 22,
      "snippet": "从这个角度来说，纯电真的要给增程狠狠地磕头。"
    },
    {
      "sentence_id": "s68",
      "char_len": 11,
      "snippet": "增程替纯电，打了广告。"
    },
    {
      "sentence_id": "s69",
      "char_len": 16,
      "snippet": "增程车，就是纯电车最好的4S店。"
    },
    {
      "sentence_id": "s70",
      "char_len": 8,
      "snippet": "哦不对，4S电。"
    },
    {
      "sentence_id": "s71",
      "char_len": 22,
      "snippet": "图片截取自: 纯电车应该给问界和理想再磕个头"
    }
  ],
