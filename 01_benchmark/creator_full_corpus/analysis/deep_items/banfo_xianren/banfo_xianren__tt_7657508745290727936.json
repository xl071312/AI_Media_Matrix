  "source_sha256": "796a356a5f055ae0551eeefe1386e0574b6c91ea11ee4227cf70a08ab04dd9de",
  "performance_tier": "HIGH",
  "spoken_marker_eligible": "N/A_TEXT",
  "analysis_status": "OK",
  "analyzer_version": "phase_c_v1",
  "sentence_count": 70,
  "sentences_index": [
    {
      "sentence_id": "s1",
      "char_len": 20,
      "snippet": "图片截取自: 春秋航空，看到这个要做噩梦"
    },
    {
      "sentence_id": "s2",
      "char_len": 1,
      "snippet": "1"
    },
    {
      "sentence_id": "s3",
      "char_len": 34,
      "snippet": "不开玩笑朋友们，我活了这么久，第一次刷电商刷到觉得自己要灵魂出窍了。"
    },
    {
      "sentence_id": "s4",
      "char_len": 17,
      "snippet": "我相信春秋航空看了这个也得做噩梦。"
    },
    {
      "sentence_id": "s5",
      "char_len": 12,
      "snippet": "这是2个收纳U形枕枕套。"
    },
    {
      "sentence_id": "s6",
      "char_len": 9,
      "snippet": "注意，不是U型枕。"
    },
    {
      "sentence_id": "s7",
      "char_len": 44,
      "snippet": "U形枕这玩意本身就是个很临时的东西，脖子疼的时候你叫它宝宝，落地以后你说你是回避型脖子。"
    },
    {
      "sentence_id": "s8",
      "char_len": 26,
      "snippet": "给它备枕芯，基本等于给泡面配海参，给共享单车贴车衣。"
    },
    {
      "sentence_id": "s9",
      "char_len": 22,
      "snippet": "因为这玩意不是用来套枕芯的，是用来套行李的。"
    },
    {
      "sentence_id": "s10",
      "char_len": 20,
      "snippet": "图片截取自: 春秋航空，看到这个要做噩梦"
    },
    {
      "sentence_id": "s11",
      "char_len": 26,
      "snippet": "平时你叫我U形枕，我不挑你理，到了机场，该叫我什么？"
    },
    {
      "sentence_id": "s12",
      "char_len": 29,
      "snippet": "没错，它就是颈椎病检测仪，斜方肌增强器，廉航的漏洞修复包。"
    },
    {
      "sentence_id": "s13",
      "char_len": 21,
      "snippet": "什么登机箱，什么压缩袋，都是中产的气氛组。"
    },
    {
      "sentence_id": "s14",
      "char_len": 19,
      "snippet": "收纳U形枕套，是春秋航空最可怕的噩梦。"
    },
    {
      "sentence_id": "s15",
      "char_len": 1,
      "snippet": "2"
    },
    {
      "sentence_id": "s16",
      "char_len": 14,
      "snippet": "坐春秋航空最大的感受是什么？"
    },
    {
      "sentence_id": "s17",
      "char_len": 5,
      "snippet": "不是便宜。"
    },
    {
      "sentence_id": "s18",
      "char_len": 36,
      "snippet": "而是你会突然意识到，原来在航空公司眼里，人类这种生物根本不需要拥有物品。"
    },
    {
      "sentence_id": "s19",
      "char_len": 20,
      "snippet": "喜鹊衔枝，松鼠藏果，骆驼都知道储存脂肪。"
    },
    {
      "sentence_id": "s20",
      "char_len": 25,
      "snippet": "只有春秋航空觉得你出门多带两条内裤高低得上七宗罪。"
    },
    {
      "sentence_id": "s21",
      "char_len": 28,
      "snippet": "我老早就写过了，春秋航空是一家伪装成航空公司的货运公司。"
    },
    {
      "sentence_id": "s22",
      "char_len": 20,
      "snippet": "你去托运，柜台告诉你，不好意思，请加钱。"
    },
    {
      "sentence_id": "s23",
      "char_len": 18,
      "snippet": "你说，20寸的小行李箱随身也能带上。"
    },
    {
      "sentence_id": "s24",
      "char_len": 34,
      "snippet": "柜台说，不好意思，体积超过20*30*40，重量超过7kg，请加钱。"
    },
    {
      "sentence_id": "s25",
      "char_len": 13,
      "snippet": "你说那带多两个包就完事了。"
    },
    {
      "sentence_id": "s26",
      "char_len": 25,
      "snippet": "空姐说，不好意思，随身行李只能免费带一件，请加钱。"
    },
    {
      "sentence_id": "s27",
      "char_len": 35,
      "snippet": "你面对这个周一围上身一样的柜台，无助得像一个开卷考试却没带书的大学生。"
    },
    {
      "sentence_id": "s28",
      "char_len": 43,
      "snippet": "20×30×40的体积限制让你怀疑人生，7公斤的行李限额让你觉得人类好像并不需要内裤。"
    },
    {
      "sentence_id": "s29",
      "char_len": 26,
      "snippet": "在春秋航空的算法面前，再强的购物癖也只能学会断舍离。"
    },
    {
      "sentence_id": "s30",
      "char_len": 23,
      "snippet": "为了省托运费，很多人开发出了人类肉体的新用途。"
    },
    {
      "sentence_id": "s31",
      "char_len": 17,
      "snippet": "有人套六件T恤，像一颗成精的洋葱；"
    },
    {
      "sentence_id": "s32",
      "char_len": 18,
      "snippet": "有人裤子套裤子，走起来像低帧率动画。"
    },
    {
      "sentence_id": "s33",
      "char_len": 57,
      "snippet": "有人羽绒服里面塞卫衣，卫衣里面塞衬衫，衬衫里面塞秋衣，远远看上去像一辆不小心在毕业季接了大学城搬家订单的五菱宏光。"
    },
    {
      "sentence_id": "s34",
      "char_len": 37,
      "snippet": "在春秋航空面前，你都只有两个选项，要cos断舍离仙人，要么化身人形行李箱。"
    },
    {
      "sentence_id": "s35",
      "char_len": 13,
      "snippet": "但，这个收纳U形枕，来了。"
    },
    {
      "sentence_id": "s36",
      "char_len": 1,
      "snippet": "3"
    },
    {
      "sentence_id": "s37",
      "char_len": 37,
      "snippet": "收纳U形枕之于春秋航空，就像蝙蝠侠之于哥谭，鸣人之于木叶村，加班之于社畜。"
    },
    {
      "sentence_id": "s38",
      "char_len": 25,
      "snippet": "再看看这两条枕头，我要是春秋航空我都觉得被锁喉了。"
    },
    {
      "sentence_id": "s39",
      "char_len": 20,
      "snippet": "图片截取自: 春秋航空，看到这个要做噩梦"
    },
    {
      "sentence_id": "s40",
      "char_len": 36,
      "snippet": "这玩意就像一个现实版四次元口袋，麻瓜版无痕伸展咒，哆啦A梦看了都想报警。"
    },
    {
      "sentence_id": "s41",
      "char_len": 24,
      "snippet": "夏天，它能吞下一周的换洗衣物，还饶你一条沙滩裤；"
    },
    {
      "sentence_id": "s42",
      "char_len": 41,
      "snippet": "冬天，它能塞进一件薄羽绒服，外加围巾手套暖宝宝，微微鼓起的厚度刚好冒充你的斜方肌。"
    },
    {
      "sentence_id": "s43",
      "char_len": 58,
      "snippet": "你可以把洗漱包、化妆包塞，把各种【万一酒店不提供】的旅行装通通塞进去，让屈臣氏和名创优品的外卖业务迎来最残酷的拷打。"
    },
    {
      "sentence_id": "s44",
      "char_len": 40,
      "snippet": "只要脖子够硬，你甚至可以在一个U形枕里完成从春装到夏装，从商务到休闲的完整循环。"
    },
    {
      "sentence_id": "s45",
      "char_len": 56,
      "snippet": "T恤和羊绒衫可以在U形枕里相遇，沙滩裤和冰凉贴能在同一条拉链里结成伴侣，一根坚硬的液压脖子就能创死所有容量焦虑。"
    },
    {
      "sentence_id": "s46",
      "char_len": 37,
      "snippet": "那些行李限额的焦虑，那些值机柜台的博弈，都在一层轻薄化纤的包裹里安详逝去。"
    },
    {
      "sentence_id": "s47",
      "char_len": 44,
      "snippet": "就这个装载能力，哆啦A梦看了都觉得次元口袋有点垃圾，好莱坞看了都想找我拍纳尼亚传奇续集。"
    },
    {
      "sentence_id": "s48",
      "char_len": 13,
      "snippet": "登机前，它是你柔软的支撑；"
    },
    {
      "sentence_id": "s49",
      "char_len": 13,
      "snippet": "登机后，它是你旅行的后盾。"
    },
    {
      "sentence_id": "s50",
      "char_len": 29,
      "snippet": "关键是，飞行过程中，拉链一开，旅客看了无言，机长看了沉默。"
    },
    {
      "sentence_id": "s51",
      "char_len": 27,
      "snippet": "然后大家痛恨飞机上没有网，恨不得立马打开电商开始搜索。"
    },
    {
      "sentence_id": "s52",
      "char_len": 1,
      "snippet": "4"
    },
    {
      "sentence_id": "s53",
      "char_len": 17,
      "snippet": "人类对于很多东西，都有天然的信任。"
    },
    {
      "sentence_id": "s54",
      "char_len": 22,
      "snippet": "例如一根香蕉，一个棒棒糖，又例如一个U形枕。"
    },
    {
      "sentence_id": "s55",
      "char_len": 32,
      "snippet": "行李箱会被查，背包会被称，水会被没收，塑料袋会被怀疑的目光审视。"
    },
    {
      "sentence_id": "s56",
      "char_len": 17,
      "snippet": "但没有人会质疑脖子上的一个U形枕。"
    },
    {
      "sentence_id": "s57",
      "char_len": 32,
      "snippet": "安检不会检查你的颈椎健康，也不会怀疑你的脖子里装满了一整个夏天。"
    },
    {
      "sentence_id": "s58",
      "char_len": 14,
      "snippet": "他们只能看到一个疲惫的灵魂。"
    },
    {
      "sentence_id": "s59",
      "char_len": 44,
      "snippet": "它护送着社畜走过春秋的严查，带着T恤在值机柜台里七进七出，领着洗漱包在行李架下纵横捭阖。"
    },
    {
      "sentence_id": "s60",
      "char_len": 16,
      "snippet": "你拖两个箱子，别人以为你要搬家；"
    },
    {
      "sentence_id": "s61",
      "char_len": 25,
      "snippet": "你和朋友一人一个U形枕，一看就是加完班来不及回家。"
    },
    {
      "sentence_id": "s62",
      "char_len": 23,
      "snippet": "你背两个背包，公司以为你要挑战春秋航空的底线；"
    },
    {
      "sentence_id": "s63",
      "char_len": 27,
      "snippet": "你脖子上套个U形枕，别人只会觉得你最近项目到了截止线。"
    },
    {
      "sentence_id": "s64",
      "char_len": 34,
      "snippet": "你箱子装得好是收纳达人，但U形枕塞满只能看到一个为生活奔波的打工人。"
    },
    {
      "sentence_id": "s65",
      "char_len": 37,
      "snippet": "搭配一根亚健康颈椎，空乘看了想给我盖毛毯（还不收钱），机长看了想给我升舱。"
    },
    {
      "sentence_id": "s66",
      "char_len": 28,
      "snippet": "谁能想到那根被富贵包祝福过的颈椎上面，扛着小半个优衣库？"
    },
    {
      "sentence_id": "s67",
      "char_len": 21,
      "snippet": "春秋航空缜密的算计，顶不住U型枕轻轻发力。"
    },
    {
      "sentence_id": "s68",
      "char_len": 28,
      "snippet": "看着超重的飞机，更高的油耗，春秋航空也得问我有没有头绪。"
    },
    {
      "sentence_id": "s69",
      "char_len": 10,
      "snippet": "而我不会告诉他们的。"
    },
    {
      "sentence_id": "s70",
      "char_len": 10,
      "snippet": "这就是，博弈的秘密。"
    }
  ],
