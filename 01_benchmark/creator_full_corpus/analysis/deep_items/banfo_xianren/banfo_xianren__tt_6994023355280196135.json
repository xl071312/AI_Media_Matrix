  "modality": "COMPLETE_TEXT",
  "source_url": "https://www.toutiao.com/article/6994023355280196135/",
  "source_sha256": "4599148b4ff1cf97b04146edf84cd1a929c1dc752b4b9c047a9cae03c84d9bcb",
  "performance_tier": "HIGH",
  "spoken_marker_eligible": "N/A_TEXT",
  "analysis_status": "OK",
  "analyzer_version": "phase_c_v1",
  "sentence_count": 100,
  "sentences_index": [
    {
      "sentence_id": "s1",
      "char_len": 19,
      "snippet": "图片截取自: 全裸战神扒了酒店的大裤衩"
    },
    {
      "sentence_id": "s2",
      "char_len": 1,
      "snippet": "1"
    },
    {
      "sentence_id": "s3",
      "char_len": 28,
      "snippet": "昨天我在微博看到了一个极其魔幻的事情，是一个女孩的哭诉。"
    },
    {
      "sentence_id": "s4",
      "char_len": 35,
      "snippet": "前两天，全X酒店里，一赤身男子，凌晨三点闯进一女顾客房间，并且发酒疯。"
    },
    {
      "sentence_id": "s5",
      "char_len": 23,
      "snippet": "这个操作把我看麻了，怎么这年头当变态都要卷了。"
    },
    {
      "sentence_id": "s6",
      "char_len": 46,
      "snippet": "而且是什么支撑着他，在50分钟内，找遍三层楼所有房间，面对着一扇扇无法推开的门，仍不起厌倦？"
    },
    {
      "sentence_id": "s7",
      "char_len": 13,
      "snippet": "总不会是，他爱的是锁孔吧？"
    },
    {
      "sentence_id": "s8",
      "char_len": 21,
      "snippet": "糟糕，就连签这个行业，也要有竞争对手了吗。"
    },
    {
      "sentence_id": "s9",
      "char_len": 8,
      "snippet": "太卷了，太卷了。"
    },
    {
      "sentence_id": "s10",
      "char_len": 19,
      "snippet": "图片截取自: 全裸战神扒了酒店的大裤衩"
    },
    {
      "sentence_id": "s11",
      "char_len": 25,
      "snippet": "言归正传，8月5号，全季酒店官方微博发了致歉声明："
    },
    {
      "sentence_id": "s12",
      "char_len": 19,
      "snippet": "图片截取自: 全裸战神扒了酒店的大裤衩"
    },
    {
      "sentence_id": "s13",
      "char_len": 33,
      "snippet": "酒店的态度确实是不错的，毕竟从利益的角度，他们也没道理纵容这事儿。"
    },
    {
      "sentence_id": "s14",
      "char_len": 44,
      "snippet": "但问题是，大家也不是第一天开酒店了，类似的问题出现肯定也不是一次两次了，之前，干嘛去了。"
    },
    {
      "sentence_id": "s15",
      "char_len": 53,
      "snippet": "考虑到酒店确实架不住别的顾客临时自由发挥，这次事件最大的问题也不是有人突然发酒疯，因为顾客干嘛谁也不知道。"
    },
    {
      "sentence_id": "s16",
      "char_len": 48,
      "snippet": "最大的问题是，发微博的人，不是他今晚第一个闹的，之前他已经发过酒疯，对于这个信息，酒店是已知的。"
    },
    {
      "sentence_id": "s17",
      "char_len": 13,
      "snippet": "那么这个事件，就有意思了。"
    },
    {
      "sentence_id": "s18",
      "char_len": 19,
      "snippet": "图片截取自: 全裸战神扒了酒店的大裤衩"
    },
    {
      "sentence_id": "s19",
      "char_len": 37,
      "snippet": "这里教大家读一下这个道歉声明，那上面强调的“整改措施”，这四个字的含义是："
    },
    {
      "sentence_id": "s20",
      "char_len": 22,
      "snippet": "我们之前不是这样的，所以我们打算调整成如此。"
    },
    {
      "sentence_id": "s21",
      "char_len": 14,
      "snippet": "原本的机制，就是的确有问题。"
    },
    {
      "sentence_id": "s22",
      "char_len": 45,
      "snippet": "比如之前的保安可能有上岗培训，但培训效果确实不咋地，是否需要保安们通过培训和考试也是未知。"
    },
    {
      "sentence_id": "s23",
      "char_len": 47,
      "snippet": "比如我们酒店楼道有监控不假，监控一直开着也是事实，但是我们绝对不保证有人时刻监察这个监控画面。"
    },
    {
      "sentence_id": "s24",
      "char_len": 22,
      "snippet": "哦，你问我，那加装监控还费电开着是干什么的？"
    },
    {
      "sentence_id": "s25",
      "char_len": 44,
      "snippet": "肯定不是监视消费者的处境状况啊，主要为了在酒店发生事故时，能及时把视频当证据提交给警方。"
    },
    {
      "sentence_id": "s26",
      "char_len": 44,
      "snippet": "这个证据可以及早证明， 一切意外事件都发生于客人之间，跟我们酒店的主观意识没有任何关联。"
    },
    {
      "sentence_id": "s27",
      "char_len": 10,
      "snippet": "无妄之灾，别牵连我。"
    },
    {
      "sentence_id": "s28",
      "char_len": 11,
      "snippet": "说白了就是，自保用的。"
    },
    {
      "sentence_id": "s29",
      "char_len": 19,
      "snippet": "图片截取自: 全裸战神扒了酒店的大裤衩"
    },
    {
      "sentence_id": "s30",
      "char_len": 42,
      "snippet": "酒店的逻辑没啥不能理解的，自保很合理，我在银行上过班，银行的监控其实也是用于自保的。"
    },
    {
      "sentence_id": "s31",
      "char_len": 16,
      "snippet": "想明白这些，我开始思考一个问题："
    },
    {
      "sentence_id": "s32",
      "char_len": 17,
      "snippet": "消费者入住酒店，酒店应该管什么事？"
    },
    {
      "sentence_id": "s33",
      "char_len": 77,
      "snippet": "这个问题我以前从没想过，毕竟我钱给到你酒店了，你酒店的配置里也是有安保力量和监控设施的，总不能到最后，我出价钱睡你，你连我最基本的人身安全，都不能保证吧？"
    },
    {
      "sentence_id": "s34",
      "char_len": 94,
      "snippet": "但是从酒店的角度，我又架不住用户互动对吧，而且最近流调的结果一出，大家都发现原来正常的生活下，无数看似正常的人竟然如此热衷于和不该互动的人亲密互动，大家相互连接"
    },
    {
      "sentence_id": "s35",
      "char_len": 19,
      "snippet": "图片截取自: 全裸战神扒了酒店的大裤衩"
    },
    {
      "sentence_id": "s36",
      "char_len": 18,
      "snippet": "既然从业务层面拦不住，那法律层面呢？"
    },
    {
      "sentence_id": "s37",
      "char_len": 54,
      "snippet": "我专门问了一个律师朋友，得到了一个很无力的信息：我国现行法律，并没有明确严格规定酒店应该履行的安全保障义务。"
    },
    {
      "sentence_id": "s38",
      "char_len": 14,
      "snippet": "好嘛，那就是业务设计问题了。"
    },
    {
      "sentence_id": "s39",
      "char_len": 14,
      "snippet": "那这里就是简单的成本问题了。"
    },
    {
      "sentence_id": "s40",
      "char_len": 23,
      "snippet": "成本对应收入，住贵一点的酒店的人，图的是什么？"
    },
    {
      "sentence_id": "s41",
      "char_len": 34,
      "snippet": "硬件上当然期望好一点，还有就是期望软件上能做的更好，例如服务和安全。"
    },
    {
      "sentence_id": "s42",
      "char_len": 24,
      "snippet": "安全保障确实酒店做不到百分百，毕竟这不是派出所。"
    },
    {
      "sentence_id": "s43",
      "char_len": 52,
      "snippet": "但拿着加特林的猛男你拦不住，也没义务帮我挡子弹，可一个油腻赤膊的裸体变态，总应该你在处理能力范围内了吧？"
    },
    {
      "sentence_id": "s44",
      "char_len": 37,
      "snippet": "况且这货都已经遭到过一次投诉了，你们还给人送回房间过一次了，这个不应该吧。"
    },
    {
      "sentence_id": "s45",
      "char_len": 8,
      "snippet": "这属于印度行为。"
    },
    {
      "sentence_id": "s46",
      "char_len": 19,
      "snippet": "图片截取自: 全裸战神扒了酒店的大裤衩"
    },
    {
      "sentence_id": "s47",
      "char_len": 20,
      "snippet": "继续往下思考，出现了一个值得深思的问题："
    },
    {
      "sentence_id": "s48",
      "char_len": 37,
      "snippet": "当一个客人，存在威胁到其他客人的潜在可能时，酒店为什么不直接采取强硬措施？"
    },
    {
      "sentence_id": "s49",
      "char_len": 13,
      "snippet": "比如派个保安负责重点跟守？"
    },
    {
      "sentence_id": "s50",
      "char_len": 22,
      "snippet": "肯定是要付出代价，代价钱，以及钱以外的其他。"
    },
    {
      "sentence_id": "s51",
      "char_len": 10,
      "snippet": "这其实是一道数学题。"
    },
    {
      "sentence_id": "s52",
      "char_len": 87,
      "snippet": "从酒店的角度，没有动力去付出大量成本来防范，因为这个可能，只是一个潜在的可能 ，倘若直接采取强硬措施，抛开保安要不要有加班费的成本支出不谈，带来的结果几乎必然是"
    },
    {
      "sentence_id": "s53",
      "char_len": 26,
      "snippet": "往小了说损失一个客源，往大了说平台上的记录不好处理。"
    },
    {
      "sentence_id": "s54",
      "char_len": 43,
      "snippet": "可只要不参与此事，哪怕潜在的可能变成现实，在酒店的眼里，矛盾的双方，也没有自己的身影。"
    },
    {
      "sentence_id": "s55",
      "char_len": 35,
      "snippet": "你们尽管自由演变尽管闹，情况若不妙，大事有警察，小事，有果盘和免房费。"
    },
    {
      "sentence_id": "s56",
      "char_len": 34,
      "snippet": "至于舆论上的隐患，其实吧，酒店总部，和门店管理者，利益未必是一致的。"
    },
    {
      "sentence_id": "s57",
      "char_len": 15,
      "snippet": "门店管理者是宁肯把事情闹大的。"
    },
    {
      "sentence_id": "s58",
      "char_len": 40,
      "snippet": "因为他严格按照自己酒店的规则来，事情闹大，那就是总部公关以及相关风险管理的事情。"
    },
    {
      "sentence_id": "s59",
      "char_len": 12,
      "snippet": "最后是总部承认规则缺失。"
    },
    {
      "sentence_id": "s60",
      "char_len": 28,
      "snippet": "如果他没有按照规则来，做出了其他操作，那么责任就是他的。"
    },
    {
      "sentence_id": "s61",
      "char_len": 13,
      "snippet": "自保，是一种打工人的智慧。"
    },
    {
      "sentence_id": "s62",
      "char_len": 19,
      "snippet": "图片截取自: 全裸战神扒了酒店的大裤衩"
    },
    {
      "sentence_id": "s63",
      "char_len": 20,
      "snippet": "这个事情里，果盘的存在，实在是太魔幻了。"
    },
    {
      "sentence_id": "s64",
      "char_len": 19,
      "snippet": "图片截取自: 全裸战神扒了酒店的大裤衩"
    },
    {
      "sentence_id": "s65",
      "char_len": 24,
      "snippet": "好像宇宙中的一切问题，都可以用一个果盘的来解决。"
    },
    {
      "sentence_id": "s66",
      "char_len": 28,
      "snippet": "我记得以前大家都是讲烧烤的，现在已经消费降级成这样了么。"
    },
    {
      "sentence_id": "s67",
      "char_len": 45,
      "snippet": "我又想了一下，酒店其实对于此类误入事件，应该是有成熟方案的，送果盘，就是方案的核心竞争力。"
    },
    {
      "sentence_id": "s68",
      "char_len": 33,
      "snippet": "这个方案就好像是在帮你庆祝认识一个陌生人那种感觉，吃个果盘开心下。"
    },
    {
      "sentence_id": "s69",
      "char_len": 22,
      "snippet": "住店的又不是牛老师，谁会对全裸猛男感兴趣呢。"
    },
    {
      "sentence_id": "s70",
      "char_len": 23,
      "snippet": "而且谁知道他是不是还穿着拖鞋，是不是真的全裸。"
    },
    {
      "sentence_id": "s71",
      "char_len": 19,
      "snippet": "图片截取自: 全裸战神扒了酒店的大裤衩"
    },
    {
      "sentence_id": "s72",
      "char_len": 17,
      "snippet": "全裸战神这事，还有很多迷幻的地方。"
    },
    {
      "sentence_id": "s73",
      "char_len": 40,
      "snippet": "战神的妻子和女顾客交流时表示，战神本人在里面很害怕……所以希望女顾客能原谅对方。"
    },
    {
      "sentence_id": "s74",
      "char_len": 36,
      "snippet": "这话说的，我扇了你一个嘴巴子，我自己的手也很疼，所以你体谅下我好不好啊？"
    },
    {
      "sentence_id": "s75",
      "char_len": 46,
      "snippet": "全裸战神自己喝多了，喝醉酒做出啥事儿可能都未必是主观意愿，但既然造成了问题，那就得承担后果。"
    },
    {
      "sentence_id": "s76",
      "char_len": 30,
      "snippet": "况且，裸体战神已经出来2天了，7月31日执行，行政拘留5日。"
    },
    {
      "sentence_id": "s77",
      "char_len": 19,
      "snippet": "图片截取自: 全裸战神扒了酒店的大裤衩"
    },
    {
      "sentence_id": "s78",
      "char_len": 13,
      "snippet": "全裸战神的问题，只是个案。"
    },
    {
      "sentence_id": "s79",
      "char_len": 23,
      "snippet": "真正的问题，是酒店行业为了控制成本的避重就轻。"
    },
    {
      "sentence_id": "s80",
      "char_len": 19,
      "snippet": "开店要赚钱的，这个可以理解，没有问题。"
    },
    {
      "sentence_id": "s81",
      "char_len": 23,
      "snippet": "但缩水，可以缩硬件，不可以缩【安全】这个软件。"
    },
    {
      "sentence_id": "s82",
      "char_len": 25,
      "snippet": "但魔幻的是，硬件看得到，所以反而大家为了竞争不缩。"
    },
    {
      "sentence_id": "s83",
      "char_len": 27,
      "snippet": "软件不好直接评价，那就大缩特缩，反正出了大问题有警察。"
    },
    {
      "sentence_id": "s84",
      "char_len": 13,
      "snippet": "出了小问题有果盘儿和道歉。"
    },
    {
      "sentence_id": "s85",
      "char_len": 9,
      "snippet": "果盘真是YYDS。"
    },
    {
      "sentence_id": "s86",
      "char_len": 19,
      "snippet": "图片截取自: 全裸战神扒了酒店的大裤衩"
    },
    {
      "sentence_id": "s87",
      "char_len": 28,
      "snippet": "归根结底，敢对自己如此低标准松要求的背景，还是代价太低。"
    },
    {
      "sentence_id": "s88",
      "char_len": 22,
      "snippet": "指望商家讲道德那是不可能的，要讲规则和代价。"
    },
    {
      "sentence_id": "s89",
      "char_len": 25,
      "snippet": "或者说 代价能否承受，才是商家判断问题的永恒规则。"
    },
    {
      "sentence_id": "s90",
      "char_len": 27,
      "snippet": "当不做一件好事对自己看起来没什么影响时，那就代表能做。"
    },
    {
      "sentence_id": "s91",
      "char_len": 31,
      "snippet": "纵使事发，也关系不到他，这是酒店以前倾向于削减安保成本的动机。"
    },
    {
      "sentence_id": "s92",
      "char_len": 31,
      "snippet": "如今事发，舆论关系到了他，这是酒店如今在道歉里表示整改的原因。"
    },
    {
      "sentence_id": "s93",
      "char_len": 26,
      "snippet": "没有舆论，这些整改根本就不可能出现，毕竟法律没规定。"
    },
    {
      "sentence_id": "s94",
      "char_len": 45,
      "snippet": "所以从这个角度看，道歉再诚恳，也并不能解决问题，甚至于酒店一声令下，保安和前台工作量加大。"
    },
    {
      "sentence_id": "s95",
      "char_len": 13,
      "snippet": "指望他们加人那是不可能的。"
    },
    {
      "sentence_id": "s96",
      "char_len": 14,
      "snippet": "真正诚恳的道歉，应该是金钱。"
    },
    {
      "sentence_id": "s97",
      "char_len": 12,
      "snippet": "嘘寒问暖，不如一笔巨款。"
    },
    {
      "sentence_id": "s98",
      "char_len": 21,
      "snippet": "不管是被有关部门罚，还是赔给顾客，都可以。"
    },
    {
      "sentence_id": "s99",
      "char_len": 10,
      "snippet": "没有代价，都是空话。"
    },
    {
      "sentence_id": "s100",
      "char_len": 19,
      "snippet": "图片截取自: 全裸战神扒了酒店的大裤衩"
    }
  ],
