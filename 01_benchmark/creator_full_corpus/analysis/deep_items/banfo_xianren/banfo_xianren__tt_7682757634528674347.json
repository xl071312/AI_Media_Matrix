  "source_sha256": "e31802ae39e3ddfe6aaa7425b56038e34159eefb9191081c684e15ed1114957a",
  "performance_tier": "MEDIAN",
  "spoken_marker_eligible": "N/A_TEXT",
  "analysis_status": "OK",
  "analyzer_version": "phase_c_v1",
  "sentence_count": 120,
  "sentences_index": [
    {
      "sentence_id": "s1",
      "char_len": 1,
      "snippet": "1"
    },
    {
      "sentence_id": "s2",
      "char_len": 49,
      "snippet": "10年前，你去问一个日本宅宅，雷电是什么颜色的，对方大概率会回答是皮卡丘的金色或"
    },
    {
      "sentence_id": "s3",
      "char_len": 30,
      "snippet": "而在现在你去问同样的问题，对方或许会告诉你是雷电将军的紫色。"
    },
    {
      "sentence_id": "s4",
      "char_len": 24,
      "snippet": "10年前你问神梦一刀是谁，对面会告诉你是橘右京。"
    },
    {
      "sentence_id": "s5",
      "char_len": 26,
      "snippet": "而现在去问同样的问题，对方或许也会告诉你是雷电将军。"
    },
    {
      "sentence_id": "s6",
      "char_len": 9,
      "snippet": "这就是原神的威力。"
    },
    {
      "sentence_id": "s7",
      "char_len": 70,
      "snippet": "六年过去，经历了骂战，骂战，骂战，很大的骂战以及更大的骂战大家已经吵不动了之后，"
    },
    {
      "sentence_id": "s8",
      "char_len": 30,
      "snippet": "什么叫流行文化的一部分，就是你或许没有体验过，但你多少知道。"
    },
    {
      "sentence_id": "s9",
      "char_len": 18,
      "snippet": "就像有的人从不摸篮球，但会知道乔丹。"
    },
    {
      "sentence_id": "s10",
      "char_len": 23,
      "snippet": "有的人一年看不了一本书，但余华表情包玩得飞起。"
    },
    {
      "sentence_id": "s11",
      "char_len": 26,
      "snippet": "不管你喜不喜欢《原神》，都必须承认《原神》的影响力。"
    },
    {
      "sentence_id": "s12",
      "char_len": 46,
      "snippet": "CM（Comic Market）上，原神是少有的能和大量日本本土IP打的有来有回"
    },
    {
      "sentence_id": "s13",
      "char_len": 23,
      "snippet": "世界各地的漫展上都能看到原神coser的身影。"
    },
    {
      "sentence_id": "s14",
      "char_len": 25,
      "snippet": "Coldplay的新歌MV里也会有原神cos出镜。"
    },
    {
      "sentence_id": "s15",
      "char_len": 22,
      "snippet": "管子上原神相关的视频总播放量达到480亿次。"
    },
    {
      "sentence_id": "s16",
      "char_len": 22,
      "snippet": "短视频平台上原神话题的播放量更是超过两千亿。"
    },
    {
      "sentence_id": "s17",
      "char_len": 39,
      "snippet": "连日本的游戏设计系老师，都在哀叹新来的学生只知道《原神》不愿意玩别的主机游戏。"
    },
    {
      "sentence_id": "s18",
      "char_len": 39,
      "snippet": "现在的《原神》早已不止是一款游戏，而是一个符号，一个IP，一个时代的文化现象。"
    },
    {
      "sentence_id": "s19",
      "char_len": 56,
      "snippet": "在这个资本做梦都想要搞出几个大IP结果越搞越搞笑，越搞越抽象的时候，原神是个值得"
    },
    {
      "sentence_id": "s20",
      "char_len": 48,
      "snippet": "因为这可能是我们能观察到的，距离我们最近的国际级IP，且从诞生到席卷世界的全过程"
    },
    {
      "sentence_id": "s21",
      "char_len": 76,
      "snippet": "注意，这里说的不是自娱自乐单方面宣布的那种自嗨IP，是那种真正打入国际市场，让老"
    },
    {
      "sentence_id": "s22",
      "char_len": 25,
      "snippet": "它从无到有被创造的过程可以算是半本IP构建教科书。"
    },
    {
      "sentence_id": "s23",
      "char_len": 1,
      "snippet": "2"
    },
    {
      "sentence_id": "s24",
      "char_len": 8,
      "snippet": "那，什么是IP。"
    },
    {
      "sentence_id": "s25",
      "char_len": 28,
      "snippet": "IP本质上，是一种精神类的，具有极强传播性的信号发生器。"
    },
    {
      "sentence_id": "s26",
      "char_len": 29,
      "snippet": "就是不管你是谁，当你知道这个IP的时候，你都会被硬控一下。"
    },
    {
      "sentence_id": "s27",
      "char_len": 17,
      "snippet": "这一种限定范围但不限定传播的模因。"
    },
    {
      "sentence_id": "s28",
      "char_len": 39,
      "snippet": "1976年，理查德·道金斯试图写一本分析基因演化规律的书，写着写着他突然发现："
    },
    {
      "sentence_id": "s29",
      "char_len": 2,
      "snippet": "哎？"
    },
    {
      "sentence_id": "s30",
      "char_len": 34,
      "snippet": "这套靠自我复制、不断变异去适应环境的东西，好像不止在生物学上说得通。"
    },
    {
      "sentence_id": "s31",
      "char_len": 19,
      "snippet": "人类文化的发展好像也是在不断复制变异。"
    },
    {
      "sentence_id": "s32",
      "char_len": 25,
      "snippet": "于是他在《自私的基因》这本书的末尾提出了一个理论："
    },
    {
      "sentence_id": "s33",
      "char_len": 15,
      "snippet": "文化也拥有一种基本因子：模因。"
    },
    {
      "sentence_id": "s34",
      "char_len": 42,
      "snippet": "一句口号，一个动作，一段洗脑歌，一个表情包，只要能快速复制、变异并传播，就算是模"
    },
    {
      "sentence_id": "s35",
      "char_len": 28,
      "snippet": "他会找一切奇怪的机会钻进你的脑子里，成为你常识的一部分。"
    },
    {
      "sentence_id": "s36",
      "char_len": 38,
      "snippet": "就好像一旦你被科普了吃席的规矩，把鱼端上桌的时候就会忍不住看一眼鱼头的朝向。"
    },
    {
      "sentence_id": "s37",
      "char_len": 34,
      "snippet": "一旦知道了某些特别的英语单词，就再没办法不带情绪的唱阳光彩虹小白马。"
    },
    {
      "sentence_id": "s38",
      "char_len": 50,
      "snippet": "那时候的道金斯认为，就像有些勇士能抵挡基因对高油高糖的渴望一样，总有一些聪明人能"
    },
    {
      "sentence_id": "s39",
      "char_len": 35,
      "snippet": "他太天真了，人类根本就不想抵抗模因，就连抵抗模因本身，都成了一种模因。"
    },
    {
      "sentence_id": "s40",
      "char_len": 48,
      "snippet": "我随便说几个，内啥太美，恭喜谁可以称帝了，我要验牌，给谁端一杯卡布奇诺，我从未见"
    },
    {
      "sentence_id": "s41",
      "char_len": 21,
      "snippet": "你看，我甚至没说全，你已经知道这是什么了。"
    },
    {
      "sentence_id": "s42",
      "char_len": 26,
      "snippet": "笑完还想扎自己的耳朵，但不行，因为龙可是帝王之征啊。"
    },
    {
      "sentence_id": "s43",
      "char_len": 3,
      "snippet": "抵抗？"
    },
    {
      "sentence_id": "s44",
      "char_len": 11,
      "snippet": "人类为什么要抵抗模因？"
    },
    {
      "sentence_id": "s45",
      "char_len": 46,
      "snippet": "人类只恨自己没有创造出新的模因，天天在网上冲浪遇到天赋型选手拼尽全力无法战胜的感"
    },
    {
      "sentence_id": "s46",
      "char_len": 27,
      "snippet": "就好像人类把可可西里的高傲狼王变成了眼神清澈的汉堡王。"
    },
    {
      "sentence_id": "s47",
      "char_len": 17,
      "snippet": "我们也会把野生模因培育成家养模因。"
    },
    {
      "sentence_id": "s48",
      "char_len": 15,
      "snippet": "这些被培育好的模因，就是IP。"
    },
    {
      "sentence_id": "s49",
      "char_len": 38,
      "snippet": "自然生成的模因三天爆发，三周火遍全网，三个月销声匿迹，三年后考古都考不出来。"
    },
    {
      "sentence_id": "s50",
      "char_len": 47,
      "snippet": "而只要用版权清理掉那些破坏性的二创，用翻拍主动操纵模因的曝光节奏，用设定本限制模"
    },
    {
      "sentence_id": "s152",
      "char_len": 23,
      "snippet": "最后就会带来很多本土玩家自发创造的高传播符号。"
    },
    {
      "sentence_id": "s153",
      "char_len": 35,
      "snippet": "按照商业的角度，完成凝聚一个高传播模因这一步就已经可以算是一个IP了。"
    },
    {
      "sentence_id": "s154",
      "char_len": 20,
      "snippet": "接下来你就可以拿他去出周边满世界赚钱了。"
    },
    {
      "sentence_id": "s155",
      "char_len": 27,
      "snippet": "可能两三年就会把IP价值抽干，但确确实实有价值可抽了。"
    },
    {
      "sentence_id": "s156",
      "char_len": 1,
      "snippet": "5"
    },
    {
      "sentence_id": "s157",
      "char_len": 20,
      "snippet": "但想真正建立一个IP，还需要关键的一步："
    },
    {
      "sentence_id": "s158",
      "char_len": 11,
      "snippet": "反过来，释放这个符号。"
    },
    {
      "sentence_id": "s159",
      "char_len": 20,
      "snippet": "讲白了，IP是符号，是一段被浓缩的记忆。"
    },
    {
      "sentence_id": "s160",
      "char_len": 29,
      "snippet": "你需要让用户的记忆被反复触发，在这个符号上关联上更多记忆。"
    },
    {
      "sentence_id": "s161",
      "char_len": 20,
      "snippet": "一开始迪士尼的角色只是一些普通动画角色。"
    },
    {
      "sentence_id": "s162",
      "char_len": 34,
      "snippet": "但你去过一次迪士尼，以后你看到这些角色就会想起陪你一起去迪士尼的人。"
    },
    {
      "sentence_id": "s163",
      "char_len": 55,
      "snippet": "主题乐园、联动、多媒介衍生、特殊的节日，这些操作可以让符号反复出现在用户面前，把"
    },
    {
      "sentence_id": "s164",
      "char_len": 45,
      "snippet": "可能你本来什么都不知道，只是想去吃个肯德基，但一进去发现店里挤爆了，还满地都是温"
    },
    {
      "sentence_id": "s165",
      "char_len": 52,
      "snippet": "这时候你的记忆里就会留下原神和肯德基联动的新记忆，记得这帮家伙不知羞耻的大喊“异"
    },
    {
      "sentence_id": "s166",
      "char_len": 24,
      "snippet": "做各种二创、改编、衍生，都是重复塑造记忆的过程。"
    },
    {
      "sentence_id": "s167",
      "char_len": 13,
      "snippet": "大部分IP都卡在这一步上。"
    },
    {
      "sentence_id": "s168",
      "char_len": 40,
      "snippet": "高传播力的模因早就已经浓缩好了，全世界都在等着这个模因被释放出来做出一些新内容。"
    },
    {
      "sentence_id": "s169",
      "char_len": 13,
      "snippet": "但IP的拥有者他们说：哎！"
    },
    {
      "sentence_id": "s170",
      "char_len": 33,
      "snippet": "我有一个新点子，我要做一个和大家心里那个符号没有一毛钱关系的东西。"
    },
    {
      "sentence_id": "s171",
      "char_len": 23,
      "snippet": "结果就是把大家对那个符号美好的记忆都给弄烂了。"
    },
    {
      "sentence_id": "s172",
      "char_len": 35,
      "snippet": "这种事儿太多了，各种续作毁IP，点谁的名都不好，大家就自行对号入座吧。"
    },
    {
      "sentence_id": "s173",
      "char_len": 39,
      "snippet": "反过来说，一旦你能成功在这个符号上挂上更多记忆，那你的IP生命力就会成倍提升。"
    },
    {
      "sentence_id": "s174",
      "char_len": 30,
      "snippet": "当堆积的美好记忆够多的时候，偶尔翻几次车也不会影响IP价值。"
    },
    {
      "sentence_id": "s175",
      "char_len": 35,
      "snippet": "就好像漫威，历史上好几次整活差点把自己整没了，但抓住机会说翻身就翻身。"
    },
    {
      "sentence_id": "s176",
      "char_len": 41,
      "snippet": "因为在漫威最惨的时候，还有很多人记得他们的角色，记得蜘蛛侠，记得绿巨人，记得雷神"
    },
    {
      "sentence_id": "s177",
      "char_len": 18,
      "snippet": "这些记忆支持他们憋出了漫威电影宇宙。"
    },
    {
      "sentence_id": "s178",
      "char_len": 33,
      "snippet": "而漫威电影又反过来，让路人记住了钢铁侠、美国队长、奇异博士，灭霸。"
    },
    {
      "sentence_id": "s179",
      "char_len": 32,
      "snippet": "这种IP就和基因一样，潜伏在你记忆深处，只需要一阵风就又被唤醒。"
    },
    {
      "sentence_id": "s180",
      "char_len": 43,
      "snippet": "即使这几年漫威做得好事儿并不多，但还有很多人因为对复联的美好记忆而被一次次骗进电"
    },
    {
      "sentence_id": "s181",
      "char_len": 42,
      "snippet": "现在我还经常刷到有人在做复联4首映时影院里的录音对轴，回顾那时影院里欢呼尖叫的场"
    },
    {
      "sentence_id": "s182",
      "char_len": 41,
      "snippet": "看这种视频的人看的早就不是电影了，是在回忆年轻的自己坐在电影院里看首映的那个晚上"
    },
    {
      "sentence_id": "s183",
      "char_len": 17,
      "snippet": "原神现在走的就是和漫威差不多的路。"
    },
    {
      "sentence_id": "s184",
      "char_len": 58,
      "snippet": "旧的高人气角色作为锚点，先固定住一部分玩家的记忆，然后去不断开拓新的高人气角色，"
    },
    {
      "sentence_id": "s185",
      "char_len": 24,
      "snippet": "这些符号不断出现，会一次次强化大众对IP的印象。"
    },
    {
      "sentence_id": "s186",
      "char_len": 49,
      "snippet": "在生活里看到cos，看到手办，看到立牌，你不知道任何原神相关的内容，但知道这角色"
    },
    {
      "sentence_id": "s187",
      "char_len": 50,
      "snippet": "你记住了那个会飞的白毛小东西，记住了那个胸口拔刀的紫头发的女人，记住了那个总是不"
    },
    {
      "sentence_id": "s188",
      "char_len": 23,
      "snippet": "你觉得自己毫无变化，但你已经被这份模因所影响。"
    },
    {
      "sentence_id": "s189",
      "char_len": 29,
      "snippet": "等哪天动画出了，电影出了，你心里那根弦就会被拨一下，会想："
    },
    {
      "sentence_id": "s190",
      "char_len": 32,
      "snippet": "“哦，这个啊，我知道，以前没碰游戏，现在看看到底是怎么回事儿吧。"
    },
    {
      "sentence_id": "s191",
      "char_len": 1,
      "snippet": "”"
    },
    {
      "sentence_id": "s314",
      "char_len": 15,
      "snippet": "那一定会是一个非常有趣的场景。"
    },
    {
      "sentence_id": "s315",
      "char_len": 1,
      "snippet": "8"
    },
    {
      "sentence_id": "s316",
      "char_len": 21,
      "snippet": "但，从IP运营的角度来说，窗口期是有限的。"
    },
    {
      "sentence_id": "s317",
      "char_len": 38,
      "snippet": "现在全世界还有大量的人记得原神，认识原神角色，对原神抱有好感但没有深入了解。"
    },
    {
      "sentence_id": "s318",
      "char_len": 26,
      "snippet": "这些人就是潜在的IP受众，他们在等一个低门槛的入口。"
    },
    {
      "sentence_id": "s319",
      "char_len": 54,
      "snippet": "如果动画能在这个窗口期内推出，这些人就会被转化为IP的深度用户，原神的传播范围就"
    },
    {
      "sentence_id": "s320",
      "char_len": 47,
      "snippet": "但如果窗口期过了，这些人的注意力被别的东西吸走了，再想把他们拉回来，就不是成本翻"
    },
    {
      "sentence_id": "s321",
      "char_len": 17,
      "snippet": "原神现在站在一个非常特殊的位置上。"
    },
    {
      "sentence_id": "s322",
      "char_len": 28,
      "snippet": "往前看，它已经完成了绝大多数IP一辈子都完成不了的事情："
    },
    {
      "sentence_id": "s323",
      "char_len": 43,
      "snippet": "在全球范围内建立了认知度，凝聚了一批高粘性的核心用户，创造了一系列高传播力的文化"
    },
    {
      "sentence_id": "s324",
      "char_len": 16,
      "snippet": "往后看，它面前还有一条很长的路："
    },
    {
      "sentence_id": "s325",
      "char_len": 26,
      "snippet": "动画化，电影化，宇宙化，跨代际传承，每一步都是硬仗。"
    },
    {
      "sentence_id": "s326",
      "char_len": 53,
      "snippet": "我当然希望他能继续走下去，走到更高更大的舞台上，不只是成为现在的世界流行文化，而"
    },
    {
      "sentence_id": "s327",
      "char_len": 36,
      "snippet": "但不管最终走到哪一步，原神都已经证明了，中国有能力制造世界级的文化产品。"
    },
    {
      "sentence_id": "s328",
      "char_len": 81,
      "snippet": "你放在十年前，告诉我，一个中国团队，可以从零开始，构建出一个被全球年轻人接受的虚"
    },
    {
      "sentence_id": "s329",
      "char_len": 40,
      "snippet": "我们早就习惯了自成一体，远远的看着国外大IP的背影，幻想我们到底要追几个二十年。"
    },
    {
      "sentence_id": "s330",
      "char_len": 45,
      "snippet": "而原神做到了，并且做得太好了，一起手就做到了国际水平，只用了6年，这是做梦都梦不"
    },
    {
      "sentence_id": "s331",
      "char_len": 29,
      "snippet": "这件事本身的意义，可能比原神这个IP最终能走多远更加重要。"
    },
    {
      "sentence_id": "s332",
      "char_len": 17,
      "snippet": "原神走过的路，会变成后来者的路标。"
    },
    {
      "sentence_id": "s333",
      "char_len": 15,
      "snippet": "它踩过的坑，后来者可以绕过去。"
    },
    {
      "sentence_id": "s334",
      "char_len": 19,
      "snippet": "它验证过的方法，后来者可以直接拿来用。"
    },
    {
      "sentence_id": "s335",
      "char_len": 24,
      "snippet": "已经有很多人跟着原神的脚步，走出国门，走向国际。"
    },
    {
      "sentence_id": "s336",
      "char_len": 28,
      "snippet": "现在那张“赚钱IP排行榜”上，大部分IP都是英语和日语。"
    },
    {
      "sentence_id": "s337",
      "char_len": 35,
      "snippet": "但未来，这个崛起中的中国，到底会在那张榜单上，添上几个来自中国的IP？"
    },
    {
      "sentence_id": "s338",
      "char_len": 20,
      "snippet": "原神锁定了一个席位，但一定不是最后一个。"
    },
    {
      "sentence_id": "s339",
      "char_len": 16,
      "snippet": "未来那张榜单上会有很多中国名字。"
    },
    {
      "sentence_id": "s340",
      "char_len": 39,
      "snippet": "也许是豪门的孤注一掷，也许是一个充满野心的小团队，也许是一个还在上学的年轻人。"
    },
    {
      "sentence_id": "s341",
      "char_len": 27,
      "snippet": "他们因为原神而第一次产生了“我也可以征服世界”的念头。"
    },
    {
      "sentence_id": "s342",
      "char_len": 14,
      "snippet": "这个念头本身，就是一颗模因。"
    },
    {
      "sentence_id": "s343",
      "char_len": 21,
      "snippet": "而模因这东西，一旦开始传播，就停不下来了。"
    }
  ],
