  "sentence_count": 70,
  "sentences_index": [
    {
      "sentence_id": "s1",
      "char_len": 1,
      "snippet": "1"
    },
    {
      "sentence_id": "s2",
      "char_len": 20,
      "snippet": "就我都不明白罗技这么大一家做硬件的公司。"
    },
    {
      "sentence_id": "s3",
      "char_len": 13,
      "snippet": "干嘛天天要在自媒体上整活？"
    },
    {
      "sentence_id": "s4",
      "char_len": 34,
      "snippet": "大家可以先看一下新闻，罗技第一时间道歉，可见他们也知道这个东西不行。"
    },
    {
      "sentence_id": "s5",
      "char_len": 25,
      "snippet": "图片截取自: 罗技别研究新媒体了，抓紧去研究黑丝吧"
    },
    {
      "sentence_id": "s6",
      "char_len": 12,
      "snippet": "（新闻截图来自极目新闻）"
    },
    {
      "sentence_id": "s7",
      "char_len": 16,
      "snippet": "这个新闻你是不是觉得已经看过了？"
    },
    {
      "sentence_id": "s8",
      "char_len": 21,
      "snippet": "别急，在上一次被收拾之后，还有全新的整活。"
    },
    {
      "sentence_id": "s9",
      "char_len": 25,
      "snippet": "图片截取自: 罗技别研究新媒体了，抓紧去研究黑丝吧"
    },
    {
      "sentence_id": "s10",
      "char_len": 19,
      "snippet": "（图片来自小红书账号罗技G官方旗舰店）"
    },
    {
      "sentence_id": "s11",
      "char_len": 20,
      "snippet": "就太厉害了，都不知道这里面是怎么思考的。"
    },
    {
      "sentence_id": "s12",
      "char_len": 21,
      "snippet": "只能说是反复证明了我在4年前就提出的观点。"
    },
    {
      "sentence_id": "s13",
      "char_len": 16,
      "snippet": "大厂压根就不该试图做新媒体内容。"
    },
    {
      "sentence_id": "s14",
      "char_len": 18,
      "snippet": "你没看错，不是怎么做，而是就不该做。"
    },
    {
      "sentence_id": "s15",
      "char_len": 25,
      "snippet": "图片截取自: 罗技别研究新媒体了，抓紧去研究黑丝吧"
    },
    {
      "sentence_id": "s16",
      "char_len": 23,
      "snippet": "甚至就俩星期前，我都重复说了大厂不要做内容了。"
    },
    {
      "sentence_id": "s17",
      "char_len": 28,
      "snippet": "当时还有很多人说我不懂，我都笑了，见过这么快的回旋镖吗？"
    },
    {
      "sentence_id": "s18",
      "char_len": 25,
      "snippet": "图片截取自: 罗技别研究新媒体了，抓紧去研究黑丝吧"
    },
    {
      "sentence_id": "s19",
      "char_len": 33,
      "snippet": "大厂新媒体账号的唯一出路，就是发券，打折，促销，说吉祥话以及捐钱。"
    },
    {
      "sentence_id": "s20",
      "char_len": 30,
      "snippet": "如果实在就想做内容，那就找好看的小哥哥小姐姐穿黑丝就可以了。"
    },
    {
      "sentence_id": "s21",
      "char_len": 88,
      "snippet": "当然，黑丝是一个指代，白丝肉丝紫丝都可以，猛男爆衣，赤膊跳舞，腹肌魅力，鸭鸭油腻"
    },
    {
      "sentence_id": "s22",
      "char_len": 25,
      "snippet": "图片截取自: 罗技别研究新媒体了，抓紧去研究黑丝吧"
    },
    {
      "sentence_id": "s23",
      "char_len": 16,
      "snippet": "为什么说大厂做新媒体必须这么做？"
    },
    {
      "sentence_id": "s24",
      "char_len": 20,
      "snippet": "因为大厂做新媒体这件事情本身，就很荒诞。"
    },
    {
      "sentence_id": "s25",
      "char_len": 10,
      "snippet": "没啥收益，全是风险。"
    },
    {
      "sentence_id": "s26",
      "char_len": 25,
      "snippet": "图片截取自: 罗技别研究新媒体了，抓紧去研究黑丝吧"
    },
    {
      "sentence_id": "s27",
      "char_len": 32,
      "snippet": "观众对于【个人形象】的账号和【公司形象】的账号，要求是不一样的。"
    },
    {
      "sentence_id": "s28",
      "char_len": 14,
      "snippet": "很多话，个人账号说了叫玩梗。"
    },
    {
      "sentence_id": "s29",
      "char_len": 11,
      "snippet": "公司账号说了叫找事儿。"
    },
    {
      "sentence_id": "s30",
      "char_len": 34,
      "snippet": "哪怕这个公司账号的发布者只是一个个人，但对外这就是代表公司对外发声。"
    },
    {
      "sentence_id": "s31",
      "char_len": 5,
      "snippet": "这怎么做？"
    },
    {
      "sentence_id": "s32",
      "char_len": 26,
      "snippet": "做好了没好处，说错一句话等于代表公司在公众场合乱来。"
    },
    {
      "sentence_id": "s33",
      "char_len": 28,
      "snippet": "哪怕只是编辑手一抖甚至忘了切号了，就要整个公司付出代价。"
    },
    {
      "sentence_id": "s34",
      "char_len": 25,
      "snippet": "图片截取自: 罗技别研究新媒体了，抓紧去研究黑丝吧"
    },
    {
      "sentence_id": "s35",
      "char_len": 13,
      "snippet": "发现这事儿荒诞处之处没有？"
    },
    {
      "sentence_id": "s36",
      "char_len": 41,
      "snippet": "大厂几亿几十个亿的商誉，就攥在月薪不高的小编手里，安全绳是完全不懂内容的中层老板"
    },
    {
      "sentence_id": "s37",
      "char_len": 12,
      "snippet": "哦不对，他们都看不懂梗。"
    },
    {
      "sentence_id": "s38",
      "char_len": 11,
      "snippet": "安全全看小编今天心情。"
    },
    {
      "sentence_id": "s39",
      "char_len": 25,
      "snippet": "图片截取自: 罗技别研究新媒体了，抓紧去研究黑丝吧"
    },
    {
      "sentence_id": "s40",
      "char_len": 44,
      "snippet": "甚至在探讨内容的时候，你都不知道这个小编被几个不懂内容的老板怎么折腾过，是不是一"
    },
    {
      "sentence_id": "s41",
      "char_len": 14,
      "snippet": "然后一想太委屈，突然的自我。"
    },
    {
      "sentence_id": "s42",
      "char_len": 39,
      "snippet": "半夜直接上号，发点不该发的东西解解压，点赞点不该点赞的东西，你大厂根本拦不住。"
    },
    {
      "sentence_id": "s43",
      "char_len": 35,
      "snippet": "而在市场眼中，这不是个人行为，这就是公司行为，谁让是你公司账号发的呢？"
    },
    {
      "sentence_id": "s44",
      "char_len": 19,
      "snippet": "第二天早上经理起床一看不好，要迟到了。"
    },
    {
      "sentence_id": "s45",
      "char_len": 25,
      "snippet": "又一看手机，放心了，不怕迟到了，因为工作已经没了。"
    },
    {
      "sentence_id": "s46",
      "char_len": 25,
      "snippet": "图片截取自: 罗技别研究新媒体了，抓紧去研究黑丝吧"
    },
    {
      "sentence_id": "s47",
      "char_len": 11,
      "snippet": "关键，这个东西咋风控？"
    },
    {
      "sentence_id": "s48",
      "char_len": 38,
      "snippet": "没法风控，甚至有时候你都找不到负责人，弄不好是AI直接爬取网络梗改改就发了。"
    },
    {
      "sentence_id": "s49",
      "char_len": 24,
      "snippet": "而很多梗，用户可以玩，作为品牌账号，碰都不该碰。"
    },
    {
      "sentence_id": "s50",
      "char_len": 10,
      "snippet": "但小编不会在乎这个。"
    },
    {
      "sentence_id": "s51",
      "char_len": 83,
      "snippet": "AI更不在乎，我是AI不服你弄我服务器啊略略略略略略略略略略略略略略略略略略略略"
    },
    {
      "sentence_id": "s52",
      "char_len": 25,
      "snippet": "图片截取自: 罗技别研究新媒体了，抓紧去研究黑丝吧"
    },
    {
      "sentence_id": "s53",
      "char_len": 54,
      "snippet": "再说一遍，这个账号是大厂的发声出口，直接代表了大厂的形象，说出来的话代表了大厂的"
    },
    {
      "sentence_id": "s54",
      "char_len": 26,
      "snippet": "这不是不爆雷的问题，是只要你做了，就怎么爆雷的问题。"
    },
    {
      "sentence_id": "s55",
      "char_len": 10,
      "snippet": "普通账号爆了就爆了。"
    },
    {
      "sentence_id": "s56",
      "char_len": 26,
      "snippet": "品牌的雷爆了，大家几个大促不买，闹不好要上征信报告。"
    },
    {
      "sentence_id": "s57",
      "char_len": 6,
      "snippet": "难，太难了。"
    },
    {
      "sentence_id": "s58",
      "char_len": 25,
      "snippet": "图片截取自: 罗技别研究新媒体了，抓紧去研究黑丝吧"
    },
    {
      "sentence_id": "s59",
      "char_len": 15,
      "snippet": "所以大厂宣发的思路应该是什么？"
    },
    {
      "sentence_id": "s60",
      "char_len": 37,
      "snippet": "要么发券，要么说吉利话，要么就别说话，找好看的小哥哥小姐姐展示好看就好了。"
    },
    {
      "sentence_id": "s61",
      "char_len": 54,
      "snippet": "实在闲着没事儿钱多的花不完，就给电视电台钱，给传统媒体钱，给自媒体钱，给代言人钱"
    },
    {
      "sentence_id": "s62",
      "char_len": 7,
      "snippet": "让他们去整活。"
    },
    {
      "sentence_id": "s63",
      "char_len": 46,
      "snippet": "花点，花点钱，人家真的是专业搞这个的，比大厂的不懂内容只知道折腾执行层员工的经理"
    },
    {
      "sentence_id": "s64",
      "char_len": 25,
      "snippet": "图片截取自: 罗技别研究新媒体了，抓紧去研究黑丝吧"
    },
    {
      "sentence_id": "s65",
      "char_len": 17,
      "snippet": "这不仅仅是需求交接，更是风险切割。"
    },
    {
      "sentence_id": "s66",
      "char_len": 46,
      "snippet": "你花钱做甲方，出了问题那甲方是受害者，就算翻了车，及时出来宣布终止合作，骂也骂不"
    },
    {
      "sentence_id": "s67",
      "char_len": 17,
      "snippet": "非得自己下场，出了问题就自己受着。"
    },
    {
      "sentence_id": "s68",
      "char_len": 9,
      "snippet": "这不是，找事儿么。"
    },
    {
      "sentence_id": "s69",
      "char_len": 12,
      "snippet": "而且还找了两回，太6了。"
    },
    {
      "sentence_id": "s70",
      "char_len": 25,
      "snippet": "图片截取自: 罗技别研究新媒体了，抓紧去研究黑丝吧"
    }
  ],
