  "sentences_index": [
    {
      "sentence_id": "s1",
      "char_len": 1,
      "snippet": "1"
    },
    {
      "sentence_id": "s2",
      "char_len": 27,
      "snippet": "本周最火的科技产品，是豆包AI手机助手+定制版的手机。"
    },
    {
      "sentence_id": "s3",
      "char_len": 16,
      "snippet": "这东西满足了很多人对AI的想象。"
    },
    {
      "sentence_id": "s4",
      "char_len": 27,
      "snippet": "图片截取自: 微信博弈豆包，人类准备好替AI坐牢了吗？"
    },
    {
      "sentence_id": "s5",
      "char_len": 11,
      "snippet": "（新闻截图来自每经网）"
    },
    {
      "sentence_id": "s6",
      "char_len": 27,
      "snippet": "但想象能不能真的成为现实，取决于多少人愿意替AI坐牢。"
    },
    {
      "sentence_id": "s7",
      "char_len": 13,
      "snippet": "你没看错，就是替AI坐牢。"
    },
    {
      "sentence_id": "s8",
      "char_len": 27,
      "snippet": "图片截取自: 微信博弈豆包，人类准备好替AI坐牢了吗？"
    },
    {
      "sentence_id": "s9",
      "char_len": 14,
      "snippet": "你或许会疑惑，有这么严重吗？"
    },
    {
      "sentence_id": "s10",
      "char_len": 9,
      "snippet": "有，就有这么严重。"
    },
    {
      "sentence_id": "s11",
      "char_len": 45,
      "snippet": "因为帮你完成一切的时候，相当于你得完全交出自己的隐私+信任AI+愿意为AI的决策承担责任。"
    },
    {
      "sentence_id": "s12",
      "char_len": 47,
      "snippet": "这里面最重要的不是商业模式，不是巨头之间你争我夺的数据壁垒以及用户资源，这些只是商业上的问题。"
    },
    {
      "sentence_id": "s13",
      "char_len": 23,
      "snippet": "真正重要的是，【人要不要为AI决策承担责任】。"
    },
    {
      "sentence_id": "s14",
      "char_len": 23,
      "snippet": "这不是商业问题，而是一个法律问题乃至哲学问题。"
    },
    {
      "sentence_id": "s15",
      "char_len": 27,
      "snippet": "图片截取自: 微信博弈豆包，人类准备好替AI坐牢了吗？"
    },
    {
      "sentence_id": "s16",
      "char_len": 62,
      "snippet": "我没乱说，你自己思考一下，掌握你的一切数据和隐私的AI，在手机上以你的账号操作，到底能不能完全代表你"
    },
    {
      "sentence_id": "s17",
      "char_len": 8,
      "snippet": "这才是本质问题。"
    },
    {
      "sentence_id": "s18",
      "char_len": 36,
      "snippet": "当你选择一切交给AI的时候，AI给你的并不是只有好处，惹的祸，也是你的。"
    },
    {
      "sentence_id": "s19",
      "char_len": 27,
      "snippet": "图片截取自: 微信博弈豆包，人类准备好替AI坐牢了吗？"
    },
    {
      "sentence_id": "s20",
      "char_len": 25,
      "snippet": "现实世界里，事物是具有两面性的，不是只有好的一面。"
    },
    {
      "sentence_id": "s21",
      "char_len": 40,
      "snippet": "当你为所谓AI可以帮你自动全平台比价下单之类的功能雀跃的时候，这里面还有另一面。"
    },
    {
      "sentence_id": "s22",
      "char_len": 20,
      "snippet": "另一面是，你完全交出了你的钱包的支配权。"
    },
    {
      "sentence_id": "s23",
      "char_len": 36,
      "snippet": "能帮你自动下单，就能帮你自动转账自动充游戏币，就能帮你买理财买虚拟产品。"
    },
    {
      "sentence_id": "s24",
      "char_len": 31,
      "snippet": "能帮你自动比价，就能悄悄把自家的东西塞进去告诉你这就是最优解。"
    },
    {
      "sentence_id": "s25",
      "char_len": 12,
      "snippet": "就能替你交共享单车押金。"
    },
    {
      "sentence_id": "s26",
      "char_len": 7,
      "snippet": "还能交好几家。"
    },
    {
      "sentence_id": "s27",
      "char_len": 27,
      "snippet": "图片截取自: 微信博弈豆包，人类准备好替AI坐牢了吗？"
    },
    {
      "sentence_id": "s28",
      "char_len": 40,
      "snippet": "这时候，对家（接手转账or下单的人）可不管你是不是AI操作的，都是算在你头上的。"
    },
    {
      "sentence_id": "s29",
      "char_len": 38,
      "snippet": "这就像是现阶段的未成年人退款or转账转错人了，你说你不是，你怎么证明你不是？"
    },
    {
      "sentence_id": "s30",
      "char_len": 8,
      "snippet": "你想找AI的事？"
    },
    {
      "sentence_id": "s31",
      "char_len": 13,
      "snippet": "嗨嗨嗨，出门右转精神科室。"
    },
    {
      "sentence_id": "s32",
      "char_len": 27,
      "snippet": "图片截取自: 微信博弈豆包，人类准备好替AI坐牢了吗？"
    },
    {
      "sentence_id": "s33",
      "char_len": 35,
      "snippet": "当你为所谓AI可以帮你跟朋友圈好友互动而开心的时候，这里面还有另一面。"
    },
    {
      "sentence_id": "s34",
      "char_len": 61,
      "snippet": "另一面是，AI在完全不合适的人那里留下了完全不合适的言论（例如在一个瘸腿的人的朋友圈里鼓励对方多运动"
    },
    {
      "sentence_id": "s35",
      "char_len": 16,
      "snippet": "AI替你讲话，你替AI承担后果。"
    },
    {
      "sentence_id": "s36",
      "char_len": 27,
      "snippet": "能帮你自动跟人互动，就能帮你得罪人，就能帮你跟人结仇。"
    },
    {
      "sentence_id": "s37",
      "char_len": 28,
      "snippet": "能帮你自动发布文案，就能帮你说出问题言论，帮你踩缝纫机。"
    },
    {
      "sentence_id": "s38",
      "char_len": 51,
      "snippet": "这时候，别人可不管你这是不是AI发言，都是算在你的头上的，因为鬼知道是你还是AI，法律上也是算你头上"
    },
    {
      "sentence_id": "s39",
      "char_len": 13,
      "snippet": "因为，东西是你的账号发的。"
    },
    {
      "sentence_id": "s40",
      "char_len": 18,
      "snippet": "别人没法顺着网线去找AI，但能弄你。"
    },
    {
      "sentence_id": "s41",
      "char_len": 27,
      "snippet": "图片截取自: 微信博弈豆包，人类准备好替AI坐牢了吗？"
    },
    {
      "sentence_id": "s42",
      "char_len": 49,
      "snippet": "这就像是现阶段的智能驾驶，一切锅是司机的，你愿不愿意用你的钱包和生命来帮助企业收集数据迭代模型呢？"
    },
    {
      "sentence_id": "s43",
      "char_len": 25,
      "snippet": "记住，一切锅，是你的，你要替你的车替车厂承担责任。"
    },
    {
      "sentence_id": "s44",
      "char_len": 8,
      "snippet": "当然，有人愿意。"
    },
    {
      "sentence_id": "s45",
      "char_len": 11,
      "snippet": "但还有很多人，不愿意。"
    },
    {
      "sentence_id": "s46",
      "char_len": 16,
      "snippet": "毕竟大家都喜欢甩锅，不喜欢接锅。"
    },
    {
      "sentence_id": "s47",
      "char_len": 13,
      "snippet": "而目前这个AI，是不粘锅。"
    },
    {
      "sentence_id": "s48",
      "char_len": 27,
      "snippet": "图片截取自: 微信博弈豆包，人类准备好替AI坐牢了吗？"
    },
    {
      "sentence_id": "s49",
      "char_len": 41,
      "snippet": "所以，表面问题是各大APP各大手机厂商的所谓护城河，数据价值，领地意识，商业模式。"
    },
    {
      "sentence_id": "s50",
      "char_len": 20,
      "snippet": "但核心是一个哲学问题，你到底如何代表你？"
    },
    {
      "sentence_id": "s51",
      "char_len": 24,
      "snippet": "AI有你的一切授权的时候，是不是AI就是你了呢？"
    },
    {
      "sentence_id": "s52",
      "char_len": 19,
      "snippet": "那，AI出的问题，是不是要算在你身上？"
    },
    {
      "sentence_id": "s53",
      "char_len": 27,
      "snippet": "图片截取自: 微信博弈豆包，人类准备好替AI坐牢了吗？"
    },
    {
      "sentence_id": "s54",
      "char_len": 35,
      "snippet": "其底层的核心矛盾是，你作为人，你愿意交出一切，让AI来替你赛博生存么？"
    },
    {
      "sentence_id": "s55",
      "char_len": 17,
      "snippet": "记住，AI做的好的赚到的，算你的。"
    },
    {
      "sentence_id": "s56",
      "char_len": 17,
      "snippet": "做的烂的得罪人的亏损的，也算你的。"
    },
    {
      "sentence_id": "s57",
      "char_len": 17,
      "snippet": "AI在帮你决策，AI也在替你活着。"
    },
    {
      "sentence_id": "s58",
      "char_len": 10,
      "snippet": "而你，在替AI背锅。"
    },
    {
      "sentence_id": "s59",
      "char_len": 6,
      "snippet": "你，愿意么？"
    },
    {
      "sentence_id": "s60",
      "char_len": 27,
      "snippet": "图片截取自: 微信博弈豆包，人类准备好替AI坐牢了吗？"
    }
  ],
