  "source_sha256": "30491508ff930396dd88daf665b0a5803dbc4eade6717a8f31baa7389ffdc8c7",
  "performance_tier": "CONTROL",
  "spoken_marker_eligible": "N/A_TEXT",
  "analysis_status": "OK",
