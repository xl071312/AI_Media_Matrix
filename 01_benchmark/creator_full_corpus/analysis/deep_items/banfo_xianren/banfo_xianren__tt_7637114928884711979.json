  "sentences_index": [
    {
      "sentence_id": "s1",
      "char_len": 1,
      "snippet": "1"
    },
    {
      "sentence_id": "s2",
      "char_len": 17,
      "snippet": "标题看起来很离谱，但你看完就懂了。"
    },
    {
      "sentence_id": "s3",
      "char_len": 25,
      "snippet": "这几天一直刷屏什么央视拒绝世界杯天价转播费的事情。"
    },
    {
      "sentence_id": "s4",
      "char_len": 22,
      "snippet": "要我说根本就别天价不天价，就不该给钱，真的。"
    },
    {
      "sentence_id": "s5",
      "char_len": 25,
      "snippet": "国际足联应该免费让央视播，甚至倒贴点钱，让央视播。"
    },
    {
      "sentence_id": "s6",
      "char_len": 21,
      "snippet": "图片截取自: 世界杯应该倒给央视钱求他们播"
    },
    {
      "sentence_id": "s7",
      "char_len": 17,
      "snippet": "你没看错，甚至应该倒贴钱让央视播。"
    },
    {
      "sentence_id": "s8",
      "char_len": 12,
      "snippet": "只要央视肯播，就足够了。"
    },
    {
      "sentence_id": "s9",
      "char_len": 3,
      "snippet": "为啥。"
    },
    {
      "sentence_id": "s10",
      "char_len": 24,
      "snippet": "因为收钱的前提是你能提供利益or稀缺性or威胁。"
    },
    {
      "sentence_id": "s11",
      "char_len": 21,
      "snippet": "如果你什么都提供不了，那多少得有点乐子吧？"
    },
    {
      "sentence_id": "s12",
      "char_len": 21,
      "snippet": "图片截取自: 世界杯应该倒给央视钱求他们播"
    },
    {
      "sentence_id": "s13",
      "char_len": 9,
      "snippet": "我们看这三个要素。"
    },
    {
      "sentence_id": "s14",
      "char_len": 27,
      "snippet": "从利益的角度，付那么多钱播你纯亏钱，为啥要付那么多钱？"
    },
    {
      "sentence_id": "s15",
      "char_len": 22,
      "snippet": "而且中国队又不去，不如直接播苏超还更有流量。"
    },
    {
      "sentence_id": "s16",
      "char_len": 26,
      "snippet": "从稀缺性的角度，有的是世界比赛可以播，为啥要播足球？"
    },
    {
      "sentence_id": "s17",
      "char_len": 22,
      "snippet": "而且中国队又不去，不如直接播苏超还更有流量。"
    },
    {
      "sentence_id": "s18",
      "char_len": 35,
      "snippet": "从威胁的角度说，中国队根本就没参加，属于无法被选中的状态，为啥要播你？"
    },
    {
      "sentence_id": "s19",
      "char_len": 21,
      "snippet": "图片截取自: 世界杯应该倒给央视钱求他们播"
    },
    {
      "sentence_id": "s20",
      "char_len": 18,
      "snippet": "而反过来，央视可以提供相当大的威胁。"
    },
    {
      "sentence_id": "s21",
      "char_len": 59,
      "snippet": "那就是只要你这东西央视有版权，就相当于多了一个被动护盾，各大平台会下意识的把关于你的非授权内容屏蔽，都是规则直接生效。"
    },
    {
      "sentence_id": "s22",
      "char_len": 15,
      "snippet": "不信你自己传视频传过就知道了。"
    },
    {
      "sentence_id": "s23",
      "char_len": 31,
      "snippet": "不管央视主观上想不想罩着你，只要央视有播出权，被动就罩着你了。"
    },
    {
      "sentence_id": "s24",
      "char_len": 67,
      "snippet": "而反过来，如果央视不播你，不对外宣称自己播你，那所有平台都不甩你，可以不花一分钱的让观众看到带弹幕的，只需要调整几个上传主体就可以了。"
    },
    {
      "sentence_id": "s25",
      "char_len": 33,
      "snippet": "有些网站自从不买版权之后，大家可以看到所有的东西了，比网盘还方便。"
    },
    {
      "sentence_id": "s26",
      "char_len": 21,
      "snippet": "图片截取自: 世界杯应该倒给央视钱求他们播"
    },
    {
      "sentence_id": "s27",
      "char_len": 21,
      "snippet": "与此同时，还涉及一个赞助商和广告商的问题。"
    },
    {
      "sentence_id": "s28",
      "char_len": 11,
      "snippet": "央视播你，是一个价格。"
    },
    {
      "sentence_id": "s29",
      "char_len": 13,
      "snippet": "央视不播你，是另一个价格。"
    },
    {
      "sentence_id": "s30",
      "char_len": 40,
      "snippet": "赞助商也不傻，尤其是国内赞助商，可以不求回报，但也不能人家目标客户根本看不到吧？"
    },
    {
      "sentence_id": "s31",
      "char_len": 11,
      "snippet": "连个面子都露不出去吧？"
    },
    {
      "sentence_id": "s32",
      "char_len": 38,
      "snippet": "人家钱也不是大风刮来的，如果一个央视都不播的体育栏目想要大赞助，那别做梦了。"
    },
    {
      "sentence_id": "s33",
      "char_len": 21,
      "snippet": "图片截取自: 世界杯应该倒给央视钱求他们播"
    },
    {
      "sentence_id": "s34",
      "char_len": 46,
      "snippet": "而如果央视播，或许也没多少效果，但这起码是个抓手，人家企业也能说服自己就当是冲着央视面子了。"
    },
    {
      "sentence_id": "s35",
      "char_len": 31,
      "snippet": "不然连自家老板那一关都过不去，人家一句话央视都不播为什么要投？"
    },
    {
      "sentence_id": "s36",
      "char_len": 8,
      "snippet": "你直接没法解释。"
    },
    {
      "sentence_id": "s37",
      "char_len": 48,
      "snippet": "所以，为了跟其他比赛以及运动竞争中国市场，要求着央视播，类似当年windows怎么搞竞争对手的？"
    },
    {
      "sentence_id": "s38",
      "char_len": 15,
      "snippet": "直接放任大家随意用，直接免费。"
    },
    {
      "sentence_id": "s39",
      "char_len": 22,
      "snippet": "为了给其他赞助商一点谈判条件，也得让央视播。"
    },
    {
      "sentence_id": "s40",
      "char_len": 40,
      "snippet": "为了防止其他平台疯狂弄你，大家都看上免费世界杯，更得求着央视播，求一个央视护盾。"
    },
    {
      "sentence_id": "s41",
      "char_len": 21,
      "snippet": "图片截取自: 世界杯应该倒给央视钱求他们播"
    },
    {
      "sentence_id": "s42",
      "char_len": 13,
      "snippet": "只要央视肯播，一切好商量。"
    },
    {
      "sentence_id": "s43",
      "char_len": 31,
      "snippet": "而且一切，归根究底都在于中国足球队给了足够多的机会和策略空间。"
    },
    {
      "sentence_id": "s44",
      "char_len": 12,
      "snippet": "谁说人家不会进攻防守呢？"
    },
    {
      "sentence_id": "s45",
      "char_len": 9,
      "snippet": "现在，攻守易型了。"
    },
    {
      "sentence_id": "s46",
      "char_len": 21,
      "snippet": "图片截取自: 世界杯应该倒给央视钱求他们播"
    }
  ],
