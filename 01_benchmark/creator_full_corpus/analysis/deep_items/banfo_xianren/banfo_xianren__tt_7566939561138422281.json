  "sentence_count": 59,
  "sentences_index": [
    {
      "sentence_id": "s1",
      "char_len": 1,
      "snippet": "1"
    },
    {
      "sentence_id": "s2",
      "char_len": 21,
      "snippet": "最近，海底捞搞了个寿司品牌叫“如鮨寿司”。"
    },
    {
      "sentence_id": "s3",
      "char_len": 21,
      "snippet": "图片截取自: 在海底捞面前，日料还是太弱了"
    },
    {
      "sentence_id": "s4",
      "char_len": 32,
      "snippet": "很多人看到这里都懵了，一个搓麻酱和牛油的，怎么就跨界捏饭团去了？"
    },
    {
      "sentence_id": "s5",
      "char_len": 32,
      "snippet": "就像郭德纲老师突然宣布出道成为偶像练习生，唱的还是阿姆的RAP。"
    },
    {
      "sentence_id": "s6",
      "char_len": 5,
      "snippet": "这合理吗？"
    },
    {
      "sentence_id": "s7",
      "char_len": 5,
      "snippet": "太合理了。"
    },
    {
      "sentence_id": "s8",
      "char_len": 15,
      "snippet": "因为没有人比海底捞，更懂日料。"
    },
    {
      "sentence_id": "s9",
      "char_len": 21,
      "snippet": "图片截取自: 在海底捞面前，日料还是太弱了"
    },
    {
      "sentence_id": "s10",
      "char_len": 18,
      "snippet": "真的，做痔疮膏的去做眼霜，叫跨赛道。"
    },
    {
      "sentence_id": "s11",
      "char_len": 31,
      "snippet": "一个做火锅的去做日料，顶多算虚线打着转向灯变道，直接呵护驾照。"
    },
    {
      "sentence_id": "s12",
      "char_len": 21,
      "snippet": "海底捞做日料不止是跨赛道，而是扩大舒适圈。"
    },
    {
      "sentence_id": "s13",
      "char_len": 13,
      "snippet": "直接把舒适圈往对手坟上盖。"
    },
    {
      "sentence_id": "s14",
      "char_len": 15,
      "snippet": "在海底捞面前，日料还是太弱了。"
    },
    {
      "sentence_id": "s15",
      "char_len": 12,
      "snippet": "没有护城河，只有下水道。"
    },
    {
      "sentence_id": "s16",
      "char_len": 21,
      "snippet": "图片截取自: 在海底捞面前，日料还是太弱了"
    },
    {
      "sentence_id": "s17",
      "char_len": 69,
      "snippet": "日料这种餐饮方式，说白了就是半成品加半成品，如果你去过日本，你就会发现他们不仅不掩饰，甚至直接半成品做成商用大包装给你开超市，生怕你不知。"
    },
    {
      "sentence_id": "s18",
      "char_len": 18,
      "snippet": "你去看一下市面上的日料店，就知道了。"
    },
    {
      "sentence_id": "s19",
      "char_len": 7,
      "snippet": "海草，预制的；"
    },
    {
      "sentence_id": "s20",
      "char_len": 7,
      "snippet": "牛丼，预制的；"
    },
    {
      "sentence_id": "s21",
      "char_len": 8,
      "snippet": "海螺片，预制的。"
    },
    {
      "sentence_id": "s22",
      "char_len": 17,
      "snippet": "很多日料店基本等于预制菜买手精选。"
    },
    {
      "sentence_id": "s23",
      "char_len": 21,
      "snippet": "图片截取自: 在海底捞面前，日料还是太弱了"
    },
    {
      "sentence_id": "s24",
      "char_len": 61,
      "snippet": "你吃的鳗鱼可能是中央厨房上个月做好的，你尝的刺身可能是上个礼拜冻好冷链今天送到解冻的，你喝的味噌汤搞不好是去年的料包冲的。"
    },
    {
      "sentence_id": "s25",
      "char_len": 23,
      "snippet": "既然大家都是玩半成品，那谁才是半成品界的王者？"
    },
    {
      "sentence_id": "s26",
      "char_len": 5,
      "snippet": "诶~火锅。"
    },
    {
      "sentence_id": "s27",
      "char_len": 32,
      "snippet": "论半成品的供应链管理，日料跟火锅，简直就是一对失散多年的亲兄弟。"
    },
    {
      "sentence_id": "s28",
      "char_len": 14,
      "snippet": "哦不对，火锅比日料厉害多了。"
    },
    {
      "sentence_id": "s29",
      "char_len": 27,
      "snippet": "因为消费者对火锅没有滤镜，不会自己脑补，所以不好糊弄。"
    },
    {
      "sentence_id": "s30",
      "char_len": 21,
      "snippet": "图片截取自: 在海底捞面前，日料还是太弱了"
    },
    {
      "sentence_id": "s31",
      "char_len": 17,
      "snippet": "这时候你看，海底捞做日料，就很妙。"
    },
    {
      "sentence_id": "s32",
      "char_len": 28,
      "snippet": "很多日料店里的产品，它本身就是在海底捞火锅业务里开光的。"
    },
    {
      "sentence_id": "s33",
      "char_len": 12,
      "snippet": "日料店的牛丼饭要用肥牛？"
    },
    {
      "sentence_id": "s34",
      "char_len": 37,
      "snippet": "我火锅店片肥牛时剔下来的边角料，都够你开三家旗舰店，还能饶你一个自助早餐。"
    },
    {
      "sentence_id": "s35",
      "char_len": 13,
      "snippet": "刺身拼盘要的三文鱼金枪鱼？"
    },
    {
      "sentence_id": "s36",
      "char_len": 19,
      "snippet": "我海底捞的冷链冰箱里，什么鱼游不过来？"
    },
    {
      "sentence_id": "s37",
      "char_len": 16,
      "snippet": "从挪威到新西兰，都是我家的鱼塘。"
    },
    {
      "sentence_id": "s38",
      "char_len": 21,
      "snippet": "图片截取自: 在海底捞面前，日料还是太弱了"
    },
    {
      "sentence_id": "s39",
      "char_len": 17,
      "snippet": "你日料要配可尔必思、大福、冰淇淋？"
    },
    {
      "sentence_id": "s40",
      "char_len": 47,
      "snippet": "海底捞的饮料台、甜品站里都是现成的，员工甚至能教你用可尔必思和草莓冰淇淋调个小红书同款鸡尾酒。"
    },
    {
      "sentence_id": "s41",
      "char_len": 25,
      "snippet": "甚至，日料引以为傲的寿喜锅，本身就是个实习小火锅。"
    },
    {
      "sentence_id": "s42",
      "char_len": 28,
      "snippet": "这时候，海底捞做日料，就像擎天柱改行做货拉拉，无缝衔接。"
    },
    {
      "sentence_id": "s43",
      "char_len": 21,
      "snippet": "图片截取自: 在海底捞面前，日料还是太弱了"
    },
    {
      "sentence_id": "s44",
      "char_len": 25,
      "snippet": "甚至再一思考，火锅供应链做日料已经有些过于奢侈了。"
    },
    {
      "sentence_id": "s45",
      "char_len": 11,
      "snippet": "牛丼饭，是肥牛拼盘的；"
    },
    {
      "sentence_id": "s46",
      "char_len": 20,
      "snippet": "你吃到甜虾，是今早和火锅虾滑一起到货的；"
    },
    {
      "sentence_id": "s47",
      "char_len": 21,
      "snippet": "你尝到海胆，是和火锅海鲜坐同一架飞机来的。"
    },
    {
      "sentence_id": "s48",
      "char_len": 26,
      "snippet": "海鲜的终极命运，不是在火锅里成熟就是在寿司醋里沐浴。"
    },
    {
      "sentence_id": "s49",
      "char_len": 61,
      "snippet": "我都怕吃到一半，服务员现场给你来一段科目三，寿司师傅把手握一扔就开始川剧变脸，两人一个托马斯全旋就开始跟所有的烦恼说拜拜。"
    },
    {
      "sentence_id": "s50",
      "char_len": 30,
      "snippet": "以后日料好不好，不看师傅的手，得看海底捞的物流车几点到门口。"
    },
    {
      "sentence_id": "s51",
      "char_len": 21,
      "snippet": "图片截取自: 在海底捞面前，日料还是太弱了"
    },
    {
      "sentence_id": "s52",
      "char_len": 58,
      "snippet": "但凡它直接把火锅底料浇在刺身上，或者人均消费满三百送半小时美甲服务，关于日料到底是吃环境还是吃食材的争论将迎来终局。"
    },
    {
      "sentence_id": "s53",
      "char_len": 27,
      "snippet": "就这个商业逻辑，寿司之神来了都稚嫩得像刚入行的实习生。"
    },
    {
      "sentence_id": "s54",
      "char_len": 15,
      "snippet": "海底捞去做日料，这能叫竞争吗？"
    },
    {
      "sentence_id": "s55",
      "char_len": 8,
      "snippet": "这叫，顺手拿捏。"
    },
    {
      "sentence_id": "s56",
      "char_len": 34,
      "snippet": "怪不得人家叫海底捞呢，日料的精髓可不就是原材料都是去海底捞上来的吗。"
    },
    {
      "sentence_id": "s57",
      "char_len": 13,
      "snippet": "这波属于谜底就在谜面上了。"
    },
    {
      "sentence_id": "s58",
      "char_len": 12,
      "snippet": "没有人比海底捞更懂日料。"
    },
    {
      "sentence_id": "s59",
      "char_len": 21,
      "snippet": "图片截取自: 在海底捞面前，日料还是太弱了"
    }
  ],
