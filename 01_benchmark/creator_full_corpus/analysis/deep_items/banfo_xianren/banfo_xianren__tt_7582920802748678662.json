      ],
      "evidence": [
        {
          "sentence_id": "s3",
          "snippet": "说来有趣，后台经常有人问我开店的成功经验，都给我看笑了。",
          "note": "问成功经验"
        },
        {
          "sentence_id": "s5",
          "snippet": "我们不能讨论一个不存在的东西。",
          "note": "不存在的东西"
        },
        {
          "sentence_id": "s7",
          "snippet": "而其中坑最狠的，就是民宿。",
          "note": "民宿坑最狠"
        }
      ]
    },
    "claim_chain": {
      "summary": "民宿浪漫幻想→运营成本高非标→地段租金两难→装修坑→手续玄学→人员管理→安全风险→不赚钱转让→建议先打工半年。",
      "patterns": [
        "幻想拆穿",
        "成本五连",
        "不赚钱",
        "打工验坑"
      ],
      "evidence": [
        {
          "sentence_id": "s15",
          "snippet": "民宿多好呀，听起来就是吉他，艳遇，江湖，花房姑娘，清新，花朵，咖啡，烧烤，篝火，",
          "note": "浪漫幻想"
        },
        {
          "sentence_id": "s21",
          "snippet": "第一，运营成本和难度较高。",
          "note": "运营成本"
        },
        {
          "sentence_id": "s152",
          "snippet": "想多了，朋友，民宿什么幺蛾子都有，但赚钱这个是真没有。",
          "note": "赚钱没有"
        },
        {
          "sentence_id": "s166",
          "snippet": "我建议你可以找一些民宿去打工，打个半年工，你就什么都懂了。",
          "note": "打工半年"
        }
