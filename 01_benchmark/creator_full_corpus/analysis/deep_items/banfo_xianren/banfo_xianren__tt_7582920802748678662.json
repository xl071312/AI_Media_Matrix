      "evidence": [
        {
          "sentence_id": "s26",
          "snippet": "连锁酒店走的是规模化标准化的高效模式，通过规模走量可以压低装修成本，一次性资金投",
          "note": "连锁可控"
        },
        {
          "sentence_id": "s27",
          "snippet": "民宿走的是低效率的个性化非标模式，先期资金投入不是很高，但后续的运营成本会特别高",
          "note": "民宿高成本"
        },
        {
          "sentence_id": "s10",
          "snippet": "因为一年就被淘汰了。",
          "note": "一年淘汰"
        },
        {
          "sentence_id": "s44",
          "snippet": "房子是租房东的，你算下成本，每天开门就是欠了钱，如果生意不好，就是赔的不行。",
          "note": "租房即欠钱"
        }
      ]
