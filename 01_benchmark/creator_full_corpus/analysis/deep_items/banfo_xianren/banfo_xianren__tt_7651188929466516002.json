  "source_sha256": "92d703f0be965dcd5cd1abdd97d2f1d002e99293c309375514daeb0537757bad",
  "performance_tier": "CONTROL",
  "spoken_marker_eligible": "N/A_TEXT",
  "analysis_status": "OK",
  "analyzer_version": "phase_c_v1",
  "sentence_count": 74,
  "sentences_index": [
    {
      "sentence_id": "s1",
      "char_len": 21,
      "snippet": "图片截取自: 华为鸿蒙这几年是磨出真东西了"
    },
    {
      "sentence_id": "s2",
      "char_len": 1,
      "snippet": "1"
    },
    {
      "sentence_id": "s3",
      "char_len": 23,
      "snippet": "昨天华为HDC大会，有个神奇的东西让我眼前一亮"
    },
    {
      "sentence_id": "s4",
      "char_len": 16,
      "snippet": "它是一个AI智能体，叫【喂星】。"
    },
    {
      "sentence_id": "s5",
      "char_len": 53,
      "snippet": "大白话讲，你，我的朋友，不但能认养一颗星，看着它陪着地球在宇宙里转圈圈，不时看一"
    },
    {
      "sentence_id": "s6",
      "char_len": 23,
      "snippet": "还能把它像小宠物一样拿捏，对着小艺喊一声“喂！"
    },
    {
      "sentence_id": "s7",
      "char_len": 31,
      "snippet": "星”，就给它叫出来，甚至在手感和体感追踪下，它还能跟着你旋转。"
    },
    {
      "sentence_id": "s8",
      "char_len": 59,
      "snippet": "看完后我的第一反应是三体还是太保守了，云天明老师到底是太实在了，你当年送程心这个"
    },
    {
      "sentence_id": "s9",
      "char_len": 12,
      "snippet": "更让我眼前一亮的是什么？"
    },
    {
      "sentence_id": "s10",
      "char_len": 88,
      "snippet": "类似的惊喜应用还有很多，它硬是给了我一种当年刚用上智能手机，打开应用商城啥都想下"
    },
    {
      "sentence_id": "s11",
      "char_len": 16,
      "snippet": "鸿蒙生态，终于成了一个大千世界。"
    },
    {
      "sentence_id": "s12",
      "char_len": 1,
      "snippet": "2"
    },
    {
      "sentence_id": "s13",
      "char_len": 32,
      "snippet": "如果把时间调回一年乃至更多年以前，连着看，会发现更多好玩的东西。"
    },
    {
      "sentence_id": "s14",
      "char_len": 48,
      "snippet": "那个时刻，我们还在讲鸿蒙跨越了微笑曲线的故事，再往前，困扰鸿蒙生态的还是先有鸡还"
    },
    {
      "sentence_id": "s15",
      "char_len": 81,
      "snippet": "那时候，做系统这事儿本事就让人迷惑，开发者不会前往没有用户的系统开发应用，用户不"
    },
    {
      "sentence_id": "s16",
      "char_len": 32,
      "snippet": "这个问题，现在没必要再回答了，只要你用过一回鸿蒙，自己就有答案。"
    },
    {
      "sentence_id": "s17",
      "char_len": 65,
      "snippet": "光多屏互联，碰一碰传文件，上班之前在手机编辑一下方案，电脑一碰继续编辑，就够打工"
    },
    {
      "sentence_id": "s18",
      "char_len": 52,
      "snippet": "去年才推出的鸿蒙星光计划，就是为了让开发者先受益，踏实干，今年就能看到各种花里胡"
    },
    {
      "sentence_id": "s19",
      "char_len": 25,
      "snippet": "做一个属于自己的系统这件事，怎么做，都不会亏的事。"
    },
    {
      "sentence_id": "s20",
      "char_len": 35,
      "snippet": "到今天，可以说鸿蒙生态从小树苗变成一棵大树，下一步，要朝着格鲁特去了。"
    },
    {
      "sentence_id": "s21",
      "char_len": 23,
      "snippet": "被这棵树链接的千行万业，实打实感受到了不一样。"
    },
    {
      "sentence_id": "s22",
      "char_len": 34,
      "snippet": "工业制造领域，哑设备也能更好地开口说话，将老师傅的经验变成模范手册；"
    },
    {
      "sentence_id": "s23",
      "char_len": 48,
      "snippet": "在医疗和金融领域，数据能被打通闭环，方便还安全，就连政务领域，也变成了服务找人，"
    },
    {
      "sentence_id": "s24",
      "char_len": 79,
      "snippet": "开源之后，6600万用户实时地感受到鸿蒙生态的日新月异，鸿蒙生态可获取应用服务突"
    },
    {
      "sentence_id": "s25",
      "char_len": 17,
      "snippet": "某种程度上讲，这何尝不是一种追更。"
    },
    {
      "sentence_id": "s26",
      "char_len": 66,
      "snippet": "甚至到今天，就像前面提到的【喂星】，很多这种新颖的应用，都是在生活逐渐无趣，信息"
    },
    {
      "sentence_id": "s27",
      "char_len": 45,
      "snippet": "比如说【像素匠PRO】，一个人一台手机，随手一拍就能做3D，大家一起搭积木搭出个"
    },
    {
      "sentence_id": "s28",
      "char_len": 46,
      "snippet": "【逐星】，摄像爱好者要大包小包背单反找星星，现在能一键寻星，甚至AI帮你拍到晦暗"
    },
    {
      "sentence_id": "s29",
      "char_len": 34,
      "snippet": "【奇妙工具箱】能够将功能变成全家桶，AR测距，人脸识别打码，很方便。"
    },
    {
      "sentence_id": "s30",
      "char_len": 47,
      "snippet": "这些应用不大，甚至纯个人手搓，但很浪漫，像是智人第一次用完了火，将炭在石壁上涂鸦"
    },
    {
      "sentence_id": "s31",
      "char_len": 32,
      "snippet": "它很初级，但更应该被看见，因为无数个美妙的故事，都是偶然的开头。"
    },
    {
      "sentence_id": "s32",
      "char_len": 60,
      "snippet": "今年HDC大会上，不但有相关高管来亲身体验应用，更会有16组投资人逛展，从商业角"
    },
    {
      "sentence_id": "s33",
      "char_len": 51,
      "snippet": "你做得好，我帮你变得更好，不是因为偶然，而是鸿蒙生态在这里，我们可以长期下去，在"
    },
    {
      "sentence_id": "s34",
      "char_len": 32,
      "snippet": "这也正是鸿蒙当初的不设限，不争利，不停步，长期共赢等理念的初心。"
    },
    {
      "sentence_id": "s35",
      "char_len": 24,
      "snippet": "你热爱一个更新的世界，那就跟我一起，把它造出来。"
    },
    {
      "sentence_id": "s36",
      "char_len": 1,
      "snippet": "3"
    },
    {
      "sentence_id": "s37",
      "char_len": 22,
      "snippet": "当然最重要的是，肉眼可见的未来，风卷云又涌。"
    },
    {
      "sentence_id": "s38",
      "char_len": 51,
      "snippet": "很现实的是，APP时代即将过去，Agent时代还未完全到来，摆在我们面前的不是十"
    },
    {
      "sentence_id": "s39",
      "char_len": 26,
      "snippet": "大家对于Agent的认知不同，自然也诞生了很多条路。"
    },
    {
      "sentence_id": "s40",
      "char_len": 65,
      "snippet": "比如一条是，认为Agent是具备推理规划和记忆能力的终极数字员工，它该以模型能力"
    },
    {
      "sentence_id": "s41",
      "char_len": 56,
      "snippet": "这条路不好走，难免会面对隐私与失控风险，就相当于把工作全交给丞相做，丞相是诸葛亮"
    },
    {
      "sentence_id": "s42",
      "char_len": 55,
      "snippet": "另一种是截然相反，让Agent成为你的私人助理，重点在于提供更个性化体验，重点在"
    },
    {
      "sentence_id": "s43",
      "char_len": 14,
      "snippet": "这条路，看起来也不那么好走。"
    },
    {
      "sentence_id": "s44",
      "char_len": 23,
      "snippet": "甚至跳出技术层面，我们值得问一个很现实的问题。"
    },
    {
      "sentence_id": "s45",
      "char_len": 58,
      "snippet": "已知，在Agent时代，大家都在争夺入口，谁定义了Agent运行、调度、协同的底"
    },
    {
      "sentence_id": "s46",
      "char_len": 77,
      "snippet": "又已知我们在应用层面，做出了很棒的成绩，并因此生活发生了翻天覆地的变化，如果这时"
    },
    {
      "sentence_id": "s47",
      "char_len": 25,
      "snippet": "这时回看7年前，如果不做鸿蒙了，是不是想想就后怕。"
    },
    {
      "sentence_id": "s48",
      "char_len": 67,
      "snippet": "因此，有一条路是，不在产品层面谈Agent，而是将它彻底下沉，变成系统本身的组成"
    },
    {
      "sentence_id": "s49",
      "char_len": 34,
      "snippet": "今年鸿蒙OS 7.0开发者Beta版发布，开始迈进意图即服务的时代。"
    },
    {
      "sentence_id": "s50",
      "char_len": 42,
      "snippet": "这条路，带来了Agent亲和架构系统，鸿蒙智能体框架2.0和系统智能体小艺三项变"
    },
    {
      "sentence_id": "s51",
      "char_len": 67,
      "snippet": "首先底层智力中枢让端侧云侧大模型能跑得快，跑得稳，跑得安全，小艺与OS全面下沉融"
    },
    {
      "sentence_id": "s52",
      "char_len": 31,
      "snippet": "可以说，比起只能保一头前两条路，鸿蒙生态不光有肉体，更有灵魂。"
    },
    {
      "sentence_id": "s53",
      "char_len": 53,
      "snippet": "其次，面向伙伴，鸿蒙智能体框架能让生态应用能被开发得更高效，能更加智能化，更Ag"
    },
    {
      "sentence_id": "s54",
      "char_len": 72,
      "snippet": "鸿蒙智能体框架在2.0升级后，复杂任务成功率更高，接入方式也更加灵活，20+AI"
    },
    {
      "sentence_id": "s55",
      "char_len": 51,
      "snippet": "面对Agent时代一旦到来，应用就该被淘汰的宿论，鸿蒙属于不但自己上了时代的船，"
    },
    {
      "sentence_id": "s56",
      "char_len": 61,
      "snippet": "最重要的是，小艺有200+项系统级数据，全天候智能感知引擎，超强记忆与上下文理解"
    },
    {
      "sentence_id": "s57",
      "char_len": 22,
      "snippet": "对用户来说，这是谁把贾维斯炼化在我手机里了？"
    },
    {
      "sentence_id": "s58",
      "char_len": 7,
      "snippet": "这有多夸张呢？"
    },
    {
      "sentence_id": "s59",
      "char_len": 34,
      "snippet": "学生党经常面对自己前脚出门，后脚导师就要求你临时改一版论文的情况吧？"
    },
    {
      "sentence_id": "s60",
      "char_len": 66,
      "snippet": "以往只能干着急，现在小艺能帮你查阅电脑上的相关资料和文件，然后发到你手机里，你在"
    },
    {
      "sentence_id": "s61",
      "char_len": 58,
      "snippet": "除此以外，鸿蒙还带来了高吞吐低时延， Agent能力升级的openPangu 2"
    },
    {
      "sentence_id": "s62",
      "char_len": 38,
      "snippet": "比如搭载性能大模型的超丝滑方舟引擎，用起来快，年度负载增长更低，用久了也快。"
    },
    {
      "sentence_id": "s63",
      "char_len": 66,
      "snippet": "以及全链路AI安全的鸿蒙星盾安全，以往要担心骗子用AI变成我的声音，以及伪装成国"
    },
    {
      "sentence_id": "s64",
      "char_len": 18,
      "snippet": "那以这种体验，谁还不愿来鸿蒙试两下。"
    },
    {
      "sentence_id": "s65",
      "char_len": 17,
      "snippet": "版本更新，这一次，大家都被加强啦。"
    },
    {
      "sentence_id": "s66",
      "char_len": 1,
      "snippet": "4"
    },
    {
      "sentence_id": "s67",
      "char_len": 23,
      "snippet": "最重要的一点是，相信未来，相信未来，相信未来。"
    },
    {
      "sentence_id": "s68",
      "char_len": 37,
      "snippet": "这次大会，其实出现了很多年轻人喜欢的大热IP，爱好者也踏踏实实过了一回节。"
    },
    {
      "sentence_id": "s69",
      "char_len": 42,
      "snippet": "随着鸿蒙生态发展，更多大热IP也会在鸿蒙上玩出一片天，因为让年轻人玩起来，也很重"
    },
    {
      "sentence_id": "s70",
      "char_len": 67,
      "snippet": "对年轻的大学生来说，从鸿蒙生态获得情绪价值的游览者，变成未来的年轻开发者，在这里"
    },
    {
      "sentence_id": "s71",
      "char_len": 20,
      "snippet": "热爱这片世界的人，才有动力改变这片世界。"
    },
    {
      "sentence_id": "s72",
      "char_len": 39,
      "snippet": "有风口，有机遇，没可能离开这里，这片生态热土，就有了下一次生命大爆炸的新纪元。"
    },
    {
      "sentence_id": "s73",
      "char_len": 16,
      "snippet": "这是一个长期的事情，但不会太远。"
    },
    {
      "sentence_id": "s74",
      "char_len": 10,
      "snippet": "下一个十年，鸿蒙见。"
    }
  ],
