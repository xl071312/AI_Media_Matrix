  "source_sha256": "00c5dda8a2e4c095de3b3a973545dbbad27a710fad6276a935a06628e35f276b",
  "performance_tier": "HIGH",
  "spoken_marker_eligible": "N/A_TEXT",
  "analysis_status": "OK",
  "analyzer_version": "phase_c_v1",
  "sentence_count": 90,
  "sentences_index": [
    {
      "sentence_id": "s1",
      "char_len": 20,
      "snippet": "图片截取自: 天地壹号，中年人最后的体面"
    },
    {
      "sentence_id": "s2",
      "char_len": 1,
      "snippet": "1"
    },
    {
      "sentence_id": "s3",
      "char_len": 27,
      "snippet": "周末，有个潮汕朋友来我家吃饭，来的时候，提了一箱饮料，"
    },
    {
      "sentence_id": "s4",
      "char_len": 34,
      "snippet": "我说来都来了，拿啥东西呢，太见外了，一边说，一边把饮料箱拿进屋子里。"
    },
    {
      "sentence_id": "s5",
      "char_len": 15,
      "snippet": "因为太过急迫，还差点摔了一跤。"
    },
    {
      "sentence_id": "s6",
      "char_len": 16,
      "snippet": "朋友说这个叫天地壹号，是苹果醋。"
    },
    {
      "sentence_id": "s7",
      "char_len": 6,
      "snippet": "我说挺好的。"
    },
    {
      "sentence_id": "s8",
      "char_len": 10,
      "snippet": "他说这是，天地壹号。"
    },
    {
      "sentence_id": "s9",
      "char_len": 6,
      "snippet": "我说谢谢你。"
    },
    {
      "sentence_id": "s10",
      "char_len": 11,
      "snippet": "他说，这是，天地壹号。"
    },
    {
      "sentence_id": "s11",
      "char_len": 4,
      "snippet": "我说啊？"
    },
    {
      "sentence_id": "s12",
      "char_len": 13,
      "snippet": "他说你不懂，这是天地壹号。"
    },
    {
      "sentence_id": "s13",
      "char_len": 22,
      "snippet": "这是我们广东人自己的鲁花5S压榨一级花生油。"
    },
    {
      "sentence_id": "s14",
      "char_len": 20,
      "snippet": "我腿一抖，差点给他磕一个，这礼也太重了。"
    },
    {
      "sentence_id": "s15",
      "char_len": 1,
      "snippet": "2"
    },
    {
      "sentence_id": "s16",
      "char_len": 37,
      "snippet": "等朋友走了以后，我就查了一下这家公司的资料，天地壹号是全国最大的醋饮公司。"
    },
    {
      "sentence_id": "s17",
      "char_len": 19,
      "snippet": "但严格来讲，它的画风更像是保健品公司。"
    },
    {
      "sentence_id": "s18",
      "char_len": 12,
      "snippet": "先解释一下，什么叫醋饮？"
    },
    {
      "sentence_id": "s19",
      "char_len": 44,
      "snippet": "就是水里加醋，加果汁，加果葡糖浆和蜂蜜和各种代糖，然后加食用的色素和香精，还打上"
    },
    {
      "sentence_id": "s20",
      "char_len": 34,
      "snippet": "你可以叫它醋酸版雪碧，也可以叫它打了气的浓酸脉动，或者说醋酸版大窑。"
    },
    {
      "sentence_id": "s21",
      "char_len": 20,
      "snippet": "图片截取自: 天地壹号，中年人最后的体面"
    },
    {
      "sentence_id": "s22",
      "char_len": 18,
      "snippet": "我本以为最大的醋饮公司应该是在山西。"
    },
    {
      "sentence_id": "s23",
      "char_len": 44,
      "snippet": "但仔细研究发现，山西的醋，镇江的醋都有区别，天地壹号的苹果醋，更像是西式醋本土化"
    },
    {
      "sentence_id": "s24",
      "char_len": 18,
      "snippet": "他们的区别，类似于刘谦和于谦的区别。"
    },
    {
      "sentence_id": "s25",
      "char_len": 10,
      "snippet": "一个魔术，一个魔幻。"
    },
    {
      "sentence_id": "s26",
      "char_len": 86,
      "snippet": "天地壹号诞生在广东，除了陈醋饮料，最大的单品是苹果醋，包装主要是两个规格，一种是"
    },
    {
      "sentence_id": "s27",
      "char_len": 53,
      "snippet": "其实挺合理的，因为销量规模小，罐子成本和运输成本都要比可口可乐高得多，但可乐才两"
    },
    {
      "sentence_id": "s28",
      "char_len": 40,
      "snippet": "天地壹号跟所有易拉罐汽水饮料面对的困境差不多，就是一句话，你怎么跟可口可乐去卷？"
    },
    {
      "sentence_id": "s29",
      "char_len": 56,
      "snippet": "诶，生命自己会寻找出路，这就要说起天地壹号的另一个规格，650ML的瓶装苹果醋，"
    },
    {
      "sentence_id": "s30",
      "char_len": 34,
      "snippet": "可乐看着它冲自己来的，没想到他一个转身往酒那去了，它可太baby啦。"
    },
    {
      "sentence_id": "s31",
      "char_len": 38,
      "snippet": "这好比说好要打拳击，它戴上拳套没有选择泰森，也没有选择泰罗，最后选择了泰迪。"
    },
    {
      "sentence_id": "s32",
      "char_len": 24,
      "snippet": "没开玩笑啊，如果你听它的名字，你会以为它是白酒。"
    },
    {
      "sentence_id": "s33",
      "char_len": 25,
      "snippet": "看它的包装，看它那个瓶子，你会以为这是一款葡萄酒。"
    },
    {
      "sentence_id": "s34",
      "char_len": 20,
      "snippet": "图片截取自: 天地壹号，中年人最后的体面"
    },
    {
      "sentence_id": "s35",
      "char_len": 20,
      "snippet": "图片截取自: 天地壹号，中年人最后的体面"
    },
    {
      "sentence_id": "s36",
      "char_len": 39,
      "snippet": "倒进杯里，你看这个绵密的气泡，还有这个特意用焦糖色调出来的颜色，你会以为是酒。"
    },
    {
      "sentence_id": "s37",
      "char_len": 20,
      "snippet": "图片截取自: 天地壹号，中年人最后的体面"
    },
    {
      "sentence_id": "s38",
      "char_len": 22,
      "snippet": "本以为是酒，没想到是醋，什么饮料界的小吕布。"
    },
    {
      "sentence_id": "s39",
      "char_len": 28,
      "snippet": "就这一瓶，卖十五，毛利率50%以上，甚至一度破了70%。"
    },
    {
      "sentence_id": "s40",
      "char_len": 78,
      "snippet": "你再看看它的营收状态，出现了明显的季节性特点，2019年，上半年7.6亿下半年1"
    },
    {
      "sentence_id": "s41",
      "char_len": 23,
      "snippet": "你说这是不是把酒骗上了炕，还把人家鞋给穿走了。"
    },
    {
      "sentence_id": "s42",
      "char_len": 24,
      "snippet": "再考虑醋是酒再进一步发酵出来的产品，你这是醋吗？"
    },
    {
      "sentence_id": "s43",
      "char_len": 14,
      "snippet": "你这是广东人独有的酸香科技。"
    },
    {
      "sentence_id": "s44",
      "char_len": 1,
      "snippet": "3"
    },
    {
      "sentence_id": "s45",
      "char_len": 16,
      "snippet": "那问题来了，为什么会有人送这个？"
    },
    {
      "sentence_id": "s46",
      "char_len": 7,
      "snippet": "因为它保健啊。"
    },
    {
      "sentence_id": "s47",
      "char_len": 95,
      "snippet": "广东人追求实用主义，以至于每个广东人都会在属于TA这个年纪里最恰当的功能性饮品："
    },
    {
      "sentence_id": "s48",
      "char_len": 27,
      "snippet": "迎面走来的可以是一个广东人，也可以是一辆四个圈的奥迪。"
    },
    {
      "sentence_id": "s49",
      "char_len": 34,
      "snippet": "那怎么样挣这一群把保健日常化，食品化的人的钱，还能把饮料做到高毛利？"
    },
    {
      "sentence_id": "s50",
      "char_len": 11,
      "snippet": "那就是把它变成保健品。"
    },
    {
      "sentence_id": "s51",
      "char_len": 55,
      "snippet": "很多买天地壹号的人可能都不信它有多保健，但内心却也希望它多吹吹牛逼，最好让所有人"
    },
    {
      "sentence_id": "s52",
      "char_len": 14,
      "snippet": "这样自己送的礼，也更有面子。"
    },
    {
      "sentence_id": "s53",
      "char_len": 18,
      "snippet": "这时你看看，天地壹号的地位就会很妙。"
    },
    {
      "sentence_id": "s54",
      "char_len": 51,
      "snippet": "你送饮品，不送AD钙奶是你成年了，不送老班章和飞天茅台是你要救钱包，送天地壹号刚"
    },
    {
      "sentence_id": "s55",
      "char_len": 63,
      "snippet": "它一个醋饮料叫这个霸气的名，你都怀疑它是不是万艾可的平替产品，或者说是生命一号的"
    },
    {
      "sentence_id": "s56",
      "char_len": 25,
      "snippet": "这就蕴藏了送礼人美好的祝愿：To be No.1。"
    },
    {
      "sentence_id": "s57",
      "char_len": 60,
      "snippet": "比这个名字更猛的叫百草一号，也是它们公司出的，但因为这个名字与饮品挂钩还是太残暴"
    },
    {
      "sentence_id": "s58",
      "char_len": 39,
      "snippet": "而醋，这是被很多人公认的降脂降压的东西，也给你省了时间科普，这到底是干嘛用的。"
    },
    {
      "sentence_id": "s59",
      "char_len": 10,
      "snippet": "最关键的是，还便宜。"
    },
    {
      "sentence_id": "s60",
      "char_len": 29,
      "snippet": "你把它当出醋卖，就它一瓶6%的食醋浓度，这简直是要抢钱啊。"
    },
    {
      "sentence_id": "s61",
      "char_len": 43,
      "snippet": "但现在它是保健品，装它的盒子本来该装人参鹿茸冬虫夏草的，那它的这个价格简直便宜到"
    },
    {
      "sentence_id": "s62",
      "char_len": 21,
      "snippet": "谢谢你，天地壹号，维持了我为数不多的体面。"
    },
    {
      "sentence_id": "s63",
      "char_len": 27,
      "snippet": "你本来不信它保健的，因为说透了它就是加了气的甜醋水嘛。"
    },
    {
      "sentence_id": "s64",
      "char_len": 73,
      "snippet": "但当你胃口小了，醋给你开胃，消化慢了，醋给你消食，吃辣了醋酸给你中和掉辣椒碱的辣"
    },
    {
      "sentence_id": "s65",
      "char_len": 18,
      "snippet": "再说透点，倒进杯子里，它跟酒差不多。"
    },
    {
      "sentence_id": "s66",
      "char_len": 21,
      "snippet": "本来该喝酒的，你喝了醋，你就说保不保健吧。"
    },
    {
      "sentence_id": "s67",
      "char_len": 34,
      "snippet": "天地壹号，喝的不是那股子醋和苹果汁中和起来的酸味儿，喝的是人情世故。"
    },
    {
      "sentence_id": "s68",
      "char_len": 39,
      "snippet": "很多中年人看到高启强卑躬屈膝去拿醋的时候，明明没在饭桌上，眼眶也开始酸了起来。"
    },
    {
      "sentence_id": "s69",
      "char_len": 10,
      "snippet": "别说了，都在醋里了。"
    },
    {
      "sentence_id": "s70",
      "char_len": 1,
      "snippet": "4"
    },
    {
      "sentence_id": "s71",
      "char_len": 53,
      "snippet": "单从数据上，可能很多人会觉得天地壹号很拉，差不多跟农夫山泉一起出道的，还出不了广"
    },
    {
      "sentence_id": "s72",
      "char_len": 27,
      "snippet": "这种观点，就像是嘲笑一个中年人为什么你没上财富榜一样。"
    },
    {
      "sentence_id": "s73",
      "char_len": 28,
      "snippet": "你说得很不错，但敢问阁下在哪里高就，又在哪处宝地发财啊？"
    },
    {
      "sentence_id": "s74",
      "char_len": 32,
      "snippet": "没经过社会毒打的话说得这么轻巧，想必阁下已经即将登陆三体星了吧。"
    },
    {
      "sentence_id": "s75",
      "char_len": 25,
      "snippet": "老师，快消品这个行业都不是卷，是旋风冲锋龙卷风了。"
    },
    {
      "sentence_id": "s76",
      "char_len": 30,
      "snippet": "消费者都喜新厌旧，逆水行舟，能够原地不退步，已经很了不起了。"
    },
    {
      "sentence_id": "s77",
      "char_len": 30,
      "snippet": "一款单品过百亿的饮料公司，也就是可口可乐、百事可乐以及红牛。"
    },
    {
      "sentence_id": "s78",
      "char_len": 39,
      "snippet": "统一果汁业务也才30亿，一个只在广东做出名气的醋饮单品能做到25亿还要怎么样？"
    },
    {
      "sentence_id": "s79",
      "char_len": 6,
      "snippet": "要叫我醋王。"
    },
    {
      "sentence_id": "s80",
      "char_len": 78,
      "snippet": "现在能靠着霸气的名字、广东人的特殊养生习惯以及常年无孔不入的广告营销，让热爱养生"
    },
    {
      "sentence_id": "s81",
      "char_len": 16,
      "snippet": "这已经很厉害，很厉害，很厉害了。"
    },
    {
      "sentence_id": "s82",
      "char_len": 19,
      "snippet": "我已经尽力卷了，可是极限，就在那里了。"
    },
    {
      "sentence_id": "s83",
      "char_len": 23,
      "snippet": "从这个角度来说，天地壹号就像它的目标用户一样。"
    },
    {
      "sentence_id": "s84",
      "char_len": 43,
      "snippet": "人到中年，有一技之长傍身，内心虽然仍然有熊熊烈火，连名字里都透露着年轻时的那股莽"
    },
    {
      "sentence_id": "s85",
      "char_len": 44,
      "snippet": "但知道自己已经不行了，被世界毒打的不行了，最后凭着一股中年人的狡黠，找到了自己的"
    },
    {
      "sentence_id": "s86",
      "char_len": 11,
      "snippet": "疲了，累了，冲不动了。"
    },
    {
      "sentence_id": "s87",
      "char_len": 13,
      "snippet": "只能在自己的舒适区里转悠。"
    },
    {
      "sentence_id": "s88",
      "char_len": 23,
      "snippet": "就像是拎着天地壹号醋饮去敲门的那个中年人一样。"
    },
    {
      "sentence_id": "s89",
      "char_len": 9,
      "snippet": "已经，很了不起了。"
    },
    {
      "sentence_id": "s90",
      "char_len": 7,
      "snippet": "都在，醋里了。"
    }
  ],
