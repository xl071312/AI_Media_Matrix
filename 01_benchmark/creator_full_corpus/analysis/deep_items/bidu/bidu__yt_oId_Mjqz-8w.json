  "sentences_index": [
    {
      "sentence_id": "s1",
      "char_len": 14,
      "snippet": "很多警区会在水时你摆一个罐子"
    },
    {
      "sentence_id": "s2",
      "char_len": 7,
      "snippet": "让你任意必许愿"
    },
    {
      "sentence_id": "s3",
      "char_len": 10,
      "snippet": "但应不得落点很难控制"
    },
    {
      "sentence_id": "s4",
      "char_len": 6,
      "snippet": "今天就教大家"
    },
    {
      "sentence_id": "s5",
      "char_len": 14,
      "snippet": "把你分支白白印幣扔进去的方法"
    },
    {
      "sentence_id": "s6",
      "char_len": 2,
      "snippet": "首先"
    },
    {
      "sentence_id": "s7",
      "char_len": 15,
      "snippet": "这种罐子并不在你看到的那个位置"
    },
    {
      "sentence_id": "s8",
      "char_len": 8,
      "snippet": "我们12元就知道"
    },
    {
      "sentence_id": "s9",
      "char_len": 6,
      "snippet": "水对光有车射"
    },
    {
      "sentence_id": "s10",
      "char_len": 11,
      "snippet": "所以底下罐子的实际位置"
    },
    {
      "sentence_id": "s11",
      "char_len": 9,
      "snippet": "会比你看到的近一些"
    },
    {
      "sentence_id": "s12",
      "char_len": 14,
      "snippet": "你扔的时候得往近一点的地方描"
    },
    {
      "sentence_id": "s13",
      "char_len": 7,
      "snippet": "其次你可能觉得"
    },
    {
      "sentence_id": "s14",
      "char_len": 7,
      "snippet": "印幣进水里之外"
    },
    {
      "sentence_id": "s15",
      "char_len": 5,
      "snippet": "继续向前出"
    },
    {
      "sentence_id": "s16",
      "char_len": 11,
      "snippet": "所以我一个打一颗提前料"
    },
    {
      "sentence_id": "s17",
      "char_len": 5,
      "snippet": "但其实不用"
    },
    {
      "sentence_id": "s18",
      "char_len": 6,
      "snippet": "水的阻力很大"
    },
    {
      "sentence_id": "s19",
      "char_len": 5,
      "snippet": "印幣一入水"
    },
    {
      "sentence_id": "s20",
      "char_len": 12,
      "snippet": "水平方向的速度就变成0了"
    },
    {
      "sentence_id": "s21",
      "char_len": 10,
      "snippet": "所以其实不管你怎么扔"
    },
    {
      "sentence_id": "s22",
      "char_len": 14,
      "snippet": "都和直接自由落体释放没啥去变"
    },
    {
      "sentence_id": "s23",
      "char_len": 15,
      "snippet": "你就努力往罐子上方的水面扔就行"
    },
    {
      "sentence_id": "s24",
      "char_len": 12,
      "snippet": "那印幣到了罐子上方的水面"
    },
    {
      "sentence_id": "s25",
      "char_len": 10,
      "snippet": "就会直接掉进罐子里吗"
    },
    {
      "sentence_id": "s26",
      "char_len": 4,
      "snippet": "不不不不"
    },
    {
      "sentence_id": "s27",
      "char_len": 6,
      "snippet": "没有那么简单"
    },
    {
      "sentence_id": "s28",
      "char_len": 5,
      "snippet": "印幣入水后"
    },
    {
      "sentence_id": "s29",
      "char_len": 9,
      "snippet": "并不会乖乖数值下落"
    },
    {
      "sentence_id": "s30",
      "char_len": 9,
      "snippet": "而是不由自主作用飞"
    },
    {
      "sentence_id": "s31",
      "char_len": 7,
      "snippet": "你不许看不清楚"
    },
    {
      "sentence_id": "s32",
      "char_len": 15,
      "snippet": "你许的愿望就这样被留提你学羞辱"
    },
    {
      "sentence_id": "s33",
      "char_len": 6,
      "snippet": "这要怎么办呢"
    },
    {
      "sentence_id": "s34",
      "char_len": 9,
      "snippet": "其实早在1853年"
    },
    {
      "sentence_id": "s35",
      "char_len": 12,
      "snippet": "麦克思伟就研究过这的问题"
    },
    {
      "sentence_id": "s36",
      "char_len": 2,
      "snippet": "没错"
    },
    {
      "sentence_id": "s37",
      "char_len": 10,
      "snippet": "就是那位电磁学组事业"
    },
    {
      "sentence_id": "s38",
      "char_len": 9,
      "snippet": "原来大牢也懂得学学"
    },
    {
      "sentence_id": "s39",
      "char_len": 12,
      "snippet": "这篇1997年的内车漏文"
    },
    {
      "sentence_id": "s40",
      "char_len": 18,
      "snippet": "把一堆小元 73 年度不同的业题里面"
    },
    {
      "sentence_id": "s41",
      "char_len": 9,
      "snippet": "扔出了四种运动形态"
    },
    {
      "sentence_id": "s42",
      "char_len": 6,
      "snippet": "分别是稳定型"
    },
    {
      "sentence_id": "s43",
      "char_len": 3,
      "snippet": "周七型"
    },
    {
      "sentence_id": "s44",
      "char_len": 3,
      "snippet": "随机型"
    },
    {
      "sentence_id": "s45",
      "char_len": 4,
      "snippet": "和翻滚型"
    },
    {
      "sentence_id": "s46",
      "char_len": 6,
      "snippet": "水的年度很小"
    },
    {
      "sentence_id": "s47",
      "char_len": 10,
      "snippet": "如果你许愿用意愿印幣"
    },
    {
      "sentence_id": "s48",
      "char_len": 10,
      "snippet": "那份的参数符合随机型"
    },
    {
      "sentence_id": "s49",
      "char_len": 7,
      "snippet": "意愿印幣付水后"
    },
    {
      "sentence_id": "s50",
      "char_len": 12,
      "snippet": "真就一定会向旁边随机飘走"
    },
    {
      "sentence_id": "s51",
      "char_len": 6,
      "snippet": "于是贪通描迟"
    },
    {
      "sentence_id": "s52",
      "char_len": 6,
      "snippet": "于是头部进去"
    },
    {
      "sentence_id": "s53",
      "char_len": 10,
      "snippet": "但亲自印幣的运动规矩"
    },
    {
      "sentence_id": "s54",
      "char_len": 5,
      "snippet": "符合周七型"
    },
    {
      "sentence_id": "s55",
      "char_len": 15,
      "snippet": "我当场掏出了小学二年纪的存千段"
    },
    {
      "sentence_id": "s56",
      "char_len": 13,
      "snippet": "找到了旅适的一毛钱和一分钱"
    },
    {
      "sentence_id": "s57",
      "char_len": 7,
      "snippet": "把他们人进水里"
    },
    {
      "sentence_id": "s58",
      "char_len": 9,
      "snippet": "印幣在水中作用飘荡"
    },
    {
      "sentence_id": "s59",
      "char_len": 12,
      "snippet": "爹爹壮壮去的落在罐子之上"
    },
    {
      "sentence_id": "s60",
      "char_len": 11,
      "snippet": "否俗泥物的运动也被点亮"
    },
    {
      "sentence_id": "s61",
      "char_len": 10,
      "snippet": "所以许愿不要用一块钱"
    },
    {
      "sentence_id": "s62",
      "char_len": 7,
      "snippet": "它会随机飘走的"
    },
    {
      "sentence_id": "s63",
      "char_len": 12,
      "snippet": "用旅质的一毛和一分钱许愿"
    },
    {
      "sentence_id": "s64",
      "char_len": 11,
      "snippet": "才更有可能跳进罐子里面"
    },
    {
      "sentence_id": "s65",
      "char_len": 8,
      "snippet": "希望管实质的神仙"
    },
    {
      "sentence_id": "s66",
      "char_len": 6,
      "snippet": "别嫌轻易分家"
    },
    {
      "sentence_id": "s67",
      "char_len": 17,
      "snippet": "但你要是觉得旅应幣的存东力还不足着"
    },
    {
      "sentence_id": "s68",
      "char_len": 7,
      "snippet": "我这儿还有三招"
    },
    {
      "sentence_id": "s69",
      "char_len": 3,
      "snippet": "第一招"
    },
    {
      "sentence_id": "s70",
      "char_len": 5,
      "snippet": "力大专飞流"
    },
    {
      "sentence_id": "s71",
      "char_len": 11,
      "snippet": "只要把一对印幣绑在一起"
    },
    {
      "sentence_id": "s72",
      "char_len": 9,
      "snippet": "这玩意儿比十多还重"
    },
    {
      "sentence_id": "s73",
      "char_len": 13,
      "snippet": "谁的小小姐弟根本组织不了他"
    },
    {
      "sentence_id": "s74",
      "char_len": 8,
      "snippet": "人进罐子亲玩意局"
    },
    {
      "sentence_id": "s75",
      "char_len": 3,
      "snippet": "第二招"
    },
    {
      "sentence_id": "s76",
      "char_len": 5,
      "snippet": "你撒幣把流"
    },
    {
      "sentence_id": "s77",
      "char_len": 9,
      "snippet": "如果你觉得绑在一起"
    },
    {
      "sentence_id": "s78",
      "char_len": 7,
      "snippet": "人外的就推大了"
    },
    {
      "sentence_id": "s79",
      "char_len": 10,
      "snippet": "那我推荐你把这对印幣"
    },
    {
      "sentence_id": "s80",
      "char_len": 8,
      "snippet": "直接撒进实质里面"
    },
    {
      "sentence_id": "s81",
      "char_len": 11,
      "snippet": "只要不是倒霉的人身部分"
    },
    {
      "sentence_id": "s82",
      "char_len": 12,
      "snippet": "总能有几个印幣落进罐子吧"
    },
    {
      "sentence_id": "s83",
      "char_len": 3,
      "snippet": "第三招"
    },
    {
      "sentence_id": "s84",
      "char_len": 5,
      "snippet": "中东土豪流"
    },
    {
      "sentence_id": "s85",
      "char_len": 15,
      "snippet": "其实只要吃自己的烈体原子足够大"
    },
    {
      "sentence_id": "s86",
      "char_len": 14,
      "snippet": "印幣就能撕滑又稳定的数值落下"
    },
    {
      "sentence_id": "s87",
      "char_len": 8,
      "snippet": "那什么也提慢租呢"
    },
    {
      "sentence_id": "s88",
      "char_len": 2,
      "snippet": "没错"
    },
    {
      "sentence_id": "s89",
      "char_len": 2,
      "snippet": "石油"
    },
    {
      "sentence_id": "s90",
      "char_len": 8,
      "snippet": "游几亿也是许愿进"
    },
    {
      "sentence_id": "s91",
      "char_len": 13,
      "snippet": "我看中东球长的许愿都挺好的"
    },
    {
      "sentence_id": "s92",
      "char_len": 11,
      "snippet": "欢迎家里有游景的朋友们"
    },
    {
      "sentence_id": "s93",
      "char_len": 4,
      "snippet": "也是也是"
    },
    {
      "sentence_id": "s94",
      "char_len": 10,
      "snippet": "我猜猜这些鸣子流不灵"
    }
