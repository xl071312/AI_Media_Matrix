  "sentences_index": [
    {
      "sentence_id": "s1",
      "char_len": 10,
      "snippet": "有很多粉丝朋友爱着我"
    },
    {
      "sentence_id": "s2",
      "char_len": 17,
      "snippet": "让我分析一下小潮院长视频的这个游戏"
    },
    {
      "sentence_id": "s3",
      "char_len": 12,
      "snippet": "这个游戏是比谁的旦更硬啊"
    },
    {
      "sentence_id": "s4",
      "char_len": 7,
      "snippet": "这话怎么这么怪"
    },
    {
      "sentence_id": "s5",
      "char_len": 6,
      "snippet": "规则呢很简单"
    },
    {
      "sentence_id": "s6",
      "char_len": 12,
      "snippet": "两个人各拿一个熟悉旦对撞"
    },
    {
      "sentence_id": "s7",
      "char_len": 6,
      "snippet": "旦碎的一方书"
    },
    {
      "sentence_id": "s8",
      "char_len": 11,
      "snippet": "诈一看这个游戏纯平密切"
    },
    {
      "sentence_id": "s9",
      "char_len": 12,
      "snippet": "但碎了急需的旦之后我发现"
    },
    {
      "sentence_id": "s10",
      "char_len": 8,
      "snippet": "这晚的入科学策略"
    },
    {
      "sentence_id": "s11",
      "char_len": 6,
      "snippet": "看完我的视频"
    },
    {
      "sentence_id": "s12",
      "char_len": 11,
      "snippet": "保你把所有人的旦动撞碎"
    },
    {
      "sentence_id": "s13",
      "char_len": 12,
      "snippet": "小潮他们在提出一些撞旦丝"
    },
    {
      "sentence_id": "s14",
      "char_len": 7,
      "snippet": "我们来分析一下"
    },
    {
      "sentence_id": "s15",
      "char_len": 5,
      "snippet": "阿嬷作人为"
    },
    {
      "sentence_id": "s16",
      "char_len": 11,
      "snippet": "把旦泡在冷血里热帐冷缩"
    },
    {
      "sentence_id": "s17",
      "char_len": 11,
      "snippet": "但密度会变大就变得更硬"
    },
    {
      "sentence_id": "s18",
      "char_len": 7,
      "snippet": "大家觉得这堆吗"
    },
    {
      "sentence_id": "s19",
      "char_len": 13,
      "snippet": "我查到一篇1973年的论文"
    },
    {
      "sentence_id": "s20",
      "char_len": 9,
      "snippet": "策了720个诞发现"
    },
    {
      "sentence_id": "s21",
      "char_len": 4,
      "snippet": "温度越低"
    },
    {
      "sentence_id": "s22",
      "char_len": 6,
      "snippet": "但可强度越大"
    },
    {
      "sentence_id": "s23",
      "char_len": 8,
      "snippet": "所以阿嬷作是对的"
    },
    {
      "sentence_id": "s24",
      "char_len": 5,
      "snippet": "纵老师捐网"
    },
    {
      "sentence_id": "s25",
      "char_len": 11,
      "snippet": "玩游戏前还偷脱血论文呢"
    },
    {
      "sentence_id": "s26",
      "char_len": 8,
      "snippet": "小潮也提立了策略"
    },
    {
      "sentence_id": "s27",
      "char_len": 9,
      "snippet": "说颜色越深的弹越硬"
    },
    {
      "sentence_id": "s28",
      "char_len": 7,
      "snippet": "黑弹就比白弹硬"
    },
    {
      "sentence_id": "s29",
      "char_len": 6,
      "snippet": "大佳节的对吗"
    },
    {
      "sentence_id": "s30",
      "char_len": 13,
      "snippet": "我查到一篇1974年的论文"
    },
    {
      "sentence_id": "s31",
      "char_len": 13,
      "snippet": "发现深色的虽然弹可比白弹薄"
    },
    {
      "sentence_id": "s32",
      "char_len": 7,
      "snippet": "但强度比白弹大"
    },
    {
      "sentence_id": "s33",
      "char_len": 9,
      "snippet": "所以小潮也也是对的"
    },
    {
      "sentence_id": "s34",
      "char_len": 5,
      "snippet": "看老师捐网"
    },
    {
      "sentence_id": "s35",
      "char_len": 11,
      "snippet": "玩游戏前还偷脱血论文呢"
    },
    {
      "sentence_id": "s36",
      "char_len": 9,
      "snippet": "小澳提出的挑弹技巧"
    },
    {
      "sentence_id": "s37",
      "char_len": 8,
      "snippet": "说小弹比大弹接应"
    },
    {
      "sentence_id": "s38",
      "char_len": 6,
      "snippet": "大家觉得对吗"
    },
    {
      "sentence_id": "s39",
      "char_len": 13,
      "snippet": "我查到一篇1977年的论文"
    },
    {
      "sentence_id": "s40",
      "char_len": 9,
      "snippet": "策略100多弹发现"
    },
    {
      "sentence_id": "s41",
      "char_len": 8,
      "snippet": "小弹弹可强度更大"
    },
    {
      "sentence_id": "s42",
      "char_len": 9,
      "snippet": "所以小澳一也是对的"
    },
    {
      "sentence_id": "s43",
      "char_len": 5,
      "snippet": "傲老师捐网"
    },
    {
      "sentence_id": "s44",
      "char_len": 11,
      "snippet": "玩游戏前还偷脱血论文呢"
    },
    {
      "sentence_id": "s45",
      "char_len": 5,
      "snippet": "小澳还提出"
    },
    {
      "sentence_id": "s46",
      "char_len": 12,
      "snippet": "动的弹比进食的弹更容易碎"
    },
    {
      "sentence_id": "s47",
      "char_len": 6,
      "snippet": "大家觉得对吗"
    },
    {
      "sentence_id": "s48",
      "char_len": 9,
      "snippet": "这个我没有查到论文"
    },
    {
      "sentence_id": "s49",
      "char_len": 12,
      "snippet": "但我自己实验了十几次发现"
    },
    {
      "sentence_id": "s50",
      "char_len": 9,
      "snippet": "好像是动弹更容易碎"
    },
    {
      "sentence_id": "s51",
      "char_len": 5,
      "snippet": "我强行解释"
    },
    {
      "sentence_id": "s52",
      "char_len": 10,
      "snippet": "近弹往背手包着等在哪"
    },
    {
      "sentence_id": "s53",
      "char_len": 15,
      "snippet": "手掌推给近弹起到一个画劲的作用"
    },
    {
      "sentence_id": "s54",
      "char_len": 14,
      "snippet": "动弹往往是急着收紧拿出往前撞"
    },
    {
      "sentence_id": "s55",
      "char_len": 8,
      "snippet": "没有画劲就容易碎"
    },
    {
      "sentence_id": "s56",
      "char_len": 4,
      "snippet": "总结一下"
    },
    {
      "sentence_id": "s57",
      "char_len": 6,
      "snippet": "小弹比大弹好"
    },
    {
      "sentence_id": "s58",
      "char_len": 6,
      "snippet": "深弹比白弹好"
    },
    {
      "sentence_id": "s59",
      "char_len": 6,
      "snippet": "近弹比动弹好"
    },
    {
      "sentence_id": "s60",
      "char_len": 6,
      "snippet": "冰弹比热弹好"
    },
    {
      "sentence_id": "s61",
      "char_len": 9,
      "snippet": "总之小身近冰弹最好"
    },
    {
      "sentence_id": "s62",
      "char_len": 12,
      "snippet": "我自己还想有很扯弹的方法"
    },
    {
      "sentence_id": "s63",
      "char_len": 13,
      "snippet": "大家应该听过这个卢博特之类"
    },
    {
      "sentence_id": "s64",
      "char_len": 10,
      "snippet": "把融化的玻璃低入水中"
    },
    {
      "sentence_id": "s65",
      "char_len": 8,
      "snippet": "就会变得非常尖艺"
    },
    {
      "sentence_id": "s66",
      "char_len": 10,
      "snippet": "锤子杂艳艳鸡鸭都没事"
    },
    {
      "sentence_id": "s67",
      "char_len": 11,
      "snippet": "这是因为卢博特之类表面"
    },
    {
      "sentence_id": "s68",
      "char_len": 12,
      "snippet": "有很大的压印力上它很尖艺"
    },
    {
      "sentence_id": "s69",
      "char_len": 7,
      "snippet": "我用力捏这个弹"
    },
    {
      "sentence_id": "s70",
      "char_len": 11,
      "snippet": "弹可受到挤压产生压印力"
    },
    {
      "sentence_id": "s71",
      "char_len": 12,
      "snippet": "是不是能得到一个强化霸佛"
    },
    {
      "sentence_id": "s72",
      "char_len": 8,
      "snippet": "成为颗卢博特之弹"
    },
    {
      "sentence_id": "s73",
      "char_len": 7,
      "snippet": "我们来实验一下"
    },
    {
      "sentence_id": "s74",
      "char_len": 1,
      "snippet": "好"
    },
    {
      "sentence_id": "s75",
      "char_len": 9,
      "snippet": "现在我用力捏这个弹"
    },
    {
      "sentence_id": "s76",
      "char_len": 2,
      "snippet": "来吧"
    },
    {
      "sentence_id": "s77",
      "char_len": 5,
      "snippet": "1 2 3"
    },
    {
      "sentence_id": "s78",
      "char_len": 4,
      "snippet": "4剩两败"
    },
    {
      "sentence_id": "s79",
      "char_len": 14,
      "snippet": "说不定这个炉弹法真的有点用逐"
    },
    {
      "sentence_id": "s80",
      "char_len": 18,
      "snippet": "建议观众开展详细的研究发片paper"
    },
    {
      "sentence_id": "s81",
      "char_len": 12,
      "snippet": "我还有一种已如特钢的死路"
    },
    {
      "sentence_id": "s82",
      "char_len": 8,
      "snippet": "把鸡弹用速泡一夜"
    },
    {
      "sentence_id": "s83",
      "char_len": 9,
      "snippet": "它就会变成一个软弹"
    },
    {
      "sentence_id": "s84",
      "char_len": 8,
      "snippet": "软弹弹团非常柔韧"
    },
    {
      "sentence_id": "s85",
      "char_len": 9,
      "snippet": "虽然不可能撞破硬弹"
    },
    {
      "sentence_id": "s86",
      "char_len": 9,
      "snippet": "但自己也永远会回复"
    },
    {
      "sentence_id": "s87",
      "char_len": 7,
      "snippet": "我们软弹赢不了"
    },
    {
      "sentence_id": "s88",
      "char_len": 5,
      "snippet": "但也不会输"
    },
    {
      "sentence_id": "s89",
      "char_len": 12,
      "snippet": "就等硬弹受不了自己的口小"
    },
    {
      "sentence_id": "s90",
      "char_len": 10,
      "snippet": "这就是软弹的生存智慧"
    },
    {
      "sentence_id": "s91",
      "char_len": 13,
      "snippet": "如何用科学让你的弹更加强大"
    },
    {
      "sentence_id": "s92",
      "char_len": 5,
      "snippet": "你学会了吗"
    },
    {
      "sentence_id": "s93",
      "char_len": 10,
      "snippet": "不要走开后面还有彩弹"
    },
    {
      "sentence_id": "s94",
      "char_len": 7,
      "snippet": "还要吃好几天呢"
    }
