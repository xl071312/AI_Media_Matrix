    {
      "sentence_id": "s1",
      "char_len": 14,
      "snippet": "小时候我听过任剧言叫屋丫喝水"
    },
    {
      "sentence_id": "s2",
      "char_len": 9,
      "snippet": "从没到没到屏子里面"
    },
    {
      "sentence_id": "s3",
      "char_len": 8,
      "snippet": "水面上升和到水了"
    },
    {
      "sentence_id": "s4",
      "char_len": 14,
      "snippet": "这个故事从小学教会我一个道理"
    },
    {
      "sentence_id": "s5",
      "char_len": 7,
      "snippet": "做人就要多喝水"
    },
    {
      "sentence_id": "s6",
      "char_len": 11,
      "snippet": "然而最近我的信仰崩塌了"
    },
    {
      "sentence_id": "s7",
      "char_len": 16,
      "snippet": "因为我发现屋丫其实根本就和不到水"
    },
    {
      "sentence_id": "s8",
      "char_len": 7,
      "snippet": "我们在做个实验"
    },
    {
      "sentence_id": "s9",
      "char_len": 14,
      "snippet": "医所预言里并没有说屏子的外形"
    },
    {
      "sentence_id": "s10",
      "char_len": 9,
      "snippet": "我随便找了几个屏子"
    },
    {
      "sentence_id": "s11",
      "char_len": 4,
      "snippet": "放一点水"
    },
    {
      "sentence_id": "s12",
      "char_len": 8,
      "snippet": "记住你是一只屋丫"
    },
    {
      "sentence_id": "s13",
      "char_len": 6,
      "snippet": "你是没有手的"
    },
    {
      "sentence_id": "s14",
      "char_len": 14,
      "snippet": "你只能用嘴巴是特地凋进屏子里"
    },
    {
      "sentence_id": "s15",
      "char_len": 6,
      "snippet": "我们再试一下"
    },
    {
      "sentence_id": "s16",
      "char_len": 3,
      "snippet": "水呢?"
    },
    {
      "sentence_id": "s17",
      "char_len": 4,
      "snippet": "坑压呢?"
    },
    {
      "sentence_id": "s18",
