  "sentences_index": [
    {
      "sentence_id": "s1",
      "char_len": 14,
      "snippet": "李清紅就更能變色的王者出現了"
    },
    {
      "sentence_id": "s2",
      "char_len": 13,
      "snippet": "這福尼究竟是黃色才是綠色呀"
    },
    {
      "sentence_id": "s3",
      "char_len": 16,
      "snippet": "前段時間我做了七千萬國防的視頻呀"
    },
    {
      "sentence_id": "s4",
      "char_len": 8,
      "snippet": "說福尼有種清紅就"
    },
    {
      "sentence_id": "s5",
      "char_len": 8,
      "snippet": "彈子裡看著是綠色"
    },
    {
      "sentence_id": "s6",
      "char_len": 8,
      "snippet": "要出來會瞬間變紅"
    },
    {
      "sentence_id": "s7",
      "char_len": 17,
      "snippet": "這部頻度區風中小江曬出了正式的東西"
    },
    {
      "sentence_id": "s8",
      "char_len": 5,
      "snippet": "叫五倍子录"
    },
    {
      "sentence_id": "s9",
      "char_len": 8,
      "snippet": "它在風潮裡時綠色"
    },
    {
      "sentence_id": "s10",
      "char_len": 10,
      "snippet": "取到瓶子裡就變黃色了"
    },
    {
      "sentence_id": "s11",
      "char_len": 13,
      "snippet": "裝到黑色斷子裡用變成綠色了"
    },
    {
      "sentence_id": "s12",
      "char_len": 9,
      "snippet": "五倍子密聽著就霸氣"
    },
    {
      "sentence_id": "s13",
      "char_len": 8,
      "snippet": "五子細瓜是三倍體"
    },
    {
      "sentence_id": "s14",
      "char_len": 6,
      "snippet": "出道有四倍體"
    },
    {
      "sentence_id": "s15",
      "char_len": 6,
      "snippet": "而五倍子密呢"
    },
    {
      "sentence_id": "s16",
      "char_len": 10,
      "snippet": "可是霸王情怪是也沒有"
    },
    {
      "sentence_id": "s17",
      "char_len": 7,
      "snippet": "它是春五倍子樹"
    },
    {
      "sentence_id": "s18",
      "char_len": 10,
      "snippet": "學名叫清富陽所產的密"
    },
    {
      "sentence_id": "s19",
      "char_len": 5,
      "snippet": "是一種陽力"
    },
    {
      "sentence_id": "s20",
      "char_len": 4,
      "snippet": "小江說呢"
    },
    {
      "sentence_id": "s21",
      "char_len": 16,
      "snippet": "五倍子密的黃綠變色還是未解知密呀"
    },
    {
      "sentence_id": "s22",
      "char_len": 3,
      "snippet": "氣好滑"
    },
    {
      "sentence_id": "s23",
      "char_len": 10,
      "snippet": "一個封密我的真不明白"
    },
    {
      "sentence_id": "s24",
      "char_len": 7,
      "snippet": "我還背心故意嗎"
    },
    {
      "sentence_id": "s25",
      "char_len": 4,
      "snippet": "做實驗呀"
    },
    {
      "sentence_id": "s26",
      "char_len": 6,
      "snippet": "我們先看一下"
    },
    {
      "sentence_id": "s27",
      "char_len": 7,
      "snippet": "它是怎麼變色的"
    },
    {
      "sentence_id": "s28",
      "char_len": 10,
      "snippet": "它就是熟悉的黃色而已"
    },
    {
      "sentence_id": "s29",
      "char_len": 12,
      "snippet": "但黑冠子裡的密就有點黃綠"
    },
    {
      "sentence_id": "s30",
      "char_len": 5,
      "snippet": "照一個白光"
    },
    {
      "sentence_id": "s31",
      "char_len": 10,
      "snippet": "這綠油有看得我心發慌"
    },
    {
      "sentence_id": "s32",
      "char_len": 9,
      "snippet": "放下白光將藍光舉起"
    },
    {
      "sentence_id": "s33",
      "char_len": 12,
      "snippet": "這銀光綠都會看得都像超底"
    },
    {
      "sentence_id": "s34",
      "char_len": 4,
      "snippet": "一種大三"
    },
    {
      "sentence_id": "s35",
      "char_len": 18,
      "snippet": "這麼看來五倍子密和清紅酒變色原理一樣"
    },
    {
      "sentence_id": "s36",
      "char_len": 9,
      "snippet": "它裡面還有銀光物質"
    },
    {
      "sentence_id": "s37",
      "char_len": 11,
      "snippet": "會吸收白光中的藍光成色"
    },
    {
      "sentence_id": "s38",
      "char_len": 6,
      "snippet": "發出綠色銀光"
    },
    {
      "sentence_id": "s39",
      "char_len": 4,
      "snippet": "白彎裡呢"
    },
    {
      "sentence_id": "s40",
      "char_len": 7,
      "snippet": "碗幣反射比較強"
    },
    {
      "sentence_id": "s41",
      "char_len": 10,
      "snippet": "看得到更多是本色的黃"
    },
    {
      "sentence_id": "s42",
      "char_len": 8,
      "snippet": "黑冠子幾乎不反射"
    },
    {
      "sentence_id": "s43",
      "char_len": 8,
      "snippet": "本色的黃色被削弱"
    },
    {
      "sentence_id": "s44",
      "char_len": 9,
      "snippet": "銀光的綠色就更清澈"
    },
    {
      "sentence_id": "s45",
      "char_len": 7,
      "snippet": "有的關註要說了"
    },
    {
      "sentence_id": "s46",
      "char_len": 12,
      "snippet": "這封密裡貼這樣的銀光物質"
    },
    {
      "sentence_id": "s47",
      "char_len": 4,
      "snippet": "還能喝嗎"
    },
    {
      "sentence_id": "s48",
      "char_len": 4,
      "snippet": "不要 黃"
    },
    {
      "sentence_id": "s49",
      "char_len": 10,
      "snippet": "發綠光的東西在生活中"
    },
    {
      "sentence_id": "s50",
      "char_len": 7,
      "snippet": "還是挺多的對吧"
    },
    {
