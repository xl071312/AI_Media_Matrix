      "char_len": 9,
      "snippet": "還要被氧氣氧化回來"
    },
    {
      "sentence_id": "s67",
      "char_len": 6,
      "snippet": "銀光重新出現"
    },
    {
      "sentence_id": "s68",
      "char_len": 7,
      "snippet": "歡迎大師彈幕上"
    },
    {
      "sentence_id": "s69",
