      "snippet": "最常見的是維生素B2"
    },
    {
      "sentence_id": "s52",
      "char_len": 7,
      "snippet": "探望學歷加一點"
    },
    {
      "sentence_id": "s53",
      "char_len": 13,
      "snippet": "光照就能看到明顯的綠色銀光"
    },
    {
      "sentence_id": "s54",
      "char_len": 13,
      "snippet": "五倍子密裡會不會就是有類似"
    },
    {
      "sentence_id": "s55",
      "char_len": 9,
      "snippet": "維生素B2的物質呢"
    },
    {
      "sentence_id": "s56",
      "char_len": 16,
      "snippet": "誒 檢驗維生素B有一個冷門圖方法"
    },
    {
      "sentence_id": "s57",
      "char_len": 8,
      "snippet": "我們湊盡自信關場"
    },
    {
      "sentence_id": "s58",
      "char_len": 4,
      "snippet": "你會發現"
    },
    {
      "sentence_id": "s59",
      "char_len": 8,
      "snippet": "維生素B2分子上"
    },
    {
      "sentence_id": "s60",
      "char_len": 15,
      "snippet": "有著藝衲樂情三環顧合大派建體系"
    },
    {
      "sentence_id": "s61",
      "char_len": 5,
      "snippet": "在發出銀光"
    },
    {
      "sentence_id": "s62",
      "char_len": 12,
      "snippet": "而連二亞流孫納俗稱保險粉"
    },
    {
      "sentence_id": "s63",
      "char_len": 10,
      "snippet": "可以將藝衛情三環加期"
    },
    {
      "sentence_id": "s64",
