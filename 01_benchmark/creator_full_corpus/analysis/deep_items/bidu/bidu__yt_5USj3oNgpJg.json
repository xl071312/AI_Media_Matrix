  "sentences_index": [
    {
      "sentence_id": "s1",
      "char_len": 21,
      "snippet": "你怎麼知道宇宙的年齡的你算過他生存八字嗎?"
    },
    {
      "sentence_id": "s2",
      "char_len": 21,
      "snippet": "其實宇宙年齡可以輕鬆算出來一個公式就能搞定"
    },
    {
      "sentence_id": "s3",
      "char_len": 26,
      "snippet": "我們的宇宙在不停的膨脹這最早是哈勃在1929年發現的"
    },
    {
      "sentence_id": "s4",
      "char_len": 14,
      "snippet": "對 就是哈勃共演進了一個哈勃"
    },
    {
      "sentence_id": "s5",
      "char_len": 23,
      "snippet": "如果新鮮們只是在一周固定大小的宇宙裡面各自運動"
    },
    {
      "sentence_id": "s6",
      "char_len": 17,
      "snippet": "他们应该会有些靠近我们有些远离我们"
    },
    {
      "sentence_id": "s7",
      "char_len": 18,
      "snippet": "但哈伯发现几乎所有的星系都在远离我们"
    },
    {
      "sentence_id": "s8",
      "char_len": 11,
      "snippet": "而且距离我们越远的星系"
    },
    {
      "sentence_id": "s9",
      "char_len": 10,
      "snippet": "远离我们的速度就越快"
    },
    {
      "sentence_id": "s10",
      "char_len": 17,
      "snippet": "星系远离的速度还和到我们的距离成正"
    },
    {
      "sentence_id": "s11",
      "char_len": 11,
      "snippet": "这只规律就叫做哈伯定律"
    },
    {
      "sentence_id": "s12",
      "char_len": 9,
      "snippet": "这比例就叫哈伯常数"
    },
    {
      "sentence_id": "s13",
      "char_len": 15,
      "snippet": "宇宙的横帐有点像这张皮精被拉长"
    },
    {
      "sentence_id": "s14",
      "char_len": 18,
      "snippet": "这时我的左手和两只骂长都觉得自己没动"
    },
    {
      "sentence_id": "s15",
      "char_len": 14,
      "snippet": "但他们还是会觉得比此越来越远"
    },
    {
      "sentence_id": "s16",
      "char_len": 9,
      "snippet": "而且在我的左手上来"
    },
    {
      "sentence_id": "s17",
      "char_len": 17,
      "snippet": "离左手远的骂长比近的骂长远离得更快"
    },
    {
      "sentence_id": "s18",
      "char_len": 13,
      "snippet": "把皮精被拉长都过程到放一下"
    },
    {
      "sentence_id": "s19",
      "char_len": 8,
      "snippet": "自然就能往回追俗"
    },
    {
      "sentence_id": "s20",
      "char_len": 7,
      "snippet": "它被拉长的多久"
    },
    {
      "sentence_id": "s21",
      "char_len": 9,
      "snippet": "酸宇宙的连离也一样"
    },
    {
      "sentence_id": "s22",
      "char_len": 23,
      "snippet": "只要从星系的距离和速度到推宇宙横帐的多久就行了"
    },
    {
      "sentence_id": "s23",
      "char_len": 18,
      "snippet": "最简单的假设是哈伯常数不变的余速横帐"
    },
    {
      "sentence_id": "s24",
      "char_len": 13,
      "snippet": "这种余速可能和你想不太一样"
    },
    {
      "sentence_id": "s25",
      "char_len": 15,
      "snippet": "其实我右手拉皮精的速会越来越快"
    },
    {
      "sentence_id": "s26",
      "char_len": 11,
      "snippet": "比如一开始皮精是1厘米"
    },
    {
      "sentence_id": "s27",
      "char_len": 9,
      "snippet": "1秒周后变成2厘米"
    },
    {
      "sentence_id": "s28",
      "char_len": 10,
      "snippet": "2秒周后它就是4厘米"
    },
    {
      "sentence_id": "s29",
      "char_len": 8,
      "snippet": "3秒钟就是8厘米"
    },
    {
      "sentence_id": "s30",
      "char_len": 12,
      "snippet": "这个余速指的是横帐率不变"
    },
    {
      "sentence_id": "s31",
      "char_len": 14,
      "snippet": "这一位传信息离我们越远的时候"
    },
    {
      "sentence_id": "s32",
      "char_len": 8,
      "snippet": "离开我们宿度越快"
    },
    {
      "sentence_id": "s33",
      "char_len": 15,
      "snippet": "所以距离成正义的技术恰好能消掉"
    },
    {
      "sentence_id": "s34",
      "char_len": 6,
      "snippet": "在这种条件下"
    },
    {
      "sentence_id": "s35",
      "char_len": 16,
      "snippet": "余周的连离就越等于哈伯常数的道数"
    },
    {
      "sentence_id": "s36",
      "char_len": 13,
      "snippet": "哈伯常数大展是67000米"
    },
    {
      "sentence_id": "s37",
      "char_len": 6,
      "snippet": "每秒每MPC"
    },
    {
      "sentence_id": "s38",
      "char_len": 12,
      "snippet": "MPC是个很大的距离单位"
    },
    {
      "sentence_id": "s39",
      "char_len": 9,
      "snippet": "越等于300万光年"
    },
    {
      "sentence_id": "s40",
      "char_len": 15,
      "snippet": "现在离咱们一MPC那么远的东西"
    },
    {
      "sentence_id": "s41",
      "char_len": 16,
      "snippet": "远离我们的速度是67000米每秒"
    },
    {
      "sentence_id": "s42",
      "char_len": 4,
      "snippet": "这么一算"
    },
    {
      "sentence_id": "s43",
      "char_len": 13,
      "snippet": "余周的连离大展是144厘米"
    },
    {
      "sentence_id": "s44",
      "char_len": 7,
      "snippet": "竟然还挺准确的"
    },
    {
      "sentence_id": "s45",
      "char_len": 11,
      "snippet": "不过这咋还有一点误差呢"
    },
    {
      "sentence_id": "s46",
      "char_len": 15,
      "snippet": "因为哈伯常数其实是个时间的寒数"
    },
    {
      "sentence_id": "s47",
      "char_len": 13,
      "snippet": "虽然在余周里所有地方都一样"
    },
    {
      "sentence_id": "s48",
      "char_len": 13,
      "snippet": "但他会随于余周的眼花而变化"
    },
    {
      "sentence_id": "s49",
      "char_len": 12,
      "snippet": "所以这世子要做一点点修改"
    },
    {
      "sentence_id": "s50",
      "char_len": 7,
      "snippet": "这个机分长这样"
    },
    {
      "sentence_id": "s51",
      "char_len": 20,
      "snippet": "被前面的算出来的余周年龄成了一个修正系数"
    },
    {
      "sentence_id": "s52",
      "char_len": 9,
      "snippet": "大约是0.9565"
    },
    {
      "sentence_id": "s53",
      "char_len": 15,
      "snippet": "成一下就得到了138亿岁的结果"
    },
    {
      "sentence_id": "s54",
      "char_len": 17,
      "snippet": "算余周的年龄是不是一小不到的简单呢"
    },
    {
      "sentence_id": "s55",
      "char_len": 12,
      "snippet": "如果只是算着余周年龄的话"
    },
    {
      "sentence_id": "s56",
      "char_len": 8,
      "snippet": "其实没什么大不了"
    },
    {
      "sentence_id": "s57",
      "char_len": 8,
      "snippet": "真正地我今天的事"
    },
    {
      "sentence_id": "s58",
      "char_len": 12,
      "snippet": "余周在138亿年前的生日"
    },
    {
      "sentence_id": "s59",
      "char_len": 9,
      "snippet": "竟然是可以会计算的"
    },
    {
      "sentence_id": "s60",
      "char_len": 13,
      "snippet": "占余周总质量26%的案物质"
    },
    {
      "sentence_id": "s61",
      "char_len": 7,
      "snippet": "69%的案能量"
    },
    {
      "sentence_id": "s62",
      "char_len": 13,
      "snippet": "我们人类对他们几乎一无所需"
    },
    {
      "sentence_id": "s63",
      "char_len": 12,
      "snippet": "然而天文学家就像真太一样"
    },
    {
      "sentence_id": "s64",
      "char_len": 12,
      "snippet": "在各种天文学现象的细节中"
    },
    {
      "sentence_id": "s65",
      "char_len": 5,
      "snippet": "找到了线索"
    },
    {
      "sentence_id": "s66",
      "char_len": 13,
      "snippet": "真的推算出了他们的质量占比"
    },
    {
      "sentence_id": "s67",
      "char_len": 9,
      "snippet": "让我们即便困于地球"
    },
    {
      "sentence_id": "s68",
      "char_len": 10,
      "snippet": "也能推演出宇宙的过去"
    },
    {
      "sentence_id": "s69",
      "char_len": 5,
      "snippet": "现在和未来"
    },
    {
      "sentence_id": "s70",
      "char_len": 10,
      "snippet": "最牢的人只能回忆百年"
    },
    {
      "sentence_id": "s71",
      "char_len": 6,
      "snippet": "一直千年网吧"
    },
    {
      "sentence_id": "s72",
      "char_len": 9,
      "snippet": "制多见过宋明的光级"
    },
    {
      "sentence_id": "s73",
      "char_len": 15,
      "snippet": "埋余地下的时辈或许能流存百万年"
    },
    {
      "sentence_id": "s74",
      "char_len": 13,
      "snippet": "而你的思维却不受时中的限制"
    },
    {
      "sentence_id": "s75",
      "char_len": 8,
      "snippet": "持成在整个宇宙中"
    },
    {
      "sentence_id": "s76",
      "char_len": 11,
      "snippet": "大概这才是我描述的人类"
    },
    {
