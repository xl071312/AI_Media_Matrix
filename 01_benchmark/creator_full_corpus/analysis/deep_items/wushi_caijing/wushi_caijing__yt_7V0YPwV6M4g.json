    },
    {
      "sentence_id": "s12",
      "char_len": 12,
      "snippet": "自己不行了,就西盟友的寫"
    },
    {
      "sentence_id": "s13",
      "char_len": 11,
      "snippet": "以北京為中心的紅色世界"
    },
    {
      "sentence_id": "s14",
      "char_len": 17,
