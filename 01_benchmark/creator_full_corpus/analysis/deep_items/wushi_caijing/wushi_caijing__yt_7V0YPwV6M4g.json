    {
      "sentence_id": "s1",
      "char_len": 10,
      "snippet": "美國時期名法官發表聯"
    },
    {
      "sentence_id": "s2",
      "char_len": 13,
      "snippet": "合聲明,有求對串目進行精神"
    },
    {
      "sentence_id": "s3",
      "char_len": 17,
      "snippet": "見定,無事的評價是,我覺得這假新聞"
    },
    {
