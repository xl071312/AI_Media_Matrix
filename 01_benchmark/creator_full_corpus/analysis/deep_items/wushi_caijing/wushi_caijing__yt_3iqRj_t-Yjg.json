  "sentences_index": [
    {
      "sentence_id": "s1",
      "char_len": 18,
      "snippet": "大陸時,巴i巴州市民和染影影的經濟量"
    },
    {
      "sentence_id": "s2",
      "char_len": 16,
      "snippet": "我願稱之為本年度內於最成功的操盤"
    },
    {
      "sentence_id": "s3",
      "char_len": 11,
      "snippet": "謀視以深入局,省天半子"
    },
    {
