  "sentences_index": [
    {
      "sentence_id": "s1",
      "char_len": 13,
      "snippet": "歡迎來到何同學工作室的開箱"
    },
    {
      "sentence_id": "s2",
      "char_len": 24,
      "snippet": "在這期節目裡面我們體驗了目前最火熱的 AI 硬件"
    },
    {
      "sentence_id": "s3",
      "char_len": 18,
      "snippet": "測試了各種便攜式風扇對人體的降溫效果"
    },
    {
      "sentence_id": "s4",
      "char_len": 17,
      "snippet": "還用探針鏡頭拍攝了各種價位的萬花筒"
    },
    {
      "sentence_id": "s5",
      "char_len": 5,
      "snippet": "第一款產品"
    },
    {
      "sentence_id": "s6",
      "char_len": 4,
      "snippet": "AI硬件"
    },
    {
      "sentence_id": "s7",
      "char_len": 17,
      "snippet": "AI毫無疑問是當下數碼圈最火的技術"
    },
    {
      "sentence_id": "s8",
      "char_len": 16,
      "snippet": "但是大部分AI都是通過軟件呈現的"
    },
    {
      "sentence_id": "s9",
      "char_len": 2,
      "snippet": "而這"
    },
    {
      "sentence_id": "s10",
      "char_len": 17,
      "snippet": "是今年年初發佈的rabbit r1"
    },
    {
      "sentence_id": "s11",
      "char_len": 15,
      "snippet": "一個自稱“口袋伴侶”的AI硬件"
    },
    {
      "sentence_id": "s12",
      "char_len": 7,
      "snippet": "按住側邊的按鈕"
    },
    {
      "sentence_id": "s13",
      "char_len": 14,
      "snippet": "拎起兔子的耳朵就可以問它問題"
    },
    {
      "sentence_id": "s14",
      "char_len": 17,
      "snippet": "Are you a rabbit？"
    },
    {
      "sentence_id": "s15",
      "char_len": 8,
      "snippet": "過一會它就會回答"
    },
    {
      "sentence_id": "s16",
      "char_len": 11,
      "snippet": "雙擊按鈕則會喚起攝像頭"
    },
    {
      "sentence_id": "s17",
      "char_len": 7,
      "snippet": "滑動旁邊的滾輪"
    },
    {
      "sentence_id": "s18",
      "char_len": 15,
      "snippet": "攝像頭還會物理意義上地翻轉過來"
    },
    {
      "sentence_id": "s19",
      "char_len": 8,
      "snippet": "按住按鈕問它問題"
    },
    {
      "sentence_id": "s20",
      "char_len": 11,
      "snippet": "What's this"
    },
    {
      "sentence_id": "s21",
      "char_len": 13,
      "snippet": "它就會拍照後結合圖片來回答"
    },
    {
      "sentence_id": "s22",
      "char_len": 13,
      "snippet": "它能識別出我們製作的打字機"
    },
    {
      "sentence_id": "s23",
      "char_len": 8,
      "snippet": "甚至寫得非常詳細"
    },
    {
      "sentence_id": "s24",
      "char_len": 12,
      "snippet": "甚至可以通過這麼一張截圖"
    },
    {
      "sentence_id": "s25",
      "char_len": 12,
      "snippet": "識別出我們做的水下無人機"
    },
    {
      "sentence_id": "s26",
      "char_len": 8,
      "snippet": "它為數不多犯的錯"
    },
    {
      "sentence_id": "s27",
      "char_len": 9,
      "snippet": "就是把這個封印之仗"
    },
    {
      "sentence_id": "s28",
      "char_len": 10,
      "snippet": "識別成了一個廚房用具"
    },
    {
      "sentence_id": "s29",
      "char_len": 13,
      "snippet": "可能它並沒有一個快樂的童年"
    },
    {
      "sentence_id": "s30",
      "char_len": 7,
      "snippet": "而他們在半年前"
    },
    {
      "sentence_id": "s31",
      "char_len": 17,
      "snippet": "在發佈會上展示的功能聽起來更加厲害"
    },
    {
      "sentence_id": "s32",
      "char_len": 8,
      "snippet": "只要對著它說一聲"
    },
    {
      "sentence_id": "s33",
      "char_len": 15,
      "snippet": "就可以幫你點外賣 打車 訂酒店"
    },
    {
      "sentence_id": "s34",
      "char_len": 14,
      "snippet": "但是今天這些功能依舊沒有實現"
    },
    {
      "sentence_id": "s35",
      "char_len": 15,
      "snippet": "並不是因為國內用不了這些App"
    },
    {
      "sentence_id": "s36",
      "char_len": 15,
      "snippet": "而是他們根本沒有做出來這些功能"
    },
    {
      "sentence_id": "s37",
      "char_len": 11,
      "snippet": "還是非常讓人感到困惑的"
    },
    {
      "sentence_id": "s38",
      "char_len": 15,
      "snippet": "更讓人困惑的是r1的軟硬件交互"
    },
    {
      "sentence_id": "s39",
      "char_len": 19,
      "snippet": "這塊顯示屏佔據了正面整整四分之三的面積"
    },
    {
      "sentence_id": "s40",
      "char_len": 5,
      "snippet": "卻不能觸摸"
    },
    {
      "sentence_id": "s41",
      "char_len": 12,
      "snippet": "只能通過旁邊的滾輪來選擇"
    },
    {
      "sentence_id": "s42",
      "char_len": 6,
      "snippet": "用按鍵來確定"
    },
    {
      "sentence_id": "s43",
      "char_len": 5,
      "snippet": "效率非常低"
    },
    {
      "sentence_id": "s44",
      "char_len": 17,
      "snippet": "而正當我以為這塊屏幕不是觸屏的時候"
    },
    {
      "sentence_id": "s45",
      "char_len": 7,
      "snippet": "原來又可以觸屏"
    },
    {
      "sentence_id": "s46",
      "char_len": 4,
      "snippet": "總結來說"
    },
    {
      "sentence_id": "s47",
      "char_len": 21,
      "snippet": "rabbit r1目前就是把ChatGPT"
    },
    {
      "sentence_id": "s48",
      "char_len": 14,
      "snippet": "塞進了一個並不好用的小盒子里"
    },
    {
      "sentence_id": "s49",
      "char_len": 11,
      "snippet": "而這是一台AI Pin"
    },
    {
      "sentence_id": "s50",
      "char_len": 7,
      "snippet": "同樣為AI硬件"
    },
    {
      "sentence_id": "s165",
      "char_len": 8,
      "snippet": "可以直接放進口袋"
    },
    {
      "sentence_id": "s166",
      "char_len": 12,
      "snippet": "風力大小是普通風扇的十倍"
    },
    {
      "sentence_id": "s167",
      "char_len": 13,
      "snippet": "可以吹出100克以上的壓力"
    },
    {
      "sentence_id": "s168",
      "char_len": 6,
      "snippet": "加上它的配件"
    },
    {
      "sentence_id": "s169",
      "char_len": 11,
      "snippet": "就能變成一台小型吸塵器"
    },
    {
      "sentence_id": "s170",
      "char_len": 8,
      "snippet": "可惜聲音有一點大"
    },
    {
      "sentence_id": "s171",
      "char_len": 10,
      "snippet": "吹起來有點像騎電瓶車"
    },
    {
      "sentence_id": "s172",
      "char_len": 7,
      "snippet": "風扇直吹的脖子"
    },
    {
      "sentence_id": "s173",
      "char_len": 16,
      "snippet": "相比於沒有風扇下降了約1.95度"
    },
    {
      "sentence_id": "s174",
      "char_len": 10,
      "snippet": "降溫水平不如掛脖風扇"
    },
    {
      "sentence_id": "s175",
      "char_len": 15,
      "snippet": "是因為掛脖風扇的風力集中在頸部"
    },
    {
      "sentence_id": "s176",
      "char_len": 5,
      "snippet": "而且足夠近"
    },
    {
      "sentence_id": "s177",
      "char_len": 8,
      "snippet": "而渦輪風扇測試時"
    },
    {
      "sentence_id": "s178",
      "char_len": 15,
      "snippet": "對肩膀和胸部也有很好的降溫效果"
    },
    {
      "sentence_id": "s179",
      "char_len": 5,
      "snippet": "下一個風扇"
    },
    {
      "sentence_id": "s180",
      "char_len": 10,
      "snippet": "是698元的掛腰冰環"
    },
    {
      "sentence_id": "s181",
      "char_len": 17,
      "snippet": "貼近身體的部位使用了一種冷相變材料"
    },
    {
      "sentence_id": "s182",
      "char_len": 9,
      "snippet": "風扇周圍還有出風口"
    },
    {
      "sentence_id": "s183",
      "char_len": 12,
      "snippet": "但降溫情況並不是特別理想"
    },
    {
      "sentence_id": "s184",
      "char_len": 12,
      "snippet": "即使是降溫幅度最大的頸部"
    },
    {
      "sentence_id": "s185",
      "char_len": 18,
      "snippet": "和沒有風扇相比只大約下降了0.55度"
    },
    {
      "sentence_id": "s186",
      "char_len": 12,
      "snippet": "你也可以把它穿在衣服裡面"
    },
    {
      "sentence_id": "s187",
      "char_len": 9,
      "snippet": "由於不受衣服的遮擋"
    },
    {
      "sentence_id": "s188",
      "char_len": 10,
      "snippet": "身體表面受風面積更大"
    },
    {
      "sentence_id": "s189",
      "char_len": 10,
      "snippet": "使用起來還是挺涼快的"
    },
    {
      "sentence_id": "s190",
      "char_len": 10,
      "snippet": "特別是對於肚子和後背"
    },
    {
      "sentence_id": "s191",
      "char_len": 16,
      "snippet": "和沒有風扇相比下降了約1.76度"
    },
    {
      "sentence_id": "s192",
      "char_len": 5,
      "snippet": "下一個風扇"
    },
    {
      "sentence_id": "s193",
      "char_len": 1,
      "snippet": "呃"
    },
    {
      "sentence_id": "s194",
      "char_len": 5,
      "snippet": "嚴格意義上"
    },
    {
      "sentence_id": "s195",
      "char_len": 8,
      "snippet": "它已經不算風扇了"
    },
    {
      "sentence_id": "s196",
      "char_len": 11,
      "snippet": "它的全稱是穿戴式空調服"
    },
    {
      "sentence_id": "s197",
      "char_len": 5,
      "snippet": "2899元"
    },
    {
      "sentence_id": "s198",
      "char_len": 13,
      "snippet": "通過冷卻冷管和人進行熱交換"
    },
    {
      "sentence_id": "s199",
      "char_len": 11,
      "snippet": "它的原理和空調非常類似"
    },
    {
      "sentence_id": "s200",
      "char_len": 6,
      "snippet": "續航有3小時"
    },
    {
      "sentence_id": "s201",
      "char_len": 13,
