  "sentences_index": [
    {
      "sentence_id": "s1",
      "char_len": 9,
      "snippet": "这是一台英文打字机"
    },
    {
      "sentence_id": "s2",
      "char_len": 4,
      "snippet": "小巧简洁"
    },
    {
      "sentence_id": "s3",
      "char_len": 13,
      "snippet": "按下按键字母就会被敲在纸上"
    },
    {
      "sentence_id": "s4",
      "char_len": 14,
      "snippet": "使用起来和现在的键盘非常相似"
    },
    {
      "sentence_id": "s5",
      "char_len": 10,
      "snippet": "而这是一台中文打字机"
    },
    {
      "sentence_id": "s6",
      "char_len": 4,
      "snippet": "庞大复杂"
    },
    {
      "sentence_id": "s7",
      "char_len": 4,
      "snippet": "想要打字"
    },
    {
      "sentence_id": "s8",
      "char_len": 11,
      "snippet": "你得先在字盘里把字找到"
    },
    {
      "sentence_id": "s9",
      "char_len": 10,
      "snippet": "按下把手把字敲到纸上"
    },
    {
      "sentence_id": "s10",
      "char_len": 14,
      "snippet": "使用起来远不如英文打字机方便"
    },
    {
      "sentence_id": "s11",
      "char_len": 10,
      "snippet": "打字速度更是难以匹敌"
    },
    {
      "sentence_id": "s12",
      "char_len": 11,
      "snippet": "可是英文字母只有26个"
    },
    {
      "sentence_id": "s13",
      "char_len": 10,
      "snippet": "而汉字的数量成千上万"
    },
    {
      "sentence_id": "s14",
      "char_len": 12,
      "snippet": "在那个科技并不先进的年代"
    },
    {
      "sentence_id": "s15",
      "char_len": 13,
      "snippet": "这似乎是没有什么办法的事情"
    },
    {
      "sentence_id": "s16",
      "char_len": 8,
      "snippet": "然而在1947年"
    },
    {
      "sentence_id": "s17",
      "char_len": 11,
      "snippet": "有人做出了这样一台机器"
    },
    {
      "sentence_id": "s18",
      "char_len": 5,
      "snippet": "明快打字机"
    },
    {
      "sentence_id": "s19",
      "char_len": 14,
      "snippet": "相比于一个2480个槽的字盘"
    },
    {
      "sentence_id": "s20",
      "char_len": 14,
      "snippet": "它身上装着一个74个键的键盘"
    },
    {
      "sentence_id": "s21",
      "char_len": 12,
      "snippet": "你可以像在电脑上打字一样"
    },
    {
      "sentence_id": "s22",
      "char_len": 6,
      "snippet": "将字打在纸上"
    },
    {
      "sentence_id": "s23",
      "char_len": 4,
      "snippet": "不仅如此"
    },
    {
      "sentence_id": "s24",
      "char_len": 12,
      "snippet": "体积只比英文打字机略大的"
    },
    {
      "sentence_id": "s25",
      "char_len": 11,
      "snippet": "它不是能打2480个字"
    },
    {
      "sentence_id": "s26",
      "char_len": 11,
      "snippet": "不是能打2万4800字"
    },
    {
      "sentence_id": "s27",
      "char_len": 9,
      "snippet": "它能打整整9万个字"
    },
    {
      "sentence_id": "s28",
      "char_len": 15,
      "snippet": "这样的打字机总共只生产出了一台"
    },
    {
      "sentence_id": "s29",
      "char_len": 14,
      "snippet": "而这唯一一台被当成垃圾扔掉了"
    },
    {
      "sentence_id": "s30",
      "char_len": 13,
      "snippet": "第一次知道明快打字机的时候"
    },
    {
      "sentence_id": "s31",
      "char_len": 10,
      "snippet": "我以为它是个都市传说"
    },
    {
      "sentence_id": "s32",
      "char_len": 14,
      "snippet": "怎么可能靠机械结构打9万个字"
    },
    {
      "sentence_id": "s33",
      "char_len": 11,
      "snippet": "不过有很多照片都证明了"
    },
    {
      "sentence_id": "s34",
      "char_len": 10,
      "snippet": "这样一台打字机的存在"
    },
    {
      "sentence_id": "s35",
      "char_len": 12,
      "snippet": "甚至还有实际工作时的视频"
    },
    {
      "sentence_id": "s36",
      "char_len": 9,
      "snippet": "更让人意想不到的是"
    },
    {
      "sentence_id": "s37",
      "char_len": 13,
      "snippet": "这台打字机的发明者不是别人"
    },
    {
      "sentence_id": "s38",
      "char_len": 13,
      "snippet": "是我国现代著名文学家林语堂"
    },
    {
      "sentence_id": "s39",
      "char_len": 8,
      "snippet": "根据林语堂的传记"
    },
    {
      "sentence_id": "s40",
      "char_len": 7,
      "snippet": "早在1931年"
    },
    {
      "sentence_id": "s41",
      "char_len": 16,
      "snippet": "他就梦想发明一架像英文打字机一样"
    },
    {
      "sentence_id": "s42",
      "char_len": 17,
      "snippet": "不必受任何训练就可以打的中文打字机"
    },
    {
      "sentence_id": "s43",
      "char_len": 10,
      "snippet": "为此他好像着了魔似的"
    },
    {
      "sentence_id": "s44",
      "char_len": 9,
      "snippet": "每天早上五六点起床"
    },
    {
      "sentence_id": "s45",
      "char_len": 9,
      "snippet": "排列了又再排列汉字"
    },
    {
      "sentence_id": "s46",
      "char_len": 7,
      "snippet": "把键盘改了又改"
    },
    {
      "sentence_id": "s47",
      "char_len": 7,
      "snippet": "终于在16年后"
    },
    {
      "sentence_id": "s48",
      "char_len": 15,
      "snippet": "做出了第一台能正常工作的原型机"
    },
    {
      "sentence_id": "s49",
      "char_len": 6,
      "snippet": "不过遗憾的是"
    },
    {
      "sentence_id": "s50",
      "char_len": 6,
      "snippet": "因为造价过高"
    },
    {
      "sentence_id": "s101",
      "char_len": 4,
      "snippet": "方便选择"
    },
    {
      "sentence_id": "s102",
      "char_len": 9,
      "snippet": "这些字能出现在这里"
    },
    {
      "sentence_id": "s103",
      "char_len": 20,
      "snippet": "是因为窗口下方还有一个专门负责预览的滚筒"
    },
    {
      "sentence_id": "s104",
      "char_len": 19,
      "snippet": "这个预览滚筒上印刷着和大滚筒上一样的字"
    },
    {
      "sentence_id": "s105",
      "char_len": 11,
      "snippet": "这些字经过反射与放大后"
    },
    {
      "sentence_id": "s106",
      "char_len": 7,
      "snippet": "可以被用户看到"
    },
    {
      "sentence_id": "s107",
      "char_len": 20,
      "snippet": "这个预览滚筒通过同步带连接着纸架和大滚筒"
    },
    {
      "sentence_id": "s108",
      "char_len": 11,
      "snippet": "纸架和大滚筒运动的时候"
    },
    {
      "sentence_id": "s109",
      "char_len": 11,
      "snippet": "会带动预览滚筒一起运动"
    },
    {
      "sentence_id": "s110",
      "char_len": 13,
      "snippet": "而它们的传动关系是如此巧妙"
    },
    {
      "sentence_id": "s111",
      "char_len": 17,
      "snippet": "以至于大滚筒上处于打印位置的八个字"
    },
    {
      "sentence_id": "s112",
      "char_len": 14,
      "snippet": "就是预览滚筒上被放大的八个字"
    },
    {
      "sentence_id": "s113",
      "char_len": 15,
      "snippet": "最后你只需要根据窗口里字的顺序"
    },
    {
      "sentence_id": "s114",
      "char_len": 9,
      "snippet": "按下键盘上的编号键"
    },
    {
      "sentence_id": "s115",
      "char_len": 21,
      "snippet": "这个机构就会把字杆旋转到对应的字 击锤敲击"
    },
    {
      "sentence_id": "s116",
      "char_len": 6,
      "snippet": "把字敲在纸上"
    },
    {
      "sentence_id": "s117",
      "char_len": 12,
      "snippet": "使用体验堪比现在的输入法"
    },
    {
      "sentence_id": "s118",
      "char_len": 20,
      "snippet": "而这种通过左上角和右下角笔画检索词的方法"
    },
    {
      "sentence_id": "s119",
      "char_len": 14,
      "snippet": "就是林语堂发明的上下行检字法"
    },
    {
      "sentence_id": "s120",
      "char_len": 16,
      "snippet": "可是即便用上了这样的三级滚筒结构"
    },
    {
      "sentence_id": "s121",
      "char_len": 12,
      "snippet": "我们也只能打8000个字"
    },
    {
      "sentence_id": "s122",
      "char_len": 12,
      "snippet": "九万个字又是如何实现的呢"
    },
    {
      "sentence_id": "s123",
      "char_len": 11,
      "snippet": "原来这8352个字母里"
    },
    {
      "sentence_id": "s124",
      "char_len": 16,
      "snippet": "有约七千个是可以直接打出来的汉字"
    },
    {
      "sentence_id": "s125",
      "char_len": 6,
      "snippet": "剩下的是偏旁"
    },
    {
      "sentence_id": "s126",
      "char_len": 9,
      "snippet": "其中约有70个声旁"
    },
    {
      "sentence_id": "s127",
      "char_len": 7,
      "snippet": "1300个型旁"
    },
    {
      "sentence_id": "s128",
      "char_len": 4,
      "snippet": "在打字时"
    },
    {
      "sentence_id": "s129",
      "char_len": 9,
      "snippet": "你可以先打一个形旁"
    },
    {
      "sentence_id": "s130",
      "char_len": 6,
      "snippet": "再打一个声旁"
    },
    {
      "sentence_id": "s131",
      "char_len": 10,
      "snippet": "把它们组合成一个汉字"
    },
    {
      "sentence_id": "s132",
      "char_len": 20,
      "snippet": "比如说我们想通过组合的方法打一个“唁”字"
    },
    {
      "sentence_id": "s133",
      "char_len": 10,
      "snippet": "你可以先按下“口”键"
    },
    {
      "sentence_id": "s134",
      "char_len": 19,
      "snippet": "这时包含“口”的偏旁就可以出现在窗口里"
    },
    {
      "sentence_id": "s135",
      "char_len": 6,
      "snippet": "把它打在纸上"
    },
    {
      "sentence_id": "s136",
      "char_len": 12,
      "snippet": "然后再按下“亠”和“口”"
    },
    {
      "sentence_id": "s137",
      "char_len": 10,
      "snippet": "你就可以找到“言”字"
    },
    {
      "sentence_id": "s138",
      "char_len": 16,
      "snippet": "而“言”字下面的小“言”就是偏旁"
    },
    {
      "sentence_id": "s139",
      "char_len": 16,
      "snippet": "而它也打上去就可组合成“唁”字了"
    },
    {
      "sentence_id": "s140",
      "char_len": 18,
      "snippet": "这些能组合出来的字约有70×1300"
    },
    {
      "sentence_id": "s212",
      "char_len": 16,
      "snippet": "传记中的一个小故事也许给出了答案"
    },
    {
      "sentence_id": "s213",
      "char_len": 15,
      "snippet": "有一天父亲和我坐在一辆计程车里"
    },
    {
      "sentence_id": "s214",
      "char_len": 12,
      "snippet": "父亲还在把玩一个纸型键盘"
    },
    {
      "sentence_id": "s215",
      "char_len": 4,
      "snippet": "得意地说"
    },
    {
      "sentence_id": "s216",
      "char_len": 9,
      "snippet": "我这个打字机的发明"
    },
    {
      "sentence_id": "s217",
      "char_len": 14,
      "snippet": "主要在利用上下行检字法的键盘"
    },
    {
      "sentence_id": "s218",
      "char_len": 14,
      "snippet": "其他机械上的问题是不难解决的"
    },
    {
      "sentence_id": "s219",
      "char_len": 18,
      "snippet": "那么你假使只把汉字照上下行检字法分类"
    },
    {
      "sentence_id": "s220",
      "char_len": 6,
      "snippet": "弄个纸形键盘"
    },
    {
      "sentence_id": "s221",
      "char_len": 8,
      "snippet": "像你手里拿的一样"
    },
    {
      "sentence_id": "s222",
      "char_len": 9,
      "snippet": "不就可以向人推销吗"
    },
    {
      "sentence_id": "s223",
      "char_len": 7,
      "snippet": "我战战兢兢地问"
    },
    {
      "sentence_id": "s224",
      "char_len": 12,
      "snippet": "当时有没有制造模型的必要"
    },
    {
      "sentence_id": "s225",
      "char_len": 6,
      "snippet": "他看了我一下"
    },
    {
      "sentence_id": "s226",
      "char_len": 3,
      "snippet": "轻声说"
    },
    {
      "sentence_id": "s227",
      "char_len": 11,
      "snippet": "也许不造模型也可以推销"
    },
    {
      "sentence_id": "s228",
      "char_len": 6,
      "snippet": "但是我忍不住"
    },
    {
      "sentence_id": "s229",
      "char_len": 10,
      "snippet": "我一定要造一部打字机"
    },
    {
      "sentence_id": "s230",
      "char_len": 9,
      "snippet": "使我可以真正地打字"
    },
    {
      "sentence_id": "s231",
      "char_len": 4,
      "snippet": "OK各位"
    },
    {
      "sentence_id": "s232",
      "char_len": 13,
      "snippet": "这就是本期视频的全部内容了"
    },
    {
      "sentence_id": "s233",
      "char_len": 10,
      "snippet": "非常感谢你能看到这里"
    },
    {
      "sentence_id": "s234",
      "char_len": 19,
      "snippet": "本期视频是本频道更新周期最长的一期视频"
    },
    {
      "sentence_id": "s235",
      "char_len": 14,
      "snippet": "也是我们做得最用心的一期视频"
    },
    {
      "sentence_id": "s236",
      "char_len": 18,
      "snippet": "所以如果你觉得这个视频做的还不错的话"
    },
    {
      "sentence_id": "s237",
      "char_len": 3,
      "snippet": "求转发"
    },
    {
      "sentence_id": "s238",
      "char_len": 13,
      "snippet": "最重要的是点一个大大的关注"
    },
    {
      "sentence_id": "s239",
      "char_len": 17,
      "snippet": "各位的支持就是我们做视频的最大动力"
    },
    {
      "sentence_id": "s240",
      "char_len": 4,
      "snippet": "OK各位"
    },
    {
      "sentence_id": "s241",
      "char_len": 6,
      "snippet": "我们下期再见"
    }
