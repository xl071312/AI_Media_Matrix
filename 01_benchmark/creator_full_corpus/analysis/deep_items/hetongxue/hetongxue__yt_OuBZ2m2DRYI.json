    },
    {
      "sentence_id": "s5",
      "char_len": 13,
      "snippet": "所以我其實還是在電腦上看的"
    },
    {
      "sentence_id": "s6",
      "char_len": 9,
      "snippet": "一、大模型Siri"
    },
    {
      "sentence_id": "s7",
      "char_len": 11,
      "snippet": "今年的Siri，外觀上"
    },
    {
      "sentence_id": "s8",
      "char_len": 9,
      "snippet": "從樸素內斂的玻璃球"
    },
    {
      "sentence_id": "s9",
      "char_len": 12,
      "snippet": "變成了炫酷的RGB跑馬燈"
    },
    {
      "sentence_id": "s10",
      "char_len": 16,
      "snippet": "內在里，它可以理解更加複雜的指令"
    },
    {
      "sentence_id": "s11",
      "char_len": 16,
      "snippet": "還能根據你的信息和當前所處的場景"
    },
    {
      "sentence_id": "s12",
      "char_len": 8,
      "snippet": "給出個性化的回復"
    },
    {
      "sentence_id": "s13",
      "char_len": 16,
      "snippet": "比如現在問，我媽媽的航班幾點到？"
    },
    {
      "sentence_id": "s14",
      "char_len": 11,
      "snippet": "Siri會給你找個網頁"
    },
    {
      "sentence_id": "s15",
      "char_len": 16,
      "snippet": "而未來的Siri，則可以結合郵件"
    },
    {
      "sentence_id": "s16",
      "char_len": 13,
      "snippet": "短信里的信息精准給出回復："
    },
    {
      "sentence_id": "s17",
      "char_len": 6,
      "snippet": "二、寫作工具"
    },
    {
      "sentence_id": "s18",
      "char_len": 12,
      "snippet": "這是系統級的AI寫作工具"
    },
    {
      "sentence_id": "s19",
      "char_len": 8,
      "snippet": "可以潤色你的文案"
    },
    {
      "sentence_id": "s20",
      "char_len": 8,
      "snippet": "只需選中一段文本"
    },
    {
      "sentence_id": "s21",
      "char_len": 8,
      "snippet": "點擊邊上的小圖標"
    },
    {
      "sentence_id": "s22",
      "char_len": 16,
      "snippet": "選擇重寫，就可以生成更得體的文本"
    },
    {
      "sentence_id": "s23",
      "char_len": 13,
      "snippet": "它還可以選擇不同的語言風格"
    },
    {
      "sentence_id": "s24",
      "char_len": 11,
      "snippet": "校對則會幫助你找出筆誤"
    },
    {
      "sentence_id": "s25",
      "char_len": 10,
      "snippet": "同樣點擊邊上的小圖標"
    },
    {
      "sentence_id": "s26",
      "char_len": 16,
      "snippet": "選擇校對，就可以幫你梳理句法問題"
    },
    {
      "sentence_id": "s27",
      "char_len": 9,
      "snippet": "給出對應建議和修改"
    },
    {
      "sentence_id": "s28",
      "char_len": 15,
      "snippet": "蘋果還原生接入了ChatGPT"
    },
    {
      "sentence_id": "s29",
      "char_len": 8,
      "snippet": "在經過你的同意後"
    },
    {
      "sentence_id": "s30",
      "char_len": 10,
      "snippet": "就可以回答更難的問題"
    },
    {
      "sentence_id": "s31",
      "char_len": 8,
      "snippet": "或者幫你擴寫內容"
    },
    {
      "sentence_id": "s32",
      "char_len": 6,
      "snippet": "三、圖像生成"
    },
    {
      "sentence_id": "s33",
      "char_len": 13,
      "snippet": "大熱的AI作圖自然也沒落下"
    },
    {
      "sentence_id": "s34",
      "char_len": 12,
      "snippet": "簡單選擇場景、人物、風格"
    },
    {
      "sentence_id": "s35",
      "char_len": 9,
      "snippet": "就可以進行圖像生成"
    },
    {
      "sentence_id": "s36",
      "char_len": 16,
      "snippet": "當然，你也可以選擇直接輸入提示詞"
    },
    {
      "sentence_id": "s37",
      "char_len": 5,
      "snippet": "進一步優化"
    },
    {
      "sentence_id": "s38",
      "char_len": 13,
      "snippet": "你還能用Genmoji功能"
    },
    {
      "sentence_id": "s39",
      "char_len": 13,
      "snippet": "生成和某人很像的emoji"
    },
    {
      "sentence_id": "s40",
      "char_len": 16,
      "snippet": "而在備忘錄里，通過分析手繪和文字"
    },
    {
      "sentence_id": "s41",
      "char_len": 16,
      "snippet": "則可以直接把草圖轉換為精美的圖片"
    },
    {
      "sentence_id": "s42",
      "char_len": 6,
      "snippet": "四、照片編輯"
    },
    {
      "sentence_id": "s43",
      "char_len": 7,
      "snippet": "好用的AI消除"
    },
    {
      "sentence_id": "s44",
      "char_len": 14,
      "snippet": "終於也出現在了iPhone上"
    },
    {
      "sentence_id": "s45",
      "char_len": 6,
      "snippet": "通過簡單圈選"
    },
    {
      "sentence_id": "s46",
      "char_len": 15,
      "snippet": "你可以將畫面里不需要的內容消除"
    },
    {
      "sentence_id": "s47",
      "char_len": 21,
      "snippet": "比較有意思的是這個功能會自動識別出人物輪廓"
    },
    {
      "sentence_id": "s48",
      "char_len": 12,
      "snippet": "圈選時會從主體後面划過去"
    },
    {
      "sentence_id": "s49",
      "char_len": 12,
      "snippet": "這樣不至於把自己也消除掉"
    },
    {
      "sentence_id": "s50",
      "char_len": 12,
      "snippet": "那實況照片能不能修復呢？"
    },
    {
      "sentence_id": "s51",
      "char_len": 11,
      "snippet": "Siri讀出來+梗圖："
    },
    {
      "sentence_id": "s52",
      "char_len": 17,
      "snippet": "以上這些功能，被賦予了一個新名字："
    },
