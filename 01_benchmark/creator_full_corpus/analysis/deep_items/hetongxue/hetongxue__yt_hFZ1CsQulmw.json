  "sentences_index": [
    {
      "sentence_id": "s1",
      "char_len": 9,
      "snippet": "為了讓大家不倒垃圾"
    },
    {
      "sentence_id": "s2",
      "char_len": 13,
      "snippet": "我們做了20個狂奔的垃圾桶"
    },
    {
      "sentence_id": "s3",
      "char_len": 7,
      "snippet": "我們工作室很亂"
    },
    {
      "sentence_id": "s4",
      "char_len": 13,
      "snippet": "桌子上和地上總是有很多垃圾"
    },
    {
      "sentence_id": "s5",
      "char_len": 8,
      "snippet": "垃圾桶也總是滿的"
    },
    {
      "sentence_id": "s6",
      "char_len": 13,
      "snippet": "一開始我以為是桶的數量不夠"
    },
    {
      "sentence_id": "s7",
      "char_len": 9,
      "snippet": "所以買了更多垃圾桶"
    },
    {
      "sentence_id": "s8",
      "char_len": 8,
      "snippet": "但沒想到還是有人"
    },
    {
      "sentence_id": "s9",
      "char_len": 8,
      "snippet": "那如果人扔垃圾後"
    },
    {
      "sentence_id": "s10",
      "char_len": 9,
      "snippet": "垃圾桶可以自己接住"
    },
    {
      "sentence_id": "s11",
      "char_len": 8,
      "snippet": "再自動把垃圾倒掉"
    },
    {
      "sentence_id": "s12",
      "char_len": 12,
      "snippet": "是不是就解決了這個問題呢"
    },
    {
      "sentence_id": "s13",
      "char_len": 5,
      "snippet": "想接住垃圾"
    },
    {
      "sentence_id": "s14",
      "char_len": 5,
      "snippet": "主要有兩點"
    },
    {
      "sentence_id": "s15",
      "char_len": 8,
      "snippet": "知道垃圾會落到哪"
    },
    {
      "sentence_id": "s16",
      "char_len": 6,
      "snippet": "快速地跑到那"
    },
    {
      "sentence_id": "s17",
      "char_len": 7,
      "snippet": "第二點比較簡單"
    },
    {
      "sentence_id": "s18",
      "char_len": 8,
      "snippet": "我們在垃圾桶底下"
    },
    {
      "sentence_id": "s19",
      "char_len": 6,
      "snippet": "加了三個舵輪"
    },
    {
      "sentence_id": "s20",
      "char_len": 8,
      "snippet": "讓它可以快速移動"
    },
    {
      "sentence_id": "s21",
      "char_len": 7,
      "snippet": "哇 真是好身手"
    },
    {
      "sentence_id": "s22",
      "char_len": 12,
      "snippet": "但是桶怎麼知道垃圾在哪呢"
    },
    {
      "sentence_id": "s23",
      "char_len": 14,
      "snippet": "12年前有朋友做過類似的項目"
    },
    {
      "sentence_id": "s24",
      "char_len": 6,
      "snippet": "他當時的方案"
    },
    {
      "sentence_id": "s25",
      "char_len": 15,
      "snippet": "是用牆上的相機(Kinect)"
    },
    {
      "sentence_id": "s26",
      "char_len": 7,
      "snippet": "檢測垃圾的位置"
    },
    {
      "sentence_id": "s27",
      "char_len": 11,
      "snippet": "但如果把相機放在環境里"
    },
    {
      "sentence_id": "s28",
      "char_len": 14,
      "snippet": "就只能在一定範圍里使用垃圾桶"
    },
    {
      "sentence_id": "s29",
      "char_len": 12,
      "snippet": "所以我們把相機放在了桶上"
    },
    {
      "sentence_id": "s30",
      "char_len": 9,
      "snippet": "這樣它想去哪都可以"
    },
    {
      "sentence_id": "s31",
      "char_len": 8,
      "snippet": "再針對常見的垃圾"
    },
    {
      "sentence_id": "s32",
      "char_len": 6,
      "snippet": "訓練識別模型"
    },
    {
      "sentence_id": "s33",
      "char_len": 13,
      "snippet": "當它看到訓練過的垃圾經過時"
    },
    {
      "sentence_id": "s34",
      "char_len": 6,
      "snippet": "就會快速移動"
    },
    {
      "sentence_id": "s35",
      "char_len": 14,
      "snippet": "在經過我們工程師的反復調試後"
    },
    {
      "sentence_id": "s36",
      "char_len": 10,
      "snippet": "它終於可以接住垃圾了"
    },
    {
      "sentence_id": "s37",
      "char_len": 4,
      "snippet": "直接進了"
    },
    {
      "sentence_id": "s38",
      "char_len": 7,
      "snippet": "基礎功能解決了"
    },
    {
      "sentence_id": "s39",
      "char_len": 12,
      "snippet": "我們又做了三個特種垃圾桶"
    },
    {
      "sentence_id": "s40",
      "char_len": 10,
      "snippet": "裝上手就可以讓它擦地"
    },
    {
      "sentence_id": "s41",
