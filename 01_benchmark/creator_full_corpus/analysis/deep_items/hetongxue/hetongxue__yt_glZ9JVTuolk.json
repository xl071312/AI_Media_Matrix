    {
      "sentence_id": "s13",
      "char_len": 3,
      "snippet": "也很軟"
    },
    {
      "sentence_id": "s14",
      "char_len": 6,
      "snippet": "靠著睡很舒服"
    },
    {
      "sentence_id": "s15",
      "char_len": 8,
      "snippet": "如果你喜歡趴著睡"
    },
    {
      "sentence_id": "s16",
      "char_len": 10,
