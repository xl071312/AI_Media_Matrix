      "snippet": "枕頭填充的是這種泡沫顆粒"
    },
    {
      "sentence_id": "s11",
      "char_len": 6,
      "snippet": "看起來很大個"
    },
    {
      "sentence_id": "s12",
      "char_len": 5,
      "snippet": "其實非常輕"
