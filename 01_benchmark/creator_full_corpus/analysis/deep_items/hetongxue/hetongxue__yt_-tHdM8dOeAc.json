    },
    {
      "sentence_id": "s2",
      "char_len": 17,
      "snippet": "这是我们工作室的同事做的射门机器人"
    },
    {
      "sentence_id": "s3",
      "char_len": 17,
      "snippet": "可以以各种原理把足球高速地发射出去"
    },
    {
      "sentence_id": "s4",
      "char_len": 2,
      "snippet": "而这"
    },
    {
      "sentence_id": "s5",
      "char_len": 8,
      "snippet": "是一个守门机器人"
    },
    {
      "sentence_id": "s6",
      "char_len": 12,
      "snippet": "可以以每秒100次的频率"
    },
    {
      "sentence_id": "s7",
      "char_len": 7,
      "snippet": "扫描足球的位置"
    },
    {
      "sentence_id": "s8",
      "char_len": 8,
      "snippet": "并且把球给扑出去"
    },
    {
      "sentence_id": "s9",
      "char_len": 17,
      "snippet": "最近工作室的大家每天都熬夜看欧洲杯"
    },
    {
      "sentence_id": "s10",
      "char_len": 12,
      "snippet": "第二天上班眼皮都要合上了"
    },
    {
      "sentence_id": "s11",
      "char_len": 10,
      "snippet": "既然大家这么喜欢足球"
    },
    {
      "sentence_id": "s12",
      "char_len": 6,
      "snippet": "不如举办一场"
    },
    {
      "sentence_id": "s13",
      "char_len": 12,
      "snippet": "我们工作室里面的足球比赛"
    },
    {
      "sentence_id": "s14",
      "char_len": 8,
      "snippet": "为了增加比赛难度"
    },
    {
      "sentence_id": "s15",
      "char_len": 10,
      "snippet": "我们将不是在禁区里面"
    },
    {
      "sentence_id": "s16",
      "char_len": 8,
      "snippet": "而是在中圈里射门"
    },
    {
      "sentence_id": "s17",
      "char_len": 2,
      "snippet": "赢家"
    },
    {
      "sentence_id": "s18",
      "char_len": 12,
      "snippet": "会获得38000元的奖金"
    },
    {
      "sentence_id": "s19",
      "char_len": 13,
      "snippet": "和我们工作室至高无上的荣誉"
    },
    {
      "sentence_id": "s20",
      "char_len": 4,
      "snippet": "大力神鸽"
    },
    {
      "sentence_id": "s21",
      "char_len": 11,
      "snippet": "让我们等天亮后开始比赛"
    },
    {
      "sentence_id": "s22",
      "char_len": 15,
      "snippet": "有请我们的第一组选手静静和路佳"
    },
    {
      "sentence_id": "s23",
      "char_len": 13,
      "snippet": "来 静哥介绍一下你们的装置"
    },
    {
      "sentence_id": "s24",
      "char_len": 1,
      "snippet": "好"
    },
    {
      "sentence_id": "s25",
      "char_len": 6,
      "snippet": "我们的装置叫"
    },
    {
      "sentence_id": "s26",
      "char_len": 10,
      "snippet": "基于射击复合弓原理的"
    },
    {
      "sentence_id": "s27",
      "char_len": 9,
      "snippet": "无敌机械足球发射机"
    },
    {
      "sentence_id": "s28",
      "char_len": 2,
      "snippet": "简称"
    },
    {
      "sentence_id": "s29",
      "char_len": 5,
      "snippet": "基击复机机"
    },
    {
      "sentence_id": "s30",
      "char_len": 11,
      "snippet": "我们用了整整三把复合弓"
    },
    {
      "sentence_id": "s31",
      "char_len": 13,
      "snippet": "能产生将近1000牛的拉力"
    },
    {
      "sentence_id": "s32",
      "char_len": 14,
      "snippet": "首先通过电机转动丝杆进行拉弓"
    },
    {
      "sentence_id": "s33",
      "char_len": 7,
      "snippet": "等到达合适位置"
    },
    {
      "sentence_id": "s34",
      "char_len": 14,
      "snippet": "控制舵机扣动扳机进行足球发射"
    },
    {
      "sentence_id": "s35",
      "char_len": 5,
      "snippet": "在此基础上"
    },
    {
      "sentence_id": "s36",
      "char_len": 15,
      "snippet": "我们还加上了双轴自由度和摄像头"
    },
    {
      "sentence_id": "s37",
      "char_len": 4,
      "snippet": "结合算法"
    },
    {
      "sentence_id": "s38",
      "char_len": 7,
      "snippet": "能紧紧锁住目标"
    },
    {
      "sentence_id": "s39",
      "char_len": 4,
      "snippet": "俗称锁头"
    },
    {
      "sentence_id": "s40",
      "char_len": 10,
      "snippet": "让路佳给大家演示一下"
    },
    {
      "sentence_id": "s41",
      "char_len": 3,
      "snippet": "看一下"
    },
    {
      "sentence_id": "s42",
      "char_len": 4,
      "snippet": "直接锁到"
    },
    {
      "sentence_id": "s43",
      "char_len": 12,
      "snippet": "它就可以自动瞄着球门走吧"
    },
    {
      "sentence_id": "s44",
      "char_len": 2,
      "snippet": "是的"
    },
    {
      "sentence_id": "s45",
      "char_len": 1,
      "snippet": "哇"
    },
    {
      "sentence_id": "s46",
      "char_len": 11,
      "snippet": "那你这个不应该叫锁门吗"
    },
    {
      "sentence_id": "s47",
      "char_len": 7,
      "snippet": "为什么叫锁头啊"
    },
    {
      "sentence_id": "s48",
      "char_len": 5,
      "snippet": "给你看这个"
    },
    {
      "sentence_id": "s49",
      "char_len": 1,
      "snippet": "哎"
    },
    {
      "sentence_id": "s50",
      "char_len": 1,
      "snippet": "啊"
    },
    {
      "sentence_id": "s130",
      "char_len": 4,
      "snippet": "确实不错"
    },
    {
      "sentence_id": "s131",
      "char_len": 9,
      "snippet": "好好快我们继续比赛"
    },
    {
      "sentence_id": "s132",
      "char_len": 10,
      "snippet": "有请我们的小五和一凡"
    },
    {
      "sentence_id": "s133",
      "char_len": 11,
      "snippet": "他们是唯一一组没有用电"
    },
    {
      "sentence_id": "s134",
      "char_len": 8,
      "snippet": "而是用人力发射的"
    },
    {
      "sentence_id": "s135",
      "char_len": 11,
      "snippet": "快 介绍一下你们的装置"
    },
    {
      "sentence_id": "s136",
      "char_len": 13,
      "snippet": "我们的装置名字叫做西西弗斯"
    },
    {
      "sentence_id": "s137",
      "char_len": 10,
      "snippet": "古希腊掌管无用功的神"
    },
    {
      "sentence_id": "s138",
      "char_len": 6,
      "snippet": "我们先将足球"
    },
    {
      "sentence_id": "s139",
      "char_len": 8,
      "snippet": "放置在发射圆环里"
    },
    {
      "sentence_id": "s140",
      "char_len": 9,
      "snippet": "然后用人力动力跑轮"
    },
    {
      "sentence_id": "s141",
      "char_len": 8,
      "snippet": "带动加速装置旋转"
    },
    {
      "sentence_id": "s142",
      "char_len": 11,
      "snippet": "当转速达到我们的要求时"
    },
    {
      "sentence_id": "s143",
      "char_len": 5,
      "snippet": "释放发射盖"
    },
    {
      "sentence_id": "s144",
      "char_len": 11,
      "snippet": "将足球以19度仰角射出"
    },
    {
      "sentence_id": "s145",
      "char_len": 16,
      "snippet": "真的是一个非常奇怪的足球发射方式"
    },
    {
      "sentence_id": "s146",
      "char_len": 11,
      "snippet": "你们是从哪里获得的灵感"
    },
    {
      "sentence_id": "s147",
      "char_len": 13,
      "snippet": "我们的灵感主要来源于投石机"
    },
    {
      "sentence_id": "s148",
      "char_len": 9,
      "snippet": "还有仓鼠的那种跑轮"
    },
    {
      "sentence_id": "s149",
      "char_len": 13,
      "snippet": "就是我们的装置叫西西弗斯嘛"
    },
    {
      "sentence_id": "s150",
      "char_len": 6,
      "snippet": "然后我们觉得"
    },
    {
      "sentence_id": "s151",
      "char_len": 11,
      "snippet": "西西弗斯他永远没有办法"
    },
    {
      "sentence_id": "s152",
      "char_len": 10,
      "snippet": "把石头推到那个山顶上"
    },
    {
      "sentence_id": "s153",
      "char_len": 5,
      "snippet": "其实本质上"
    },
    {
      "sentence_id": "s154",
      "char_len": 15,
      "snippet": "和仓鼠永远没有办法跑出那个跑轮"
    },
    {
      "sentence_id": "s155",
      "char_len": 5,
      "snippet": "是非常像的"
    },
    {
      "sentence_id": "s156",
      "char_len": 8,
      "snippet": "但是从生理上来说"
    },
    {
      "sentence_id": "s157",
      "char_len": 16,
      "snippet": "仓鼠跑跑轮的时候是非常非常快乐的"
    },
    {
      "sentence_id": "s158",
      "char_len": 9,
      "snippet": "所以这给了我们一种"
    },
    {
      "sentence_id": "s159",
      "char_len": 11,
      "snippet": "一种信心去相信西西弗斯"
    },
    {
      "sentence_id": "s160",
      "char_len": 8,
      "snippet": "他应当也是幸福的"
    },
    {
      "sentence_id": "s161",
      "char_len": 5,
      "snippet": "所以你想说"
    },
    {
      "sentence_id": "s162",
      "char_len": 14,
      "snippet": "只要人有一个具体的目标在追求"
    },
    {
      "sentence_id": "s163",
      "char_len": 15,
      "snippet": "无论这个追求的过程有多么的虚无"
    },
    {
      "sentence_id": "s164",
      "char_len": 6,
      "snippet": "人都是幸福的"
    },
    {
      "sentence_id": "s165",
      "char_len": 3,
      "snippet": "不是的"
    },
    {
      "sentence_id": "s166",
      "char_len": 15,
      "snippet": "主要是仓鼠跑跑轮的时候非常可爱"
    },
    {
      "sentence_id": "s167",
      "char_len": 1,
      "snippet": "来"
    },
    {
      "sentence_id": "s168",
      "char_len": 6,
      "snippet": "感觉很有希望"
    },
    {
      "sentence_id": "s169",
      "char_len": 2,
      "snippet": "很快"
    },
    {
      "sentence_id": "s270",
      "char_len": 14,
      "snippet": "但他们利用守门员反应的时间差"
    },
    {
      "sentence_id": "s271",
      "char_len": 6,
      "snippet": "把球打了进去"
    },
    {
      "sentence_id": "s272",
      "char_len": 7,
      "snippet": "真是非常的聪明"
    },
    {
      "sentence_id": "s273",
      "char_len": 6,
      "snippet": "真的很了不起"
    },
    {
      "sentence_id": "s274",
      "char_len": 4,
      "snippet": "我的天哪"
    },
    {
      "sentence_id": "s275",
      "char_len": 16,
      "snippet": "接下来颁给你们我们至高无上的荣誉"
    },
    {
      "sentence_id": "s276",
      "char_len": 17,
      "snippet": "别看我们工作室的同事现在放得这么开"
    },
    {
      "sentence_id": "s277",
      "char_len": 8,
      "snippet": "其实他们和我一样"
    },
    {
      "sentence_id": "s278",
      "char_len": 6,
      "snippet": "都是老I人了"
    },
    {
      "sentence_id": "s279",
      "char_len": 14,
      "snippet": "大家平常在工作室话说得也不多"
    },
    {
      "sentence_id": "s280",
      "char_len": 9,
      "snippet": "默默地对着屏幕干活"
    },
    {
      "sentence_id": "s281",
      "char_len": 13,
      "snippet": "项目卡住了也免不了满面愁容"
    },
    {
      "sentence_id": "s282",
      "char_len": 4,
      "snippet": "唉声叹气"
    },
    {
      "sentence_id": "s283",
      "char_len": 9,
      "snippet": "但是一到了比赛项目"
    },
    {
      "sentence_id": "s284",
      "char_len": 7,
      "snippet": "就个个充满斗志"
    },
    {
      "sentence_id": "s285",
      "char_len": 11,
      "snippet": "还能想出各种各样的狠活"
    },
    {
      "sentence_id": "s286",
      "char_len": 13,
      "snippet": "我想这就是自驱和他驱的区别"
    },
    {
      "sentence_id": "s287",
      "char_len": 14,
      "snippet": "也是我们要搞DIY比赛的原因"
    },
    {
      "sentence_id": "s288",
      "char_len": 11,
      "snippet": "把大家的创造力推到极限"
    },
    {
      "sentence_id": "s289",
      "char_len": 18,
      "snippet": "让我们的工程师在镜头前自信地展示自己"
    },
    {
      "sentence_id": "s290",
      "char_len": 10,
      "snippet": "如果你有喜欢的组的话"
    },
    {
      "sentence_id": "s291",
      "char_len": 9,
      "snippet": "欢迎在评论区里投票"
    },
    {
      "sentence_id": "s292",
      "char_len": 9,
      "snippet": "但就不要写赢的组了"
    },
    {
      "sentence_id": "s293",
      "char_len": 8,
      "snippet": "他们已经很得瑟了"
    },
    {
      "sentence_id": "s294",
      "char_len": 16,
      "snippet": "如果你想看更多比赛相关的内容的话"
    },
    {
      "sentence_id": "s295",
      "char_len": 11,
      "snippet": "求赞求收藏求硬币求转发"
    },
    {
      "sentence_id": "s296",
      "char_len": 13,
      "snippet": "最重要的是点一个大大的关注"
    },
    {
      "sentence_id": "s297",
      "char_len": 17,
      "snippet": "各位的支持就是我们做视频的最大动力"
    },
    {
      "sentence_id": "s298",
      "char_len": 4,
      "snippet": "OK各位"
