      "char_len": 3,
      "snippet": "拿最後"
    },
    {
      "sentence_id": "s87",
      "char_len": 7,
      "snippet": "水刀切得開爐木"
    },
    {
      "sentence_id": "s88",
      "char_len": 5,
      "snippet": "不特之類嗎"
