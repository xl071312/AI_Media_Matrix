  "sentence_count": 120,
  "sentences_index": [
    {
      "sentence_id": "s1",
      "char_len": 25,
      "snippet": "图片截取自: 亚洲首富垄断印度经济，竟然被做空了？"
    },
    {
      "sentence_id": "s2",
      "char_len": 4,
      "snippet": "亚洲首富"
    },
    {
      "sentence_id": "s3",
      "char_len": 12,
      "snippet": "凭什么是这两位印度大佬？"
    },
    {
      "sentence_id": "s4",
      "char_len": 19,
      "snippet": "*内容来自小Lin说2023年5月视频"
    },
    {
      "sentence_id": "s5",
      "char_len": 25,
      "snippet": "图片截取自: 亚洲首富垄断印度经济，竟然被做空了？"
    },
    {
      "sentence_id": "s6",
      "char_len": 34,
      "snippet": "亚洲首富从2019年起就被两位印度大佬给包了，那就是阿达尼和安巴尼。"
    },
    {
      "sentence_id": "s7",
      "char_len": 30,
      "snippet": "他们背后的集团：阿达尼集团和信实工业更是笼罩了整个印度经济。"
    },
    {
      "sentence_id": "s8",
      "char_len": 13,
      "snippet": "你要是生活在印度，你可能："
    },
    {
      "sentence_id": "s9",
      "char_len": 21,
      "snippet": "用着安巴尼提供的无线网，和阿达尼提供的电；"
    },
    {
      "sentence_id": "s10",
      "char_len": 20,
      "snippet": "在安巴尼的网店上，买着阿达尼进口的商品；"
    },
    {
      "sentence_id": "s11",
      "char_len": 20,
      "snippet": "用着安巴尼炼的汽油，开在阿达尼建的路上；"
    },
    {
      "sentence_id": "s12",
      "char_len": 21,
      "snippet": "放着安巴尼出品的节目，去阿达尼运营的机场。"
    },
    {
      "sentence_id": "s13",
      "char_len": 23,
      "snippet": "反正你的生活，几乎不可能离开这两位的商业帝国。"
    },
    {
      "sentence_id": "s14",
      "char_len": 30,
      "snippet": "安巴尼被媒体称为是\"印度的洛克菲勒\"，达到了富可敌国的程度；"
    },
    {
      "sentence_id": "s15",
      "char_len": 59,
      "snippet": "而阿达尼从2020年开始突然半路杀了出来，2022年成为全世界身价飙升最多的人，"
    },
    {
      "sentence_id": "s16",
      "char_len": 34,
      "snippet": "可2023年的年初又被华尔街的做空机构给干倒，成了身价下跌最多的人。"
    },
    {
      "sentence_id": "s17",
      "char_len": 25,
      "snippet": "图片截取自: 亚洲首富垄断印度经济，竟然被做空了？"
    },
    {
      "sentence_id": "s18",
      "char_len": 12,
      "snippet": "图片截取自: 小Lin说"
    },
    {
      "sentence_id": "s19",
      "char_len": 6,
      "snippet": "这两位大佬："
    },
    {
      "sentence_id": "s20",
      "char_len": 16,
      "snippet": "一个拼的是爹，一个拼的是哥们儿；"
    },
    {
      "sentence_id": "s21",
      "char_len": 14,
      "snippet": "一个是真有实力，一个是虚胖；"
    },
    {
      "sentence_id": "s22",
      "char_len": 22,
      "snippet": "一个擅长搞排面，一个整天把国家利益挂在嘴边；"
    },
    {
      "sentence_id": "s23",
      "char_len": 14,
      "snippet": "一个叫安巴尼，一个叫阿达尼。"
    },
    {
      "sentence_id": "s24",
      "char_len": 19,
      "snippet": "咱们就来看看这两位叱咤印度的顶级富豪！"
    },
    {
      "sentence_id": "s25",
      "char_len": 25,
      "snippet": "图片截取自: 亚洲首富垄断印度经济，竟然被做空了？"
    },
    {
      "sentence_id": "s26",
      "char_len": 5,
      "snippet": "安巴尼崛起"
    },
    {
      "sentence_id": "s27",
      "char_len": 2,
      "snippet": "起家"
    },
    {
      "sentence_id": "s28",
      "char_len": 27,
      "snippet": "有个好老爹的安巴尼出生在1957年，比阿达尼大了5岁。"
    },
    {
      "sentence_id": "s29",
      "char_len": 68,
      "snippet": "而他爹老安巴尼在1958年，也就是安巴尼出生的第一年就建立了这个未来横扫印度的公"
    },
    {
      "sentence_id": "s30",
      "char_len": 65,
      "snippet": "之后一步一个脚印拓展到了纺织业，当时，印度经济普遍实行许可证制度，几乎所有事务均"
    },
    {
      "sentence_id": "s31",
      "char_len": 30,
      "snippet": "老安巴尼因为搞定了政府关系拿到了许可，一路势如破竹越做越大。"
    },
    {
      "sentence_id": "s32",
      "char_len": 9,
      "snippet": "在1977年上市。"
    },
    {
      "sentence_id": "s33",
      "char_len": 33,
      "snippet": "这时候的小安巴尼19岁，他老爸的公司刚上市，他也赶着好时候成年了。"
    },
    {
      "sentence_id": "s34",
      "char_len": 83,
      "snippet": "1980年，安巴尼在斯坦福大学读MBA读到一半，就被老爸拉回来培养经商了，也拉上"
    },
    {
      "sentence_id": "s35",
      "char_len": 47,
      "snippet": "到2000年初，信实工业已经成为印度最大的公司 ，而且远远甩开第二名，成为印度家"
    },
    {
      "sentence_id": "s36",
      "char_len": 16,
      "snippet": "被大家戏称是\"印度的洛克菲勒\"。"
    },
    {
      "sentence_id": "s37",
      "char_len": 25,
      "snippet": "图片截取自: 亚洲首富垄断印度经济，竟然被做空了？"
    },
    {
      "sentence_id": "s38",
      "char_len": 12,
      "snippet": "图片截取自: 小Lin说"
    },
    {
      "sentence_id": "s39",
      "char_len": 4,
      "snippet": "兄弟争斗"
    },
    {
      "sentence_id": "s40",
      "char_len": 52,
      "snippet": "2002年，老安巴尼因中风突然去世，遗憾的是，他未能留下遗嘱或建立信托，来指导其"
    },
    {
      "sentence_id": "s41",
      "char_len": 17,
      "snippet": "这导致了两兄弟之间激烈的遗产争夺。"
    },
    {
      "sentence_id": "s42",
      "char_len": 47,
      "snippet": "这场家族纷争最终由他们的母亲出面调解，于2005年达成了分割协议，将信实工业集团"
    },
    {
      "sentence_id": "s43",
      "char_len": 24,
      "snippet": "安巴尼拿到了：石油、天然气、化工、炼油和制造业；"
    },
    {
      "sentence_id": "s44",
      "char_len": 18,
      "snippet": "而弟弟阿尼尔拿到了电力、电信和金融。"
    },
    {
      "sentence_id": "s45",
      "char_len": 22,
      "snippet": "这才结束了这么一场牵动整个印度的管理层斗争。"
    },
    {
      "sentence_id": "s46",
      "char_len": 32,
      "snippet": "看起来好像是平分，其实 核心的赚钱业务基本上都给了哥哥安巴尼 。"
    },
    {
      "sentence_id": "s47",
      "char_len": 40,
      "snippet": "而这场斗争当时影响非常广，毕竟这个印度最大的集团，可是覆盖了印度四分之一的股民。"
    },
    {
      "sentence_id": "s48",
      "char_len": 25,
      "snippet": "图片截取自: 亚洲首富垄断印度经济，竟然被做空了？"
    },
    {
      "sentence_id": "s49",
      "char_len": 12,
      "snippet": "图片截取自: 小Lin说"
    },
    {
      "sentence_id": "s50",
      "char_len": 4,
      "snippet": "继续扩张"
    },
    {
      "sentence_id": "s60",
      "char_len": 22,
      "snippet": "信实工业在安巴尼的带领下市值又翻了40倍 。"
    },
    {
      "sentence_id": "s61",
      "char_len": 48,
      "snippet": "安巴尼本人从2019年开始就持续稳坐亚洲首富的宝座，在2022年被阿达尼赶超之前"
    },
    {
      "sentence_id": "s62",
      "char_len": 50,
      "snippet": "安巴尼也很高调，干得最出名的一件事儿就是专门给自己的家族在孟买精心设计并且建了一"
    },
    {
      "sentence_id": "s63",
      "char_len": 70,
      "snippet": "共37000平米，600个员工常驻在里面，有三个停机坪，6层楼的停车场，停了16"
    },
    {
      "sentence_id": "s64",
      "char_len": 52,
      "snippet": "信实工业整个集团也很符合安巴尼这种张扬的个性，特别高调，公司的一些发言、发布会搞"
    },
    {
      "sentence_id": "s65",
      "char_len": 25,
      "snippet": "图片截取自: 亚洲首富垄断印度经济，竟然被做空了？"
    },
    {
      "sentence_id": "s66",
      "char_len": 5,
      "snippet": "阿达尼崛起"
    },
    {
      "sentence_id": "s67",
      "char_len": 4,
      "snippet": "早期发展"
    },
    {
      "sentence_id": "s68",
      "char_len": 30,
      "snippet": "1962年，阿达尼出生在印度古吉拉特邦的一个普通中产家庭中。"
    },
    {
      "sentence_id": "s69",
      "char_len": 62,
      "snippet": "父亲是个小纺织商，在父亲的耳濡目染之下，他从小对经商也产生了浓厚的兴趣，大学读到"
    },
    {
      "sentence_id": "s70",
      "char_len": 63,
      "snippet": "1988年，26岁的阿达尼成立了阿达尼出口，也就是现在阿达尼集团的前身，主要就是"
    },
    {
      "sentence_id": "s71",
      "char_len": 51,
      "snippet": "1991年，对印度来说是关键的转折点，开始全面经济改革，走向市场化，也开始将很多"
    },
    {
      "sentence_id": "s72",
      "char_len": 15,
      "snippet": "阿达尼就借着这波大势迅速崛起；"
    },
    {
      "sentence_id": "s73",
      "char_len": 39,
      "snippet": "1995年，阿达尼又走出了关键一步，成功从政府那包下了他老家古吉拉特邦的港口；"
    },
    {
      "sentence_id": "s74",
      "char_len": 58,
      "snippet": "阿达尼是搞贸易的，又赶上了经济全面市场化，又包下了港口，不出所料他的业务做得风生"
    },
    {
      "sentence_id": "s75",
      "char_len": 31,
      "snippet": "到了2000年，阿达尼已经成为了古吉拉特邦富甲一方的商业大佬。"
    },
    {
      "sentence_id": "s76",
      "char_len": 33,
      "snippet": "虽然这时候他已经很厉害了，但在印度全国范围内，肯定还是排不上号的。"
    },
    {
      "sentence_id": "s77",
      "char_len": 22,
      "snippet": "他的下一步腾飞，就要仰仗一位他的贵人了..."
    },
    {
      "sentence_id": "s78",
      "char_len": 25,
      "snippet": "图片截取自: 亚洲首富垄断印度经济，竟然被做空了？"
    },
    {
      "sentence_id": "s79",
      "char_len": 12,
      "snippet": "图片截取自: 小Lin说"
    },
    {
      "sentence_id": "s80",
      "char_len": 7,
      "snippet": "印度总理：莫迪"
    },
    {
      "sentence_id": "s81",
      "char_len": 30,
      "snippet": "就在2001年，古吉拉特邦上任了一个\"第一部长\"，叫做莫迪。"
    },
    {
      "sentence_id": "s82",
      "char_len": 10,
      "snippet": "是不是听着有点耳熟?"
    },
    {
      "sentence_id": "s83",
      "char_len": 13,
      "snippet": "没错，他就是现任印度总理。"
    },
    {
      "sentence_id": "s84",
      "char_len": 16,
      "snippet": "阿达尼跟莫迪俩人关系非常不一般。"
    },
    {
      "sentence_id": "s85",
      "char_len": 52,
      "snippet": "在莫迪还在管古吉拉特邦的时候，俩人就 商政合并 ，你帮我选举、发展、搞政绩，我帮"
    },
    {
      "sentence_id": "s86",
      "char_len": 37,
      "snippet": "当时政府拍卖一些土地，卖给各种私企的价格是470 - 1110卢比/平米；"
    },
    {
      "sentence_id": "s87",
      "char_len": 46,
      "snippet": "而最后阿达尼不知道怎么的，到手价最高也只有32卢比/平米，而有些地甚至 低到1卢"
    },
    {
      "sentence_id": "s88",
      "char_len": 32,
      "snippet": "这就是其中的一个例子，你就能想象阿达尼集团从政府那拿了多少好处。"
    },
    {
      "sentence_id": "s89",
      "char_len": 47,
      "snippet": "2014年莫迪参选印度总理，经常要全国范围飞来飞去，一直坐的都是阿达尼集团特供的"
    },
    {
      "sentence_id": "s90",
      "char_len": 12,
      "snippet": "这大家都已经见怪不怪了。"
    },
    {
      "sentence_id": "s91",
      "char_len": 51,
      "snippet": "一个挺有意思的现象是什么呢，就是那年大选随着莫迪当选的胜率越来越高，阿达尼集团的"
    },
    {
      "sentence_id": "s92",
      "char_len": 20,
      "snippet": "最后 莫迪当选，阿达尼的股票翻了三倍 ！"
    },
    {
      "sentence_id": "s93",
      "char_len": 25,
      "snippet": "图片截取自: 亚洲首富垄断印度经济，竟然被做空了？"
    },
    {
      "sentence_id": "s94",
      "char_len": 12,
      "snippet": "图片截取自: 小Lin说"
    },
    {
      "sentence_id": "s95",
      "char_len": 47,
      "snippet": "甭管媒体如何洗白，这资本市场还是诚实的，当时是个印度人都知道：阿达尼和莫迪那就是"
    },
    {
      "sentence_id": "s96",
      "char_len": 65,
      "snippet": "后来到了2018年，印度要拍卖6个机场，结果没有任何航空业务经验的阿达尼集团居然"
    },
    {
      "sentence_id": "s97",
      "char_len": 60,
      "snippet": "2023年， 阿达尼集团就有七家上市公司 ，业务涵盖了发电、矿业、电网、机场、天"
    },
    {
      "sentence_id": "s98",
      "char_len": 71,
      "snippet": "而阿达尼为数不多的公开言论中，总是会强调阿达尼集团和印度这个国家的利益那是深深绑"
    },
    {
      "sentence_id": "s99",
      "char_len": 1,
      "snippet": "！"
    },
    {
      "sentence_id": "s130",
      "char_len": 46,
      "snippet": "几个小时之后，它们发布了一个长达一百多页的做空报告—— 指控阿达尼集团操纵股票、"
    },
    {
      "sentence_id": "s131",
      "char_len": 51,
      "snippet": "报告列了海量的证据，主要内容就是：阿达尼集团虽然是个上市公司，但阿达尼本人和他的"
    },
    {
      "sentence_id": "s132",
      "char_len": 20,
      "snippet": "这个比例压根就不像个上市公司该有的比例。"
    },
    {
      "sentence_id": "s133",
      "char_len": 45,
      "snippet": "试想一下，阿达尼一个人攥着那么多股份，市场上真正流通的股票就很少了，这就非常容易"
    },
    {
      "sentence_id": "s134",
      "char_len": 39,
      "snippet": "他稍微花点钱买入，股票就往上猛涨，然后他手上那75%的股票全都跟着水涨船高了。"
    },
    {
      "sentence_id": "s135",
      "char_len": 56,
      "snippet": "这就是报告里分析的阿达尼的套路，他哥在毛里求斯和开曼群岛偷偷建了至少38家空壳公"
    },
    {
      "sentence_id": "s136",
      "char_len": 34,
      "snippet": "这样一方面自己可以控制更多阿达尼集团的股票，同时也可以操控它的股价。"
    },
    {
      "sentence_id": "s137",
      "char_len": 55,
      "snippet": "这些空壳公司的股票交易就占到了阿达尼集团全部股票交易的30%-50%，这才导致这"
    },
    {
      "sentence_id": "s138",
      "char_len": 9,
      "snippet": "股票涨完了之后呢？"
    },
    {
      "sentence_id": "s139",
      "char_len": 50,
      "snippet": "阿达尼就可以拿这些股票去找银行抵押贷款，贷出大量的钱去玩下一轮，也导致了阿达尼集"
    },
    {
      "sentence_id": "s140",
      "char_len": 29,
      "snippet": "报告一经曝出，整个证据链完整， 阿达尼股票立刻全线暴跌 。"
    },
    {
      "sentence_id": "s141",
      "char_len": 25,
      "snippet": "图片截取自: 亚洲首富垄断印度经济，竟然被做空了？"
    },
    {
      "sentence_id": "s142",
      "char_len": 12,
      "snippet": "视频截取自: 小Lin说"
    },
    {
      "sentence_id": "s143",
      "char_len": 2,
      "snippet": "反击"
    },
    {
      "sentence_id": "s144",
      "char_len": 74,
      "snippet": "阿达尼集团赶紧在五天之后就出了一份四百多页的报告，也不管是不是相关数据，反正全堆"
    },
    {
      "sentence_id": "s145",
      "char_len": 44,
      "snippet": "阿达尼自己也拍视频，站出来回应：我的公司没问题，我们的资产负债表很健康，投资人要"
    },
    {
      "sentence_id": "s146",
      "char_len": 55,
      "snippet": "而且，还拿出了阿达尼的杀手锏：公司都是为了印度的国家建设，攻击我就是攻击印度，这"
    },
    {
      "sentence_id": "s147",
      "char_len": 73,
