  "source_sha256": "3cd175b43d6f99eac55d71f7a1cc4eaaadeac6841c3acaf9ce946f9446d40cb0",
  "performance_tier": "HIGH",
  "spoken_marker_eligible": "N/A_TEXT",
  "analysis_status": "OK",
  "analyzer_version": "phase_c_v1",
  "sentence_count": 119,
  "sentences_index": [
    {
      "sentence_id": "s1",
      "char_len": 4,
      "snippet": "全球经济"
    },
    {
      "sentence_id": "s2",
      "char_len": 12,
      "snippet": "2024年发展得怎么样？"
    },
    {
      "sentence_id": "s3",
      "char_len": 29,
      "snippet": "朋友们，一年一度的重磅内容来了——2024年全球经济概览。"
    },
    {
      "sentence_id": "s4",
      "char_len": 19,
      "snippet": "先帮大家梳理一下, 这期内容的大框架。"
    },
    {
      "sentence_id": "s5",
      "char_len": 13,
      "snippet": "全球、各个国家的经济全貌："
    },
    {
      "sentence_id": "s6",
      "char_len": 14,
      "snippet": "全球整体这一年发展得怎么样?"
    },
    {
      "sentence_id": "s7",
      "char_len": 15,
      "snippet": "中国的经济遇到了什么样的问题？"
    },
    {
      "sentence_id": "s8",
      "char_len": 10,
      "snippet": "美国的经济到底如何？"
    },
    {
      "sentence_id": "s9",
      "char_len": 27,
      "snippet": "日本、德国、阿根廷、俄罗斯、印度是个什么情况等等..."
    },
    {
      "sentence_id": "s10",
      "char_len": 14,
      "snippet": "也稍微夹带一些我自己的分析。"
    },
    {
      "sentence_id": "s11",
      "char_len": 25,
      "snippet": "我的盘点可能会和大家看到的大部分经济概览不一样啊："
    },
    {
      "sentence_id": "s12",
      "char_len": 79,
      "snippet": "很多人可能给你捋一遍2024发生所有的大事儿、头条，1月发生了什么，2月发生了什么... 给你听得热血沸腾的，可听完了，你可能没法知道哪个是重点，逻辑是什么；"
    },
    {
      "sentence_id": "s13",
      "char_len": 40,
      "snippet": "也有些人可能会有专业的财经分析、财报那种，各种表逐一分析数据，让人比较容易犯困。"
    },
    {
      "sentence_id": "s14",
      "char_len": 53,
      "snippet": "我想做的是找一个中间态，逻辑上是像财报一样专业，但同时又尽量说人话，扔掉那些过于细枝末节、过于专业的数据。"
    },
    {
      "sentence_id": "s15",
      "char_len": 21,
      "snippet": "废话少说，我们开始，2024全球经济概览~"
    },
    {
      "sentence_id": "s16",
      "char_len": 12,
      "snippet": "图片截取自: 小Lin说"
    },
    {
      "sentence_id": "s17",
      "char_len": 4,
      "snippet": "全球总览"
    },
    {
      "sentence_id": "s18",
      "char_len": 39,
      "snippet": "2024年之前，虽然全球的经济称不上陷入衰退，但确实是处于一种非常动荡的状态。"
    },
    {
      "sentence_id": "s19",
      "char_len": 20,
      "snippet": "疫情、俄乌战争、通货膨胀、各国紧急加息。"
    },
    {
      "sentence_id": "s20",
      "char_len": 76,
      "snippet": "这就导致一连串的危机：全球供应链危机、欧洲的能源危机、美国的银行业危机、日本的日元危机、英国的债务危机、中国的房地产危机、非洲的粮食危机，等等等等..."
    },
    {
      "sentence_id": "s21",
      "char_len": 23,
      "snippet": "大家能想象么，这么多危机都集中发生在这两年里。"
    },
    {
      "sentence_id": "s22",
      "char_len": 49,
      "snippet": "这里随便哪个单拿出来，放到疫情之前，简直都是核弹级别的危机，潜在是可能引起全球金融海啸这个级别的。"
    },
    {
      "sentence_id": "s23",
      "char_len": 23,
      "snippet": "但实际上，我们都晃晃悠悠、摇摇摆摆地挺过来了。"
    },
    {
      "sentence_id": "s24",
      "char_len": 35,
      "snippet": "(之前发生的事儿咱这次不细说了，感兴趣的朋友可以翻翻往期文章和视频~）"
    },
    {
      "sentence_id": "s25",
      "char_len": 12,
      "snippet": "图片截取自: 小Lin说"
    },
    {
      "sentence_id": "s26",
      "char_len": 8,
      "snippet": "而2024年呢？"
    },
    {
      "sentence_id": "s27",
      "char_len": 59,
      "snippet": "其实主要的政治经济大事件都只是事件，不是\"雷\", 比如美国大选、中国大规模刺激、日本加息、美联储降息，这都只是个事儿。"
    },
    {
      "sentence_id": "s28",
      "char_len": 24,
      "snippet": "相比之前两年那么惊心动魄，可以说真的是相当平稳。"
    },
    {
      "sentence_id": "s29",
      "char_len": 36,
      "snippet": "GDP增长3.2%，通货膨胀率也在进一步回落，但是失业率是在缓慢上升的。"
    },
    {
      "sentence_id": "s30",
      "char_len": 23,
      "snippet": "所以2024年全球经济我的总结就是：有韧性的。"
    },
    {
      "sentence_id": "s31",
      "char_len": 21,
      "snippet": "其实这不光是我的总结了，很多研报都这么说。"
    },
    {
      "sentence_id": "s32",
      "char_len": 42,
      "snippet": "而且，真的有很多分析师爱用这个词儿，听起来特别的高级，有韧性的，Resilient。"
    },
    {
      "sentence_id": "s33",
      "char_len": 9,
      "snippet": "其实是什么意思呢？"
    },
    {
      "sentence_id": "s34",
      "char_len": 9,
      "snippet": "就是凑合，还可以。"
    },
    {
      "sentence_id": "s35",
      "char_len": 41,
      "snippet": "毕竟客观环境又不太好，但是整体经济撑住了，大家表现得很有意志力，很坚韧，我们真棒！"
    },
    {
      "sentence_id": "s36",
      "char_len": 39,
      "snippet": "相比\"一般\"、 \"平庸\"这类词，\"有韧性\"这个形容，就更有一种自我激励的感觉。"
    },
    {
      "sentence_id": "s37",
      "char_len": 12,
      "snippet": "图片截取自: 小Lin说"
    },
    {
      "sentence_id": "s38",
      "char_len": 7,
      "snippet": "关键词一：大选"
    },
    {
      "sentence_id": "s39",
      "char_len": 33,
      "snippet": "2024年的全球经济有两个关键词，一个是\"转向\"，一个是\"大选\"。"
    },
    {
      "sentence_id": "s40",
      "char_len": 9,
      "snippet": "\"大选\"很好理解。"
    },
    {
      "sentence_id": "s41",
      "char_len": 87,
      "snippet": "2024年对全球来说是一个超级大选年，全球有至少70个国家，比如美国、印度、巴基斯坦、印度尼西亚、俄罗斯、英国、法国、墨西哥、欧盟议会等等，覆盖超过49%人口，"
    },
    {
      "sentence_id": "s42",
      "char_len": 9,
      "snippet": "大致上的一些趋势:"
    },
    {
      "sentence_id": "s43",
      "char_len": 16,
      "snippet": "各国政府内部的分歧普遍正在加大；"
    },
    {
      "sentence_id": "s44",
      "char_len": 12,
      "snippet": "民粹主义普遍得到了增强；"
    },
    {
      "sentence_id": "s45",
      "char_len": 19,
      "snippet": "整体更右移了，不过这里面英国是个例外;"
    },
    {
      "sentence_id": "s46",
      "char_len": 20,
      "snippet": "还有就是原来的执政党，表现普遍都不太好。"
    },
    {
      "sentence_id": "s47",
      "char_len": 5,
      "snippet": "举几个例:"
    },
    {
      "sentence_id": "s48",
      "char_len": 9,
      "snippet": "美国，就不用说了；"
    },
    {
      "sentence_id": "s49",
      "char_len": 50,
      "snippet": "英国，保守党结束了14年的执政，工党赢得压倒性多数，它其实更左倾一点，大政府一点，在全球算是个特例。"
    },
    {
      "sentence_id": "s50",
      "char_len": 12,
      "snippet": "图片截取自: 小Lin说"
    },
    {
      "sentence_id": "s51",
      "char_len": 7,
      "snippet": "关键词二：转向"
    },
    {
      "sentence_id": "s52",
      "char_len": 36,
      "snippet": "2024年的另一个关键词就是 \"转向\"，这个转向我主要指的是政策的转向。"
    },
    {
      "sentence_id": "s53",
      "char_len": 66,
      "snippet": "2023年下半年开始，全球的通胀就开始缓和，尤其是核心商品的通胀，基本上已经回归正常，油价也降下来了，OPEC+都减产来控制油价了。"
    },
    {
      "sentence_id": "s54",
      "char_len": 42,
      "snippet": "只是服务的通胀整体还比较高，比如理发、搓澡这类服务，因为它毕竟更滞后、更有粘性一点。"
    },
    {
      "sentence_id": "s55",
      "char_len": 34,
      "snippet": "在这种整体温度下降的大背景下，大部分经济体就开始把刹车缓慢地松开了。"
    },
    {
      "sentence_id": "s56",
      "char_len": 29,
      "snippet": "2024年全球主要37个央行里，有27个都开始了降息周期。"
    },
    {
      "sentence_id": "s57",
      "char_len": 34,
      "snippet": "本来大家是都盯着美国，美联储体量大先开始，\"小弟们\"才好一起跟上么。"
    },
    {
      "sentence_id": "s58",
      "char_len": 31,
      "snippet": "结果美联储迟迟没有行动，开始以为它春天降息，耗到立秋了还没降。"
    },
    {
      "sentence_id": "s59",
      "char_len": 47,
      "snippet": "其它国家都等不及了，英国、加拿大、欧元区、瑞士等等都开始降息，美联储9月份，才发现好像降晚了。"
    },
    {
      "sentence_id": "s60",
      "char_len": 19,
      "snippet": "于是赶紧多降点，上来就降了50个基点。"
    },
    {
      "sentence_id": "s61",
      "char_len": 46,
      "snippet": "日本正好反过来，它并不是降息，而是从持续了8年的负利率政策中首次开始加息，也是一个重大转向；"
    },
    {
      "sentence_id": "s62",
      "char_len": 76,
      "snippet": "中国虽然没有方向上的转变，一直在降息，但是9月份开始，货币政策、财政政策接连发大招加强刺激，中央的话语体系也发生了明显的转变，这其实也可以说是一个转向。"
    },
    {
      "sentence_id": "s63",
      "char_len": 28,
      "snippet": "目前整体来看，大家的转向，都比较小心（毕竟是第一步嘛）。"
    },
    {
      "sentence_id": "s64",
      "char_len": 14,
      "snippet": "并没出现什么出乎意料的结果。"
    },
    {
      "sentence_id": "s65",
      "char_len": 12,
      "snippet": "图片截取自: 小Lin说"
    },
    {
      "sentence_id": "s66",
      "char_len": 2,
      "snippet": "美国"
    },
    {
      "sentence_id": "s67",
      "char_len": 7,
      "snippet": "大框架说完了。"
    },
    {
      "sentence_id": "s68",
      "char_len": 16,
      "snippet": "咱们聚焦看一下各个经济体的表现。"
    },
    {
      "sentence_id": "s69",
      "char_len": 9,
      "snippet": "首先先来看看美国。"
    },
    {
      "sentence_id": "s70",
      "char_len": 39,
      "snippet": "美国2024年GDP增长2.8%，2023、2024年连续两年超过了市场预期。"
    },
    {
      "sentence_id": "s71",
      "char_len": 19,
      "snippet": "可以说是所有发达经济体中表现最亮眼的。"
    },
    {
      "sentence_id": "s72",
      "char_len": 21,
      "snippet": "亮眼到大家都感觉这有点不合理了，不应该啊?"
    },
    {
      "sentence_id": "s73",
      "char_len": 1,
      "snippet": "!"
    },
    {
      "sentence_id": "s74",
      "char_len": 23,
      "snippet": "利率都加到那么高，怎么还保持这么强劲的内需呢？"
    },
    {
      "sentence_id": "s75",
      "char_len": 31,
      "snippet": "这也是为什么去年我总结美国的经济叫\"莫名其妙\"嘛，现在还适用。"
    },
    {
      "sentence_id": "s76",
      "char_len": 89,
      "snippet": "原因有可能是超额储蓄，就是大家之前存了一大波钱、有可能是很多人在加息之前就加了一波杠杆、贷款买房了、有可能是非法移民的涌入、有可能是股票增长带来的财富效应，也有"
    },
    {
      "sentence_id": "s77",
      "char_len": 13,
      "snippet": "总之，美国的内需比较旺盛。"
    },
    {
      "sentence_id": "s78",
      "char_len": 14,
      "snippet": "其实之前大家担心的是什么呀？"
    },
    {
      "sentence_id": "s79",
      "char_len": 23,
      "snippet": "摩根大通特别爱用的一个形容，叫\"温水煮青蛙\"。"
    },
    {
      "sentence_id": "s80",
      "char_len": 71,
      "snippet": "青蛙放在正在加热的温水里，开始可能还觉得真暖和，真舒服，它还没有意识到环境正在缓慢、不可逆的恶化，等到它感觉\"烫烫烫烫烫\"的时候，就已经晚了。"
    },
    {
      "sentence_id": "s81",
      "char_len": 72,
      "snippet": "这个开水，摩根大通指的就是高利率的环境，它本来以为2024年美国经济很有可能会出些问题，要么商业地产，要么经济上出现明显的下滑，青蛙会感觉到烫。"
    },
    {
      "sentence_id": "s82",
      "char_len": 7,
      "snippet": "没想到都没有！"
    },
    {
      "sentence_id": "s83",
      "char_len": 28,
      "snippet": "这也是美联储为什么憋到9月份才迟迟开始降息的一部分原因。"
    },
    {
      "sentence_id": "s84",
      "char_len": 12,
      "snippet": "视频截取自: 小Lin说"
    },
    {
      "sentence_id": "s85",
      "char_len": 6,
      "snippet": "企业利润率高"
    },
    {
      "sentence_id": "s86",
      "char_len": 54,
      "snippet": "这个美国经济这么多数据里面，有一个数据非常引人瞩目，增长相当快，就是它的公司利润，2024年增长了7.7%。"
    },
    {
      "sentence_id": "s87",
      "char_len": 22,
      "snippet": "美国企业的利润率达到了70年代以来的最高点。"
    },
    {
      "sentence_id": "s88",
      "char_len": 33,
      "snippet": "简而言之就是疫情过后，美国的公司反而达到了自二战以来最赚钱的时候。"
    },
    {
      "sentence_id": "s89",
      "char_len": 39,
      "snippet": "观察BlackRock对比美国、欧洲和除日本以外的亚洲企业最近20年的利润率。"
    },
    {
      "sentence_id": "s109",
      "char_len": 44,
      "snippet": "所以最近五年，企业家和打工人之间的贫富差距在拉大，小企业和大企业之间的贫富差距也在拉大。"
    },
    {
      "sentence_id": "s110",
      "char_len": 99,
      "snippet": "这也是为什么美国的数据很好看，可是很多美国人的感受却并不明显、甚至会反过来，感觉这两年活的并没有以前滋润，毕竟连硅谷、华尔街、好莱坞都开始大规模裁员了，财富越来"
    },
    {
      "sentence_id": "s111",
      "char_len": 12,
      "snippet": "图片截取自: 小Lin说"
    },
    {
      "sentence_id": "s112",
      "char_len": 5,
      "snippet": "美联储政策"
    },
    {
      "sentence_id": "s113",
      "char_len": 12,
      "snippet": "咱来说说美国的货币政策。"
    },
    {
      "sentence_id": "s114",
      "char_len": 29,
      "snippet": "我们知道美联储的政策牵动着美元，美元牵动着全球的金融市场。"
    },
    {
      "sentence_id": "s115",
      "char_len": 22,
      "snippet": "所以大家都盯着美联储，盯着鲍威尔的一举一动。"
    },
    {
      "sentence_id": "s116",
      "char_len": 9,
      "snippet": "而鲍威尔盯着什么？"
    },
    {
      "sentence_id": "s117",
      "char_len": 16,
      "snippet": "最主要的就是美国的通胀和失业率。"
    },
    {
      "sentence_id": "s118",
      "char_len": 52,
      "snippet": "现在的大致情况是：通货膨胀已经落在比较稳的区间，正在一点一点被大家抛在脑后，美联储关注的焦点就在失业率。"
    },
    {
      "sentence_id": "s119",
      "char_len": 44,
      "snippet": "11月是4.2%，一般感觉如果在4.5%以下徘徊，美联储降息的节奏应该就不怎么会受影响。"
    },
    {
      "sentence_id": "s120",
      "char_len": 34,
      "snippet": "其实这回美联储降息，并不会像2年前加息一样，掀起全球资本的滔天巨浪。"
    },
    {
      "sentence_id": "s121",
      "char_len": 20,
      "snippet": "一个是当时加息非常突然，大家都没有预期。"
    },
    {
      "sentence_id": "s122",
      "char_len": 16,
      "snippet": "再有就是它的幅度是完全不一样的。"
    },
    {
      "sentence_id": "s123",
      "char_len": 22,
      "snippet": "当时是从0加到了5.5%，加了五百多个基点；"
    },
    {
      "sentence_id": "s124",
      "char_len": 52,
      "snippet": "而现在呢，已经降到了4.5%，最终大家预期就会降到3.5%左右，不会再回到2%以下，甚至0%利率时代的。"
    },
    {
      "sentence_id": "s125",
      "char_len": 18,
      "snippet": "所以也就剩大概100个基点的空间了。"
    },
    {
      "sentence_id": "s126",
      "char_len": 12,
      "snippet": "视频截取自: 小Lin说"
    },
    {
      "sentence_id": "s127",
      "char_len": 8,
      "snippet": "特朗普2.0时代"
    },
    {
      "sentence_id": "s128",
      "char_len": 40,
      "snippet": "咱们来说一下接下来，特朗普2.0时代，它可能的一些政策，基本上是这么几个大方向:"
