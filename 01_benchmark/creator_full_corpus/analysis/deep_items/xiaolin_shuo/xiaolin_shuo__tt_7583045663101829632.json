  "performance_tier": "MEDIAN",
  "spoken_marker_eligible": "N/A_TEXT",
  "analysis_status": "OK",
  "analyzer_version": "phase_c_v1",
  "sentence_count": 120,
  "sentences_index": [
    {
      "sentence_id": "s1",
      "char_len": 2,
      "snippet": "赌球"
    },
    {
      "sentence_id": "s2",
      "char_len": 9,
      "snippet": "怎么赌,怎么赚钱？"
    },
    {
      "sentence_id": "s3",
      "char_len": 4,
      "snippet": "【注意】"
    },
    {
      "sentence_id": "s4",
      "char_len": 20,
      "snippet": "本视频涉及赌球案例与行业分析，旨在科普。"
    },
    {
      "sentence_id": "s5",
      "char_len": 38,
      "snippet": "请务必遵守国家法律法规，坚决抵制任何形式的非法博彩，保护好自己的财产与安全。"
    },
    {
      "sentence_id": "s6",
      "char_len": 18,
      "snippet": "赌球，是个大多数人熟悉而又陌生的词。"
    },
    {
      "sentence_id": "s7",
      "char_len": 26,
      "snippet": "新闻里经常和犯罪、操控比赛、洗钱、高利贷联系在一起。"
    },
    {
      "sentence_id": "s8",
      "char_len": 56,
      "snippet": "2018年世界杯期间，北京警方查出一特大网络赌球犯罪团伙，抓获违法犯罪嫌疑人46名，涉赌流水资金超过3.2亿元。"
    },
    {
      "sentence_id": "s9",
      "char_len": 66,
      "snippet": "2025年土耳其爆出重大裁判赌球案，足协发现它联赛的571名裁判中，有371人持有博彩账号，其中152人活跃下注比赛，涉嫌操纵比赛。"
    },
    {
      "sentence_id": "s10",
      "char_len": 36,
      "snippet": "2015年，北美跨国犯罪集团ODOG Enterprise被FBI端掉。"
    },
    {
      "sentence_id": "s11",
      "char_len": 68,
      "snippet": "它的创始人，绰号ODOG的欧文·汉森，曾是美国名流圈最知名的地下体育博彩庄家，涉及体育博彩、毒品走私、洗钱等，被判处225个月有期徒刑。"
    },
    {
      "sentence_id": "s12",
      "char_len": 29,
      "snippet": "类似的案子比比皆是，这些都只是全球体育博彩行业的冰山一角。"
    },
    {
      "sentence_id": "s13",
      "char_len": 42,
      "snippet": "据估算，2024年全球体育博彩总下注额，超过了1.5万亿美元，是智能手机市场的三倍。"
    },
    {
      "sentence_id": "s14",
      "char_len": 27,
      "snippet": "\"赌球\"这个词，是不是听着就违法，感觉跟\"洗钱\"一样。"
    },
    {
      "sentence_id": "s15",
      "char_len": 21,
      "snippet": "其实我们今天要聊的，确切来说，是体育博彩。"
    },
    {
      "sentence_id": "s16",
      "char_len": 36,
      "snippet": "这里包括线上、线下，包括赌球、赌马，包括赌场、博彩平台，也包括体育彩票。"
    },
    {
      "sentence_id": "s17",
      "char_len": 27,
      "snippet": "绝大多数国家地区，都是有一些合法的渠道允许体育博彩的。"
    },
    {
      "sentence_id": "s18",
      "char_len": 33,
      "snippet": "比如美国，2018年之前，全国范围除了拉斯维加斯，几乎是全面禁止。"
    },
    {
      "sentence_id": "s19",
      "char_len": 39,
      "snippet": "NFL之前也一直都是非常抵制赌球，说它是美式橄榄球最大的威胁，我们一定要警惕！"
    },
    {
      "sentence_id": "s20",
      "char_len": 5,
      "snippet": "可现在呢？"
    },
    {
      "sentence_id": "s21",
      "char_len": 41,
      "snippet": "美国转播的橄榄球比赛，中插广告、赛场里的大屏幕，各种博彩的广告、滚动的赔率满天飞。"
    },
    {
      "sentence_id": "s22",
      "char_len": 27,
      "snippet": "英超联赛里更夸张，超过一半球队的赞助商是体育博彩公司。"
    },
    {
      "sentence_id": "s23",
      "char_len": 22,
      "snippet": "这个体育博彩产业，横跨黑白两道却又如此庞大。"
    },
    {
      "sentence_id": "s24",
      "char_len": 30,
      "snippet": "咱们今天就来一口气聊聊这个游走在法律边缘的产业——体育博彩。"
    },
    {
      "sentence_id": "s25",
      "char_len": 4,
      "snippet": "市场介绍"
    },
    {
      "sentence_id": "s26",
      "char_len": 36,
      "snippet": "首先，我们站在宏观的视角，简单地观察一下，全球体育博彩市场的规模和分布。"
    },
    {
      "sentence_id": "s27",
      "char_len": 4,
      "snippet": "足球市场"
    },
    {
      "sentence_id": "s28",
      "char_len": 15,
      "snippet": "全球最赚钱的足球俱乐部，是谁？"
    },
    {
      "sentence_id": "s29",
      "char_len": 6,
      "snippet": "皇家马德里。"
    },
    {
      "sentence_id": "s30",
      "char_len": 57,
      "snippet": "它是唯一一个突破了十亿欧元营收大关的俱乐部，2024 - 2025年营收11.85亿欧元, 也就是13.7亿美元；"
    },
    {
      "sentence_id": "s31",
      "char_len": 36,
      "snippet": "欧洲五大联赛最赚钱的英超，每年所有俱乐部加上主办方总共赚大约85亿美元；"
    },
    {
      "sentence_id": "s32",
      "char_len": 35,
      "snippet": "欧洲所有足球联赛，各个级别、各个国家的营收加起来，大约是450亿美元；"
    },
    {
      "sentence_id": "s33",
      "char_len": 51,
      "snippet": "而据估算，全球体育博彩市场里和足球相关的博彩，也就是俗称的赌球，光庄家、平台的营收就高达750亿美元；"
    },
    {
      "sentence_id": "s34",
      "char_len": 41,
      "snippet": "但这只是庄家的营收，大家真正的下注额，还要再高一个数量级，据估算有8000亿美元。"
    },
    {
      "sentence_id": "s35",
      "char_len": 41,
      "snippet": "由此可知，所有踢球、玩球的所谓实体玩家赚钱的总和，还不到背后下注赌他们输赢的零头。"
    },
    {
      "sentence_id": "s36",
      "char_len": 81,
      "snippet": "再比如美国的体育博彩市场，它其实是从2018年才发展起来的，博彩总下注额已经超过了 NBA (110亿) 、NFL (190)、MLB(120) 营收总和的三倍"
    },
    {
      "sentence_id": "s37",
      "char_len": 26,
      "snippet": "都是一个相对小的实体市场，撬动了背后巨大的博彩市场。"
    },
    {
      "sentence_id": "s38",
      "char_len": 92,
      "snippet": "这其实和金融市场很像，当市场发展到一定程度，衍生品市场的大小是数十倍于本体、实体市场的大小，比如黄金期货、原油期货、股票期货，这些期货市场的大小要比真正的黄金、"
    },
    {
      "sentence_id": "s39",
      "char_len": 12,
      "snippet": "视频截取自: 小Lin说"
    },
    {
      "sentence_id": "s40",
      "char_len": 4,
      "snippet": "市场大小"
    },
    {
      "sentence_id": "s41",
      "char_len": 34,
      "snippet": "全球2024年体育博彩总投注，据估算可能高达1.5 - 2万亿美元。"
    },
    {
      "sentence_id": "s42",
      "char_len": 27,
      "snippet": "因为这里有大量的灰色地下产业，所以我们只能粗略地估算。"
    },
    {
      "sentence_id": "s43",
      "char_len": 11,
      "snippet": "这里面赌什么的最多呢？"
    },
    {
      "sentence_id": "s44",
      "char_len": 23,
      "snippet": "最主要的就是足球，大概占了35% - 50%。"
    },
    {
      "sentence_id": "s45",
      "char_len": 36,
      "snippet": "号称\"世界第一运动\"呢，至少从博彩的角度看，它确实是无可争议的第一运动。"
    },
    {
      "sentence_id": "s46",
      "char_len": 44,
      "snippet": "然后比较主要的是篮球、赛马、美式橄榄球，板球也挺多的，主要来自印度、巴基斯坦、澳大利亚。"
    },
    {
      "sentence_id": "s47",
      "char_len": 12,
      "snippet": "图片截取自: 小Lin说"
    },
    {
      "sentence_id": "s48",
      "char_len": 42,
      "snippet": "地域分布，大约有三分之二在亚洲，也就是说光亚洲体育博彩的盘子就超过了一万亿美元每年。"
    },
    {
      "sentence_id": "s49",
      "char_len": 26,
      "snippet": "但亚洲这里，绝大多数，超过九成，都是地下的、非法的；"
    },
    {
      "sentence_id": "s50",
      "char_len": 48,
      "snippet": "其次是欧洲，大概占了全球15% - 20%, 然后是美国，欧洲和美国市场合法的比例相对还高一些。"
    },
    {
      "sentence_id": "s205",
      "char_len": 26,
      "snippet": "\"嘿我就不信了\"，就差一点，这种其实更容易让人上头。"
    },
    {
      "sentence_id": "s206",
      "char_len": 15,
      "snippet": "可能就能跟这个游戏死磕一整晚。"
    },
    {
      "sentence_id": "s207",
      "char_len": 28,
      "snippet": "这叫做Near Miss Effect, 差一点点效应。"
    },
    {
      "sentence_id": "s208",
      "char_len": 75,
      "snippet": "体育博彩容易上瘾、吸引人的点就在这，每次球打在门框上，差一点就进了，差一点就怎么样了，你这肾上腺素、多巴胺全都起来了，甭管赌输了赌赢了你都想再来一把。"
    },
    {
      "sentence_id": "s209",
      "char_len": 23,
      "snippet": "那博彩公司怎么能尽量刺激你上瘾，留你在桌上呢？"
    },
    {
      "sentence_id": "s210",
      "char_len": 6,
      "snippet": "常用的技巧："
    },
    {
      "sentence_id": "s211",
      "char_len": 50,
      "snippet": "一个就是想方设法增加更多的下注项目，不光猜胜负，比赛的任意一个细节都可以下注，增加你参与下注的频率；"
    },
    {
      "sentence_id": "s212",
      "char_len": 31,
      "snippet": "再有就是经常会有连续输太多的用户，可能刚刚注册就一连输了5把。"
    },
    {
      "sentence_id": "s213",
      "char_len": 15,
      "snippet": "这时候平台怕你输怕了，不玩了。"
    },
    {
      "sentence_id": "s214",
      "char_len": 3,
      "snippet": "赶紧！"
    },
    {
      "sentence_id": "s215",
      "char_len": 3,
      "snippet": "送钱。"
    },
    {
      "sentence_id": "s216",
      "char_len": 15,
      "snippet": "立刻弹窗，送你100，接着赌！"
    },
    {
      "sentence_id": "s217",
      "char_len": 34,
      "snippet": "你输得越多，它送得越多，当然送的钱有条件，你必须要赌多少多少轮才行。"
    },
    {
      "sentence_id": "s218",
      "char_len": 46,
      "snippet": "这就有点像很多互联网企业的手法，你要是在购物网站里逛半天不买，过一会儿，就弹出来一个优惠券；"
    },
    {
      "sentence_id": "s219",
      "char_len": 36,
      "snippet": "再有就是根据你的喜好，不停的推送信息，告诉你实时的盘口，比赛就要开始啦！"
    },
    {
      "sentence_id": "s220",
      "char_len": 8,
      "snippet": "你不来玩一玩吗?"
    },
    {
      "sentence_id": "s221",
      "char_len": 26,
      "snippet": "等等方式吧，这些都是比较常见的，增强用户粘性的方式。"
    },
    {
      "sentence_id": "s222",
      "char_len": 109,
      "snippet": "所以，这就是体育博彩合法化的一个弊端，如果你允许体育博彩公司充分商业化，它底层上就是在尽量设计激发人们赌博的瘾，通过实时盘口、手机推送、返现优惠、算法推荐……让"
    },
    {
      "sentence_id": "s223",
      "char_len": 12,
      "snippet": "图片截取自: 小Lin说"
    },
    {
      "sentence_id": "s224",
      "char_len": 4,
      "snippet": "各国市场"
    },
    {
      "sentence_id": "s225",
      "char_len": 18,
      "snippet": "上面我们分析了操纵比赛、假球的问题。"
    },
    {
      "sentence_id": "s226",
      "char_len": 20,
      "snippet": "接下来，咱们继续说回到合法的，台面上的。"
    },
    {
      "sentence_id": "s227",
      "char_len": 35,
      "snippet": "咱来看看各国、各地区对体育博彩、赌球赌马的态度，也了解一下各国的市场。"
    },
    {
      "sentence_id": "s228",
      "char_len": 37,
      "snippet": "首先一类国家地区，对体育博彩的态度最最开放，基本完全合法，全面拥抱市场化。"
    },
    {
      "sentence_id": "s229",
      "char_len": 16,
      "snippet": "这里最有代表性的国家，就是英国。"
    },
    {
      "sentence_id": "s230",
      "char_len": 2,
      "snippet": "英国"
    },
    {
      "sentence_id": "s231",
      "char_len": 27,
      "snippet": "英国，简直是全世界最成熟、最老牌的体育博彩市场之一了。"
    },
    {
      "sentence_id": "s232",
      "char_len": 23,
      "snippet": "从18世纪在英国的贵族、军官圈就非常流行赌马。"
    },
    {
      "sentence_id": "s233",
      "char_len": 19,
      "snippet": "但赌马，只能在比赛现场围栏内押注赌博。"
    },
    {
      "sentence_id": "s234",
      "char_len": 39,
      "snippet": "那时候地下体育博彩其实也很猖獗，政府基本上都是对规模不大的，睁一只眼闭一只眼。"
    },
    {
      "sentence_id": "s235",
      "char_len": 112,
      "snippet": "二战之后，1960年，英国政府觉得体育博彩虽然有弊端，但确实是大家合理的消费需求，另一方面地下赌博太猖獗了，所以出台了著名的《1960博彩法》，一夜之间，英国的"
    },
    {
      "sentence_id": "s236",
      "char_len": 34,
      "snippet": "现在英国各种线上博彩投注的App、网站已经做得非常完善、非常成熟了。"
    },
    {
      "sentence_id": "s237",
      "char_len": 14,
      "snippet": "大大小小的博彩广告到处都是。"
    },
    {
      "sentence_id": "s238",
      "char_len": 32,
      "snippet": "足球比赛T恤正面，都有赞助商大大的logo，那是他们的主赞助商。"
    },
    {
      "sentence_id": "s239",
      "char_len": 41,
      "snippet": "全球商业化最成功的联赛，英超，20支球队里，有11支球队的主赞助商是体育博彩公司。"
    },
    {
      "sentence_id": "s240",
      "char_len": 42,
      "snippet": "现在在英国非常常见的场景，比如几个朋友周末聚会，一起看球，拿出手机在App上下两注。"
    },
    {
      "sentence_id": "s241",
      "char_len": 32,
      "snippet": "和英国类似的比较开放的，还有澳大利亚、加拿大、法国、意大利等等。"
    },
    {
      "sentence_id": "s242",
      "char_len": 12,
      "snippet": "图片截取自: 小Lin说"
    },
    {
      "sentence_id": "s243",
      "char_len": 2,
      "snippet": "美国"
    },
    {
      "sentence_id": "s244",
      "char_len": 23,
      "snippet": "但提到官方体育博彩营收最高的国家，那还是美国。"
    },
    {
      "sentence_id": "s420",
      "char_len": 48,
      "snippet": "后来成为了南加州大学的橄榄球队员，成为了校队明星，也结识了大量之后在NFL叱咤风云的橄榄球明星。"
    },
    {
      "sentence_id": "s421",
      "char_len": 27,
      "snippet": "于是他借着这个人脉便利，开始做起了地下体育博彩的业务。"
    },
    {
      "sentence_id": "s422",
      "char_len": 23,
      "snippet": "上文提到过，2018年之前美国赌球是不合法的。"
    },
    {
      "sentence_id": "s423",
      "char_len": 54,
      "snippet": "他就私下攒赌球局，因为他本人就和一些NFL明星是哥们儿嘛，自然有很多名人都找他下注，这里包括了巴黎·希尔顿。"
    },
    {
      "sentence_id": "s424",
      "char_len": 25,
      "snippet": "他的业务越做越大，成为了美国高端赌球圈的一个名人。"
    },
    {
      "sentence_id": "s425",
      "char_len": 40,
      "snippet": "他当时把总部设在哥斯达黎加，然后会远程在美国境内，雇佣很多狠人去跑腿，取钱送钱。"
    },
    {
      "sentence_id": "s426",
      "char_len": 68,
      "snippet": "如果碰到那种输钱不愿意付钱的客户，汉森就会给客户寄他家人的照片，或者直接给客户的家人寄束花，说你老公该还钱了，以此来恐吓，一般都很管用。"
    },
    {
      "sentence_id": "s427",
      "char_len": 9,
      "snippet": "保证资金流转顺畅。"
    },
    {
      "sentence_id": "s428",
      "char_len": 17,
      "snippet": "但到这，说实在的都还属于赌球范畴。"
    },
    {
      "sentence_id": "s429",
      "char_len": 56,
      "snippet": "对欧文·汉森来说，有这么庞大的跑腿网络，送个现金不就是稍带手的事儿么，于是他开始帮各大帮派、黑帮、地下组织洗钱。"
    },
    {
      "sentence_id": "s430",
      "char_len": 49,
      "snippet": "这一下子利润就上来了，据他说，就只是送一趟现金，比如送100万，就可以有10%，10万美元的回报。"
    },
    {
      "sentence_id": "s431",
      "char_len": 45,
      "snippet": "之后，随着他运送网络越来越广，就有一个客户给他了一个神秘的黑莓手机，无法被追踪，完全加密。"
    },
    {
      "sentence_id": "s432",
      "char_len": 38,
      "snippet": "原来这是全球最大的毒枭之一，希望汉森的网络可以帮他运送毒品，然后洗毒品的钱。"
    },
    {
      "sentence_id": "s433",
      "char_len": 18,
      "snippet": "我不想说太多细节，咱也不是这种频道。"
    },
    {
      "sentence_id": "s434",
      "char_len": 22,
      "snippet": "总之，汉森从普通的赌球庄家，到洗钱，到毒品。"
    },
    {
      "sentence_id": "s435",
      "char_len": 41,
      "snippet": "虽然都是犯罪，都违法，但这里面，显然严重程度是不同的，当然他赚的钱也在呈指数增长。"
    },
    {
      "sentence_id": "s436",
      "char_len": 21,
      "snippet": "当时，在澳大利亚得到的钱，怎么运回美国呢？"
    },
    {
      "sentence_id": "s437",
      "char_len": 9,
      "snippet": "他有一招挺搞笑的。"
    },
    {
      "sentence_id": "s438",
      "char_len": 31,
      "snippet": "他就查，发现很多美国人喜欢去澳大利亚买UGG雪地靴，这很合理。"
    },
    {
      "sentence_id": "s439",
      "char_len": 55,
      "snippet": "于是他就整了一大批UGG的雪地靴，然后把现金换成金币，塞在UGG鞋垫里，咱也不清楚，这就能把黄金顺利的送出来。"
    },
    {
      "sentence_id": "s440",
      "char_len": 29,
      "snippet": "2015年，汉森被FBI逮捕，2017年被判刑21年监禁。"
    },
    {
      "sentence_id": "s441",
      "char_len": 13,
      "snippet": "地下赌球危险的地方在于哪？"
    },
    {
      "sentence_id": "s442",
      "char_len": 85,
      "snippet": "它很容易发现，洗钱、毒品，这些方向，他好像赚起钱来要容易得多，他接触的圈子又有很多这方面的人，就很容易把业务扩展到洗钱、毒品这些资金链更庞大、通常来讲更严重的犯"
    },
    {
      "sentence_id": "s443",
      "char_len": 34,
      "snippet": "其实，纵观这么长的人类历史，运动天生就伴随着赌，赌天生就伴随着犯罪。"
    },
    {
      "sentence_id": "s444",
      "char_len": 15,
      "snippet": "这些不是必然，但是相关性极高。"
    },
    {
      "sentence_id": "s445",
      "char_len": 12,
      "snippet": "图片截取自: 小Lin说"
    },
    {
      "sentence_id": "s446",
      "char_len": 19,
      "snippet": "这就是关于体育博彩我想聊的全部内容了。"
    },
    {
      "sentence_id": "s447",
      "char_len": 26,
      "snippet": "一些非法的部分，我尽量避开了所有细节，希望大家理解。"
    },
    {
      "sentence_id": "s448",
      "char_len": 27,
      "snippet": "最后，再强调一遍：不管你在哪，遵守法律，远离地下博彩！"
    },
    {
      "sentence_id": "s449",
      "char_len": 11,
      "snippet": "—— E N D ——"
    }
  ],
