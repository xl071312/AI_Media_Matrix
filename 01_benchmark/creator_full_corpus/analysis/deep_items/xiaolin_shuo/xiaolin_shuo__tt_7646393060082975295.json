  "source_sha256": "29fb78ca33df63ed688fa85027e90e7281cc43e222365145e09eeb5cc74808b3",
  "performance_tier": "CONTROL",
  "spoken_marker_eligible": "N/A_TEXT",
  "analysis_status": "OK",
  "analyzer_version": "phase_c_v1",
  "sentence_count": 120,
  "sentences_index": [
    {
      "sentence_id": "s1",
      "char_len": 2,
      "snippet": "内存"
    },
    {
      "sentence_id": "s2",
      "char_len": 10,
      "snippet": "背后有什么商业秘密？"
    },
    {
      "sentence_id": "s3",
      "char_len": 10,
      "snippet": "朋友们，你想赚钱么？"
    },
    {
      "sentence_id": "s4",
      "char_len": 29,
      "snippet": "我跟你说，现在机会多得是，你看看过去一年你错过了几个亿啊~"
    },
    {
      "sentence_id": "s5",
      "char_len": 31,
      "snippet": "最近一年，美股和A股的表现，一年上涨了超过20%，你抓住了么；"
    },
    {
      "sentence_id": "s6",
      "char_len": 17,
      "snippet": "对比黄金的表现，上涨了大概50%。"
    },
    {
      "sentence_id": "s7",
      "char_len": 30,
      "snippet": "再对比韩国股市的表现，一整个国家的股票指数，一年里翻了三倍!"
    },
    {
      "sentence_id": "s8",
      "char_len": 8,
      "snippet": "这是怎么回事儿？"
    },
    {
      "sentence_id": "s9",
      "char_len": 25,
      "snippet": "唉，这背后就是因为这两家公司：三星，和SK海力士。"
    },
    {
      "sentence_id": "s10",
      "char_len": 26,
      "snippet": "你可能会想，就两家公司，就能带动整个国家股市的暴涨？"
    },
    {
      "sentence_id": "s11",
      "char_len": 7,
      "snippet": "没错，还真是。"
    },
    {
      "sentence_id": "s12",
      "char_len": 43,
      "snippet": "在这一轮暴涨过后，这两家公司的市值，就已经占到了整个韩国KOSPI200总市值的"
    },
    {
      "sentence_id": "s13",
      "char_len": 34,
      "snippet": "两家公司占了一国股市的一半，我刚看到这个数字的时候，还是非常震惊的。"
    },
    {
      "sentence_id": "s14",
      "char_len": 12,
      "snippet": "图片截取自: 小Lin说"
    },
    {
      "sentence_id": "s15",
      "char_len": 40,
      "snippet": "这要是放A股，一半市值至少要全国最大的前220家上市公司加起来，韩国呢，就他俩！"
    },
    {
      "sentence_id": "s16",
      "char_len": 23,
      "snippet": "所以夸张点说，整个韩国股市，就是这两家公司了。"
    },
    {
      "sentence_id": "s17",
      "char_len": 14,
      "snippet": "它俩都快被泼天的富贵砸晕了。"
    },
    {
      "sentence_id": "s18",
      "char_len": 109,
      "snippet": "我说它们营收多少多少亿，你可能也没概念，这么说吧，SK海力士会把利润的10%给员"
    },
    {
      "sentence_id": "s19",
      "char_len": 26,
      "snippet": "三星那边员工看了眼红，抗议了：\"我们也要这么高奖金！"
    },
    {
      "sentence_id": "s20",
      "char_len": 9,
      "snippet": "我们要更高的奖金！"
    },
    {
      "sentence_id": "s21",
      "char_len": 37,
      "snippet": "\"最近，就是因为员工和公司领导层没谈拢，在5月底要进行为期18天的大罢工。"
    },
    {
      "sentence_id": "s22",
      "char_len": 56,
      "snippet": "至于这两家公司这么赚钱、股票涨这么厉害的原因，我相信大家多少都有所耳闻了，也是我"
    },
    {
      "sentence_id": "s23",
      "char_len": 31,
      "snippet": "三星和SK海力士，是全球存储芯片三巨头之二，而且是最大的两个。"
    },
    {
      "sentence_id": "s24",
      "char_len": 18,
      "snippet": "实际上，半个韩国的股市就是做内存的。"
    },
    {
      "sentence_id": "s25",
      "char_len": 50,
      "snippet": "最近一年，全球内存市场涨价极其夸张，价格基本上都暴涨了300% - 500%，最"
    },
    {
      "sentence_id": "s26",
      "char_len": 28,
      "snippet": "导致身边的手机、电脑、汽车等等，所有电子产品都受到波及。"
    },
    {
      "sentence_id": "s27",
      "char_len": 7,
      "snippet": "怎么回事儿呢？"
    },
    {
      "sentence_id": "s28",
      "char_len": 40,
      "snippet": "其实逻辑很简单，AI对内存需求暴增，挤兑了其它内存产能，导致供给不足，价格上涨。"
    },
    {
      "sentence_id": "s29",
      "char_len": 10,
      "snippet": "那两位自然赚得飞起。"
    },
    {
      "sentence_id": "s30",
      "char_len": 23,
      "snippet": "但这背后，其实还是有不少值得深入聊聊的内容的："
    },
    {
      "sentence_id": "s31",
      "char_len": 14,
      "snippet": "内存怎么就成了韩国人的天下？"
    },
    {
      "sentence_id": "s32",
      "char_len": 14,
      "snippet": "它的价格为什么一天到晚抽风？"
    },
    {
      "sentence_id": "s33",
      "char_len": 12,
      "snippet": "AI和内存是个什么关系？"
    },
    {
      "sentence_id": "s34",
      "char_len": 19,
      "snippet": "咱们来看看，内存背后的商业秘密...."
    },
    {
      "sentence_id": "s35",
      "char_len": 4,
      "snippet": "早期混战"
    },
    {
      "sentence_id": "s36",
      "char_len": 17,
      "snippet": "首先，我们简单了解一下什么是内存。"
    },
    {
      "sentence_id": "s37",
      "char_len": 51,
      "snippet": "现在，比如买手机、买电脑，可能参数是 \"16G / 512G\"的，指的就是16G"
    },
    {
      "sentence_id": "s38",
      "char_len": 19,
      "snippet": "这两个都属于存储芯片，用来存储数据的。"
    },
    {
      "sentence_id": "s39",
      "char_len": 50,
      "snippet": "硬盘是用来做长期存储的，它容量大、断了电也不会消失，但读取速度会比较慢, 这个不"
    },
    {
      "sentence_id": "s40",
      "char_len": 53,
      "snippet": "重点是这个俗称的内存，其实确切的说是DRAM，是临时性存储的，断了电就没了，但是"
    },
    {
      "sentence_id": "s41",
      "char_len": 59,
      "snippet": "DRAM这个词儿，听着有点拗口，但是它确实是行业主流的分类方式，所以我们今天还是"
    },
    {
      "sentence_id": "s42",
      "char_len": 32,
      "snippet": "【严正声明】我的定义解释非常不严谨，但求通俗易懂，希望大家理解。"
    },
    {
      "sentence_id": "s43",
      "char_len": 6,
      "snippet": "\"日本五杰\""
    },
    {
      "sentence_id": "s44",
      "char_len": 21,
      "snippet": "其实最早的内存呢，几乎就是美国公司的天下。"
    },
    {
      "sentence_id": "s45",
      "char_len": 46,
      "snippet": "1970年，英特尔首次推出了商用的DRAM，之后德州仪器、AMD、摩托罗拉等等，"
    },
    {
      "sentence_id": "s46",
      "char_len": 19,
      "snippet": "接下来发生了一件事儿，改变了整个行业。"
    },
    {
      "sentence_id": "s47",
      "char_len": 5,
      "snippet": "是什么呢？"
    },
    {
      "sentence_id": "s48",
      "char_len": 6,
      "snippet": "日本人来了。"
    },
    {
      "sentence_id": "s49",
      "char_len": 43,
      "snippet": "80年代，日本的电子工业崛起，NEC、东芝、日立、富士通、三菱，全都进军DRAM"
    },
    {
      "sentence_id": "s50",
      "char_len": 13,
      "snippet": "号称\"日本DRAM五杰\"。"
    },
    {
      "sentence_id": "s91",
      "char_len": 9,
      "snippet": "之后它改名叫什么？"
    },
    {
      "sentence_id": "s92",
      "char_len": 26,
      "snippet": "海力士 (Hynix Semiconductor)。"
    },
    {
      "sentence_id": "s93",
      "char_len": 70,
      "snippet": "但不是改了个名字，日子就好起来了啊，2001年海力士还是濒临破产，在政府牵头下被"
    },
    {
      "sentence_id": "s94",
      "char_len": 70,
      "snippet": "接下来基本上就是\"被国家养\"了十年，这十年里债权人也一直想退出，但苦于找不到买家"
    },
    {
      "sentence_id": "s95",
      "char_len": 73,
      "snippet": "直到 2012 年，韩国第三大财阀SK集团动心了，董事长崔泰源觉得自己主营业务，"
    },
    {
      "sentence_id": "s96",
      "char_len": 74,
      "snippet": "以3.4万亿韩元，大概相当于30亿美元，收购了海力士21.05%的股份，把它纳入"
    },
    {
      "sentence_id": "s97",
      "char_len": 55,
      "snippet": "被收购之后，它发展模式从\"债权人模式\"又重新回归到了\"财阀模式\"，也可以说是\"不"
    },
    {
      "sentence_id": "s98",
      "char_len": 69,
      "snippet": "但有点荒诞的是什么呢，崔泰源在2012年收购海力士，不到一年之后，他就因为挪用公"
    },
    {
      "sentence_id": "s99",
      "char_len": 18,
      "snippet": "海力士刚被接手的那几年，他全在牢里。"
    },
    {
      "sentence_id": "s100",
      "char_len": 27,
      "snippet": "但这可能跟咱们今天主线没太大关系啊，我就是觉得挺巧的。"
    },
    {
      "sentence_id": "s101",
      "char_len": 21,
      "snippet": "总之就是，韩国这边基本上稳定下来双雄格局。"
    },
    {
      "sentence_id": "s102",
      "char_len": 12,
      "snippet": "视频截取自: 小Lin说"
    },
    {
      "sentence_id": "s103",
      "char_len": 2,
      "snippet": "日本"
    },
    {
      "sentence_id": "s104",
      "char_len": 79,
      "snippet": "日本的情况也差不多，1996年开始，那五杰亏钱都亏的很惨，金融危机之后，日本政府"
    },
    {
      "sentence_id": "s105",
      "char_len": 16,
      "snippet": "后来把三菱的内存业务也并了进来。"
    },
    {
      "sentence_id": "s106",
      "char_len": 11,
      "snippet": "东芝和富士通则退出了。"
    },
    {
      "sentence_id": "s107",
      "char_len": 32,
      "snippet": "也就是说，日本五杰在这一轮洗牌后，变成了一家国家队 - 尔必达。"
    },
    {
      "sentence_id": "s108",
      "char_len": 38,
      "snippet": "但和韩国类似啊，合并了、改名字了不等于日子就好了，尔必达也可以说是苟延残喘。"
    },
    {
      "sentence_id": "s109",
      "char_len": 50,
      "snippet": "2008年金融危机，最后是日本政府注资1400亿日元，相当于15亿美元，直接持股"
    },
    {
      "sentence_id": "s110",
      "char_len": 41,
      "snippet": "但金融危机之后，日本企业和韩国企业，面临着的一个非常大的不同环境，你知道是什么吗"
    },
    {
      "sentence_id": "s111",
      "char_len": 5,
      "snippet": "就是汇率。"
    },
    {
      "sentence_id": "s112",
      "char_len": 21,
      "snippet": "金融危机爆发之后，资本撤离韩国，韩元暴跌;"
    },
    {
      "sentence_id": "s113",
      "char_len": 20,
      "snippet": "但日元作为避险资产，连续好几年持续上涨。"
    },
    {
      "sentence_id": "s114",
      "char_len": 26,
      "snippet": "这套逻辑咱们观众应该很熟悉了吧，出口企业是要遭殃的。"
    },
    {
      "sentence_id": "s115",
      "char_len": 20,
      "snippet": "所以，尔必达金融危机后受到了巨大的冲击。"
    },
    {
      "sentence_id": "s116",
      "char_len": 71,
      "snippet": "随着日元兑美元持续升值，负债累累尔，尔必达最终还是撑不住了，2012年在东京地方"
    },
    {
      "sentence_id": "s117",
      "char_len": 9,
      "snippet": "后来它怎么样了呢？"
    },
    {
      "sentence_id": "s118",
      "char_len": 69,
      "snippet": "破产保护不等于那些工厂就都拆了啊，之后被美国的美光收购，成为了美光的子公司，这也"
    },
    {
      "sentence_id": "s119",
      "char_len": 12,
      "snippet": "视频截取自: 小Lin说"
    },
    {
      "sentence_id": "s120",
      "char_len": 62,
      "snippet": "2000年初，全球其它的公司，也在这一轮大洗牌中倒闭的倒闭、合并的合并，包括曾经"
    },
    {
      "sentence_id": "s121",
      "char_len": 48,
      "snippet": "整个行业从原来的20多家，锐减到了三家：三星、SK海力士、美光，形成了寡头局面，"
    },
    {
      "sentence_id": "s122",
      "char_len": 12,
      "snippet": "视频截取自: 小Lin说"
    },
    {
      "sentence_id": "s123",
      "char_len": 6,
      "snippet": "海力士的押注"
    },
    {
      "sentence_id": "s124",
      "char_len": 47,
      "snippet": "从2012年 - 2022年，这十年里，整个行业经历过大的高潮和低谷，但这三位基"
    },
    {
      "sentence_id": "s125",
      "char_len": 20,
      "snippet": "2022年，全球DRAM市场份额的格局："
    },
    {
      "sentence_id": "s126",
      "char_len": 39,
      "snippet": "这十年里，SK海力士其实一直被三星压一头，它想要弯道超车、赶超上来，怎么办呢？"
    },
    {
      "sentence_id": "s127",
      "char_len": 23,
      "snippet": "就只能去死磕一些大哥不愿意做、不屑于做的方向。"
    },
    {
      "sentence_id": "s128",
      "char_len": 25,
      "snippet": "有一个它就瞄准的一个方向，叫做HBM，高带宽内存。"
    },
    {
      "sentence_id": "s129",
      "char_len": 25,
      "snippet": "划重点这个很关键啊，是之后AI芯片内存的核心技术。"
    },
    {
      "sentence_id": "s130",
      "char_len": 12,
      "snippet": "视频截取自: 小Lin说"
    },
    {
      "sentence_id": "s192",
      "char_len": 41,
      "snippet": "其实，从上文我们把整个行业竞争格局分析下来，你应该能隐隐的感觉到，这个行业非常卷"
    },
    {
      "sentence_id": "s193",
      "char_len": 53,
      "snippet": "90年代这么多巨头，十年里就被淘汰了，即使最大的几家内存厂，说倒闭就倒闭，说破产"
    },
    {
      "sentence_id": "s194",
      "char_len": 21,
      "snippet": "这就要说到，内存制造行业一个很重要的特点："
    },
    {
      "sentence_id": "s195",
      "char_len": 25,
      "snippet": "就是它是一个高固定成本投入、产品高度同质化的产业。"
    },
    {
      "sentence_id": "s196",
      "char_len": 60,
      "snippet": "什么意思呢，固定成本，就是要在初期投很多钱，花钱都是其次的，关键是花时间，而一旦"
    },
    {
      "sentence_id": "s197",
      "char_len": 35,
      "snippet": "同时，产品还同质化，就是三星产的内存条，和美光的，海力士的，都差不多。"
    },
    {
      "sentence_id": "s198",
      "char_len": 17,
      "snippet": "这就会导致它会陷入一个大周期轮回:"
    },
    {
      "sentence_id": "s199",
      "char_len": 64,
      "snippet": "需求爆发 -> 价格暴涨 -> 厂家扩产能 -> 产能过剩 -> 价格暴跌 ->"
    },
    {
      "sentence_id": "s200",
      "char_len": 9,
      "snippet": "-> 需求再次爆发"
    },
    {
      "sentence_id": "s201",
      "char_len": 12,
      "snippet": "视频截取自: 小Lin说"
    },
    {
      "sentence_id": "s202",
      "char_len": 40,
      "snippet": "周而复始，每一轮低迷，都会淘汰掉资本实力不足的、负债率高的、成本控制不行的企业。"
    },
    {
      "sentence_id": "s203",
      "char_len": 41,
      "snippet": "其实像什么航空、酒店，都是这种高固定成本、高同质化产品的行业，都面临着类似的困境"
    },
    {
      "sentence_id": "s204",
      "char_len": 54,
      "snippet": "可想而知，那资本肯定是不喜欢这种剧烈波动的大周期行业的，不管现在多赚钱，指不定下"
    },
    {
      "sentence_id": "s205",
      "char_len": 28,
      "snippet": "所以这类行业估值普遍偏低，市盈率一般可能也就5-10倍。"
    },
    {
      "sentence_id": "s206",
      "char_len": 7,
      "snippet": "产业格局的转变"
    },
    {
      "sentence_id": "s207",
      "char_len": 24,
      "snippet": "但现在呢，HBM其实正在改变整个内存产业的格局。"
    },
    {
      "sentence_id": "s208",
      "char_len": 41,
      "snippet": "它已经不是同质化产品了，你针对不同的显卡、不同的AI芯片，都需要定制不同的HBM"
    },
    {
      "sentence_id": "s209",
      "char_len": 120,
      "snippet": "比如，你会看到SK海力士和英伟达，绑定非常紧密，一起设计HBM的接口，还和台积电"
    },
    {
      "sentence_id": "s210",
      "char_len": 88,
      "snippet": "三星也不甘示弱，它虽然HBM3E上栽了个跟头，但下一代HBM4上迅速追赶，主导谷"
    },
    {
      "sentence_id": "s211",
      "char_len": 68,
      "snippet": "而由于需求稳定，订单的周期也显著拉长，其实已经整个把这个DRAM市场，拖出了原来"
    },
    {
      "sentence_id": "s212",
      "char_len": 18,
      "snippet": "这几家公司的股价，为什么涨得这么猛？"
    },
    {
      "sentence_id": "s213",
      "char_len": 58,
      "snippet": "一方面是赚钱，其实还有很关键的原因，就是它们行业模式的改变，也悄悄改变了背后的估"
    },
    {
      "sentence_id": "s214",
      "char_len": 12,
      "snippet": "图片截取自: 小Lin说"
    },
