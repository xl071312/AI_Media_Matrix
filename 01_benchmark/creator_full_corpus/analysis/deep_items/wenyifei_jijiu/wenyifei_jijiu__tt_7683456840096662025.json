  "sentence_count": 48,
  "sentences_index": [
    {
      "sentence_id": "s1",
      "char_len": 30,
      "snippet": "为什么所有人都在说学历贬值，但中国的家长们却还在疯狂卷教育？"
    },
    {
      "sentence_id": "s2",
      "char_len": 45,
      "snippet": "你有没有发现：一边是大学生越来越多，网上天天有人说本科不值钱了、研究生毕业照样找"
    },
    {
      "sentence_id": "s3",
      "char_len": 66,
      "snippet": "但另一边，学生们依然是周一到周五早上6点多起床，晚上11点还得写作业，周末英语、"
    },
    {
      "sentence_id": "s4",
      "char_len": 24,
      "snippet": "很多家长选择掏空家底，给孩子搞各种教育军备竞赛。"
    },
    {
      "sentence_id": "s5",
      "char_len": 24,
      "snippet": "既然大家都知道学历在贬值，为什么反而越卷越厉害？"
    },
    {
      "sentence_id": "s6",
      "char_len": 31,
      "snippet": "核心逻辑在于：学历的稀缺性确实下降了，但低学历的代价却在变高。"
    },
    {
      "sentence_id": "s7",
      "char_len": 49,
      "snippet": "2026年高校毕业生大约1270万人，但企业并没有因此说“本科不值钱了，那我以后"
    },
    {
      "sentence_id": "s8",
      "char_len": 24,
      "snippet": "恰恰相反——很多岗位原来高中能干，后来要求大专；"
    },
    {
      "sentence_id": "s9",
      "char_len": 14,
      "snippet": "原来大专可以，后来必须本科；"
    },
    {
      "sentence_id": "s10",
      "char_len": 20,
      "snippet": "原来本科就够，现在招聘直接写着硕士起步。"
    },
    {
      "sentence_id": "s11",
      "char_len": 41,
      "snippet": "今天的中国家长不是不知道教育回报率在缩水，而是不敢赌，因为赌输了很有可能万劫不复"
    },
    {
      "sentence_id": "s12",
      "char_len": 53,
      "snippet": "这就形成了一个典型的囚徒困境：孩子晚上11点前不能睡觉，补习班必须上个不停，看到"
    },
    {
      "sentence_id": "s13",
      "char_len": 18,
      "snippet": "最后的结果就是大家一起卷个没完没了。"
    },
    {
      "sentence_id": "s14",
      "char_len": 20,
      "snippet": "这种无限竞争模式演变到最后会变成什么样？"
    },
    {
      "sentence_id": "s15",
      "char_len": 17,
      "snippet": "韩国已经给出了一个非常现实的样本。"
    },
    {
      "sentence_id": "s16",
      "char_len": 20,
      "snippet": "首尔大峙洞，密密麻麻分布着大量补习机构。"
    },
    {
      "sentence_id": "s17",
      "char_len": 34,
      "snippet": "孩子放学后不是回家，而是在英语、数学、写作等各种补习班之间不停转场。"
    },
    {
      "sentence_id": "s18",
      "char_len": 24,
      "snippet": "小学提前学初中的，初中提前学高中的，越来越普遍。"
    },
    {
      "sentence_id": "s19",
      "char_len": 57,
      "snippet": "甚至连补习班本身都开始有了门槛，一些热门补习班需要考试才能进，于是又出现了专门帮"
    },
    {
      "sentence_id": "s20",
      "char_len": 28,
      "snippet": "但市场上能够提供的工作岗位并没有因为大家越来越卷而增多。"
    },
    {
      "sentence_id": "s21",
      "char_len": 36,
      "snippet": "这个时候，教育投入从正常的投资，变成了一场互相竞争、无限加码的军备竞赛。"
    },
    {
      "sentence_id": "s22",
      "char_len": 7,
      "snippet": "我们算一笔账。"
    },
    {
      "sentence_id": "s23",
      "char_len": 82,
      "snippet": "一个典型的重视教育投入的城市家庭，从小学到高中，为了让孩子在保证学习成绩的前提下"
    },
    {
      "sentence_id": "s24",
      "char_len": 36,
      "snippet": "还有隐性投入：父母的时间成本——选机构、接送、陪读、盯作业、跟老师沟通。"
    },
    {
      "sentence_id": "s25",
      "char_len": 24,
      "snippet": "很多家庭为了孩子，甚至要单独腾一个人出来不上班。"
    },
    {
      "sentence_id": "s26",
      "char_len": 18,
      "snippet": "保守算，每年1万，12年就是12万。"
    },
    {
      "sentence_id": "s27",
      "char_len": 50,
      "snippet": "如果再追求一些私立学校、高价借读费，或者有送孩子出国留学的打算，累计费用很容易来"
    },
    {
      "sentence_id": "s28",
      "char_len": 10,
      "snippet": "100万是什么概念？"
    },
    {
      "sentence_id": "s29",
      "char_len": 60,
      "snippet": "央行的存款保险数据显示，50万元的存款保险限额就可以覆盖99%以上的存款人群，全"
    },
    {
      "sentence_id": "s30",
      "char_len": 29,
      "snippet": "给孩子存下这100万，已经超过了绝大多数中国人的现金储备。"
    },
    {
      "sentence_id": "s31",
      "char_len": 19,
      "snippet": "一个普通年轻人自己攒100万需要多久？"
    },
    {
      "sentence_id": "s32",
      "char_len": 26,
      "snippet": "2024届本科毕业生毕业半年后平均月收入6199元。"
    },
    {
      "sentence_id": "s33",
      "char_len": 29,
      "snippet": "按6200算，每月存一半，从零攒到100万需要大约27年；"
    },
    {
      "sentence_id": "s34",
      "char_len": 20,
      "snippet": "哪怕一分钱不花，全部存下来也要13年多。"
    },
    {
      "sentence_id": "s35",
      "char_len": 12,
      "snippet": "而且别忘了，钱可以生息。"
    },
    {
      "sentence_id": "s36",
      "char_len": 31,
      "snippet": "按年化1%算，100万一年的利息也有1万，平均每月800多块。"
    },
    {
      "sentence_id": "s37",
      "char_len": 21,
      "snippet": "这笔钱给了一个人最稀缺的东西：试错的底气。"
    },
    {
      "sentence_id": "s38",
      "char_len": 50,
      "snippet": "不用为了生存做没有发展的工作，可以去成长空间更大的公司，可以承受一段时间的失业，"
    },
    {
      "sentence_id": "s39",
      "char_len": 32,
      "snippet": "从小学到高中整整12年，孩子在学校里本身就有大量复习巩固的机会。"
    },
    {
      "sentence_id": "s40",
      "char_len": 17,
      "snippet": "平时有单元测试，期中期末集中复习；"
    },
    {
      "sentence_id": "s41",
      "char_len": 36,
      "snippet": "到了初三高三，还有围绕中考高考展开的一轮又一轮复习、专题训练、模拟考试。"
    },
    {
      "sentence_id": "s42",
      "char_len": 18,
      "snippet": "很多知识都在反复练、反复讲、反复考。"
    },
    {
      "sentence_id": "s43",
      "char_len": 84,
      "snippet": "这个时候再压榨孩子唯一的休息时间去补习班，再多学一遍他已经听腻了或者早就听不懂的"
    },
    {
      "sentence_id": "s44",
      "char_len": 13,
      "snippet": "我们绝对不是说读书不重要。"
    },
    {
      "sentence_id": "s45",
      "char_len": 12,
      "snippet": "教育会影响一个人的认知。"
    },
    {
      "sentence_id": "s46",
      "char_len": 41,
      "snippet": "但真正应该重新审视的是：基础教育的投资和无限追加的教育军备竞赛，到底是不是一回事"
    },
    {
      "sentence_id": "s47",
      "char_len": 26,
      "snippet": "在这个充满不确定性的时代，思路永远比盲目内卷更重要。"
    },
    {
      "sentence_id": "s48",
      "char_len": 60,
      "snippet": "未来真正能够给你孩子保底的，大概率不会是他在补习班学到的那些东西，而是你银行卡里"
    }
  ],
