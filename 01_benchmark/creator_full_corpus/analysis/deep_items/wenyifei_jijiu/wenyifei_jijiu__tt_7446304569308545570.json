  "sentence_count": 47,
  "sentences_index": [
    {
      "sentence_id": "s1",
      "char_len": 35,
      "snippet": "今天来揭秘一个超硬核的区域经济冷知识：为什么山东是中国的“战备大省”？"
    },
    {
      "sentence_id": "s2",
      "char_len": 24,
      "snippet": "一句古话就能解释：“天下之胜，势不在秦必在齐”。"
    },
    {
      "sentence_id": "s3",
      "char_len": 49,
      "snippet": "山东，不仅在关键时刻扛大旗，平时更像一座资源满满的战略补给站，源源不断地为国家“上装备、加士气”。"
    },
    {
      "sentence_id": "s4",
      "char_len": 8,
      "snippet": "为什么这么说呢？"
    },
    {
      "sentence_id": "s5",
      "char_len": 8,
      "snippet": "咱们一起来看看。"
    },
    {
      "sentence_id": "s6",
      "char_len": 13,
      "snippet": "你以为山东只有煎饼和大葱？"
    },
    {
      "sentence_id": "s7",
      "char_len": 3,
      "snippet": "错了！"
    },
    {
      "sentence_id": "s8",
      "char_len": 33,
      "snippet": "山东可是战略物资生产基地，农业、工业、能源矿产，全都“稳”到起飞！"
    },
    {
      "sentence_id": "s9",
      "char_len": 27,
      "snippet": "先说农业，山东可是全国第一个农产品产值突破万亿的省份！"
    },
    {
      "sentence_id": "s10",
      "char_len": 47,
      "snippet": "虽然耕地面积只占全国的6%，但却贡献了8%的粮食、11%的水果、12%的蔬菜和13%的水产品。"
    },
    {
      "sentence_id": "s11",
      "char_len": 28,
      "snippet": "网友调侃：“山东的大葱高过姚明，山东的苹果比柚子还大”！"
    },
    {
      "sentence_id": "s12",
      "char_len": 23,
      "snippet": "一个山东，顶了半个中国的粮仓、菜篮子和果园子。"
    },
    {
      "sentence_id": "s13",
      "char_len": 17,
      "snippet": "这“战备大省”的名号，这不是吹的！"
    },
    {
      "sentence_id": "s14",
      "char_len": 14,
      "snippet": "再看能源矿产，山东也超硬核。"
    },
    {
      "sentence_id": "s15",
      "char_len": 14,
      "snippet": "全国十大金矿，山东占了五个！"
    },
    {
      "sentence_id": "s16",
      "char_len": 20,
      "snippet": "全国第二大油田、第四大煤矿，也都在山东。"
    },
    {
      "sentence_id": "s17",
      "char_len": 25,
      "snippet": "左手黄金，右手石油，稳稳端住东部能源的“大饭碗”。"
    },
    {
      "sentence_id": "s18",
      "char_len": 21,
      "snippet": "工业更不用说，山东的重工业简直“硬邦邦”！"
    },
    {
      "sentence_id": "s19",
      "char_len": 27,
      "snippet": "全国制造业装备百强企业中，山东独占了16家，排名第一。"
    },
    {
      "sentence_id": "s20",
      "char_len": 27,
      "snippet": "发动机、重型汽车、挖掘机这些“钢铁猛兽”，山东都能造。"
    },
    {
      "sentence_id": "s21",
      "char_len": 14,
      "snippet": "和平时期，默默支持国家发展；"
    },
    {
      "sentence_id": "s22",
      "char_len": 15,
      "snippet": "非常时期，立马转型，火力全开。"
    },
    {
      "sentence_id": "s23",
      "char_len": 11,
      "snippet": "山东能稳，国家就能稳。"
    },
    {
      "sentence_id": "s24",
      "char_len": 19,
      "snippet": "山东的位置，简直就是为战备量身定做的！"
    },
    {
      "sentence_id": "s25",
      "char_len": 32,
      "snippet": "北靠渤海、南临黄海，海岸线长达3000多公里，占全国的六分之一。"
    },
    {
      "sentence_id": "s26",
      "char_len": 30,
      "snippet": "不论是支援京津冀，还是保卫东部沿海，山东都是关键的“C位”！"
    },
    {
      "sentence_id": "s27",
      "char_len": 21,
      "snippet": "更牛的是，山东的交通配置堪称满级“神装”！"
    },
    {
      "sentence_id": "s28",
      "char_len": 19,
      "snippet": "高铁总里程突破3000公里，全国第一！"
    },
    {
      "sentence_id": "s29",
      "char_len": 19,
      "snippet": "坐高铁，从山东出发，可以到达全国各地。"
    },
    {
      "sentence_id": "s30",
      "char_len": 36,
      "snippet": "高速公路总里程全国第六，路网密的跟“蜘蛛侠”织的网一样，随便去哪都通畅。"
    },
    {
      "sentence_id": "s31",
      "char_len": 26,
      "snippet": "海运更是霸气，2023年山东港口吞吐量稳居全球第一。"
    },
    {
      "sentence_id": "s32",
      "char_len": 14,
      "snippet": "有货直接装船开跑，效率拉满。"
    },
    {
      "sentence_id": "s33",
      "char_len": 32,
      "snippet": "内河运输也不含糊，京杭大运河就是山东的“莱茵河”，水运一路畅通。"
    },
    {
      "sentence_id": "s34",
      "char_len": 17,
      "snippet": "而且，山东还建了多条战备高速公路！"
    },
    {
      "sentence_id": "s35",
      "char_len": 40,
      "snippet": "这些路能让军用飞机直接起飞降落，路面又宽又厚，哪怕炮弹砸下来，照样“稳如老狗”。"
    },
    {
      "sentence_id": "s36",
      "char_len": 15,
      "snippet": "这配置，全国没几个省份能做到。"
    },
    {
      "sentence_id": "s37",
      "char_len": 32,
      "snippet": "在中国大家庭里，北京是政治中心，上海是经济中心，广东是改革先锋。"
    },
    {
      "sentence_id": "s38",
      "char_len": 21,
      "snippet": "而山东，就是关键时刻扛大旗的“战备大省”！"
    },
    {
      "sentence_id": "s39",
      "char_len": 14,
      "snippet": "历史早就写满了山东人的担当。"
    },
    {
      "sentence_id": "s40",
      "char_len": 25,
      "snippet": "抗战时期，八路军90多万人中，近三分之一是山东人。"
    },
    {
      "sentence_id": "s41",
      "char_len": 58,
      "snippet": "解放战争中，山东籍战士占了全军的四分之一，淮海战役里，山东老乡推着小推车送了4.5亿斤军粮到前线，占了总军粮的一半。"
    },
    {
      "sentence_id": "s42",
      "char_len": 25,
      "snippet": "抗美援朝，28万山东志愿军参战，牺牲人数全国第二。"
    },
    {
      "sentence_id": "s43",
      "char_len": 23,
      "snippet": "拼劲、硬气、顶得住，这就是山东人骨子里的担当。"
    },
    {
      "sentence_id": "s44",
      "char_len": 40,
      "snippet": "所以，中国第一艘国产航母叫“山东舰”，这名字是山东人民用汗水和牺牲拼出来的荣耀！"
    },
    {
      "sentence_id": "s45",
      "char_len": 58,
      "snippet": "山东可能没有北上广那么光鲜亮丽，也不像江浙那么“高精尖”，但它沉稳、硬核，为国家默默付出，关键时刻能顶得住、扛得起。"
    },
    {
      "sentence_id": "s46",
      "char_len": 28,
      "snippet": "这个“战备大省”的名号，不用官方说，大家心里早就有数了。"
    },
    {
      "sentence_id": "s47",
      "char_len": 28,
      "snippet": "我是温义飞，关注我，带你了解更多关于中国区域经济的秘密！"
    }
  ],
