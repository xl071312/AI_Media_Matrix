  "performance_tier": "HIGH",
  "spoken_marker_eligible": "N/A_TEXT",
  "analysis_status": "OK",
  "analyzer_version": "phase_c_v1",
  "sentence_count": 97,
  "sentences_index": [
    {
      "sentence_id": "s1",
      "char_len": 18,
      "snippet": "图片截取自: 日本支柱产业宣布停产！"
    },
    {
      "sentence_id": "s2",
      "char_len": 17,
      "snippet": "中国这一刀，砍在了日本右翼大动脉上"
    },
    {
      "sentence_id": "s3",
      "char_len": 36,
      "snippet": "日本的极右翼正在用葬送这个国家最后生路的方式，把1.2亿日本人捆上战车。"
    },
    {
      "sentence_id": "s4",
      "char_len": 18,
      "snippet": "最近，一个叫做六氟化钨的新概念火了。"
    },
    {
      "sentence_id": "s5",
      "char_len": 46,
      "snippet": "现在全球最顶级的芯片厂都在排着队求中国卖自己这种材料，因为没有它，3纳米芯片一片都造不出来。"
    },
    {
      "sentence_id": "s6",
      "char_len": 21,
      "snippet": "而这波财富，是日本的极右翼亲手送给我们的。"
    },
    {
      "sentence_id": "s7",
      "char_len": 37,
      "snippet": "日本天天叫嚣“存亡危机”，结果被中国断供了军民两用物资，其中就有高纯钨粉。"
    },
    {
      "sentence_id": "s8",
      "char_len": 37,
      "snippet": "最近他们还让特朗普帮忙说情，希望重新拿到我们的稀土，结果被中国直接拒绝了。"
    },
    {
      "sentence_id": "s9",
      "char_len": 18,
      "snippet": "图片截取自: 日本支柱产业宣布停产！"
    },
    {
      "sentence_id": "s10",
      "char_len": 17,
      "snippet": "中国这一刀，砍在了日本右翼大动脉上"
    },
    {
      "sentence_id": "s11",
      "char_len": 41,
      "snippet": "没过几天，这个曾经被日本垄断全球九成以上份额、躺赚了几十年的产业，直接宣布将停产。"
    },
    {
      "sentence_id": "s12",
      "char_len": 26,
      "snippet": "连客户带定价权，都被日本的极右翼打包送到了中国手里。"
    },
    {
      "sentence_id": "s13",
      "char_len": 14,
      "snippet": "而六氟化钨，还只是一个开始。"
    },
    {
      "sentence_id": "s14",
      "char_len": 39,
      "snippet": "今天我们就来聊一聊日本的极右翼是怎么一步一步把本就脆弱的日本经济给彻底压垮的。"
    },
    {
      "sentence_id": "s15",
      "char_len": 18,
      "snippet": "图片截取自: 日本支柱产业宣布停产！"
    },
    {
      "sentence_id": "s16",
      "char_len": 17,
      "snippet": "中国这一刀，砍在了日本右翼大动脉上"
    },
    {
      "sentence_id": "s17",
      "char_len": 29,
      "snippet": "要看清这件事，你得先知道日本经济的底子已经烂到了什么程度。"
    },
    {
      "sentence_id": "s18",
      "char_len": 51,
      "snippet": "日本财务省上个月刚刚公布了一个数据：国债总额1343万亿日元，再一次创下历史新高，是GDP的两倍还多。"
    },
    {
      "sentence_id": "s19",
      "char_len": 39,
      "snippet": "这个比例在全世界的发达国家里排第一，比那个天天喊着要债务暴雷的美国还高出一倍。"
    },
    {
      "sentence_id": "s20",
      "char_len": 33,
      "snippet": "摊到每个日本人头上，一人欠了1090万日元，折合人民币近50万元。"
    },
    {
      "sentence_id": "s21",
      "char_len": 37,
      "snippet": "这个雷以前之所以还没炸，是因为日本央行搞了几十年的零利率，借钱不用付利息。"
    },
    {
      "sentence_id": "s22",
      "char_len": 16,
      "snippet": "只要不还本，本金欠多少都能装死。"
    },
    {
      "sentence_id": "s23",
      "char_len": 31,
      "snippet": "但现在彻底装不下去了，日元疯狂贬值，逼得日本央行只能被迫加息。"
    },
    {
      "sentence_id": "s24",
      "char_len": 18,
      "snippet": "图片截取自: 日本支柱产业宣布停产！"
    },
    {
      "sentence_id": "s25",
      "char_len": 17,
      "snippet": "中国这一刀，砍在了日本右翼大动脉上"
    },
    {
      "sentence_id": "s26",
      "char_len": 37,
      "snippet": "结果10年期国债收益率三年前还不到0.5%，今年6月就飙到了2.6%以上。"
    },
    {
      "sentence_id": "s27",
      "char_len": 46,
      "snippet": "到了2026年度，日本光是还旧债、付利息这一项就要掏31万亿日元，占整个国家预算的四分之一。"
    },
    {
      "sentence_id": "s28",
      "char_len": 18,
      "snippet": "但即便这样，也没拦住日元贬值的步伐。"
    },
    {
      "sentence_id": "s29",
      "char_len": 33,
      "snippet": "现在日元对美元已经从五年前的1:103贬到了今年的逼近1:160。"
    },
    {
      "sentence_id": "s30",
      "char_len": 45,
      "snippet": "我们都知道，日本是一个资源极度匮乏的国家，石油、天然气百分之百依靠进口，粮食一半依靠进口。"
    },
    {
      "sentence_id": "s31",
      "char_len": 23,
      "snippet": "所以日元每贬值一分，老百姓的米面油就得贵一分。"
    },
    {
      "sentence_id": "s32",
      "char_len": 34,
      "snippet": "结果就是，日本作为一个发达国家，活生生过出了吃饭都要精打细算的日子。"
    },
    {
      "sentence_id": "s33",
      "char_len": 23,
      "snippet": "而且扣掉物价，日本的实际工资已经连续跌了四年。"
    },
    {
      "sentence_id": "s34",
      "char_len": 41,
      "snippet": "所以别看他们账面上天天宣传“30年来最大涨薪”，到手的购买力实际上是在年年缩水的。"
    },
    {
      "sentence_id": "s35",
      "char_len": 30,
      "snippet": "现在的日本就卡在一个死局里：加息，国债利息滚雪球，财政先崩；"
    },
    {
      "sentence_id": "s36",
      "char_len": 18,
      "snippet": "不加息，日元接着贬，老百姓先扛不住。"
    },
    {
      "sentence_id": "s37",
      "char_len": 12,
      "snippet": "左边是悬崖，右边是火坑。"
    },
    {
      "sentence_id": "s38",
      "char_len": 28,
      "snippet": "问题来了，一个国家被逼到这个份上，正常的政府应该干什么？"
    },
    {
      "sentence_id": "s39",
      "char_len": 22,
      "snippet": "不应该砸锅卖铁也要去搞产业、稳物价、提工资？"
    },
    {
      "sentence_id": "s40",
      "char_len": 18,
      "snippet": "图片截取自: 日本支柱产业宣布停产！"
    },
    {
      "sentence_id": "s41",
      "char_len": 17,
      "snippet": "中国这一刀，砍在了日本右翼大动脉上"
    },
    {
      "sentence_id": "s42",
      "char_len": 23,
      "snippet": "可是，日本的极右翼却给出了一份完全相反的答案。"
    },
    {
      "sentence_id": "s43",
      "char_len": 19,
      "snippet": "今年2月，高市早苗解散国会，重新大选。"
    },
    {
      "sentence_id": "s44",
      "char_len": 17,
      "snippet": "自民党拿下了众议院三分之二的议席。"
    },
    {
      "sentence_id": "s45",
      "char_len": 14,
      "snippet": "紧接着，一套组合拳打了出来："
    },
    {
      "sentence_id": "s46",
      "char_len": 44,
      "snippet": "新版的《防卫白皮书》把中国定为“前所未有的最大战略挑战”，专门新设一章研究新型作战方式。"
    },
    {
      "sentence_id": "s47",
      "char_len": 18,
      "snippet": "图片截取自: 日本支柱产业宣布停产！"
    },
    {
      "sentence_id": "s48",
      "char_len": 17,
      "snippet": "中国这一刀，砍在了日本右翼大动脉上"
    },
    {
      "sentence_id": "s49",
      "char_len": 23,
      "snippet": "高市早苗自己则在会上亲口说要“准备长期战争”。"
    },
    {
      "sentence_id": "s50",
      "char_len": 34,
      "snippet": "5月份国会通过法案，7月就要成立一个整合国内外情报的“国家情报局”。"
    },
    {
      "sentence_id": "s51",
      "char_len": 56,
      "snippet": "日本在野党管它叫 “现代版的特高课” ——而历史上策划了九一八事变、把日本拖进战争深渊的，就是这个所谓的特高课。"
    },
    {
      "sentence_id": "s52",
      "char_len": 43,
      "snippet": "6月7日，富士山脚下，史上最大规模的实弹演习，第一次亮出射程1000公里的高速滑翔弹。"
    },
    {
      "sentence_id": "s53",
      "char_len": 21,
      "snippet": "从西南诸岛打出去，能够覆盖中国的东南沿海。"
    },
    {
      "sentence_id": "s54",
      "char_len": 32,
      "snippet": "这就是日本极右翼的全部答案，经济上交不了卷，就在安全上制造敌人。"
    },
    {
      "sentence_id": "s55",
      "char_len": 32,
      "snippet": "工资搞不上去，物价压不下来，唯一能做到的就是让普通民众感到害怕。"
    },
    {
      "sentence_id": "s56",
      "char_len": 39,
      "snippet": "天天讲“中国的威胁”“存亡的危机”，恐惧上头了，老百姓就顾不上算自己家的账了。"
    },
    {
      "sentence_id": "s57",
      "char_len": 27,
      "snippet": "日本右翼叫嚣的音量，和它在经济上的绝望程度是成正比的。"
    },
    {
      "sentence_id": "s58",
      "char_len": 14,
      "snippet": "它喊得越凶，说明它越没有牌。"
    },
    {
      "sentence_id": "s59",
      "char_len": 37,
      "snippet": "这套把戏不光是骗人，还要真金白银地付账——这才是把日本经济彻底压垮的地方。"
    },
    {
      "sentence_id": "s60",
      "char_len": 47,
      "snippet": "2026年，日本防卫预算被推高至9万亿日元，史上首次突破这一关口，并且已经是连续第14年增长。"
    },
    {
      "sentence_id": "s61",
      "char_len": 16,
      "snippet": "日本财政早已捉襟见肘，钱从哪来？"
    },
    {
      "sentence_id": "s62",
      "char_len": 9,
      "snippet": "答案只有一个：借。"
    },
    {
      "sentence_id": "s63",
      "char_len": 17,
      "snippet": "这次甚至连“建设国债”都被动用了。"
    },
    {
      "sentence_id": "s64",
      "char_len": 51,
      "snippet": "要知道，建设国债在日本战后一直是禁忌——上一次日本靠发行国债堆砌军费，最终把整个国家拖进了战争的深渊。"
    },
    {
      "sentence_id": "s65",
      "char_len": 18,
      "snippet": "图片截取自: 日本支柱产业宣布停产！"
    },
    {
      "sentence_id": "s66",
      "char_len": 17,
      "snippet": "中国这一刀，砍在了日本右翼大动脉上"
    },
    {
      "sentence_id": "s67",
      "char_len": 17,
      "snippet": "而如今，这个禁忌被极右翼亲手打破。"
    },
    {
      "sentence_id": "s68",
      "char_len": 39,
      "snippet": "更令人震惊的是，从2027年起，全体日本人的所得税还将额外加征一笔“防卫税”。"
    },
    {
      "sentence_id": "s69",
      "char_len": 35,
      "snippet": "最讽刺的是，这9万亿日元中，有一半以上要交给美国——而且还是分期付款。"
    },
    {
      "sentence_id": "s70",
      "char_len": 32,
      "snippet": "这些钱，正是日本前几年疯狂采购战斧导弹和F35战斗机时欠下的账。"
    },
    {
      "sentence_id": "s71",
      "char_len": 27,
      "snippet": "说白了，日本就是在借着子孙后代的钱，替美国军火商打工。"
    },
    {
      "sentence_id": "s72",
      "char_len": 18,
      "snippet": "图片截取自: 日本支柱产业宣布停产！"
    },
    {
      "sentence_id": "s73",
      "char_len": 17,
      "snippet": "中国这一刀，砍在了日本右翼大动脉上"
    },
    {
      "sentence_id": "s74",
      "char_len": 18,
      "snippet": "不仅如此，日本的后路也已经被锁死了。"
    },
    {
      "sentence_id": "s75",
      "char_len": 35,
      "snippet": "这30年来，日本的终端产业几乎被啃光了：家电、面板、造船、手机全丢了。"
    },
    {
      "sentence_id": "s76",
      "char_len": 44,
      "snippet": "如今，日本还能吃饭的产业，只剩下半导体材料、特种化学品和精密零部件——这是它最后的底气。"
    },
    {
      "sentence_id": "s77",
      "char_len": 45,
      "snippet": "但这份底气有一个致命的前提：所有原材料都依赖进口，而且高度依赖中国，命脉完全攥在中国手里。"
    },
    {
      "sentence_id": "s78",
      "char_len": 17,
      "snippet": "那按照正常的逻辑，日本应该怎么做？"
    },
    {
      "sentence_id": "s79",
      "char_len": 17,
      "snippet": "当然是搞好对华关系，然后闷声赚钱。"
    },
    {
      "sentence_id": "s80",
      "char_len": 30,
      "snippet": "可是极右翼偏要拉着已经输无可输的菲律宾，一起跟着对中国叫嚣。"
    },
    {
      "sentence_id": "s81",
      "char_len": 42,
      "snippet": "结果就是，中国的管制清单一张一张落地，从稀土材料到提纯技术，再到生产设备，一起管制。"
    },
    {
      "sentence_id": "s82",
      "char_len": 18,
      "snippet": "图片截取自: 日本支柱产业宣布停产！"
    },
    {
      "sentence_id": "s83",
      "char_len": 17,
      "snippet": "中国这一刀，砍在了日本右翼大动脉上"
    },
    {
      "sentence_id": "s84",
      "char_len": 31,
      "snippet": "只要产品中来自中国的成分超过0.1%，出口就必须经过中国批准。"
    },
    {
      "sentence_id": "s85",
      "char_len": 33,
      "snippet": "六氟化钨产业已经没了，下一个是磁体，再下一个是零部件，接着是医药。"
    },
    {
      "sentence_id": "s86",
      "char_len": 21,
      "snippet": "日本最后的家底，正在被右翼一件一件地败光。"
    },
    {
      "sentence_id": "s87",
      "char_len": 39,
      "snippet": "所以，这个逻辑已经很清晰了，经济越差，右翼就越要叫嚣，通过转移矛盾来稳住局面；"
    },
    {
      "sentence_id": "s88",
      "char_len": 18,
      "snippet": "越叫嚣，军费就越膨胀，财政垮得越快；"
    },
    {
      "sentence_id": "s89",
      "char_len": 22,
      "snippet": "越挑衅，原材料和市场断得越多，产业塌得越快；"
    },
    {
      "sentence_id": "s90",
      "char_len": 11,
      "snippet": "产业一塌，经济就更差。"
    },
    {
      "sentence_id": "s91",
      "char_len": 8,
      "snippet": "然后，继续叫嚣。"
    },
    {
      "sentence_id": "s92",
      "char_len": 9,
      "snippet": "这就是一个死循环。"
    },
    {
      "sentence_id": "s93",
      "char_len": 38,
      "snippet": "日本的右翼以为自己抓住了救命稻草，但这根稻草，很可能只是压垮日本的最后一根。"
    },
    {
      "sentence_id": "s94",
      "char_len": 26,
      "snippet": "等到它真正落下来的那一天，或许就是日本经济的大结局。"
    },
    {
      "sentence_id": "s95",
      "char_len": 15,
      "snippet": "这个代价，他们真的承受得起吗？"
    },
    {
      "sentence_id": "s96",
      "char_len": 18,
      "snippet": "图片截取自: 日本支柱产业宣布停产！"
    },
    {
      "sentence_id": "s97",
      "char_len": 17,
      "snippet": "中国这一刀，砍在了日本右翼大动脉上"
    }
  ],
