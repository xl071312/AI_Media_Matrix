  "sentences_index": [
    {
      "sentence_id": "s1",
      "char_len": 17,
      "snippet": "图片截取自: 房子太小，影响生娃？"
    },
    {
      "sentence_id": "s2",
      "char_len": 22,
      "snippet": "“90/70”终结，大户型才是下一个黄金十年"
    },
    {
      "sentence_id": "s3",
      "char_len": 17,
      "snippet": "“本文仅在今日头条发布，请勿转载”"
    },
    {
      "sentence_id": "s4",
      "char_len": 14,
      "snippet": "中国的房地产接下来会怎么走？"
    },
    {
      "sentence_id": "s5",
      "char_len": 15,
      "snippet": "未来什么样的房子更加能够保值？"
    },
    {
      "sentence_id": "s6",
      "char_len": 27,
      "snippet": "其实这里面有一条隐藏的逻辑主线，很多人一直没有意识到。"
    },
    {
      "sentence_id": "s7",
      "char_len": 48,
      "snippet": "为什么今年的政府工作报告里面头一回说要加强初婚初育家庭的住房保障，还要支持多子女"
    },
    {
      "sentence_id": "s8",
      "char_len": 18,
      "snippet": "这绝不是托底楼市、刺激需求这么简单。"
    },
    {
      "sentence_id": "s9",
      "char_len": 113,
      "snippet": "如果你接下来准备结婚买房或者生孩子换房，一定要看完这篇文章，因为一系列政策变化的"
    },
    {
      "sentence_id": "s10",
      "char_len": 97,
      "snippet": "现在都说年轻人不愿意生娃是因为经济压力、教育成本等等各种原因，但有一个很关键的点"
    },
    {
      "sentence_id": "s11",
      "char_len": 17,
      "snippet": "图片截取自: 房子太小，影响生娃？"
    },
    {
      "sentence_id": "s12",
      "char_len": 22,
      "snippet": "“90/70”终结，大户型才是下一个黄金十年"
    },
    {
      "sentence_id": "s13",
      "char_len": 20,
      "snippet": "居住痛点：高层小户型下的“三代同堂”困境"
    },
    {
      "sentence_id": "s14",
      "char_len": 23,
      "snippet": "但是现在市面上主流的高层住宅根本住不下三代人。"
    },
    {
      "sentence_id": "s15",
      "char_len": 33,
      "snippet": "一套在房产证上有90平米的房子，扣完公摊，套内面积连80平都不到。"
    },
    {
      "sentence_id": "s16",
      "char_len": 56,
      "snippet": "就算你装修出花来，也很难做出三房，只能整两室一厅：夫妻住一间，孩子住一间，来帮忙"
    },
    {
      "sentence_id": "s17",
      "char_len": 36,
      "snippet": "在早上和晚上，老人还得非常自觉地去小区散步或者跳广场舞，把家留给年轻人；"
    },
    {
      "sentence_id": "s18",
      "char_len": 23,
      "snippet": "等年轻人出门上班之后，老人才能回家做卫生做饭。"
    },
    {
      "sentence_id": "s19",
      "char_len": 37,
      "snippet": "而且房子一挤，生活里面所有的鸡毛蒜皮都会被无限放大，婆媳矛盾也就跟着来了。"
    },
    {
      "sentence_id": "s20",
      "char_len": 27,
      "snippet": "在这样的环境里面，连生一胎都很憋屈，更别说二胎三胎了。"
    },
    {
      "sentence_id": "s21",
      "char_len": 44,
      "snippet": "那你肯定要问了，既然这种小面积的高层住宅有这么多的问题，当年设计的时候难道没有人"
    },
    {
      "sentence_id": "s22",
      "char_len": 44,
      "snippet": "这就不得不说到一个改变中国楼市十几年的政策，估计很多人都没有听过，叫“90/70"
    },
    {
      "sentence_id": "s23",
      "char_len": 17,
      "snippet": "图片截取自: 房子太小，影响生娃？"
    },
    {
      "sentence_id": "s24",
      "char_len": 22,
      "snippet": "“90/70”终结，大户型才是下一个黄金十年"
    },
    {
      "sentence_id": "s25",
      "char_len": 25,
      "snippet": "历史回溯：“9070政策”与开发商的“偷面积”博弈"
    },
    {
      "sentence_id": "s26",
      "char_len": 36,
      "snippet": "“90/70政策”就是说一个小区90平米以下的小户型占比不能低于70%。"
    },
    {
      "sentence_id": "s27",
      "char_len": 16,
      "snippet": "它的出发点是很好，也很有智慧的。"
    },
    {
      "sentence_id": "s28",
      "char_len": 68,
      "snippet": "当时的城镇化加速，房价越来越高，普通人买房越来越困难，所以从2006年开始，国家"
    },
    {
      "sentence_id": "s29",
      "char_len": 34,
      "snippet": "同样一块地就能够盖出更多套房子，还把总价打了下来，让更多人能够上车。"
    },
    {
      "sentence_id": "s30",
      "char_len": 55,
      "snippet": "毫不夸张地说，当时要是没有“90/70政策”，很多人根本没有机会买房，更别说赶上"
    },
    {
      "sentence_id": "s31",
      "char_len": 75,
      "snippet": "但是这个政策也给开发商出了一个很大的难题：一层楼的户数越少，设计的空间就越大，比"
    },
    {
      "sentence_id": "s32",
      "char_len": 61,
      "snippet": "可是现在必须要把70%的房源做成小户型，每层楼都要塞进6户、8户甚至10户，那肯"
    },
    {
      "sentence_id": "s33",
      "char_len": 49,
      "snippet": "想要满足日照要求，只能够把每一栋楼的楼面做小，做成点式塔楼，可是这样一来，每层能"
    },
    {
      "sentence_id": "s34",
      "char_len": 36,
      "snippet": "最后算来算去，开发商只剩下唯一一条出路，就是往天上盖那种小户型点式高层。"
    },
    {
      "sentence_id": "s35",
      "char_len": 59,
      "snippet": "但问题在于，中国的高层住宅还没有流行开，很多刚从农村进城的人住惯了老家的大房子，"
    },
    {
      "sentence_id": "s36",
      "char_len": 34,
      "snippet": "既要盖楼满足政策要求，又要迎合普通人大空间的需求，这几乎是一个死局。"
    },
    {
      "sentence_id": "s37",
      "char_len": 37,
      "snippet": "但是在中国，任何事情都是上有政策下有对策，开发商也很擅长在夹缝里面找出路。"
    },
    {
      "sentence_id": "s38",
      "char_len": 64,
      "snippet": "脑子最活的深圳很快就想出了办法，比如现在你去深圳买二手房，懂行的都知道那些200"
    },
    {
      "sentence_id": "s39",
      "char_len": 73,
      "snippet": "这些房子你看产权证上面全部都是清一色的88、89平，但是你现场一看实际面积都在1"
    },
    {
      "sentence_id": "s40",
      "char_len": 17,
      "snippet": "图片截取自: 房子太小，影响生娃？"
    },
    {
      "sentence_id": "s41",
      "char_len": 22,
      "snippet": "“90/70”终结，大户型才是下一个黄金十年"
    },
    {
      "sentence_id": "s42",
      "char_len": 10,
      "snippet": "他们是怎么做到的呢？"
    },
    {
      "sentence_id": "s43",
      "char_len": 35,
      "snippet": "当时深圳的测绘规范里面对阳台有严格的规定，但是两层高的阳台不计入面积。"
    },
    {
      "sentence_id": "s44",
      "char_len": 75,
      "snippet": "但是当时的深圳开发商通过奇数层、偶数层的错层送阳台的形式规避了这个限制，像当时的"
    },
    {
      "sentence_id": "s45",
      "char_len": 42,
      "snippet": "开发商一交房，业主马上找施工队进场，关起门来封阳台、搭楼板，把赠送的空间全改成房"
    },
    {
      "sentence_id": "s46",
      "char_len": 30,
      "snippet": "改造完的房子就像是瘦子穿了一件很厚的羽绒服，直接胖了一大圈。"
    },
    {
      "sentence_id": "s47",
      "char_len": 58,
      "snippet": "所以你别看现在的四代宅送面积、送阳台，其实这些玩法深圳的开发商早在2006年就已"
    },
    {
      "sentence_id": "s48",
      "char_len": 32,
      "snippet": "但是“偷面积”这种事情必定是打政策的擦边球，既不安全也无法长久。"
    },
    {
      "sentence_id": "s49",
      "char_len": 39,
      "snippet": "后面测绘规范越来越严，阳台飘窗的赠送比例被卡死，错层送面积的玩法彻底行不通了。"
    },
    {
      "sentence_id": "s50",
      "char_len": 50,
      "snippet": "从这之后，市面上的高层住宅都是高公摊、低得房率了，住起来也越来越拥挤，三代同住的"
    },
    {
      "sentence_id": "s51",
      "char_len": 17,
      "snippet": "图片截取自: 房子太小，影响生娃？"
    },
    {
      "sentence_id": "s52",
      "char_len": 22,
      "snippet": "“90/70”终结，大户型才是下一个黄金十年"
    },
    {
      "sentence_id": "s53",
      "char_len": 18,
      "snippet": "未来展望：回归家庭需求与楼市财富洗牌"
    },
    {
      "sentence_id": "s54",
      "char_len": 48,
      "snippet": "所以为什么现在取消了“90/70”的限制，叫停了高层住宅，各种四代住宅重新开放了"
    },
    {
      "sentence_id": "s55",
      "char_len": 70,
      "snippet": "这些变化从来都不只是卖房子、托楼市这么简单，而是经过十几年的政策、资本、业主的三"
    },
    {
      "sentence_id": "s56",
      "char_len": 65,
      "snippet": "以前是政策要保城镇化、保刚需，开发商要抠利润，业主要有限的预算里面去找空间，三方"
    },
    {
      "sentence_id": "s57",
      "char_len": 22,
      "snippet": "“十五五”规划最大的变化就是把人放在了C位。"
    },
    {
      "sentence_id": "s58",
      "char_len": 74,
      "snippet": "这一次政府工作报告对初婚初育家庭、多子女家庭的住房支持，就是一个顶层的定调：房地"
    },
    {
      "sentence_id": "s59",
      "char_len": 28,
      "snippet": "接下来不只是会有又大又便宜的房子，还会有真金白银的补贴。"
    },
    {
      "sentence_id": "s60",
      "char_len": 45,
      "snippet": "当然这个后续的逻辑也将会从土地拍卖到容积率调整，再到价格终端变化，最终形成缓慢的"
    },
    {
      "sentence_id": "s61",
      "char_len": 68,
      "snippet": "它的过程不是一蹴而就，而是逐渐切换，从而完成楼市新一轮的财富洗牌：一些房子的保值"
    }
  ],
