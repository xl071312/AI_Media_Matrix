  "performance_tier": "CONTROL",
  "spoken_marker_eligible": "N/A_TEXT",
  "analysis_status": "OK",
  "analyzer_version": "phase_c_v1",
  "sentence_count": 59,
  "sentences_index": [
    {
      "sentence_id": "s1",
      "char_len": 45,
      "snippet": "你有没有发现，同样是经济发达地区，但在吸引人口这件事上，近两年江浙沪似乎突然抢不过广东了。"
    },
    {
      "sentence_id": "s2",
      "char_len": 25,
      "snippet": "2025年各地人口数据出炉，结果出乎大多数人意料。"
    },
    {
      "sentence_id": "s3",
      "char_len": 66,
      "snippet": "在常住人口增量前十的城市中，广东一省独占六席，而经济体量相当于两个广东的江浙沪（合计约29万亿GDP），却仅有杭州一根独苗勉强支撑。"
    },
    {
      "sentence_id": "s4",
      "char_len": 41,
      "snippet": "算总账更扎心，广东去年一年常住人口猛增79万，其中自然增长29万，净流入约50万。"
    },
    {
      "sentence_id": "s5",
      "char_len": 27,
      "snippet": "反观长三角，浙江虽增加了31万人，但自然增长率已转负；"
    },
    {
      "sentence_id": "s6",
      "char_len": 15,
      "snippet": "江苏更惨，直接减少了约8万人；"
    },
    {
      "sentence_id": "s7",
      "char_len": 8,
      "snippet": "上海微增5万多。"
    },
    {
      "sentence_id": "s8",
      "char_len": 24,
      "snippet": "江浙沪三巨头捆在一起，人口总增量竟不及广东一半。"
    },
    {
      "sentence_id": "s9",
      "char_len": 19,
      "snippet": "同是发达地区，为何出现如此魔幻的分化？"
    },
    {
      "sentence_id": "s10",
      "char_len": 20,
      "snippet": "人口增长无非两条路：自己生，或者外面抢。"
    },
    {
      "sentence_id": "s11",
      "char_len": 7,
      "snippet": "先说自然增长。"
    },
    {
      "sentence_id": "s12",
      "char_len": 34,
      "snippet": "去年全国仅剩5个省份人口自然增长为正：广东、新疆、青海、贵州、西藏。"
    },
    {
      "sentence_id": "s13",
      "char_len": 17,
      "snippet": "沿海发达地区除广东外，已全军覆没。"
    },
    {
      "sentence_id": "s14",
      "char_len": 49,
      "snippet": "江浙沪一边抢人速度跟不上，一边本地户籍人口负增长还在不断抵消抢进来的数量，一进一出，差距自然拉开。"
    },
    {
      "sentence_id": "s15",
      "char_len": 10,
      "snippet": "广东为什么这么能生？"
    },
    {
      "sentence_id": "s16",
      "char_len": 29,
      "snippet": "除了生育文化和理念差异，深层原因在于其极度健康的年龄结构。"
    },
    {
      "sentence_id": "s17",
      "char_len": 36,
      "snippet": "2025年，全国65岁以上人口占比已达15.9%，而广东仅为10.3%。"
    },
    {
      "sentence_id": "s18",
      "char_len": 28,
      "snippet": "东莞15至59岁劳动人口占比高达81.41%，断层领先；"
    },
    {
      "sentence_id": "s19",
      "char_len": 45,
      "snippet": "深圳、中山、广州、佛山等人口增长前十的城市，年轻人占比普遍在70%以上，堪称“青春之城”。"
    },
    {
      "sentence_id": "s20",
      "char_len": 38,
      "snippet": "正是这些二三十岁进厂、进公司的年轻人，硬生生撑起了广东全年百万级的出生人口。"
    },
    {
      "sentence_id": "s21",
      "char_len": 27,
      "snippet": "广东的人口逻辑形成了一个良性闭环，机会多，年轻人涌入；"
    },
    {
      "sentence_id": "s22",
      "char_len": 10,
      "snippet": "愿意留下，愿意生育；"
    },
    {
      "sentence_id": "s23",
      "char_len": 18,
      "snippet": "人口结构保持年轻，继续吸引更多机会。"
    },
    {
      "sentence_id": "s24",
      "char_len": 37,
      "snippet": "而起步更早、率先富裕起来的江浙沪，老龄化已将自然增长这条“血槽”彻底拖空。"
    },
    {
      "sentence_id": "s25",
      "char_len": 27,
      "snippet": "江苏65岁以上常住人口占全省19%，浙江达16.1%。"
    },
    {
      "sentence_id": "s26",
      "char_len": 36,
      "snippet": "上海若只看户籍人口，65岁以上老人已占30%，每三个人里就有一个是老人。"
    },
    {
      "sentence_id": "s27",
      "char_len": 22,
      "snippet": "对比广东10.3%的老龄化率，差距触目惊心。"
    },
    {
      "sentence_id": "s28",
      "char_len": 30,
      "snippet": "有人会问，就算都不生了，光拼抢人，江浙沪也不至于输这么多吧？"
    },
    {
      "sentence_id": "s29",
      "char_len": 16,
      "snippet": "这里涉及两地产业生态的根本差异。"
    },
    {
      "sentence_id": "s30",
      "char_len": 34,
      "snippet": "江苏经济形态呈典型“建制派”特征，基本盘是大型外企、国企和高端制造。"
    },
    {
      "sentence_id": "s31",
      "char_len": 43,
      "snippet": "高新技术产值占规上工业比重达52.1%，16个先进制造业集群营收占规上工业高达75%。"
    },
    {
      "sentence_id": "s32",
      "char_len": 21,
      "snippet": "这些企业合规性极高，提供标准化的正规岗位。"
    },
    {
      "sentence_id": "s33",
      "char_len": 21,
      "snippet": "想在此谋个好前程，硕博起步的学历是敲门砖。"
    },
    {
      "sentence_id": "s34",
      "char_len": 25,
      "snippet": "对学历普通的打工人而言，光看招聘要求就打退堂鼓了。"
    },
    {
      "sentence_id": "s35",
      "char_len": 28,
      "snippet": "广东同样吸引精英，但它从未忘记自己的深层底色，草根经济。"
    },
    {
      "sentence_id": "s36",
      "char_len": 19,
      "snippet": "有句话说得好，东西南北中，发财到广东。"
    },
    {
      "sentence_id": "s37",
      "char_len": 51,
      "snippet": "第五次全国经济普查数据显示，广东二三产业法人单位多达460多万个，江苏仅290万个，这个差距极为关键。"
    },
    {
      "sentence_id": "s38",
      "char_len": 34,
      "snippet": "企业越多，从业池子越大，跳槽机会、临时机会就越多，产业链配套越密集。"
    },
    {
      "sentence_id": "s39",
      "char_len": 71,
      "snippet": "珠三角拥有全国最庞大的非正规经济生态，华强北的一米柜台、十三行的服装档口、遍布城中村的跨境电商小作坊，以及东莞、佛山、中山密密麻麻的产业配套。"
    },
    {
      "sentence_id": "s40",
      "char_len": 55,
      "snippet": "不同于江苏“十三太保”及浙江各城市相对分散的引力（如义乌、温州虽强但体量有限），广东走的是高密度产业浓缩路线。"
    },
    {
      "sentence_id": "s41",
      "char_len": 77,
      "snippet": "近8000万人口汇聚在珠三角核心城市群，极高的人口与企业密度催生了恐怖的乘数效应：一个制造业岗位落地，背后带动房东、便利店、夜市摊、外卖一整条生活服务链。"
    },
    {
      "sentence_id": "s42",
      "char_len": 32,
      "snippet": "一个工厂开起来，养活的不仅是流水线工人，更是周边一整套配套服务。"
    },
    {
      "sentence_id": "s43",
      "char_len": 12,
      "snippet": "机会就这样源源不断溢出。"
    },
    {
      "sentence_id": "s44",
      "char_len": 36,
      "snippet": "加之紧邻广西、江西、湖南等劳务输出大省，劳动力一出来便被珠三角无缝衔接。"
    },
    {
      "sentence_id": "s45",
      "char_len": 53,
      "snippet": "对普通人而言，在广东，进不了大厂进小厂，进不了写字楼跑外卖，做不了高精尖做仓储物流，实在不行还能档口摆摊。"
    },
    {
      "sentence_id": "s46",
      "char_len": 14,
      "snippet": "这里从不缺少草根逆袭的故事。"
    },
    {
      "sentence_id": "s47",
      "char_len": 51,
      "snippet": "今天拎着蛇皮袋进城的打工人，明天就能在城中村租个200块的小房间，吃碗15块钱的隆江猪脚饭先安顿下来。"
    },
    {
      "sentence_id": "s48",
      "char_len": 14,
      "snippet": "有本事创业，没本事打工糊口。"
    },
    {
      "sentence_id": "s49",
      "char_len": 30,
      "snippet": "今天败了，明天换个城中村、换个档口、换个工厂，照样重新开始。"
    },
    {
      "sentence_id": "s50",
      "char_len": 15,
      "snippet": "只要你愿意干，广东就给你机会。"
    },
    {
      "sentence_id": "s51",
      "char_len": 78,
      "snippet": "一个耐人寻味的现象是，前段时间广州拟出台举报“三非”外国人奖励新规，大家拍手叫好时，可曾想过：那些没钱、没学历、甚至语言不通的非洲人，为何能在广州生存下来？"
    },
    {
      "sentence_id": "s52",
      "char_len": 19,
      "snippet": "答案正是广东真正的底牌，极高的容错率。"
    },
    {
      "sentence_id": "s53",
      "char_len": 30,
      "snippet": "这里的生存门槛低到了下限，绝大多数人只要来了，就能找到活路。"
    },
    {
      "sentence_id": "s54",
      "char_len": 44,
      "snippet": "在这个人口大盘缩水、学历门槛加速内卷的时代，普通人选择城市，本质上是在选择人生的容错率。"
    },
    {
      "sentence_id": "s55",
      "char_len": 46,
      "snippet": "当传统的正规岗位日益拥挤，珠三角庞大的灵活就业生态和包容底色，反而成了无数人最坚实的安全网。"
    },
    {
      "sentence_id": "s56",
      "char_len": 43,
      "snippet": "读懂这套人口流动逻辑就会明白，未来真正能持续吸引人口的城市，不一定是高高在上的样板间。"
    },
    {
      "sentence_id": "s57",
      "char_len": 38,
      "snippet": "许多看似光鲜的高科技产业，实则吸纳就业人数有限，这轮AI浪潮已验证了这一点。"
    },
    {
      "sentence_id": "s58",
      "char_len": 30,
      "snippet": "接下来真正比拼的，是能给更多人留下一张兜底饭桌的“大熔炉”。"
    },
    {
      "sentence_id": "s59",
      "char_len": 42,
      "snippet": "看清这个宏观趋势，你才可能在接下来残酷的存量博弈中，找到真正属于自己安身立命的坐标。"
    }
  ],
