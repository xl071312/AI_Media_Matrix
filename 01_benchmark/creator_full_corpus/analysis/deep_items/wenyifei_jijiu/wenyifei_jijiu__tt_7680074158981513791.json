  "sentence_count": 35,
  "sentences_index": [
    {
      "sentence_id": "s1",
      "char_len": 16,
      "snippet": "从前借钱靠亲戚，现在借钱靠花呗。"
    },
    {
      "sentence_id": "s2",
      "char_len": 36,
      "snippet": "一代人的迁徙，正在把七大姑八大姨变成朋友圈里的点赞之交，背后真相扎心了。"
    },
    {
      "sentence_id": "s3",
      "char_len": 13,
      "snippet": "你有多久没主动联系过亲戚？"
    },
    {
      "sentence_id": "s4",
      "char_len": 22,
      "snippet": "从前常串门的亲人，如今只剩过年时的客套寒暄。"
    },
    {
      "sentence_id": "s5",
      "char_len": 33,
      "snippet": "从小一起长大的堂表兄弟姐妹，连彼此在哪座城市、是否成婚都一无所知。"
    },
    {
      "sentence_id": "s6",
      "char_len": 28,
      "snippet": "延续千年的亲族关系，为何在当代年轻人中出现大规模断亲潮？"
    },
    {
      "sentence_id": "s7",
      "char_len": 19,
      "snippet": "断亲不是道德问题，而是生存模式的颠覆。"
    },
    {
      "sentence_id": "s8",
      "char_len": 26,
      "snippet": "父母辈的亲戚关系，建立在熟人社会与农业生产的基础上。"
    },
    {
      "sentence_id": "s9",
      "char_len": 56,
      "snippet": "生活半径局限于十里八乡，盖房要亲戚帮工，农忙要互相换工，急用钱只能找亲戚借，办喜事得几十位亲友搭手才能完成流程。"
    },
    {
      "sentence_id": "s10",
      "char_len": 29,
      "snippet": "那时的亲戚互助，本质是民间非正式的保险体系，彼此互为依靠。"
    },
    {
      "sentence_id": "s11",
      "char_len": 32,
      "snippet": "如今搬家有货拉拉，缺钱有正规金融渠道，结婚有婚庆公司一条龙服务。"
    },
    {
      "sentence_id": "s12",
      "char_len": 29,
      "snippet": "当能用钱和市场规则解决问题时，没人愿意背负还不清的人情债。"
    },
    {
      "sentence_id": "s13",
      "char_len": 23,
      "snippet": "断亲潮的真正赢家，是银行、保险公司与平台经济。"
    },
    {
      "sentence_id": "s14",
      "char_len": 32,
      "snippet": "年轻人只是把原先压在亲戚身上的需求，换成了按月缴费的市场化服务。"
    },
    {
      "sentence_id": "s15",
      "char_len": 38,
      "snippet": "过去30年，中国城镇化率从不足30%飙升至近70%，几亿人离开农村进城安家。"
    },
    {
      "sentence_id": "s16",
      "char_len": 59,
      "snippet": "这代年轻人是在工业与城镇化环境中长大的第一代，父辈的童年是农忙、换工与家族群聚，我们的童年是单元楼、兴趣班与独生子女。"
    },
    {
      "sentence_id": "s17",
      "char_len": 41,
      "snippet": "农业社会里，经验可代代相传，爷爷懂看云识雨，二大爷懂土地习性，不听老人言真会吃亏。"
    },
    {
      "sentence_id": "s18",
      "char_len": 56,
      "snippet": "但现在，我们用几十年走完西方几百年的路，工业社会经验保质期缩至十年，互联网时代只剩一两年，AI时代甚至按月计算。"
    },
    {
      "sentence_id": "s19",
      "char_len": 32,
      "snippet": "你关注大模型、自媒体与行业内卷，长辈惦记考研、考公、买房与生育；"
    },
    {
      "sentence_id": "s20",
      "char_len": 34,
      "snippet": "你面对经济周期、996与收入困境，长辈却觉得大学生毕业该鲤鱼跃龙门。"
    },
    {
      "sentence_id": "s21",
      "char_len": 40,
      "snippet": "连智能手机定位都搞不清的长辈，他们的经验放到北上广深，可能一个标点符号都用不上。"
    },
    {
      "sentence_id": "s22",
      "char_len": 39,
      "snippet": "不少父母是家族网络的“路由器”，记得所有血缘关系，负责串门、组局、送礼与调解。"
    },
    {
      "sentence_id": "s23",
      "char_len": 71,
      "snippet": "但如今城镇常住人口超9.4亿，等这代“路由器”老去，下一代既无共同生活经历，也无互相扶持的记忆，通讯录里的表哥表姐，终将变成见面不识的陌生人。"
    },
    {
      "sentence_id": "s24",
      "char_len": 30,
      "snippet": "“一代亲，二代表，三代四代不走了”的老话，在当代被无限放大。"
    },
    {
      "sentence_id": "s25",
      "char_len": 41,
      "snippet": "这并非中国独有，大洋彼岸的美国，在那段轰轰烈烈的城镇化进程中，也曾出现相似断亲潮。"
    },
    {
      "sentence_id": "s26",
      "char_len": 18,
      "snippet": "我们只是站在了社会转型的历史节点上。"
    },
    {
      "sentence_id": "s27",
      "char_len": 36,
      "snippet": "有意思的是，这代经历断亲潮的人，或许是最后一代能真正享受亲戚红利的群体。"
    },
    {
      "sentence_id": "s28",
      "char_len": 72,
      "snippet": "不少父母辈多出生于60、70年代，赶上多子女生育高峰末班车，兄弟姐妹动辄五六个，庞大的亲戚矩阵里，总有几位愿意拉你一把、提供信息差的长辈或同辈。"
    },
    {
      "sentence_id": "s29",
      "char_len": 17,
      "snippet": "很多人的工作，就是亲戚帮忙介绍的。"
    },
    {
      "sentence_id": "s30",
      "char_len": 19,
      "snippet": "我们可以去芜存菁，自由选择联络的亲戚。"
    },
    {
      "sentence_id": "s31",
      "char_len": 41,
      "snippet": "但再往下一代，独生子女成为父母，连兄弟姐妹都没有，七大姑八大姨将彻底成为历史名词。"
    },
    {
      "sentence_id": "s32",
      "char_len": 32,
      "snippet": "那种几十口人聚在一起吵吵闹闹、互相帮忙的家族烟火气，很快会消失。"
    },
    {
      "sentence_id": "s33",
      "char_len": 18,
      "snippet": "迎接下一代的，将是完全原子化的社会。"
    },
    {
      "sentence_id": "s34",
      "char_len": 32,
      "snippet": "我们正在告别一个时代，断亲断掉的是传统社会强行捆绑的利益与规矩。"
    },
    {
      "sentence_id": "s35",
      "char_len": 64,
      "snippet": "但如果剥离这些后，身边还有愿意真心换真心的亲人，请一定要好好珍惜，毕竟在越发原子化的社会里，这种毫无保留的羁绊，已经越来越少了。"
    }
  ],
