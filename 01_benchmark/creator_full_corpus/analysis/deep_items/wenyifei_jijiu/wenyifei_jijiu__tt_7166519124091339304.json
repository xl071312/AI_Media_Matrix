  "source_sha256": "8bc715ae57fa297bc2a2b26d8bf68de8af5c223537b0d6f8e5d46595c985ef6b",
  "performance_tier": "HIGH",
  "spoken_marker_eligible": "N/A_TEXT",
  "analysis_status": "OK",
  "analyzer_version": "phase_c_v1",
  "sentence_count": 78,
  "sentences_index": [
    {
      "sentence_id": "s1",
      "char_len": 2,
      "snippet": "一、"
    },
    {
      "sentence_id": "s2",
      "char_len": 52,
      "snippet": "中国去年一整年，花在医疗卫生上的钱，所有人加起来一共是7.55万亿，平均到每个人就是5000多块钱一年。"
    },
    {
      "sentence_id": "s3",
      "char_len": 42,
      "snippet": "再乘以我们的人均寿命78岁，也就是说一个中国人，一辈子平均消耗的医疗费是40万左右。"
    },
    {
      "sentence_id": "s4",
      "char_len": 22,
      "snippet": "图片截取自: 你的工资够你在ICU里住几天？"
    },
    {
      "sentence_id": "s5",
      "char_len": 11,
      "snippet": "在中国看病到底贵不贵？"
    },
    {
      "sentence_id": "s6",
      "char_len": 65,
      "snippet": "但是这里面包含了建医院的费用，买设备的费用，还有医保报销的费用，如果我们只说，从你个人口袋里掏出来的钱，你自己自费花的钱是多少呢？"
    },
    {
      "sentence_id": "s7",
      "char_len": 64,
      "snippet": "2021年，中国人均医疗消费是2115元，一个人每年平均要花2000多看病，算你活八十岁，也就是每个人一辈子要花17万在医疗上。"
    },
    {
      "sentence_id": "s8",
      "char_len": 22,
      "snippet": "图片截取自: 你的工资够你在ICU里住几天？"
    },
    {
      "sentence_id": "s9",
      "char_len": 11,
      "snippet": "在中国看病到底贵不贵？"
    },
    {
      "sentence_id": "s10",
      "char_len": 15,
      "snippet": "一个人，一辈子，花17万看病。"
    },
    {
      "sentence_id": "s11",
      "char_len": 17,
      "snippet": "似乎看着还行，咬咬牙好像也能承受。"
    },
    {
      "sentence_id": "s12",
      "char_len": 13,
      "snippet": "但是这个数字，有几个问题。"
    },
    {
      "sentence_id": "s13",
      "char_len": 27,
      "snippet": "第一，医疗开销的上涨速度特别快，比经济增长速度快得多。"
    },
    {
      "sentence_id": "s14",
      "char_len": 77,
      "snippet": "过去十年，经济的增速是每年百分之六，而医疗开销每年涨百分之十二，十年涨了三倍多了，2018年的时候还是五万多亿，19年就六万多亿了，到20年就七万多亿了。"
    },
    {
      "sentence_id": "s15",
      "char_len": 50,
      "snippet": "第二点，前几年老龄化还不严重，从去年开始，中国进入深度老龄化，老龄化一出现，医疗支出肯定会跟着就涨。"
    },
    {
      "sentence_id": "s16",
      "char_len": 85,
      "snippet": "一般发达国家医疗占经济的比例，都是10%以上，像法国德国日本，都是11%左右，美国医疗特别贵，干到了GDP的17%，中国现在只占了7%，明显是比较低，等涨到10"
    },
    {
      "sentence_id": "s17",
      "char_len": 52,
      "snippet": "那比如说，现在人均收入一年是三万五，80年下来你能赚，280万，其中十分之一是医药费，那就是将近三十万。"
    },
    {
      "sentence_id": "s18",
      "char_len": 96,
      "snippet": "30万一个人，一家三口人，对普通家庭，那就是一个很大的开销了，而且健康的时候不花钱，一生病就是短时间需要大笔的现金，病人自己不能再工作，往往还需要再出一个劳力去"
    },
    {
      "sentence_id": "s19",
      "char_len": 21,
      "snippet": "而且医疗还有个问题，就是地区之间很不平衡。"
    },
    {
      "sentence_id": "s20",
      "char_len": 55,
      "snippet": "最好的医院，都在大城市，你在小城市赚了钱，房租、吃饭、买衣服这些都是按当地物价来生活，那都是跟当地收入配套的。"
    },
    {
      "sentence_id": "s21",
      "char_len": 40,
      "snippet": "但遇上大病必须要去省会甚至北京上海去看病，当地医院的价格都是按当地收入标准来定。"
    },
    {
      "sentence_id": "s22",
      "char_len": 67,
      "snippet": "这跟其他贵的东西不太一样，去餐厅吃饭的时候，你没钱可以不进大酒店，豪车豪宅，没钱可以不买，但是生了病，大家都还是希望能见到最好的医生。"
    },
    {
      "sentence_id": "s23",
      "char_len": 36,
      "snippet": "最后普通人用小城市三万块的收入水平，去应对年收入三十万一年的地方的物价。"
    },
    {
      "sentence_id": "s24",
      "char_len": 30,
      "snippet": "还有人说，人一辈子的积蓄，40%都花在临终前的最后两个月里。"
    },
    {
      "sentence_id": "s25",
      "char_len": 36,
      "snippet": "省吃俭用的钱，到了最后时刻，被迫地去烧掉，这种感受才是最让人觉得荒唐的。"
    },
    {
      "sentence_id": "s26",
      "char_len": 2,
      "snippet": "二、"
    },
    {
      "sentence_id": "s27",
      "char_len": 45,
      "snippet": "我专门找了几位知名三甲医院的院长，问了一下普通人可能会遇到的最贵的病，还有治疗要花多少钱。"
    },
    {
      "sentence_id": "s28",
      "char_len": 60,
      "snippet": "其中有一位院长给我的回复我印象很深，他说医院不是你想的那样，一个病人来了，要么就把钱交齐，一次把病治好，要么就回家等死。"
    },
    {
      "sentence_id": "s29",
      "char_len": 22,
      "snippet": "图片截取自: 你的工资够你在ICU里住几天？"
    },
    {
      "sentence_id": "s30",
      "char_len": 11,
      "snippet": "在中国看病到底贵不贵？"
    },
    {
      "sentence_id": "s31",
      "char_len": 68,
      "snippet": "医院像一个美食城，富人来了，有生猛海鲜照顾，普通人来了，也有家常菜可以点，实在一点钱都没有，免费的盒饭也能给你一个，让你这一顿饭饿不死。"
    },
    {
      "sentence_id": "s32",
      "char_len": 16,
      "snippet": "同样的病，有钱没钱各有各的治法。"
    },
    {
      "sentence_id": "s33",
      "char_len": 45,
      "snippet": "比如说癌症患者，有进口的药，靶向加免疫，副作用小，效果也好，但是很贵，一年大几十万不报销。"
    },
    {
      "sentence_id": "s34",
      "char_len": 67,
      "snippet": "差一点呢，可以放疗加化疗，一年十万，医保还能报销一半，再不行还有口服化疗药，提高生存质量，缓解症状，一个月几千块钱，自费的比例非常小。"
    },
    {
      "sentence_id": "s35",
      "char_len": 22,
      "snippet": "图片截取自: 你的工资够你在ICU里住几天？"
    },
    {
      "sentence_id": "s36",
      "char_len": 11,
      "snippet": "在中国看病到底贵不贵？"
    },
    {
      "sentence_id": "s37",
      "char_len": 20,
      "snippet": "要是一点钱都没有，也有回家吃中药的路线。"
    },
    {
      "sentence_id": "s38",
      "char_len": 54,
      "snippet": "癌症以外，几个最贵的科室，像心内科CRTD植入，15万左右，胸外科有四五十万的心脏移植，二三十万的孙氏手术。"
    },
    {
      "sentence_id": "s39",
      "char_len": 44,
      "snippet": "脑外科的肿瘤有五十万左右的手术，最贵的是肾病，慢性肾病有的需要十几万一年，持续二三十年。"
    },
    {
      "sentence_id": "s40",
      "char_len": 17,
      "snippet": "再就是器官移植，常常会到百万以上。"
    },
    {
      "sentence_id": "s41",
      "char_len": 63,
      "snippet": "在中国，如果你不考虑去美国看病，遇到大病重病，想要跟医生说一句，钱不用考虑，用最好的办法全力治病，账户里起码要有一两百万打底。"
    },
    {
      "sentence_id": "s42",
      "char_len": 34,
      "snippet": "听起来有些残忍，特别是如果明明有治疗方案，却因为钱不够治不起的时候。"
    },
    {
      "sentence_id": "s43",
      "char_len": 12,
      "snippet": "但是，医药费真的很贵吗？"
    },
    {
      "sentence_id": "s44",
      "char_len": 25,
      "snippet": "我觉得这里分两块，药费真的很贵，医疗器材真的很贵。"
    },
    {
      "sentence_id": "s45",
      "char_len": 8,
      "snippet": "医生真的很便宜。"
    },
    {
      "sentence_id": "s46",
      "char_len": 26,
      "snippet": "在中国的医院看病，挂号费几十块，专家一两百就能见到。"
    },
    {
      "sentence_id": "s47",
      "char_len": 57,
      "snippet": "这是一群起码读了八年医学院，实习培训，多年研究的专业技术人员，任何一个其他类似行业，专业技术都不会便宜到这个地步。"
    },
    {
      "sentence_id": "s48",
      "char_len": 31,
      "snippet": "说得极端一点，现在去进医院挂号的费用，比去动物园看猴子还便宜。"
    },
    {
      "sentence_id": "s49",
      "char_len": 27,
      "snippet": "找主任专家那看个病的钱，比去隔壁理发店剪个头发还便宜。"
    },
    {
      "sentence_id": "s50",
      "char_len": 2,
      "snippet": "三、"
    },
    {
      "sentence_id": "s51",
      "char_len": 55,
      "snippet": "我们国家人均收入一年才三万多，重症监护室一天的开销就要八千，一年的工作不吃不喝，万一进了ICU，只够治四天的。"
    },
    {
      "sentence_id": "s52",
      "char_len": 13,
      "snippet": "所以从数字上说，确实很贵。"
    },
    {
      "sentence_id": "s53",
      "char_len": 71,
      "snippet": "但是相对而言，便宜又是真的便宜，医院几十块就能挂个号，一百多就能见专家，一台心脏手术，如果不算药材和器械，一屋子的医生护士的手艺只值几千块钱。"
    },
    {
      "sentence_id": "s54",
      "char_len": 22,
      "snippet": "图片截取自: 你的工资够你在ICU里住几天？"
    },
    {
      "sentence_id": "s55",
      "char_len": 11,
      "snippet": "在中国看病到底贵不贵？"
    },
    {
      "sentence_id": "s56",
      "char_len": 24,
      "snippet": "相比发达国家的医生收入，中国的医生算非常廉价了。"
    },
    {
      "sentence_id": "s57",
      "char_len": 47,
      "snippet": "就比如最顶级的协和医院，2000多个床位，年收入112亿，人民币，算上财政的支持，能勉强不亏。"
    },
    {
      "sentence_id": "s58",
      "char_len": 60,
      "snippet": "美国最顶级的梅奥医院，也是2000个床位，年收入157亿，美金，也就是1100亿人民币，每张床的收入，刚好是协和的十倍。"
    },
    {
      "sentence_id": "s59",
      "char_len": 43,
      "snippet": "全世界各国的医疗开销，一般占GDP是10%左右，其中医疗机构的人员支出，一般是占一半。"
    },
    {
      "sentence_id": "s60",
      "char_len": 49,
      "snippet": "而我们国家医疗占GDP的6%，医疗设备耗材这些，全世界价格都差不多，省出来的其实主要就是医生工资。"
    },
    {
      "sentence_id": "s61",
      "char_len": 30,
      "snippet": "大家还觉得很贵，核心的原因其实在于两点，首先是医疗的被迫性。"
    },
    {
      "sentence_id": "s62",
      "char_len": 70,
      "snippet": "酒吧一晚上几万，一个名牌包几十万，一个块名表几百万，一套豪宅几个亿，这些消费不说是满地都是，起码大家都知道，并且默认合理，自己不消费就行了。"
    },
    {
      "sentence_id": "s63",
      "char_len": 67,
      "snippet": "但是医疗不行，医疗虽然也有匹配各种价格的服务，比如社区医院，二级医院，但是大家真的生了病，都还是会去找三甲医院，都还是去挂老专家的号。"
    },
    {
      "sentence_id": "s64",
      "char_len": 30,
      "snippet": "你不得不去消费最高级的医疗产品，不然你会痛苦，甚至会有危险。"
    },
    {
      "sentence_id": "s65",
      "char_len": 9,
      "snippet": "可以说你是被迫的。"
    },
    {
      "sentence_id": "s66",
      "char_len": 60,
      "snippet": "然后大家默认健康是应得的，是理所应当的，花了钱没有让你更好，只不过是让你恢复正常而已，所以哪怕花了一点钱，也会觉得很亏。"
    },
    {
      "sentence_id": "s67",
      "char_len": 27,
      "snippet": "其实客观讲，中国的医疗体系已经是最照顾普通人的方式了。"
    },
    {
      "sentence_id": "s68",
      "char_len": 72,
      "snippet": "我们医保报销的逻辑，就是越便宜的治法报销得越多，反而像是进口药，原研药，最先进的那些治疗手段，报销比例非常低，大部分都要自费，因为要照顾老百姓。"
    },
    {
      "sentence_id": "s69",
      "char_len": 51,
      "snippet": "你在中国买好车，买名表，用进口药，都要额外交税，这些消费都比国外贵，反而是看病的消费，都要比国外便宜。"
    },
    {
      "sentence_id": "s70",
      "char_len": 53,
      "snippet": "很多有钱人得病最后去美国治，就是因为美国的医疗体系特别擅长把一些疑难杂症，甚至是绝症，延长半年一年的寿命。"
    },
    {
      "sentence_id": "s71",
      "char_len": 94,
      "snippet": "因为美国医院大部分不是公立的，倒也不是说为了赚钱，因为主流都是非盈利的公益机构，但是他们要为基金的投资人负责，投资人都是富豪，所以医院特别喜欢治富豪的病，不惜代"
    },
    {
      "sentence_id": "s72",
      "char_len": 23,
      "snippet": "但是这对大部分普通人来说是根本接触不到的资源。"
    },
    {
      "sentence_id": "s73",
      "char_len": 15,
      "snippet": "最后，如果治病最后真的没钱了。"
    },
    {
      "sentence_id": "s74",
      "char_len": 36,
      "snippet": "最后的办法，第一，想办法进临床试验，反而可能有机会收到最先进的治疗方案。"
    },
    {
      "sentence_id": "s75",
      "char_len": 44,
      "snippet": "第二，想办法拖时间，现在集采不断再把药材价格打下来，医保也许明天就突然覆盖了你需要的药。"
    },
    {
      "sentence_id": "s76",
      "char_len": 22,
      "snippet": "图片截取自: 你的工资够你在ICU里住几天？"
    },
    {
      "sentence_id": "s77",
      "char_len": 11,
      "snippet": "在中国看病到底贵不贵？"
    },
    {
      "sentence_id": "s78",
      "char_len": 52,
      "snippet": "最后也劝大家有闲钱的，一年几百一千块钱买个百万医疗险，别买贵的，就买基础型，一顿饭的钱，关键时候能保命。"
    }
  ],
