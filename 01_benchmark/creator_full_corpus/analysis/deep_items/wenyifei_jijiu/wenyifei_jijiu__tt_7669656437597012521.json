  "performance_tier": "CONTROL",
  "spoken_marker_eligible": "N/A_TEXT",
  "analysis_status": "OK",
  "analyzer_version": "phase_c_v1",
  "sentence_count": 75,
  "sentences_index": [
    {
      "sentence_id": "s1",
      "char_len": 24,
      "snippet": "高市早苗的不懈努力之下，日元终于快要跌成废纸了。"
    },
    {
      "sentence_id": "s2",
      "char_len": 37,
      "snippet": "日本的破产企业数量也创下了十几年以来的新高，留给日本的时间真的已经不多了。"
    },
    {
      "sentence_id": "s3",
      "char_len": 54,
      "snippet": "就在最近几天，外汇市场甩出一个足以刺痛每个日本人的数字：美元兑日元盘中突破\"16"
    },
    {
      "sentence_id": "s4",
      "char_len": 28,
      "snippet": "仅仅在过去一年多时间里，日元兑人民币就贬值了接近20%。"
    },
    {
      "sentence_id": "s5",
      "char_len": 66,
      "snippet": "前段时间，日本更是一度成为iPhone手机售价最便宜的地区，不是苹果在日本良心发"
    },
    {
      "sentence_id": "s6",
      "char_len": 36,
      "snippet": "与此同时，日本最新的民调也出来了，高市早苗内阁的支持率已经跌到了41%。"
    },
    {
      "sentence_id": "s7",
      "char_len": 36,
      "snippet": "要知道她巅峰时期的支持率可是82%，从巅峰到腰斩，高市只用了9个月时间。"
    },
    {
      "sentence_id": "s8",
      "char_len": 30,
      "snippet": "到底是什么样的骚操作，才能够把支持率和日元汇率搞得每况愈下？"
    },
    {
      "sentence_id": "s9",
      "char_len": 18,
      "snippet": "接下来等待日本的又将会是怎样的命运？"
    },
    {
      "sentence_id": "s10",
      "char_len": 30,
      "snippet": "高市早苗之所以能够上台，主要还是因为她会玩弄日本社会的情绪。"
    },
    {
      "sentence_id": "s11",
      "char_len": 15,
      "snippet": "日本产业转型失败，怪中国崛起；"
    },
    {
      "sentence_id": "s12",
      "char_len": 11,
      "snippet": "经济下滑，怪中方反制。"
    },
    {
      "sentence_id": "s13",
      "char_len": 33,
      "snippet": "总之，只要日本老百姓的日子越来越难，就把锅全部甩给所谓的外部打压。"
    },
    {
      "sentence_id": "s14",
      "char_len": 31,
      "snippet": "甚至为了极右翼的支持，她还无中生有编造出什么“存亡危机事态”。"
    },
    {
      "sentence_id": "s15",
      "char_len": 58,
      "snippet": "再加上日本经济已经低迷了30多年，很多日本人心里确实憋着一口气，希望能够出现一个"
    },
    {
      "sentence_id": "s16",
      "char_len": 20,
      "snippet": "这个时候，高市早苗当然就很容易收割选票。"
    },
    {
      "sentence_id": "s17",
      "char_len": 31,
      "snippet": "但是这套把戏能够玩下去的前提是，你得真的能给现状带来一点改变。"
    },
    {
      "sentence_id": "s18",
      "char_len": 21,
      "snippet": "现在来看，改变确实有了，但没有一件是好事。"
    },
    {
      "sentence_id": "s19",
      "char_len": 22,
      "snippet": "日本本来就没有剩下几条路，现在都快被堵死了。"
    },
    {
      "sentence_id": "s20",
      "char_len": 27,
      "snippet": "上次日元来到美元兑日元163这个位置，还是1986年。"
    },
    {
      "sentence_id": "s21",
      "char_len": 36,
      "snippet": "那个时候，日本虽然泡沫已经膨胀了，但不可否认那也是日本经济最辉煌的年代。"
    },
    {
      "sentence_id": "s22",
      "char_len": 45,
      "snippet": "GDP世界第二，人均国民生产总值一度超过美国，半导体占据全球一半的市场，汽车产量"
    },
    {
      "sentence_id": "s23",
      "char_len": 33,
      "snippet": "那个时候的日本人，洛克菲勒中心说买就买，哥伦比亚影业说收购就收购。"
    },
    {
      "sentence_id": "s24",
      "char_len": 88,
      "snippet": "40多年后的今天，还是1:163，但日本的GDP已经跌到了世界第四，半导体全球份"
    },
    {
      "sentence_id": "s25",
      "char_len": 1,
      "snippet": "\""
    },
    {
      "sentence_id": "s26",
      "char_len": 31,
      "snippet": "刺痛日本人的不只是日本衰落的账单，还有饭桌上不断飙升的扣款单。"
    },
    {
      "sentence_id": "s27",
      "char_len": 42,
      "snippet": "作为一个典型的资源匮乏国家，石油天然气靠进口，大量的粮食和工业原料同样要从海外购"
    },
    {
      "sentence_id": "s28",
      "char_len": 38,
      "snippet": "日元不断贬值，就意味着进口成本变高，最终反馈到日本普通人身上，就是物价飙升。"
    },
    {
      "sentence_id": "s29",
      "char_len": 46,
      "snippet": "根据日本官方数据，截至今年5月，东京一袋5公斤的月光米平均售价折合人民币已经接近"
    },
    {
      "sentence_id": "s30",
      "char_len": 43,
      "snippet": "要知道，2023年同样的大米折合人民币平均也就100块钱，短短3年时间，米价翻了"
    },
    {
      "sentence_id": "s31",
      "char_len": 11,
      "snippet": "而且贵的可不只是大米。"
    },
    {
      "sentence_id": "s32",
      "char_len": 67,
      "snippet": "如果你把2020年的东京食品价格指数定为100，那么到了今年6月，这个数字已经涨"
    },
    {
      "sentence_id": "s33",
      "char_len": 59,
      "snippet": "光是今年7月，日本就有2566种食品集中宣布涨价，平均每次涨幅达到了11%，今年"
    },
    {
      "sentence_id": "s34",
      "char_len": 35,
      "snippet": "很多家庭开始用豆腐代替肉馅，减少米饭的食用量，只为节省出那一点点开支。"
    },
    {
      "sentence_id": "s35",
      "char_len": 11,
      "snippet": "企业的日子同样不好过。"
    },
    {
      "sentence_id": "s36",
      "char_len": 31,
      "snippet": "今年上半年，日本10个主要行业中，有8个行业的企业在加速破产。"
    },
    {
      "sentence_id": "s37",
      "char_len": 21,
      "snippet": "其中物价变高是推高企业破产数量的重要原因。"
    },
    {
      "sentence_id": "s38",
      "char_len": 62,
      "snippet": "上半年受原材料等成本上涨影响而破产的企业达到了439家，同比增长了27.6%，创"
    },
    {
      "sentence_id": "s39",
      "char_len": 17,
      "snippet": "面对这样的局面，高市当然想过救市。"
    },
    {
      "sentence_id": "s40",
      "char_len": 37,
      "snippet": "今年4月到5月，日本财务省砸下了11.73万亿日元干预汇率，创下历史纪录。"
    },
    {
      "sentence_id": "s41",
      "char_len": 24,
      "snippet": "结果日元也就坚挺了两个多月，转头又跌回了163。"
    },
    {
      "sentence_id": "s42",
      "char_len": 32,
      "snippet": "到了6月，日本央行又把利率加到1%，创下了31年以来的最高水平。"
    },
    {
      "sentence_id": "s43",
      "char_len": 10,
      "snippet": "可是市场照样不买账。"
    },
    {
      "sentence_id": "s44",
      "char_len": 23,
      "snippet": "因为全世界都知道，日本根本没有真正加息的底气。"
    },
    {
      "sentence_id": "s45",
      "char_len": 36,
      "snippet": "日本公共债务占GDP的比例已经接近了250%，在全球主要经济体里面最高。"
    },
    {
      "sentence_id": "s46",
      "char_len": 30,
      "snippet": "日本政府每花出去4块钱，其中有1块钱要拿去还债或者支付利息。"
    },
    {
      "sentence_id": "s47",
      "char_len": 15,
      "snippet": "所以现在的日本已经进退两难了。"
    },
    {
      "sentence_id": "s48",
      "char_len": 30,
      "snippet": "加息慢了，日元继续贬值，进口商品继续涨价，日本老百姓继续骂；"
    },
    {
      "sentence_id": "s49",
      "char_len": 32,
      "snippet": "但加息快了，国债利息马上飙升，政府的财政和银行系统又顶不住压力。"
    },
    {
      "sentence_id": "s50",
      "char_len": 38,
      "snippet": "可偏偏这个时候，高市又推出了一个长达14年、折合约2.3万亿美元的投资计划。"
    },
    {
      "sentence_id": "s51",
      "char_len": 12,
      "snippet": "最关键的是，钱从哪里来？"
    },
    {
      "sentence_id": "s52",
      "char_len": 6,
      "snippet": "高市没有说。"
    },
    {
      "sentence_id": "s53",
      "char_len": 57,
      "snippet": "于是全球资本市场看到的根本不是一个准备复兴的日本，而是一个本来就快还不起账的人，"
    },
    {
      "sentence_id": "s54",
      "char_len": 37,
      "snippet": "于是日本国债继续被卖，日元继续被抛售，硬生生把汇率干回了40多年前的水平。"
    },
    {
      "sentence_id": "s55",
      "char_len": 35,
      "snippet": "被堵死的还不只是货币这一条后路，日本的产业已经被高市早苗推到悬崖边上。"
    },
    {
      "sentence_id": "s56",
      "char_len": 66,
      "snippet": "对日本来说，现在最应该做的事情本来是像韩国一样，先稳住中国市场，稳住亚洲供应链，"
    },
    {
      "sentence_id": "s57",
      "char_len": 76,
      "snippet": "结果高市干的恰恰相反，上台以后不断扩大军费，推动武器出口，部署远程导弹，还四处奔"
    },
    {
      "sentence_id": "s58",
      "char_len": 57,
      "snippet": "最后换来的自然是中方一轮又一轮的反制：水产品进口停了，赴日中国游客大幅减少，大量"
    },
    {
      "sentence_id": "s59",
      "char_len": 31,
      "snippet": "两轮管制下来，几十家日本企业和研究机构被纳入两用物项管制范围。"
    },
    {
      "sentence_id": "s60",
      "char_len": 61,
      "snippet": "现在日本已经急得满世界找稀土，从澳大利亚找到格陵兰岛，再到自己跑去6千米的深海里"
    },
    {
      "sentence_id": "s61",
      "char_len": 37,
      "snippet": "最后实在没有办法，日本甚至已经开始捡垃圾了，从废旧空调和压缩机里回收稀土。"
    },
    {
      "sentence_id": "s62",
      "char_len": 32,
      "snippet": "问题是回收成本是直接进口的3倍，纯度还不一定满足高端制造的需求。"
    },
    {
      "sentence_id": "s63",
      "char_len": 11,
      "snippet": "能源这条路也被堵死了。"
    },
    {
      "sentence_id": "s64",
      "char_len": 31,
      "snippet": "过去日本能源虽依赖中东，但俄罗斯一直是分散中东风险的重要渠道。"
    },
    {
      "sentence_id": "s65",
      "char_len": 22,
      "snippet": "结果俄乌战争爆发后，日本紧跟美国制裁俄罗斯。"
    },
    {
      "sentence_id": "s66",
      "char_len": 75,
      "snippet": "高市上台后更甚，一边跟乌克兰搞无人机合作，一边在G20上追着俄罗斯指责，还嚷嚷着"
    },
    {
      "sentence_id": "s67",
      "char_len": 15,
      "snippet": "买俄油这条路，日本想都别想了。"
    },
    {
      "sentence_id": "s68",
      "char_len": 39,
      "snippet": "再看中东，他的好大哥美国一头栽进泥潭几个月，霍尔木兹海峡到现在还不能稳定通行。"
    },
    {
      "sentence_id": "s69",
      "char_len": 9,
      "snippet": "那从美国买行不行？"
    },
    {
      "sentence_id": "s70",
      "char_len": 33,
      "snippet": "当然可以，但以前日本对中东原油依赖高达95%，为什么不去买美国的？"
    },
    {
      "sentence_id": "s71",
      "char_len": 5,
      "snippet": "因为贵啊！"
    },
    {
      "sentence_id": "s72",
      "char_len": 53,
      "snippet": "美国能源运输距离长，还要加上液化、仓储和政治溢价，再叠加日元疯狂贬值，最后的价格"
    },
    {
      "sentence_id": "s73",
      "char_len": 35,
      "snippet": "高市早苗上台时创造的“存亡危机”这个词，用来形容现在的日本，非常合适。"
    },
    {
      "sentence_id": "s74",
      "char_len": 37,
      "snippet": "眼下，外汇市场在等165，日本企业在等稀土库存见底，老百姓在等下一轮涨价。"
    },
    {
      "sentence_id": "s75",
      "char_len": 15,
      "snippet": "高市手里的牌，已经不剩多少了。"
    }
  ],
