{
  "creator_id": "wenyifei_jijiu",
  "work_id": "wenyifei_jijiu__tt_7638447217912709647",
  "modality": "COMPLETE_TEXT",
  "source_url": "https://www.toutiao.com/article/7638447217912709647/",
  "source_sha256": "bfec75315d050110cfc6db2e1ec1ff51b5d5e721ca01cdd920b6333366225c20",
  "performance_tier": "MEDIAN",
  "spoken_marker_eligible": "N/A_TEXT",
  "analysis_status": "OK",
  "analyzer_version": "phase_c_v1",
  "sentence_count": 118,
  "sentences_index": [
    {
      "sentence_id": "s1",
      "char_len": 47,
      "snippet": "很多人都曾思考过一个问题：身处货币持续贬值、各类资产涨跌充满诱惑的时代，普通人究"
    },
    {
      "sentence_id": "s2",
      "char_len": 22,
      "snippet": "图片截取自: 现金贬值、炒股被套、买房亏钱？"
    },
    {
      "sentence_id": "s3",
      "char_len": 11,
      "snippet": "普通人究竟该如何自处？"
    },
    {
      "sentence_id": "s4",
      "char_len": 37,
      "snippet": "有人始终持有现金，却不得不面对购买力持续缩水、银行存款利率不断下行的困境；"
    },
    {
      "sentence_id": "s5",
      "char_len": 35,
      "snippet": "有人满仓投入股市，屡屡在高位接盘被套牢，反复被市场收割，财富持续缩水；"
    },
    {
      "sentence_id": "s6",
      "char_len": 35,
      "snippet": "还有人重仓布局楼市，最终受资产流动性不足与债务压力拖累，投资陷入被动。"
    },
    {
      "sentence_id": "s7",
      "char_len": 35,
      "snippet": "那么，是否存在一种折中方式，既能跑赢通货膨胀，又无需承担过高投资风险？"
    },
    {
      "sentence_id": "s8",
      "char_len": 21,
      "snippet": "其实， 基金投资 便是贴近这一标准的答案。"
    },
    {
      "sentence_id": "s9",
      "char_len": 47,
      "snippet": "请先不必急于反驳，我理解您可能会想到，前几年高位买入基金的人至今尚未解套，基金似"
    },
    {
      "sentence_id": "s10",
      "char_len": 15,
      "snippet": "然而，这个领域有一句至理名言："
    },
    {
      "sentence_id": "s11",
      "char_len": 19,
      "snippet": "“好卖的时候不赚钱，赚钱的时候不好卖。"
    },
    {
      "sentence_id": "s12",
      "char_len": 1,
      "snippet": "”"
    },
    {
      "sentence_id": "s13",
      "char_len": 26,
      "snippet": "许多被套牢的投资者，往往是在市场高位时冲进去接盘的。"
    },
    {
      "sentence_id": "s14",
      "char_len": 23,
      "snippet": "彼时基金销售异常火爆，但赚钱的空间已十分有限。"
    },
    {
      "sentence_id": "s15",
      "char_len": 31,
      "snippet": "而真正等到市场低位、具备赚钱潜力时，却人心涣散，无人愿意买入。"
    },
    {
      "sentence_id": "s16",
      "char_len": 33,
      "snippet": "若能带着这种逆向思维重新审视基金，或许会得出截然不同的答案与结果。"
    },
    {
      "sentence_id": "s17",
      "char_len": 22,
      "snippet": "图片截取自: 现金贬值、炒股被套、买房亏钱？"
    },
    {
      "sentence_id": "s18",
      "char_len": 11,
      "snippet": "普通人究竟该如何自处？"
    },
    {
      "sentence_id": "s19",
      "char_len": 19,
      "snippet": "先从最基础的概念说起：基金究竟是什么？"
    },
    {
      "sentence_id": "s20",
      "char_len": 7,
      "snippet": "它有哪些种类？"
    },
    {
      "sentence_id": "s21",
      "char_len": 44,
      "snippet": "简单而言，购买基金，即是你专门付费聘请一位专业的基金经理，由其代为管理这笔资金进"
    },
    {
      "sentence_id": "s22",
      "char_len": 53,
      "snippet": "个人炒股可能亏损多于盈利，但基金经理背后是一个完整的研究团队，其信息分析能力与风"
    },
    {
      "sentence_id": "s23",
      "char_len": 27,
      "snippet": "我们日常所说的基金主要分为两类： 场内基金与场外基金。"
    },
    {
      "sentence_id": "s24",
      "char_len": 15,
      "snippet": "这里的“场”指的是证券交易所。"
    },
    {
      "sentence_id": "s25",
      "char_len": 51,
      "snippet": "场内基金，如最常见的ETF，需要投资者拥有证券账户，像买卖股票一样在交易时间内随"
    },
    {
      "sentence_id": "s26",
      "char_len": 22,
      "snippet": "图片截取自: 现金贬值、炒股被套、买房亏钱？"
    },
    {
      "sentence_id": "s27",
      "char_len": 11,
      "snippet": "普通人究竟该如何自处？"
    },
    {
      "sentence_id": "s28",
      "char_len": 54,
      "snippet": "这对大多数普通投资者而言稍显复杂，需要自行判断买卖点，心态易受K线走势影响，反而"
    },
    {
      "sentence_id": "s29",
      "char_len": 44,
      "snippet": "而场外基金，则是在常见的第三方理财平台或银行APP上即可直接购买，无需自行开设证"
    },
    {
      "sentence_id": "s30",
      "char_len": 25,
      "snippet": "对普通人而言，场外基金更为便捷，申购费也常有折扣。"
    },
    {
      "sentence_id": "s31",
      "char_len": 21,
      "snippet": "基金的分类、评级、历史业绩等信息清晰明了。"
    },
    {
      "sentence_id": "s32",
      "char_len": 22,
      "snippet": "可以说，场外基金是普通人投资基金的主流选择。"
    },
    {
      "sentence_id": "s33",
      "char_len": 36,
      "snippet": "在场外基金的大家族中，我们最常接触的是两大类： 偏股型基金与偏债型基金。"
    },
    {
      "sentence_id": "s34",
      "char_len": 39,
      "snippet": "股票占比较高的为偏股型，债券占比较高的为偏债型，两者的风险与收益特征截然不同。"
    },
    {
      "sentence_id": "s35",
      "char_len": 17,
      "snippet": "那么，为何说普通人绕不开基金投资？"
    },
    {
      "sentence_id": "s36",
      "char_len": 37,
      "snippet": "核心在于，仅依靠固定工资和单打独斗，确实难以跑赢这个充满诱惑与通胀的时代。"
    },
    {
      "sentence_id": "s37",
      "char_len": 22,
      "snippet": "图片截取自: 现金贬值、炒股被套、买房亏钱？"
    },
    {
      "sentence_id": "s38",
      "char_len": 11,
      "snippet": "普通人究竟该如何自处？"
    },
    {
      "sentence_id": "s39",
      "char_len": 23,
      "snippet": "现代社会中，每个家庭、每个人都需思考理财问题。"
    },
    {
      "sentence_id": "s40",
      "char_len": 32,
      "snippet": "然而，摆在普通人面前的投资选项看似众多，实则每条道路都布满荆棘。"
    },
    {
      "sentence_id": "s41",
      "char_len": 27,
      "snippet": "期货专业度高，风险极大，即便是专业投资者也常遭遇失败；"
    },
    {
      "sentence_id": "s42",
      "char_len": 35,
      "snippet": "股票需要多年的投资经验与系统性学习才能实现稳定盈利，大多数人难以驾驭；"
    },
    {
      "sentence_id": "s43",
      "char_len": 25,
      "snippet": "将资金存入银行，利息又低得可怜，完全无法跑赢通胀。"
    },
    {
      "sentence_id": "s44",
      "char_len": 37,
      "snippet": "综合考量，收益高于存款利息，但风险又低于股票、期货的选项，似乎只剩下基金。"
    },
    {
      "sentence_id": "s45",
      "char_len": 22,
      "snippet": "图片截取自: 现金贬值、炒股被套、买房亏钱？"
    },
    {
      "sentence_id": "s46",
      "char_len": 11,
      "snippet": "普通人究竟该如何自处？"
    },
    {
      "sentence_id": "s47",
      "char_len": 13,
      "snippet": "为何说基金的风险相对可控？"
    },
    {
      "sentence_id": "s48",
      "char_len": 19,
      "snippet": "因为其本质是 “专业的人做专业的事”。"
    },
    {
      "sentence_id": "s49",
      "char_len": 32,
      "snippet": "投资者无需精通财报分析与行业周期，这些是基金经理需要操心的事务。"
    },
    {
      "sentence_id": "s50",
      "char_len": 33,
      "snippet": "投资者的任务是选择自己信得过的基金，并懂得如何判断一只基金的优劣。"
    },
    {
      "sentence_id": "s51",
      "char_len": 26,
      "snippet": "当然，基金并非稳赚不赔的提款机，这一点必须着重强调。"
    },
    {
      "sentence_id": "s52",
      "char_len": 19,
      "snippet": "只要是投资，就存在风险，基金也不例外。"
    },
    {
      "sentence_id": "s53",
      "char_len": 30,
      "snippet": "它只是风险水平低于股票、期货，但绝非一个岁月静好的财富游戏。"
    },
    {
      "sentence_id": "s54",
      "char_len": 41,
      "snippet": "许多投资者存在一个错误认知，认为买基金风险很小、赚钱很容易，这种心态其实相当危险"
    },
    {
      "sentence_id": "s55",
      "char_len": 38,
      "snippet": "必须正视风险与收益的关系，它们是“盈亏同源”的一体两面：收益越高，风险越大；"
    },
    {
      "sentence_id": "s56",
      "char_len": 20,
      "snippet": "而追求低风险，就必须接受相对平庸的收益。"
    },
    {
      "sentence_id": "s57",
      "char_len": 22,
      "snippet": "图片截取自: 现金贬值、炒股被套、买房亏钱？"
    },
    {
      "sentence_id": "s58",
      "char_len": 11,
      "snippet": "普通人究竟该如何自处？"
    },
    {
      "sentence_id": "s59",
      "char_len": 16,
      "snippet": "这即是常说的“风浪越大鱼越贵”。"
    },
    {
      "sentence_id": "s60",
      "char_len": 16,
      "snippet": "基金的风险等级从R1到R5排列。"
    },
    {
      "sentence_id": "s61",
      "char_len": 65,
      "snippet": "R1为谨慎型 ，基本不会亏损，主要投资于国债、存款，但严格来说也并非保本，年化收"
    },
    {
      "sentence_id": "s62",
      "char_len": 33,
      "snippet": "R2为稳健型 ，少数情况下可能出现1%至5%的亏损，总体影响不大。"
    },
    {
      "sentence_id": "s63",
      "char_len": 29,
      "snippet": "R3为平衡型 ，可能出现10%至20%的亏损，需引起注意。"
    },
    {
      "sentence_id": "s64",
      "char_len": 27,
      "snippet": "R4为进取型 ，可能亏损20%至50%，风险显著加大。"
    },
    {
      "sentence_id": "s65",
      "char_len": 25,
      "snippet": "R5为激进型 ，可能亏损50%以上，甚至血本无归。"
    },
    {
      "sentence_id": "s66",
      "char_len": 48,
      "snippet": "因此，当看到一只基金的历史年化收益率超过4%，且风险等级在R3以上时，心中应有数"
    },
    {
      "sentence_id": "s67",
      "char_len": 33,
      "snippet": "投资者务必根据自身的风险承受能力进行选择，切勿一开始就挑战高难度。"
    },
    {
      "sentence_id": "s68",
      "char_len": 22,
      "snippet": "图片截取自: 现金贬值、炒股被套、买房亏钱？"
    },
    {
      "sentence_id": "s69",
      "char_len": 11,
      "snippet": "普通人究竟该如何自处？"
    },
    {
      "sentence_id": "s70",
      "char_len": 14,
      "snippet": "那么，如何挑选一只好的基金？"
    },
    {
      "sentence_id": "s71",
      "char_len": 9,
      "snippet": "这是最核心的环节。"
    },
    {
      "sentence_id": "s72",
      "char_len": 15,
      "snippet": "请记住一个总结的“灵魂口诀”："
    },
    {
      "sentence_id": "s73",
      "char_len": 10,
      "snippet": "“莫看平台，只看人。"
    },
    {
      "sentence_id": "s74",
      "char_len": 24,
      "snippet": "五年连胜守一城，大盘下沉随手买，指数不必费心神。"
    },
    {
      "sentence_id": "s75",
      "char_len": 16,
      "snippet": "买完须上无情锁，市场专宰有情人。"
    },
    {
      "sentence_id": "s76",
      "char_len": 1,
      "snippet": "”"
    },
    {
      "sentence_id": "s77",
      "char_len": 40,
      "snippet": "这首打油诗的含义是：购买时，务必仔细查看基金的档案资料，不要被平台的宣传所迷惑。"
    },
    {
      "sentence_id": "s78",
      "char_len": 45,
      "snippet": "基金经理最好拥有五年以上的投资业绩，这样才能判断其是否经历过一轮牛熊周期的考验，"
    },
    {
      "sentence_id": "s79",
      "char_len": 19,
      "snippet": "同时，基金规模最好在5亿至50亿之间。"
    },
    {
      "sentence_id": "s80",
      "char_len": 17,
      "snippet": "规模过小，不稳定，甚至有清盘风险；"
    },
    {
      "sentence_id": "s81",
      "char_len": 27,
      "snippet": "规模过大，则显得笨重，基金经理难以操作，收益会被摊薄。"
    },
    {
      "sentence_id": "s82",
      "char_len": 22,
      "snippet": "图片截取自: 现金贬值、炒股被套、买房亏钱？"
    },
    {
      "sentence_id": "s83",
      "char_len": 11,
      "snippet": "普通人究竟该如何自处？"
    },
    {
      "sentence_id": "s84",
      "char_len": 45,
      "snippet": "在整个大盘位置和估值处于相对低位时，最简单有效的办法是 投资指数 ，即购买ETF"
    },
    {
      "sentence_id": "s85",
      "char_len": 44,
      "snippet": "指数基金相当于将所有股票打包买入一部分，一次买入数百只股票，技术含量不高，管理费"
    },
    {
      "sentence_id": "s86",
      "char_len": 17,
      "snippet": "这也是股神巴菲特最推崇的投资方式。"
    },
    {
      "sentence_id": "s87",
      "char_len": 36,
      "snippet": "从美股市场来看，拉长至20年的长期收益，能够战胜指数的基金经理寥寥无几。"
    },
    {
      "sentence_id": "s88",
      "char_len": 39,
      "snippet": "A股指数虽然表现并非如此强劲，但指数基金仍然可以购买，核心策略是“高抛低吸”。"
    },
    {
      "sentence_id": "s107",
      "char_len": 25,
      "snippet": "这对于不太会自行判断高低的普通投资者而言非常友好。"
    },
    {
      "sentence_id": "s108",
      "char_len": 47,
      "snippet": "尤其对于有持续工资收入的上班族而言，薪水可以视为“无限子弹”，能够提供更高的容错"
    },
    {
      "sentence_id": "s109",
      "char_len": 23,
      "snippet": "有了投资方法之后，便是如何构建自己的基金组合。"
    },
    {
      "sentence_id": "s110",
      "char_len": 29,
      "snippet": "市面上一般有偏股型、偏债型、指数型基金等，究竟该如何配置？"
    },
    {
      "sentence_id": "s111",
      "char_len": 18,
      "snippet": "偏股型基金风险最高，潜在收益也最高。"
    },
    {
      "sentence_id": "s112",
      "char_len": 34,
      "snippet": "它又分为三种，一种是多元化布局的基金，投资各行各业，不押注单一赛道；"
    },
    {
      "sentence_id": "s113",
      "char_len": 31,
      "snippet": "一种是平衡型基金，股债比例大致为五五开，风险和收益都较为适中；"
    },
    {
      "sentence_id": "s114",
      "char_len": 33,
      "snippet": "还有一种是行业主题型基金，专门投资一个行业，如新能源、消费、医药。"
    },
    {
      "sentence_id": "s115",
      "char_len": 23,
      "snippet": "如果看好某个行业的长期发展，可以选择行业基金；"
    },
    {
      "sentence_id": "s116",
      "char_len": 26,
      "snippet": "如果只想分享经济整体增长的红利，则应选择多元化基金。"
    },
    {
      "sentence_id": "s117",
      "char_len": 35,
      "snippet": "偏债型基金风险低很多，收益也相对平稳，年化收益率大约在2%至8%之间。"
    },
    {
      "sentence_id": "s118",
      "char_len": 35,
      "snippet": "它也分为两种，一种是安稳型，90%以上为债券，几乎不碰股票，非常稳健；"
    },
    {
      "sentence_id": "s119",
      "char_len": 40,
      "snippet": "另一种是稳中进取型，债券占大头，但会拿出约20%的资金购买股票，以博取更高收益。"
    },
    {
      "sentence_id": "s120",
      "char_len": 58,
      "snippet": "对于刚开始接触基金的朋友，可能更推荐从偏债型基金入手，先感受净值的小幅波动，建立"
    },
    {
      "sentence_id": "s121",
      "char_len": 22,
      "snippet": "图片截取自: 现金贬值、炒股被套、买房亏钱？"
    },
    {
      "sentence_id": "s122",
      "char_len": 11,
      "snippet": "普通人究竟该如何自处？"
    },
    {
      "sentence_id": "s123",
      "char_len": 17,
      "snippet": "最后，我想特别提一下 指数型基金。"
    },
    {
      "sentence_id": "s124",
      "char_len": 32,
      "snippet": "如前所述，这是股神巴菲特唯一在公开场合向普通人推荐过的投资品种。"
    },
    {
      "sentence_id": "s125",
      "char_len": 47,
      "snippet": "指数基金是被动型基金，不依赖基金经理的个人能力，而是跟踪一个指数，例如沪深300"
    },
    {
      "sentence_id": "s126",
      "char_len": 22,
      "snippet": "图片截取自: 现金贬值、炒股被套、买房亏钱？"
    },
    {
      "sentence_id": "s127",
      "char_len": 11,
      "snippet": "普通人究竟该如何自处？"
    },
    {
      "sentence_id": "s128",
      "char_len": 33,
      "snippet": "买入沪深300指数基金，就相当于一次性买入了这300家优秀的公司。"
    },
    {
      "sentence_id": "s129",
      "char_len": 21,
      "snippet": "其好处是成本极低、风险分散、长期趋势向上。"
    },
    {
      "sentence_id": "s130",
      "char_len": 56,
      "snippet": "投资者无需学会选股，只需相信这些公司会越来越好，并按照前述方法，在相对低位定投大"
    },
    {
      "sentence_id": "s131",
      "char_len": 54,
      "snippet": "对于不想花太多时间研究，又想分享股市长期红利的普通投资者而言， 指数基金定投 可"
    },
    {
      "sentence_id": "s132",
      "char_len": 34,
      "snippet": "当然，阐述了许多方法与技巧后，最后想说投资中最重要的东西—— 心态。"
    },
    {
      "sentence_id": "s133",
      "char_len": 44,
      "snippet": "我在资本市场中见过无数想要一夜暴富，却在出现重大亏损后埋怨自己为何没有做好风险管"
    },
    {
      "sentence_id": "s134",
      "char_len": 32,
      "snippet": "而投资基金，更像是一种资产配置的思维，是与时间做朋友的长期主义。"
    },
    {
      "sentence_id": "s135",
      "char_len": 74,
      "snippet": "投资者无需成为专家，但需要有学习的意愿与耐心，要弄清自己的风险底线，选择让自己安"
    },
    {
      "sentence_id": "s136",
      "char_len": 55,
      "snippet": "当能够逐渐理解市场规律，以淡定的心态面对基金投资时，会发现收获的不仅仅是财富的增"
    }
