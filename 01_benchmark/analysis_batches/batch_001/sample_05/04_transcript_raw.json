[
  {
    "start": 0.0,
    "end": 2.44,
    "text": "七个关于赚钱的铁率",
    "segment_id": "S0001"
  },
  {
    "start": 2.44,
    "end": 5.08,
    "text": "是我们几代温州人的心血",
    "segment_id": "S0002"
  },
  {
    "start": 5.08,
    "end": 6.84,
    "text": "有一点点露鼓",
    "segment_id": "S0003"
  },
  {
    "start": 6.84,
    "end": 8.32,
    "text": "希望",
    "segment_id": "S0004"
  },
  {
    "start": 8.32,
    "end": 10.96,
    "text": "希望你可以记下新来认真的",
    "segment_id": "S0005"
  },
  {
    "start": 10.96,
    "end": 11.92,
    "text": "今晚",
    "segment_id": "S0006"
  },
  {
    "start": 11.92,
    "end": 13.6,
    "text": "如果听不懂",
    "segment_id": "S0007"
  },
  {
    "start": 13.6,
    "end": 16.6,
    "text": "可以多来几次",
    "segment_id": "S0008"
  },
  {
    "start": 16.6,
    "end": 18.8,
    "text": "可以多听几次",
    "segment_id": "S0009"
  },
  {
    "start": 21.8,
    "end": 22.96,
    "text": "一",
    "segment_id": "S0010"
  },
  {
    "start": 22.96,
    "end": 24.560000000000002,
    "text": "读书和学习",
    "segment_id": "S0011"
  },
  {
    "start": 24.560000000000002,
    "end": 27.52,
    "text": "是两号完全不永不一样的逻辑",
    "segment_id": "S0012"
  },
  {
    "start": 27.52,
    "end": 28.92,
    "text": "你会发现",
    "segment_id": "S0013"
  },
  {
    "start": 29.080000000000002,
    "end": 32.440000000000005,
    "text": "那些考试非常厉害的释放",
    "segment_id": "S0014"
  },
  {
    "start": 32.440000000000005,
    "end": 33.84,
    "text": "读书会以后",
    "segment_id": "S0015"
  },
  {
    "start": 33.84,
    "end": 35.04,
    "text": "赚钱的能力",
    "segment_id": "S0016"
  },
  {
    "start": 35.04,
    "end": 37.0,
    "text": "还不如那些写账",
    "segment_id": "S0017"
  },
  {
    "start": 37.0,
    "end": 40.120000000000005,
    "text": "学校和社会最大的区别就是",
    "segment_id": "S0018"
  },
  {
    "start": 40.120000000000005,
    "end": 42.2,
    "text": "学校里面考试是毕端的",
    "segment_id": "S0019"
  },
  {
    "start": 42.2,
    "end": 43.760000000000005,
    "text": "不允许潮",
    "segment_id": "S0020"
  },
  {
    "start": 43.760000000000005,
    "end": 46.480000000000004,
    "text": "社会这个考场",
    "segment_id": "S0021"
  },
  {
    "start": 46.480000000000004,
    "end": 48.2,
    "text": "好事实开简的",
    "segment_id": "S0022"
  },
  {
    "start": 48.2,
    "end": 50.0,
    "text": "你可以随时是去潮",
    "segment_id": "S0023"
  },
  {
    "start": 50.0,
    "end": 52.32000000000001,
    "text": "优等深的那个答案",
    "segment_id": "S0024"
  },
  {
    "start": 52.32000000000001,
    "end": 53.32000000000001,
    "text": "可以",
    "segment_id": "S0025"
  },
  {
    "start": 53.32000000000001,
    "end": 55.120000000000005,
    "text": "所有做生意的朋友们",
    "segment_id": "S0026"
  },
  {
    "start": 55.120000000000005,
    "end": 56.160000000000004,
    "text": "请记住",
    "segment_id": "S0027"
  },
  {
    "start": 57.160000000000004,
    "end": 61.36000000000001,
    "text": "你最好的老师",
    "segment_id": "S0028"
  },
  {
    "start": 61.36000000000001,
    "end": 63.36000000000001,
    "text": "都是什么经济学大师",
    "segment_id": "S0029"
  },
  {
    "start": 63.36000000000001,
    "end": 64.96000000000001,
    "text": "不是采金国主",
    "segment_id": "S0030"
  },
  {
    "start": 64.96000000000001,
    "end": 65.68,
    "text": "而是那个",
    "segment_id": "S0031"
  },
  {
    "start": 65.68,
    "end": 67.0,
    "text": "在你的行业里面",
    "segment_id": "S0032"
  },
  {
    "start": 67.0,
    "end": 69.08,
    "text": "做得比您好的",
    "segment_id": "S0033"
  },
  {
    "start": 69.08,
    "end": 71.88000000000001,
    "text": "赚钱比你更多的同好",
    "segment_id": "S0034"
  },
  {
    "start": 71.88000000000001,
    "end": 72.88,
    "text": "朝他",
    "segment_id": "S0035"
  },
  {
    "start": 72.88,
    "end": 74.0,
    "text": "学他",
    "segment_id": "S0036"
  },
  {
    "start": 74.0,
    "end": 75.84,
    "text": "朝越他",
    "segment_id": "S0037"
  },
  {
    "start": 77.84,
    "end": 79.2,
    "text": "历认和风险",
    "segment_id": "S0038"
  },
  {
    "start": 79.2,
    "end": 81.76,
    "text": "永远是困绑到一块的",
    "segment_id": "S0039"
  },
  {
    "start": 81.76,
    "end": 83.04,
    "text": "历认越高",
    "segment_id": "S0040"
  },
  {
    "start": 83.04,
    "end": 84.32000000000001,
    "text": "风险越大",
    "segment_id": "S0041"
  },
  {
    "start": 84.32000000000001,
    "end": 85.2,
    "text": "相反",
    "segment_id": "S0042"
  },
  {
    "start": 85.2,
    "end": 86.28,
    "text": "历认越低",
    "segment_id": "S0043"
  },
  {
    "start": 86.28,
    "end": 87.76,
    "text": "风险越低",
    "segment_id": "S0044"
  },
  {
    "start": 87.76,
    "end": 89.80000000000001,
    "text": "这就是为什么",
    "segment_id": "S0045"
  },
  {
    "start": 89.80000000000001,
    "end": 91.12,
    "text": "老板不理",
    "segment_id": "S0046"
  },
  {
    "start": 91.12,
    "end": 92.28,
    "text": "这就是为什么",
    "segment_id": "S0047"
  },
  {
    "start": 92.28,
    "end": 94.52000000000001,
    "text": "大功永远包不了材",
    "segment_id": "S0048"
  },
  {
    "start": 94.52000000000001,
    "end": 95.48,
    "text": "因为风险",
    "segment_id": "S0049"
  },
  {
    "start": 95.48,
    "end": 97.4,
    "text": "都被老板承担了",
    "segment_id": "S0050"
  },
  {
    "start": 97.4,
    "end": 100.44000000000001,
    "text": "所以你再做任何投资之前",
    "segment_id": "S0051"
  },
  {
    "start": 100.44000000000001,
    "end": 101.60000000000001,
    "text": "一定不要",
    "segment_id": "S0052"
  },
  {
    "start": 101.60000000000001,
    "end": 103.76,
    "text": "只看能赚多少钱",
    "segment_id": "S0053"
  },
  {
    "start": 103.76,
    "end": 107.80000000000001,
    "text": "而是应该认真且严肃的去评估",
    "segment_id": "S0054"
  },
  {
    "start": 107.80000000000001,
    "end": 110.2,
    "text": "相应的风险和代价",
    "segment_id": "S0055"
  },
  {
    "start": 110.2,
    "end": 111.60000000000001,
    "text": "是否在我们自己能",
    "segment_id": "S0056"
  },
  {
    "start": 111.60000000000001,
    "end": 114.04,
    "text": "努力的承受范围之内",
    "segment_id": "S0057"
  },
  {
    "start": 114.08000000000001,
    "end": 115.44000000000001,
    "text": "赚钱是为了",
    "segment_id": "S0058"
  },
  {
    "start": 115.44000000000001,
    "end": 117.64,
    "text": "让我们更好的生活",
    "segment_id": "S0059"
  },
  {
    "start": 117.64,
    "end": 119.68,
    "text": "不是去莫命的",
    "segment_id": "S0060"
  },
  {
    "start": 119.68,
    "end": 122.44000000000001,
    "text": "当你抱着那种",
    "segment_id": "S0061"
  },
  {
    "start": 122.44000000000001,
    "end": 123.52000000000001,
    "text": "要么成功",
    "segment_id": "S0062"
  },
  {
    "start": 123.52000000000001,
    "end": 125.36000000000001,
    "text": "要么承认的心态",
    "segment_id": "S0063"
  },
  {
    "start": 125.36000000000001,
    "end": 126.96000000000001,
    "text": "去赚钱的时候",
    "segment_id": "S0064"
  },
  {
    "start": 126.96000000000001,
    "end": 128.0,
    "text": "请假当场",
    "segment_id": "S0065"
  },
  {
    "start": 128.0,
    "end": 131.28,
    "text": "已经是注定的结果了",
    "segment_id": "S0066"
  },
  {
    "start": 131.28,
    "end": 132.48000000000002,
    "text": "来",
    "segment_id": "S0067"
  },
  {
    "start": 132.48000000000002,
    "end": 134.24,
    "text": "圈子",
    "segment_id": "S0068"
  },
  {
    "start": 134.24,
    "end": 136.48000000000002,
    "text": "圈子真的很重要",
    "segment_id": "S0069"
  },
  {
    "start": 136.48000000000002,
    "end": 138.12,
    "text": "跟着富人婚",
    "segment_id": "S0070"
  },
  {
    "start": 138.12,
    "end": 140.16,
    "text": "那你会越婚业婚",
    "segment_id": "S0071"
  },
  {
    "start": 140.16,
    "end": 141.76,
    "text": "那就我认婚",
    "segment_id": "S0072"
  },
  {
    "start": 141.76,
    "end": 143.76,
    "text": "那只会越婚业从",
    "segment_id": "S0073"
  },
  {
    "start": 143.76,
    "end": 144.56,
    "text": "若有",
    "segment_id": "S0074"
  },
  {
    "start": 144.56,
    "end": 146.56,
    "text": "或者说是贫穷",
    "segment_id": "S0075"
  },
  {
    "start": 146.56,
    "end": 148.23999999999998,
    "text": "看起来只是两种",
    "segment_id": "S0076"
  },
  {
    "start": 148.23999999999998,
    "end": 150.23999999999998,
    "text": "就是不同的结果",
    "segment_id": "S0077"
  },
  {
    "start": 150.23999999999998,
    "end": 151.76,
    "text": "但实际上",
    "segment_id": "S0078"
  },
  {
    "start": 151.76,
    "end": 156.39999999999998,
    "text": "是两种人不同的思维方式和习惯者",
    "segment_id": "S0079"
  },
  {
    "start": 156.39999999999998,
    "end": 157.79999999999998,
    "text": "从人讲道义",
    "segment_id": "S0080"
  },
  {
    "start": 157.79999999999998,
    "end": 159.44,
    "text": "富人讲病",
    "segment_id": "S0081"
  },
  {
    "start": 159.44,
    "end": 160.6,
    "text": "从人哀念",
    "segment_id": "S0082"
  },
  {
    "start": 160.6,
    "end": 163.32,
    "text": "只忽然来个脸子",
    "segment_id": "S0083"
  },
  {
    "start": 163.32,
    "end": 165.68,
    "text": "和人相信自己看见",
    "segment_id": "S0084"
  },
  {
    "start": 165.68,
    "end": 169.16,
    "text": "但是富人会看见自己相信的",
    "segment_id": "S0085"
  },
  {
    "start": 169.16,
    "end": 171.0,
    "text": "从人拿时间贯钱",
    "segment_id": "S0086"
  },
  {
    "start": 171.0,
    "end": 172.12,
    "text": "富人把钱",
    "segment_id": "S0087"
  },
  {
    "start": 172.12,
    "end": 174.0,
    "text": "你时间",
    "segment_id": "S0088"
  },
  {
    "start": 174.0,
    "end": 176.0,
    "text": "从人为钱工作",
    "segment_id": "S0089"
  },
  {
    "start": 176.0,
    "end": 181.0,
    "text": "富人让钱可以自己工作",
    "segment_id": "S0090"
  },
  {
    "start": 181.0,
    "end": 183.16,
    "text": "可能他完上面这一条",
    "segment_id": "S0091"
  },
  {
    "start": 183.16,
    "end": 184.68,
    "text": "你会问着了吧",
    "segment_id": "S0092"
  },
  {
    "start": 184.68,
    "end": 185.44,
    "text": "着了吧",
    "segment_id": "S0093"
  },
  {
    "start": 185.44,
    "end": 187.96,
    "text": "我也想要去跟富人结交",
    "segment_id": "S0094"
  },
  {
    "start": 187.96,
    "end": 192.44,
    "text": "可是这个富人他就不理我",
    "segment_id": "S0095"
  },
  {
    "start": 192.44,
    "end": 193.24,
    "text": "朋友",
    "segment_id": "S0096"
  },
  {
    "start": 193.24,
    "end": 194.96,
    "text": "请记住",
    "segment_id": "S0097"
  },
  {
    "start": 194.96,
    "end": 197.28,
    "text": "你要学会",
    "segment_id": "S0098"
  },
  {
    "start": 197.28,
    "end": 199.28,
    "text": "并且养成一种习惯",
    "segment_id": "S0099"
  },
  {
    "start": 199.28,
    "end": 201.4,
    "text": "那就是",
    "segment_id": "S0100"
  },
  {
    "start": 201.4,
    "end": 203.92000000000002,
    "text": "越终于被利用",
    "segment_id": "S0101"
  },
  {
    "start": 203.92000000000002,
    "end": 205.48,
    "text": "人性都是自私的",
    "segment_id": "S0102"
  },
  {
    "start": 205.48,
    "end": 207.16,
    "text": "所以你是有机会的",
    "segment_id": "S0103"
  },
  {
    "start": 207.16,
    "end": 209.32,
    "text": "你要想尽一切办法",
    "segment_id": "S0104"
  },
  {
    "start": 209.32,
    "end": 211.76,
    "text": "让有钱人利用",
    "segment_id": "S0105"
  },
  {
    "start": 211.76,
    "end": 214.4,
    "text": "当然前提是你的有用",
    "segment_id": "S0106"
  },
  {
    "start": 214.4,
    "end": 215.88,
    "text": "想要跟大哥和他",
    "segment_id": "S0107"
  },
  {
    "start": 215.88,
    "end": 217.4,
    "text": "愿者先想明白",
    "segment_id": "S0108"
  },
  {
    "start": 217.4,
    "end": 219.56,
    "text": "大哥想要什么",
    "segment_id": "S0109"
  },
  {
    "start": 219.56,
    "end": 221.56,
    "text": "然后利用规则",
    "segment_id": "S0110"
  },
  {
    "start": 221.56,
    "end": 224.84,
    "text": "可能会好大哥",
    "segment_id": "S0111"
  },
  {
    "start": 224.84,
    "end": 227.20000000000002,
    "text": "因为这个社会就是",
    "segment_id": "S0112"
  },
  {
    "start": 227.20000000000002,
    "end": 229.20000000000002,
    "text": "制定规则的人利用",
    "segment_id": "S0113"
  },
  {
    "start": 229.20000000000002,
    "end": 231.24,
    "text": "利用规则的人管理",
    "segment_id": "S0114"
  },
  {
    "start": 231.24,
    "end": 233.28,
    "text": "申守规则的人",
    "segment_id": "S0115"
  },
  {
    "start": 236.44,
    "end": 238.36,
    "text": "五",
    "segment_id": "S0116"
  },
  {
    "start": 238.36,
    "end": 240.08,
    "text": "另一交换的本质",
    "segment_id": "S0117"
  },
  {
    "start": 240.08,
    "end": 242.16,
    "text": "其实就是妈没有的",
    "segment_id": "S0118"
  },
  {
    "start": 242.16,
    "end": 243.52,
    "text": "况且你要",
    "segment_id": "S0119"
  },
  {
    "start": 243.52,
    "end": 245.48000000000002,
    "text": "这个道理大家都很好理解",
    "segment_id": "S0120"
  },
  {
    "start": 245.48000000000002,
    "end": 248.8,
    "text": "但是除了把现在想要跟你说的是什么",
    "segment_id": "S0121"
  },
  {
    "start": 248.8,
    "end": 252.72,
    "text": "如果说你现在什么都没有",
    "segment_id": "S0122"
  },
  {
    "start": 252.72,
    "end": 254.52,
    "text": "没有一个好的出身",
    "segment_id": "S0123"
  },
  {
    "start": 254.52,
    "end": 256.28000000000003,
    "text": "没有一个好的学历",
    "segment_id": "S0124"
  },
  {
    "start": 256.28000000000003,
    "end": 257.68,
    "text": "没有一个好的机会",
    "segment_id": "S0125"
  },
  {
    "start": 257.68,
    "end": 259.08,
    "text": "或者说是背景",
    "segment_id": "S0126"
  },
  {
    "start": 259.08,
    "end": 261.08,
    "text": "要怎样去跟别人交换",
    "segment_id": "S0127"
  },
  {
    "start": 262.2,
    "end": 263.36,
    "text": "却跳",
    "segment_id": "S0128"
  },
  {
    "start": 263.36,
    "end": 266.72,
    "text": "就在一个戒指上面",
    "segment_id": "S0129"
  },
  {
    "start": 266.72,
    "end": 269.76,
    "text": "所谓资源整合其实本质上",
    "segment_id": "S0130"
  },
  {
    "start": 269.76,
    "end": 271.44,
    "text": "就是戒令",
    "segment_id": "S0131"
  },
  {
    "start": 271.44,
    "end": 272.40000000000003,
    "text": "戒施",
    "segment_id": "S0132"
  },
  {
    "start": 272.40000000000003,
    "end": 275.2,
    "text": "戒资源的一个过程",
    "segment_id": "S0133"
  },
  {
    "start": 275.2,
    "end": 276.6,
    "text": "其实有很多的想要",
    "segment_id": "S0134"
  },
  {
    "start": 276.6,
    "end": 278.92,
    "text": "往往上他的第一步",
    "segment_id": "S0135"
  },
  {
    "start": 278.92,
    "end": 281.52,
    "text": "就是从这里开始的",
    "segment_id": "S0136"
  },
  {
    "start": 281.52,
    "end": 283.0,
    "text": "这种别人有的",
    "segment_id": "S0137"
  },
  {
    "start": 283.0,
    "end": 284.76,
    "text": "往往他人想到",
    "segment_id": "S0138"
  },
  {
    "start": 284.76,
    "end": 286.71999999999997,
    "text": "得到你要的",
    "segment_id": "S0139"
  },
  {
    "start": 286.71999999999997,
    "end": 288.44,
    "text": "六",
    "segment_id": "S0140"
  },
  {
    "start": 288.44,
    "end": 289.47999999999996,
    "text": "谈生意",
