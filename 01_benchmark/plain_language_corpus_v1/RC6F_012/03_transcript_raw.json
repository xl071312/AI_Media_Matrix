{
  "status": "COMPLETE",
  "segments": [
    {
      "start": 0.0,
      "end": 3.2,
      "text": "這就是比起寶財富銷亡的無聲殺手",
      "segment_id": "S0001"
    },
    {
      "start": 3.2,
      "end": 4.5,
      "text": "通貨緊縮",
      "segment_id": "S0002"
    },
    {
      "start": 5.4,
      "end": 7.8,
      "text": "那究竟什麼是通貨緊縮呢",
      "segment_id": "S0003"
    },
    {
      "start": 7.8,
      "end": 9.8,
      "text": "在一場瘋狂的泡沫之後",
      "segment_id": "S0004"
    },
    {
      "start": 9.8,
      "end": 12.3,
      "text": "大家突然發現口袋裡沒錢了",
      "segment_id": "S0005"
    },
    {
      "start": 12.3,
      "end": 14.0,
      "text": "謝老闆為了維持生意",
      "segment_id": "S0006"
    },
    {
      "start": 14.0,
      "end": 16.6,
      "text": "做出了一個看私利好全體居民的決定",
      "segment_id": "S0007"
    },
    {
      "start": 16.6,
      "end": 19.3,
      "text": "降價原本50塊一個的謝皇寶",
      "segment_id": "S0008"
    },
    {
      "start": 19.3,
      "end": 21.4,
      "text": "降到40 再降到20",
      "segment_id": "S0009"
    },
    {
      "start": 21.4,
      "end": 23.3,
      "text": "按照場裡東西便宜了",
      "segment_id": "S0010"
    },
    {
      "start": 23.3,
      "end": 24.7,
      "text": "買的人應該更多",
      "segment_id": "S0011"
    },
    {
      "start": 24.7,
      "end": 26.3,
      "text": "但離人性越近的地方",
      "segment_id": "S0012"
    },
    {
      "start": 26.3,
      "end": 28.2,
      "text": "邏輯往往越反直覺",
      "segment_id": "S0013"
    },
    {
      "start": 28.2,
      "end": 29.6,
      "text": "當張宇哥發現",
      "segment_id": "S0014"
    },
    {
      "start": 29.6,
      "end": 31.6,
      "text": "昨天的20塊能買一個漢寶",
      "segment_id": "S0015"
    },
    {
      "start": 31.6,
      "end": 33.1,
      "text": "今天卻能買兩個時",
      "segment_id": "S0016"
    },
    {
      "start": 33.1,
      "end": 34.7,
      "text": "他的第一反應不是夠買",
      "segment_id": "S0017"
    },
    {
      "start": 34.7,
      "end": 35.8,
      "text": "而是等待",
      "segment_id": "S0018"
    },
    {
      "start": 35.8,
      "end": 37.1,
      "text": "當全社會都陷入",
      "segment_id": "S0019"
    },
    {
      "start": 37.1,
      "end": 38.8,
      "text": "明天會更便宜的預期時",
      "segment_id": "S0020"
    },
    {
      "start": 38.8,
      "end": 40.1,
      "text": "消費消失了",
      "segment_id": "S0021"
    },
    {
      "start": 40.1,
      "end": 41.4,
      "text": "這種為了等更低價",
      "segment_id": "S0022"
    },
    {
      "start": 41.4,
      "end": 42.8,
      "text": "而停止花錢的行為",
      "segment_id": "S0023"
    },
    {
      "start": 42.8,
      "end": 44.4,
      "text": "便是消費抑制",
      "segment_id": "S0024"
    },
    {
      "start": 44.4,
      "end": 45.4,
      "text": "物價在跌",
      "segment_id": "S0025"
    },
    {
      "start": 45.4,
      "end": 47.5,
      "text": "但有一種東西是絕對不會跌的",
      "segment_id": "S0026"
    },
    {
      "start": 47.5,
      "end": 48.5,
      "text": "那就是債務",
      "segment_id": "S0027"
    },
    {
      "start": 48.5,
      "end": 50.8,
      "text": "當年派大興在房價高點時",
      "segment_id": "S0028"
    },
    {
      "start": 50.8,
      "end": 53.3,
      "text": "向銀行借了100萬買下縫離屋",
      "segment_id": "S0029"
    },
    {
      "start": 53.3,
      "end": 54.9,
      "text": "約定每月還5000塊",
      "segment_id": "S0030"
    },
    {
      "start": 54.9,
      "end": 57.2,
      "text": "那時候派大興賣500個漢寶",
      "segment_id": "S0031"
    },
    {
      "start": 57.2,
      "end": 58.5,
      "text": "就能湊起房貸",
      "segment_id": "S0032"
    },
    {
      "start": 58.5,
      "end": 60.6,
      "text": "但現在漢寶跌到了5塊錢",
      "segment_id": "S0033"
    },
    {
      "start": 60.6,
      "end": 63.2,
      "text": "派大興的賣1000個才能還上錢",
      "segment_id": "S0034"
    },
    {
      "start": 63.2,
      "end": 64.3,
      "text": "物價跌了一半",
      "segment_id": "S0035"
    },
    {
      "start": 64.3,
      "end": 66.2,
      "text": "意味著派大興的勞動價值",
      "segment_id": "S0036"
    },
    {
      "start": 66.2,
      "end": 67.3,
      "text": "縮水了一半",
      "segment_id": "S0037"
    },
    {
      "start": 67.3,
      "end": 69.6,
      "text": "但他欠銀行的數字分好未解",
      "segment_id": "S0038"
    },
    {
      "start": 69.6,
      "end": 70.8,
      "text": "在這個過程中",
      "segment_id": "S0039"
    },
    {
      "start": 70.8,
      "end": 72.2,
      "text": "錢變得越來越貴",
      "segment_id": "S0040"
    },
    {
      "start": 72.2,
      "end": 74.2,
      "text": "而人的漢水變得越來越見",
      "segment_id": "S0041"
    },
    {
      "start": 74.2,
      "end": 76.3,
      "text": "這就是通縮最殘忍的地方",
      "segment_id": "S0042"
    },
    {
      "start": 76.3,
      "end": 78.5,
      "text": "他讓債務在無形中膨脹",
      "segment_id": "S0043"
    },
    {
      "start": 78.5,
      "end": 80.8,
      "text": "讓借錢的人永無翻身之日",
      "segment_id": "S0044"
    },
    {
      "start": 80.8,
      "end": 82.1,
      "text": "當漢寶賣不動",
      "segment_id": "S0045"
    },
    {
      "start": 82.1,
      "end": 84.4,
      "text": "且價格被壓到成本線以下時",
      "segment_id": "S0046"
    },
    {
      "start": 84.4,
      "end": 85.8,
      "text": "謝老闆稱不住了",
      "segment_id": "S0047"
    },
    {
      "start": 85.8,
      "end": 87.7,
      "text": "那他會採取什麼措施呢",
      "segment_id": "S0048"
    },
    {
      "start": 87.7,
      "end": 88.9,
      "text": "在實體經濟中",
      "segment_id": "S0049"
    },
    {
      "start": 88.9,
      "end": 90.3,
      "text": "成本是有剛性的",
      "segment_id": "S0050"
    },
    {
      "start": 90.3,
      "end": 92.2,
      "text": "足經電費原材料",
      "segment_id": "S0051"
    },
    {
      "start": 92.2,
      "end": 94.0,
      "text": "這些並不會隨著漢寶降價",
      "segment_id": "S0052"
    },
    {
      "start": 94.0,
      "end": 95.0,
      "text": "而立刻下降",
      "segment_id": "S0053"
    },
    {
      "start": 95.0,
      "end": 96.0,
      "text": "為了不倒閉",
      "segment_id": "S0054"
    },
    {
      "start": 96.0,
      "end": 97.9,
      "text": "謝老闆只剩下唯一的出路",
      "segment_id": "S0055"
    },
    {
      "start": 97.9,
      "end": 98.9,
      "text": "向內開刀",
      "segment_id": "S0056"
    },
    {
      "start": 98.9,
      "end": 100.9,
      "text": "他取消了海綿寶寶的加班費",
      "segment_id": "S0057"
    },
    {
      "start": 100.9,
      "end": 102.6,
      "text": "縮減了清潔工的工資",
      "segment_id": "S0058"
    },
    {
      "start": 102.6,
      "end": 103.6,
      "text": "當所有企業",
      "segment_id": "S0059"
    },
    {
      "start": 103.6,
      "end": 105.9,
      "text": "都在為了生存而削減胎之時",
      "segment_id": "S0060"
    },
    {
      "start": 105.9,
      "end": 107.8,
      "text": "全社會的總收入開始暴跌",
      "segment_id": "S0061"
    },
    {
      "start": 107.8,
      "end": 109.1,
      "text": "這種收入下降",
      "segment_id": "S0062"
    },
    {
      "start": 109.1,
      "end": 110.1,
      "text": "消費更少",
      "segment_id": "S0063"
    },
    {
      "start": 110.1,
      "end": 111.8,
      "text": "價格再降的惡性循環",
      "segment_id": "S0064"
    },
    {
      "start": 111.8,
      "end": 114.0,
      "text": "便是著名的債務通縮螺旋",
      "segment_id": "S0065"
    },
    {
      "start": 114.0,
      "end": 115.0,
      "text": "在這個遊戲裡",
      "segment_id": "S0066"
    },
    {
      "start": 115.0,
      "end": 116.3,
      "text": "錢並沒有消失",
      "segment_id": "S0067"
    },
    {
      "start": 116.3,
      "end": 118.1,
      "text": "他只是變成了一湯死水",
      "segment_id": "S0068"
    },
    {
      "start": 118.1,
      "end": 119.6,
      "text": "原本大白沙銀行",
      "segment_id": "S0069"
    },
    {
      "start": 119.6,
      "end": 121.7,
      "text": "應該放待給謝老闆開分店",
      "segment_id": "S0070"
    },
    {
      "start": 121.7,
      "end": 123.3,
      "text": "但現在銀行發現",
      "segment_id": "S0071"
    },
    {
      "start": 123.3,
      "end": 125.8,
      "text": "把錢帶給任何實體電都是虧本的",
      "segment_id": "S0072"
    },
    {
      "start": 125.8,
      "end": 126.8,
      "text": "因為物價在跌",
      "segment_id": "S0073"
    },
    {
      "start": 126.8,
      "end": 128.0,
      "text": "生意在縮水",
      "segment_id": "S0074"
    },
    {
      "start": 128.0,
      "end": 130.5,
      "text": "於是銀行選擇把錢所進保險貴",
      "segment_id": "S0075"
    },
    {
      "start": 130.5,
      "end": 132.2,
      "text": "而有錢的張餘哥們發現",
      "segment_id": "S0076"
    },
    {
      "start": 132.2,
      "end": 134.0,
      "text": "只要把現金捏在手裡不動",
      "segment_id": "S0077"
    },
    {
      "start": 134.0,
      "end": 135.7,
      "text": "購買力就在自然增長",
      "segment_id": "S0078"
    },
    {
      "start": 135.7,
      "end": 138.2,
      "text": "這筆投資任何工廠都賺得多",
      "segment_id": "S0079"
    },
    {
      "start": 138.2,
      "end": 140.0,
      "text": "當秦老不再創造價值",
      "segment_id": "S0080"
    },
    {
      "start": 140.0,
      "end": 142.4,
      "text": "當躺平成了最高收益的投資時",
      "segment_id": "S0081"
    },
    {
      "start": 142.4,
      "end": 143.8,
      "text": "實體經濟的血液",
      "segment_id": "S0082"
    },
    {
      "start": 143.8,
      "end": 144.8,
      "text": "徹底凝固了",
      "segment_id": "S0083"
    },
    {
      "start": 144.9,
      "end": 147.9,
      "text": "這邊是金融脫離實體後的另一種極端",
      "segment_id": "S0084"
    },
    {
      "start": 147.9,
      "end": 149.4,
      "text": "流動性陷阱",
      "segment_id": "S0085"
    },
    {
      "start": 149.4,
      "end": 151.1,
      "text": "在這場經濟大消條中",
      "segment_id": "S0086"
    },
    {
      "start": 151.1,
      "end": 152.2,
      "text": "誰在獲利",
      "segment_id": "S0087"
    },
    {
      "start": 152.2,
      "end": 152.9,
      "text": "答案是",
      "segment_id": "S0088"
    },
    {
      "start": 152.9,
      "end": 154.4,
      "text": "那些在通縮開始前",
      "segment_id": "S0089"
    },
    {
      "start": 154.4,
      "end": 155.9,
      "text": "就持有大量現金",
      "segment_id": "S0090"
    },
    {
      "start": 155.9,
      "end": 158.0,
      "text": "且沒有任何債務的極少數人",
      "segment_id": "S0091"
    },
    {
      "start": 158.0,
      "end": 160.5,
      "text": "他們靜靜地看著派大興失去房子",
      "segment_id": "S0092"
    },
    {
      "start": 160.5,
      "end": 162.3,
      "text": "看著海綿寶寶失去工作",
      "segment_id": "S0093"
    },
    {
      "start": 162.3,
      "end": 164.2,
      "text": "看著謝老闆的工廠倒閉",
      "segment_id": "S0094"
    },
    {
      "start": 164.2,
      "end": 165.7,
      "text": "等到物價跌到地心",
      "segment_id": "S0095"
    },
    {
      "start": 165.7,
      "end": 168.5,
      "text": "等到所有人都在絕望中拋售資產時",
      "segment_id": "S0096"
    },
    {
      "start": 168.5,
      "end": 169.7,
      "text": "他們會拿著手裡",
      "segment_id": "S0097"
    },
    {
      "start": 169.7,
      "end": 171.4,
      "text": "變得極度值錢的現金",
      "segment_id": "S0098"
    },
    {
      "start": 171.4,
      "end": 174.5,
      "text": "下場收割那些被打兩折三折的優質資產",
      "segment_id": "S0099"
    },
    {
      "start": 174.5,
      "end": 177.6,
      "text": "通貨膨脹是通過稀釋存款來轉移財富",
      "segment_id": "S0100"
    },
    {
      "start": 177.6,
      "end": 178.7,
      "text": "而通貨緊縮",
      "segment_id": "S0101"
    },
    {
      "start": 178.7,
      "end": 180.1,
      "text": "則是通過切斷收入",
      "segment_id": "S0102"
    },
    {
      "start": 180.1,
      "end": 183.2,
      "text": "放大債務來直接清吞你的生存資產",
      "segment_id": "S0103"
    },
    {
      "start": 183.2,
      "end": 185.2,
      "text": "比起寶的燈火一斬斬細滅",
      "segment_id": "S0104"
    },
    {
      "start": 185.2,
      "end": 187.5,
      "text": "曾經宣鬧的街道只剩下封傷",
      "segment_id": "S0105"
    },
    {
      "start": 187.5,
      "end": 190.4,
      "text": "碰縮的反制是全社會信用的攤塔",
      "segment_id": "S0106"
    },
    {
      "start": 190.4,
      "end": 192.3,
      "text": "當市場已經無法自救",
      "segment_id": "S0107"
    },
    {
      "start": 192.3,
      "end": 194.6,
      "text": "國家機器只剩最後一種選擇",
      "segment_id": "S0108"
    },
    {
      "start": 194.6,
      "end": 196.4,
      "text": "強行啟動貨幣扁執",
      "segment_id": "S0109"
    },
    {
      "start": 196.4,
      "end": 198.1,
      "text": "通過無底線的行政指令",
      "segment_id": "S0110"
    },
    {
      "start": 198.1,
      "end": 199.6,
      "text": "向銀行注入信用",
      "segment_id": "S0111"
    },
    {
      "start": 199.6,
      "end": 201.8,
      "text": "強行扭轉物價下跌的預期",
      "segment_id": "S0112"
    },
    {
      "start": 201.8,
      "end": 203.2,
      "text": "用人為製造的通脹",
      "segment_id": "S0113"
    },
    {
      "start": 203.2,
      "end": 204.9,
      "text": "來對衝著致命的寒冬",
      "segment_id": "S0114"
    },
    {
      "start": 204.9,
      "end": 207.2,
      "text": "這種以債養債的終極賭局",
      "segment_id": "S0115"
    },
    {
      "start": 207.2,
      "end": 209.4,
      "text": "究竟是讓比起寶重貨新生",
      "segment_id": "S0116"
    },
    {
      "start": 209.4,
      "end": 211.6,
      "text": "還是在為下一場更大的崩塌",
      "segment_id": "S0117"
    },
    {
      "start": 211.6,
      "end": 212.4,
      "text": "積累火養",
      "segment_id": "S0118"
    }
  ],
