{
  "status": "COMPLETE",
  "segments": [
    {
      "start": 0.0,
      "end": 1.2,
      "text": "不值不配",
      "segment_id": "S0001"
    },
    {
      "start": 1.2,
      "end": 3.2,
      "text": "不理解的三步消費",
      "segment_id": "S0002"
    },
    {
      "start": 3.2,
      "end": 4.0,
      "text": "第一種",
      "segment_id": "S0003"
    },
    {
      "start": 4.0,
      "end": 5.0,
      "text": "蒙合潮碗",
      "segment_id": "S0004"
    },
    {
      "start": 5.0,
      "end": 6.7,
      "text": "從蒙奇起到冰准的老婆",
      "segment_id": "S0005"
    },
    {
      "start": 6.7,
      "end": 7.8,
      "text": "每個一段時間",
      "segment_id": "S0006"
    },
    {
      "start": 7.8,
      "end": 8.8,
      "text": "總會出現一個",
      "segment_id": "S0007"
    },
    {
      "start": 8.8,
      "end": 10.0,
      "text": "天降座吧",
      "segment_id": "S0008"
    },
    {
      "start": 10.0,
      "end": 10.6,
      "text": "被瘋強",
      "segment_id": "S0009"
    },
    {
      "start": 10.6,
      "end": 12.6,
      "text": "一架高到維度以為",
      "segment_id": "S0010"
    },
    {
      "start": 12.6,
      "end": 14.0,
      "text": "這反應能夠說脫的",
      "segment_id": "S0011"
    },
    {
      "start": 14.0,
      "end": 14.8,
      "text": "撐度",
      "segment_id": "S0012"
    },
    {
      "start": 14.8,
      "end": 16.4,
      "text": "七八十塊的偶爾小買一下",
      "segment_id": "S0013"
    },
    {
      "start": 16.4,
      "end": 17.2,
      "text": "我可以理解",
      "segment_id": "S0014"
    },
    {
      "start": 17.2,
      "end": 18.4,
      "text": "但是上千剩萬的",
      "segment_id": "S0015"
    },
    {
      "start": 18.4,
      "end": 20.6,
      "text": "連一派對的大打出手的",
      "segment_id": "S0016"
    },
    {
      "start": 20.6,
      "end": 21.5,
      "text": "我說你們砸了",
      "segment_id": "S0017"
    },
    {
      "start": 21.5,
      "end": 23.8,
      "text": "小吃街邊擺攤賣你一步線一步",
      "segment_id": "S0018"
    },
    {
      "start": 23.8,
      "end": 24.6,
      "text": "乖馬市長",
      "segment_id": "S0019"
    },
    {
      "start": 24.6,
      "end": 25.9,
      "text": "你突然想入亂裝了",
      "segment_id": "S0020"
    },
    {
      "start": 25.9,
      "end": 27.0,
      "text": "你想要的真的是她嗎",
      "segment_id": "S0021"
    },
    {
      "start": 27.0,
      "end": 28.2,
      "text": "還是她被靠的",
      "segment_id": "S0022"
    },
    {
      "start": 28.2,
      "end": 29.9,
      "text": "大碗是虛幻的",
      "segment_id": "S0023"
    },
    {
      "start": 29.9,
      "end": 31.0,
      "text": "和富人之間的",
      "segment_id": "S0024"
    },
    {
      "start": 31.0,
      "end": 31.8,
      "text": "還批人很感慮",
      "segment_id": "S0025"
    },
    {
      "start": 31.8,
      "end": 32.6,
      "text": "如果買個娃娃",
      "segment_id": "S0026"
    },
    {
      "start": 32.6,
      "end": 33.9,
      "text": "真的就能快樂接審",
      "segment_id": "S0027"
    },
    {
      "start": 33.9,
      "end": 35.0,
      "text": "那這麼好的活動",
      "segment_id": "S0028"
    },
    {
      "start": 35.0,
      "end": 35.8,
      "text": "等她結束了",
      "segment_id": "S0029"
    },
    {
      "start": 35.8,
      "end": 37.0,
      "text": "說得你都不知道有這回事",
      "segment_id": "S0030"
    },
    {
      "start": 37.0,
      "end": 37.8,
      "text": "所以早日去妹妹吧",
      "segment_id": "S0031"
    },
    {
      "start": 37.8,
      "end": 39.8,
      "text": "不然下次資本再退出什麼",
      "segment_id": "S0032"
    },
    {
      "start": 39.8,
      "end": 40.8,
      "text": "火拉了",
      "segment_id": "S0033"
    },
    {
      "start": 40.8,
      "end": 41.8,
      "text": "轉媽媽",
      "segment_id": "S0034"
    },
    {
      "start": 41.8,
      "end": 43.0,
      "text": "廣家家",
      "segment_id": "S0035"
    },
    {
      "start": 43.0,
      "end": 44.1,
      "text": "哪一呢",
      "segment_id": "S0036"
    },
    {
      "start": 44.1,
      "end": 45.0,
      "text": "你還得掏錢",
      "segment_id": "S0037"
    },
    {
      "start": 45.0,
      "end": 45.6,
      "text": "二",
      "segment_id": "S0038"
    },
    {
      "start": 45.6,
      "end": 46.2,
      "text": "漂亮飯",
      "segment_id": "S0039"
    },
    {
      "start": 46.2,
      "end": 47.0,
      "text": "地獄之菜",
      "segment_id": "S0040"
    },
    {
      "start": 47.0,
      "end": 48.0,
      "text": "但是西式白白",
      "segment_id": "S0041"
    },
    {
      "start": 48.0,
      "end": 48.7,
      "text": "加上權益門",
      "segment_id": "S0042"
    },
    {
      "start": 48.7,
      "end": 49.4,
      "text": "或者中英",
      "segment_id": "S0043"
    },
    {
      "start": 49.4,
      "end": 50.1,
      "text": "紅和殿民",
      "segment_id": "S0044"
    },
    {
      "start": 50.1,
      "end": 50.7,
      "text": "加上朝人",
      "segment_id": "S0045"
    },
    {
      "start": 50.7,
      "end": 51.4,
      "text": "打卡拍照",
      "segment_id": "S0046"
    },
    {
      "start": 51.4,
      "end": 52.6,
      "text": "加上太多更差的主理人",
      "segment_id": "S0047"
    },
    {
      "start": 52.6,
      "end": 53.6,
      "text": "登於",
      "segment_id": "S0048"
    },
    {
      "start": 53.6,
      "end": 54.2,
      "text": "沒有四百塊錢",
      "segment_id": "S0049"
    },
    {
      "start": 54.2,
      "end": 55.0,
      "text": "你出不了這個門",
      "segment_id": "S0050"
    },
    {
      "start": 55.0,
      "end": 56.0,
      "text": "誰同意誰反對",
      "segment_id": "S0051"
    },
    {
      "start": 56.0,
      "end": 57.1,
      "text": "和規密逛街累了",
      "segment_id": "S0052"
    },
    {
      "start": 57.1,
      "end": 57.7,
      "text": "然後想找個",
      "segment_id": "S0053"
    },
    {
      "start": 57.7,
      "end": 58.8,
      "text": "對二隨便吃口飯",
      "segment_id": "S0054"
    },
    {
      "start": 58.8,
      "end": 59.5,
      "text": "昨天一家",
      "segment_id": "S0055"
    },
    {
      "start": 59.5,
      "end": 60.2,
      "text": "用挺漂亮",
      "segment_id": "S0056"
    },
    {
      "start": 60.2,
      "end": 61.3,
      "text": "挺乾淨的小店",
      "segment_id": "S0057"
    },
    {
      "start": 61.3,
      "end": 62.1,
      "text": "打開這個菜單",
      "segment_id": "S0058"
    },
    {
      "start": 62.1,
      "end": 63.4,
      "text": "我就直接化身豬豬翔",
      "segment_id": "S0059"
    },
    {
      "start": 63.4,
      "end": 64.6,
      "text": "擴好下個脫舊的",
      "segment_id": "S0060"
    },
    {
      "start": 64.6,
      "end": 65.3,
      "text": "三頁指",
      "segment_id": "S0061"
    },
    {
      "start": 65.3,
      "end": 66.1,
      "text": "沒幾個中國字",
      "segment_id": "S0062"
    },
    {
      "start": 66.1,
      "end": 66.6,
      "text": "也就算了",
      "segment_id": "S0063"
    },
    {
      "start": 66.6,
      "end": 67.3,
      "text": "好不容易",
      "segment_id": "S0064"
    },
    {
      "start": 67.3,
      "end": 68.3,
      "text": "有一個認識的殺啦",
      "segment_id": "S0065"
    },
    {
      "start": 68.3,
      "end": 69.0,
      "text": "一看價格",
      "segment_id": "S0066"
    },
    {
      "start": 69.0,
      "end": 70.3,
      "text": "我還以為單位是越南頓",
      "segment_id": "S0067"
    },
    {
      "start": 70.3,
      "end": 71.0,
      "text": "不是我說",
      "segment_id": "S0068"
    },
    {
      "start": 71.0,
      "end": 72.5,
      "text": "就是那個東北戰將菜",
      "segment_id": "S0069"
    },
    {
      "start": 72.5,
      "end": 73.6,
      "text": "他賣你二十一盆",
      "segment_id": "S0070"
    },
    {
      "start": 73.6,
      "end": 75.1,
      "text": "他都算是很狹窄你了",
      "segment_id": "S0071"
    },
    {
      "start": 75.1,
      "end": 76.2,
      "text": "腦袋戰將菜",
      "segment_id": "S0072"
    },
    {
      "start": 76.2,
      "end": 77.2,
      "text": "剩了就就是吧",
      "segment_id": "S0073"
    },
    {
      "start": 77.2,
      "end": 78.2,
      "text": "你要死你",
      "segment_id": "S0074"
    },
    {
      "start": 78.2,
      "end": 79.4,
      "text": "除了這種半土不洋派",
      "segment_id": "S0075"
    },
    {
      "start": 79.4,
      "end": 80.0,
      "text": "這幾年打軍",
      "segment_id": "S0076"
    },
    {
      "start": 80.0,
      "end": 82.0,
      "text": "雲貴穿奇浩的杯子手",
      "segment_id": "S0077"
    },
    {
      "start": 86.0,
      "end": 86.8,
      "text": "一款炒蛋",
      "segment_id": "S0078"
    },
    {
      "start": 86.8,
      "end": 88.8,
      "text": "撒上蝦蜜就敢說自己是穿屎",
      "segment_id": "S0079"
    },
    {
      "start": 88.8,
      "end": 90.8,
      "text": "撒上蝦跟就敢說自己是貴屎",
      "segment_id": "S0080"
    },
    {
      "start": 90.8,
      "end": 91.8,
      "text": "撒一點不合",
      "segment_id": "S0081"
    },
    {
      "start": 91.8,
      "end": 93.0,
      "text": "就敢說自己是顛屎",
      "segment_id": "S0082"
    },
    {
      "start": 93.0,
      "end": 93.9,
      "text": "我一個宿舟人",
      "segment_id": "S0083"
    },
    {
      "start": 93.9,
      "end": 94.8,
      "text": "都要看不下去",
      "segment_id": "S0084"
    },
    {
      "start": 94.8,
      "end": 96.0,
      "text": "體雲貴穿人命發生了",
      "segment_id": "S0085"
    },
    {
      "start": 96.0,
      "end": 97.2,
      "text": "就這種店",
      "segment_id": "S0086"
    },
    {
      "start": 97.2,
      "end": 98.7,
      "text": "能不能夠困難",
      "segment_id": "S0087"
    },
    {
      "start": 98.7,
      "end": 99.3,
      "text": "第三",
      "segment_id": "S0088"
    },
    {
      "start": 99.3,
      "end": 100.6,
      "text": "旋學消費",
      "segment_id": "S0089"
    },
    {
      "start": 100.6,
      "end": 101.2,
      "text": "這兩年",
      "segment_id": "S0090"
    },
    {
      "start": 101.2,
      "end": 102.7,
      "text": "這個旋學變現賽道",
      "segment_id": "S0091"
    },
    {
      "start": 102.7,
      "end": 104.2,
      "text": "也是火如爆",
      "segment_id": "S0092"
    },
    {
      "start": 104.2,
      "end": 104.7,
      "text": "什麼",
      "segment_id": "S0093"
    },
    {
      "start": 104.7,
      "end": 106.2,
      "text": "招命黃水晶",
      "segment_id": "S0094"
    },
    {
      "start": 106.2,
      "end": 107.7,
      "text": "蜘育白水晶",
      "segment_id": "S0095"
    },
    {
      "start": 107.7,
      "end": 109.2,
      "text": "防小人黑水晶",
      "segment_id": "S0096"
    },
    {
      "start": 109.2,
      "end": 110.9,
      "text": "對這一批量生產的工業手臉子",
      "segment_id": "S0097"
    },
    {
      "start": 110.9,
      "end": 112.2,
      "text": "還能感受到什麼能量",
      "segment_id": "S0098"
    },
    {
      "start": 112.2,
      "end": 112.8,
      "text": "責場",
      "segment_id": "S0099"
    },
    {
      "start": 112.8,
      "end": 114.0,
      "text": "還有什麼合適的人",
      "segment_id": "S0100"
    },
    {
      "start": 114.0,
      "end": 115.4,
      "text": "有緣的人才能有管理",
      "segment_id": "S0101"
    },
    {
      "start": 115.4,
      "end": 117.0,
      "text": "買完手臉還不夠",
      "segment_id": "S0102"
    },
    {
      "start": 117.0,
      "end": 118.0,
      "text": "還有買那個盆災",
      "segment_id": "S0103"
    },
    {
      "start": 118.0,
      "end": 119.0,
      "text": "那麼大的水晶處",
      "segment_id": "S0104"
    },
    {
      "start": 119.0,
      "end": 120.8,
      "text": "月光下三針午晒",
      "segment_id": "S0105"
    },
    {
      "start": 120.8,
      "end": 121.5,
      "text": "平滑能量",
      "segment_id": "S0106"
    },
    {
      "start": 121.5,
      "end": 122.5,
      "text": "我說大傻春",
      "segment_id": "S0107"
    },
    {
      "start": 122.5,
      "end": 123.6,
      "text": "你要敢失誤",
      "segment_id": "S0108"
    },
    {
      "start": 123.6,
      "end": 124.9,
      "text": "那晚要真有那麼厲害",
      "segment_id": "S0109"
    },
    {
      "start": 124.9,
      "end": 125.5,
      "text": "那蜜巴當年",
      "segment_id": "S0110"
    },
    {
      "start": 125.5,
      "end": 126.3,
      "text": "也不用那麼廢事",
      "segment_id": "S0111"
    },
    {
      "start": 126.3,
      "end": 127.9,
      "text": "倒出口內午客無限保持了",
      "segment_id": "S0112"
    },
    {
      "start": 127.9,
      "end": 128.9,
      "text": "他直接買個高鐵票",
      "segment_id": "S0113"
    },
    {
      "start": 128.9,
      "end": 129.9,
      "text": "去趟一屋",
      "segment_id": "S0114"
    },
    {
      "start": 129.9,
      "end": 131.3,
      "text": "手套上香香多少",
      "segment_id": "S0115"
    },
    {
      "start": 131.3,
      "end": 132.0,
      "text": "香多少",
      "segment_id": "S0116"
    },
    {
      "start": 132.0,
      "end": 132.5,
      "text": "再一個",
      "segment_id": "S0117"
    },
    {
      "start": 132.5,
      "end": 133.3,
      "text": "沒細品一下",
      "segment_id": "S0118"
    },
    {
      "start": 133.3,
      "end": 134.5,
      "text": "你花一千塊錢",
      "segment_id": "S0119"
    },
    {
      "start": 134.5,
      "end": 136.6,
      "text": "買回來成本二十的黃水晶",
      "segment_id": "S0120"
    },
    {
      "start": 136.6,
      "end": 137.8,
      "text": "進虧九百八",
      "segment_id": "S0121"
    },
    {
      "start": 137.8,
      "end": 138.8,
      "text": "你還說他招財",
      "segment_id": "S0122"
    },
    {
      "start": 138.8,
      "end": 139.5,
      "text": "是合理盟",
      "segment_id": "S0123"
    },
    {
      "start": 139.5,
      "end": 142.3,
      "text": "同理一個五百塊錢的防小人黑水晶",
      "segment_id": "S0124"
    },
    {
      "start": 142.3,
      "end": 144.4,
      "text": "你的目前內客已經被上下騙了",
      "segment_id": "S0125"
    },
    {
      "start": 144.4,
      "end": 146.9,
      "text": "這小人也沒幫助我",
      "segment_id": "S0126"
    },
    {
      "start": 146.9,
      "end": 148.9,
      "text": "四天降手機客",
      "segment_id": "S0127"
    },
    {
      "start": 148.9,
      "end": 150.3,
      "text": "我不懂",
      "segment_id": "S0128"
    },
    {
      "start": 150.3,
      "end": 151.4,
      "text": "五百塊錢",
      "segment_id": "S0129"
    },
    {
      "start": 151.4,
      "end": 153.2,
      "text": "那一個俗料收機客",
      "segment_id": "S0130"
    },
    {
      "start": 153.2,
      "end": 155.0,
      "text": "這是我生活",
      "segment_id": "S0131"
    },
    {
      "start": 155.0,
      "end": 156.0,
      "text": "那有人要說了",
      "segment_id": "S0132"
    },
    {
      "start": 156.0,
      "end": 157.9,
      "text": "好馬就得配好安",
      "segment_id": "S0133"
    },
    {
      "start": 157.9,
      "end": 159.2,
      "text": "八千塊的手機我都買了",
      "segment_id": "S0134"
    },
    {
      "start": 159.2,
      "end": 160.7,
      "text": "我還差一個五百塊的手機合嗎",
      "segment_id": "S0135"
    },
    {
      "start": 160.7,
      "end": 161.5,
      "text": "再說了",
      "segment_id": "S0136"
    },
    {
      "start": 161.5,
      "end": 163.4,
      "text": "五百能說明他質量好",
      "segment_id": "S0137"
    },
    {
      "start": 163.4,
      "end": 165.3,
      "text": "我就不用擔心他便宜的發黃問題了",
      "segment_id": "S0138"
    },
    {
      "start": 165.3,
      "end": 165.9,
      "text": "住嘴",
      "segment_id": "S0139"
    },
    {
      "start": 165.9,
      "end": 166.7,
      "text": "首先",
      "segment_id": "S0140"
