{
  "status": "COMPLETE",
  "segments": [
    {
      "start": 0.0,
      "end": 1.5,
      "text": "汇报的核心就在于",
      "segment_id": "S0001"
    },
    {
      "start": 1.5,
      "end": 2.9,
      "text": "让干了这件事的人",
      "segment_id": "S0002"
    },
    {
      "start": 2.9,
      "end": 4.3,
      "text": "知道你干了很多火",
      "segment_id": "S0003"
    },
    {
      "start": 4.3,
      "end": 5.9,
      "text": "让每一干这件事的人",
      "segment_id": "S0004"
    },
    {
      "start": 5.9,
      "end": 7.7,
      "text": "知道你干这件事有多难",
      "segment_id": "S0005"
    },
    {
      "start": 7.7,
      "end": 9.4,
      "text": "才能展现出你的价值",
      "segment_id": "S0006"
    },
    {
      "start": 9.4,
      "end": 10.5,
      "text": "你汇报做得好",
      "segment_id": "S0007"
    },
    {
      "start": 10.5,
      "end": 13.0,
      "text": "比你默默无闻的干一百件事要强",
      "segment_id": "S0008"
    },
    {
      "start": 13.0,
      "end": 14.0,
      "text": "你可以去观察一下",
      "segment_id": "S0009"
    },
    {
      "start": 14.0,
      "end": 15.1,
      "text": "看一下是不是职场上",
      "segment_id": "S0010"
    },
    {
      "start": 15.1,
      "end": 16.6,
      "text": "那些上升的很快的人",
      "segment_id": "S0011"
    },
    {
      "start": 16.6,
      "end": 18.1,
      "text": "都是汇报做得好的人",
      "segment_id": "S0012"
    },
    {
      "start": 18.1,
      "end": 20.1,
      "text": "我说是毕业在私起干了两年",
      "segment_id": "S0013"
    },
    {
      "start": 20.1,
      "end": 21.5,
      "text": "在国起干了四年",
      "segment_id": "S0014"
    },
    {
      "start": 21.5,
      "end": 23.4,
      "text": "我分享一个一直被民道",
      "segment_id": "S0015"
    },
    {
      "start": 23.4,
      "end": 25.4,
      "text": "夸张邮邏进的汇报方法",
      "segment_id": "S0016"
    },
    {
      "start": 25.4,
      "end": 26.6,
      "text": "我们在汇报前",
      "segment_id": "S0017"
    },
    {
      "start": 26.6,
      "end": 28.6,
      "text": "就应该要搞清楚这些事情",
      "segment_id": "S0018"
    },
    {
      "start": 28.7,
      "end": 31.0,
      "text": "第一本次汇报的目的",
      "segment_id": "S0019"
    },
    {
      "start": 31.0,
      "end": 32.6,
      "text": "是为了总结自己的工作",
      "segment_id": "S0020"
    },
    {
      "start": 32.6,
      "end": 35.4,
      "text": "还是向某个领导来展示自己的工作成果",
      "segment_id": "S0021"
    },
    {
      "start": 35.4,
      "end": 36.9,
      "text": "还是为了决策某个方案",
      "segment_id": "S0022"
    },
    {
      "start": 36.9,
      "end": 39.0,
      "text": "还是要顺便秀一下自己的业绩",
      "segment_id": "S0023"
    },
    {
      "start": 39.0,
      "end": 41.2,
      "text": "所有的汇报最终的结果",
      "segment_id": "S0024"
    },
    {
      "start": 41.2,
      "end": 43.0,
      "text": "肯定就是为了达成这个目的",
      "segment_id": "S0025"
    },
    {
      "start": 43.0,
      "end": 45.7,
      "text": "第二就是我们要区分汇报的对象",
      "segment_id": "S0026"
    },
    {
      "start": 45.7,
      "end": 47.2,
      "text": "毛泉里面有一句话是",
      "segment_id": "S0027"
    },
    {
      "start": 47.2,
      "end": 49.4,
      "text": "知己知彼百战不代",
      "segment_id": "S0028"
    },
    {
      "start": 49.4,
      "end": 51.4,
      "text": "和不同的领导汇报的重点",
      "segment_id": "S0029"
    },
    {
      "start": 51.4,
      "end": 52.8,
      "text": "肯定是不一样的",
      "segment_id": "S0030"
    },
    {
      "start": 52.8,
      "end": 55.4,
      "text": "比如说如果你是向你的直接领导汇报的话",
      "segment_id": "S0031"
    },
    {
      "start": 55.4,
      "end": 57.1,
      "text": "那他关心的是什么问题呢",
      "segment_id": "S0032"
    },
    {
      "start": 57.2,
      "end": 59.6,
      "text": "他关心进度加有没有风险点",
      "segment_id": "S0033"
    },
    {
      "start": 59.6,
      "end": 61.1,
      "text": "加你的解决方案",
      "segment_id": "S0034"
    },
    {
      "start": 61.1,
      "end": 63.7,
      "text": "但是你如果适合更高层的领导汇报",
      "segment_id": "S0035"
    },
    {
      "start": 63.7,
      "end": 64.4,
      "text": "那他关心什么",
      "segment_id": "S0036"
    },
    {
      "start": 64.4,
      "end": 66.6,
      "text": "他根本都不关心你这些实现的细节了",
      "segment_id": "S0037"
    },
    {
      "start": 66.6,
      "end": 71.4,
      "text": "他就想知道结果加收益加有没有什么战略意义",
      "segment_id": "S0038"
    },
    {
      "start": 71.4,
      "end": 73.3,
      "text": "他关心的东西都是非常顶层的",
      "segment_id": "S0039"
    },
    {
      "start": 73.3,
      "end": 75.6,
      "text": "你对不同的汇报对象的话",
      "segment_id": "S0040"
    },
    {
      "start": 75.6,
      "end": 78.2,
      "text": "你的汇报的内容和重点是不一样的",
      "segment_id": "S0041"
    },
    {
      "start": 78.2,
      "end": 80.4,
      "text": "我们把目标和对象搞定之后",
      "segment_id": "S0042"
    },
    {
      "start": 80.4,
      "end": 83.1,
      "text": "我们就明确我们真正的汇报内容",
      "segment_id": "S0043"
    },
    {
      "start": 83.1,
      "end": 84.2,
      "text": "我们的汇报内容",
      "segment_id": "S0044"
    },
    {
      "start": 84.2,
      "end": 86.1,
      "text": "不要去过多的去展示细节",
      "segment_id": "S0045"
    },
    {
      "start": 86.1,
      "end": 88.6,
      "text": "而是要更多的去展示成果",
      "segment_id": "S0046"
    },
    {
      "start": 88.6,
      "end": 91.2,
      "text": "领导其实不关心你怎么把像不做下来的",
      "segment_id": "S0047"
    },
    {
      "start": 91.2,
      "end": 93.0,
      "text": "但是他关心你做成之后",
      "segment_id": "S0048"
    },
    {
      "start": 93.0,
      "end": 95.8,
      "text": "你获得了什么样的收益",
      "segment_id": "S0049"
    },
    {
      "start": 95.8,
      "end": 96.6,
      "text": "但是这个收益呢",
      "segment_id": "S0050"
    },
    {
      "start": 96.6,
      "end": 98.2,
      "text": "我们不能干八八的犯犯的语言",
      "segment_id": "S0051"
    },
    {
      "start": 98.2,
      "end": 101.7,
      "text": "去讲还要懂得包装",
      "segment_id": "S0052"
    },
    {
      "start": 101.7,
      "end": 104.6,
      "text": "比如经过我本次的优化性能大大提升",
      "segment_id": "S0053"
    },
    {
      "start": 104.6,
      "end": 105.6,
      "text": "你这样讲",
      "segment_id": "S0054"
    },
    {
      "start": 105.6,
      "end": 106.4,
      "text": "他就很干",
      "segment_id": "S0055"
    },
    {
      "start": 106.4,
      "end": 107.2,
      "text": "一把他改成",
      "segment_id": "S0056"
    },
    {
      "start": 107.2,
      "end": 110.4,
      "text": "经过我这次优化性能提升了90%",
      "segment_id": "S0057"
    },
    {
      "start": 110.4,
      "end": 113.0,
      "text": "从之前的用户点击想因速度2秒",
      "segment_id": "S0058"
    },
    {
      "start": 113.0,
      "end": 115.2,
      "text": "优化到了现在的100毫秒",
      "segment_id": "S0059"
    },
    {
      "start": 115.2,
      "end": 119.2,
      "text": "你看我们用数据来表明你结论的权威性",
      "segment_id": "S0060"
    },
    {
      "start": 119.2,
      "end": 120.9,
      "text": "又从用户的角度来描述的话",
      "segment_id": "S0061"
    },
    {
      "start": 120.9,
      "end": 123.0,
      "text": "会使这个结果更加的直观",
      "segment_id": "S0062"
    },
    {
      "start": 123.0,
      "end": 124.6,
      "text": "比如说如果你说我去买水果",
      "segment_id": "S0063"
    },
    {
      "start": 124.6,
      "end": 125.4,
      "text": "我买了很多",
      "segment_id": "S0064"
    },
    {
      "start": 125.4,
      "end": 126.2,
      "text": "这不够直观",
      "segment_id": "S0065"
    },
    {
      "start": 126.2,
      "end": 128.3,
      "text": "那你如果说我买了10斤",
      "segment_id": "S0066"
    },
    {
      "start": 128.3,
      "end": 129.6,
      "text": "哎这好像有点感觉了",
      "segment_id": "S0067"
    },
    {
      "start": 129.6,
      "end": 130.8,
      "text": "如果你再补充一下",
      "segment_id": "S0068"
    },
    {
      "start": 130.8,
      "end": 133.4,
      "text": "这10斤给我一个人吃10天",
      "segment_id": "S0069"
    },
    {
      "start": 133.4,
      "end": 135.4,
      "text": "这个时候这10斤就剧下花了",
      "segment_id": "S0070"
    },
    {
      "start": 135.4,
      "end": 137.5,
      "text": "那我们说完了成果之后",
      "segment_id": "S0071"
    },
    {
      "start": 137.5,
      "end": 139.8,
      "text": "我们再来说过程",
      "segment_id": "S0072"
    },
    {
      "start": 139.8,
      "end": 142.0,
      "text": "这部分内容就像是漫威电影的",
      "segment_id": "S0073"
    },
    {
      "start": 142.0,
      "end": 143.6,
      "text": "以资英雄之语的故事",
      "segment_id": "S0074"
    },
    {
      "start": 143.6,
      "end": 146.2,
      "text": "这个故事你要讲清楚它的背景是什么",
      "segment_id": "S0075"
    },
    {
      "start": 146.2,
      "end": 148.2,
      "text": "然后我们为了达成这个目标",
      "segment_id": "S0076"
    },
    {
      "start": 148.2,
      "end": 149.9,
      "text": "所做出的努力",
      "segment_id": "S0077"
    },
    {
      "start": 149.9,
      "end": 153.0,
      "text": "以及我们克服了什么样的困难",
      "segment_id": "S0078"
    },
    {
      "start": 153.0,
      "end": 155.6,
      "text": "然后我们最终达成了目标",
      "segment_id": "S0079"
    },
    {
      "start": 155.6,
      "end": 158.0,
      "text": "或者说我还超恶完成了目标",
      "segment_id": "S0080"
    },
    {
      "start": 158.0,
      "end": 159.0,
      "text": "这让人听我的感觉",
      "segment_id": "S0081"
    },
    {
      "start": 159.0,
      "end": 160.5,
      "text": "就像你刚从电源走出来一样",
      "segment_id": "S0082"
    },
    {
      "start": 160.5,
      "end": 161.8,
      "text": "只能说一句太流了吧",
      "segment_id": "S0083"
    },
    {
      "start": 161.8,
      "end": 163.1,
      "text": "比如说我们标识表达",
      "segment_id": "S0084"
    },
    {
      "start": 163.1,
      "end": 164.9,
      "text": "哎我这做这个事情遇到了很多困难",
      "segment_id": "S0085"
    },
    {
      "start": 164.9,
      "end": 167.6,
      "text": "你直接说我在临经验的情况下",
      "segment_id": "S0086"
    },
    {
      "start": 167.6,
      "end": 169.6,
      "text": "我们用A方法试错了",
      "segment_id": "S0087"
    },
    {
      "start": 169.6,
      "end": 172.2,
      "text": "三次最终我们创新性的用",
      "segment_id": "S0088"
    },
    {
      "start": 172.2,
      "end": 173.6,
      "text": "毕方案破局",
      "segment_id": "S0089"
    },
    {
      "start": 173.6,
      "end": 174.6,
      "text": "最后第五点",
      "segment_id": "S0090"
    },
    {
      "start": 174.6,
      "end": 176.9,
      "text": "我们还要带上复盘和什么呢",
      "segment_id": "S0091"
    },
    {
      "start": 176.9,
      "end": 178.6,
      "text": "和未来计划",
      "segment_id": "S0092"
    },
    {
      "start": 178.6,
      "end": 179.4,
      "text": "说白了这个事",
      "segment_id": "S0093"
    },
    {
      "start": 179.4,
      "end": 181.3,
      "text": "就是要适当的画表硬",
      "segment_id": "S0094"
    },
    {
      "start": 181.3,
      "end": 183.6,
      "text": "比如我的这套质量管理体系",
      "segment_id": "S0095"
    },
    {
      "start": 183.6,
      "end": 185.2,
      "text": "已经在三个项目完成验证了",
      "segment_id": "S0096"
    },
    {
      "start": 185.2,
      "end": 187.5,
      "text": "预计下半年全团队推广后",
      "segment_id": "S0097"
    },
    {
      "start": 187.5,
      "end": 190.7,
      "text": "可降低百分之四十的线上事故",
      "segment_id": "S0098"
    },
    {
      "start": 190.7,
      "end": 192.0,
      "text": "哎根据这个中工定律",
      "segment_id": "S0099"
    },
    {
      "start": 192.0,
      "end": 193.8,
      "text": "适当的升华一下结尾",
      "segment_id": "S0100"
    },
    {
      "start": 193.8,
      "end": 195.3,
      "text": "最终会让听汇报的人",
      "segment_id": "S0101"
    },
    {
      "start": 195.3,
      "end": 197.2,
      "text": "对你的印象分大大的提升",
      "segment_id": "S0102"
    },
    {
      "start": 197.2,
      "end": 199.4,
      "text": "我们最后记住一个毛选的心法",
      "segment_id": "S0103"
    },
    {
      "start": 199.4,
      "end": 202.0,
      "text": "感觉执解决现象问题",
      "segment_id": "S0104"
    },
    {
      "start": 202.0,
      "end": 204.7,
      "text": "理论才解决本质问题",
      "segment_id": "S0105"
    },
    {
      "start": 204.7,
      "end": 206.7,
      "text": "你只有把我们敏散的工作",
      "segment_id": "S0106"
    },
    {
      "start": 206.7,
      "end": 208.1,
      "text": "升华成一个方法论",
      "segment_id": "S0107"
    },
    {
      "start": 208.1,
      "end": 209.8,
      "text": "那你就同一个执行者",
      "segment_id": "S0108"
    },
    {
      "start": 209.8,
      "end": 211.9,
      "text": "变成了规则的制定者",
      "segment_id": "S0109"
