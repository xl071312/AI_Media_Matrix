[
  {
    "start": 0.0,
    "end": 1.6,
    "text": "全世界最重要的声音是什么"
  },
  {
    "start": 1.6,
    "end": 3.2,
    "text": "找一万个人每人每天给你20块"
  },
  {
    "start": 3.2,
    "end": 5.6,
    "text": "错了孟老习问每天排队给你20块"
  },
  {
    "start": 5.6,
    "end": 6.8,
    "text": "只要三个不走席会了"
  },
  {
    "start": 6.8,
    "end": 8.08,
    "text": "你去小兄弟下个乱时时"
  },
  {
    "start": 8.08,
    "end": 8.96,
    "text": "接着工厅"
  },
  {
    "start": 8.96,
    "end": 11.92,
    "text": "第一招叫做设计又而把刚兴设计场领运购"
  },
  {
    "start": 11.92,
    "end": 12.88,
    "text": "这么冲向吗"
  },
  {
    "start": 12.88,
    "end": 15.12,
    "text": "九里早一月节或者大型情绪去去吧"
  },
  {
    "start": 15.12,
    "end": 16.56,
    "text": "排队至少一两个小时继务"
  },
  {
    "start": 16.56,
    "end": 18.16,
    "text": "没作为没着的大太阳"
  },
  {
    "start": 18.16,
    "end": 20.08,
    "text": "这个时候做的他心情话就是刚兴"
  },
  {
    "start": 20.08,
    "end": 20.96,
    "text": "那领袁公"
  },
  {
    "start": 20.96,
    "end": 22.0,
    "text": "别人他们小做的"
  },
  {
    "start": 22.0,
    "end": 23.52,
    "text": "你周年费记得他们折业马扎"
  },
  {
    "start": 23.52,
    "end": 24.56,
    "text": "人数是你免费"
  },
  {
    "start": 24.56,
    "end": 26.56,
    "text": "天然结糊在场所有钱在不可"
  },
  {
    "start": 26.56,
    "end": 27.36,
    "text": "一万人就不就来了"
  },
  {
    "start": 27.36,
    "end": 28.56,
    "text": "就算有一万人"
  },
  {
    "start": 28.56,
    "end": 30.56,
    "text": "跟东年费记了怎么赚的20块"
  },
  {
    "start": 30.56,
    "end": 32.4,
    "text": "压筋只要三个四个20块"
  },
  {
    "start": 32.4,
    "end": 33.2,
    "text": "天和线的手机号"
  },
  {
    "start": 33.2,
    "end": 34.64,
    "text": "这个邓子全天拿着随定"
  },
  {
    "start": 34.64,
    "end": 36.48,
    "text": "用直要晚上在指定的那种规划"
  },
  {
    "start": 36.48,
    "end": 37.36,
    "text": "压筋定量退"
  },
  {
    "start": 37.36,
    "end": 39.12,
    "text": "可是之前你就会把还在退给人家吗"
  },
  {
    "start": 39.12,
    "end": 39.92,
    "text": "白毛我呀"
  },
  {
    "start": 39.92,
    "end": 40.72,
    "text": "最近才地来了"
  },
  {
    "start": 40.72,
    "end": 43.28,
    "text": "音乐节赛场时候几万人同时有限出口"
  },
  {
    "start": 43.28,
    "end": 44.0,
    "text": "那么大一几期"
  },
  {
    "start": 44.0,
    "end": 46.0,
    "text": "难问到北门中间至少隔着几公里"
  },
  {
    "start": 46.0,
    "end": 46.56,
    "text": "但调的时候"
  },
  {
    "start": 46.56,
    "end": 47.36,
    "text": "谁不是惊惊地地进"
  },
  {
    "start": 47.36,
    "end": 48.8,
    "text": "只想为九天好好睡一觉"
  },
  {
    "start": 48.8,
    "end": 50.56,
    "text": "为了20块的邓子还要特地"
  },
  {
    "start": 50.56,
    "end": 52.72,
    "text": "让陆拍场队去退登子"
  },
  {
    "start": 52.72,
    "end": 52.96,
    "text": "哦"
  },
  {
    "start": 52.96,
    "end": 55.12,
    "text": "觉得当作是第一个年头就是算太车厂"
  },
  {
    "start": 55.12,
    "end": 55.44,
    "text": "没错"
  },
  {
    "start": 55.44,
    "end": 56.8,
    "text": "就当花了20买了马甲"
  },
  {
    "start": 56.8,
    "end": 58.48,
    "text": "反正出去陆引掉一斗很重"
  },
  {
    "start": 58.48,
    "end": 60.0,
    "text": "能够自过这20亚金的人"
  },
  {
    "start": 60.0,
    "end": 61.2,
    "text": "他其实也不在过这20"
  },
  {
    "start": 61.2,
    "end": 62.88,
    "text": "但是一定也会有人活到退款"
  },
  {
    "start": 62.88,
    "end": 64.08,
    "text": "一天一万个人"
  },
  {
    "start": 64.08,
    "end": 65.6,
    "text": "拿派其中有四千个人"
  },
  {
    "start": 65.6,
    "end": 66.72,
    "text": "喜欢退了亚金"
  },
  {
    "start": 66.72,
    "end": 68.32,
    "text": "还是想留情的钱的钱满分不退的"
  },
  {
    "start": 68.32,
    "end": 69.68,
    "text": "直接留下12万的六人"
  },
  {
    "start": 69.68,
    "end": 71.68,
    "text": "不自那马甲本身也有成本的"
  },
  {
    "start": 71.68,
    "end": 74.16,
    "text": "马甲被名艺的当地夜校套的影龄广告"
  },
  {
    "start": 74.16,
    "end": 76.08,
    "text": "每个马甲收上家无望钱的退款费"
  },
  {
    "start": 76.08,
    "end": 77.52,
    "text": "别忘了马甲就是五千块"
  },
  {
    "start": 77.52,
    "end": 78.88,
    "text": "直接抵抢马甲的成本了"
  },
  {
    "start": 78.88,
    "end": 79.6,
    "text": "哇 雪"
  },
  {
    "start": 79.6,
    "end": 80.8,
    "text": "牛拿还有一张"
  },
  {
    "start": 80.8,
    "end": 82.88,
    "text": "第三张交捉四里资产变形"
  },
  {
    "start": 82.88,
    "end": 83.28,
    "text": "要知道"
  },
  {
    "start": 83.28,
    "end": 84.48,
    "text": "为了交压金这一万人"
  },
  {
    "start": 84.48,
    "end": 86.32,
    "text": "和全部都跟你留了自己的个人信息"
  },
  {
    "start": 86.32,
    "end": 87.76,
    "text": "当下公寓平台要想买一个"
  },
  {
    "start": 87.76,
    "end": 89.36,
    "text": "真实生活的真实信息可无陪"
  },
  {
    "start": 89.36,
    "end": 90.8,
    "text": "况且你这凯是最精组的"
  },
  {
    "start": 90.8,
    "end": 92.24,
    "text": "有效被牛力的那批用物"
  },
  {
    "start": 92.24,
    "end": 93.28,
    "text": "价值可想而知"
  },
  {
    "start": 93.28,
    "end": 93.6,
    "text": "哦"
  },
  {
    "start": 93.6,
    "end": 95.12,
    "text": "紧去可以退休周边特下有点"
  },
  {
    "start": 95.12,
    "end": 96.08,
    "text": "医院节可以退休潮"
  },
  {
    "start": 96.08,
    "end": 97.24,
    "text": "排剩日期下一次"
  },
  {
    "start": 97.24,
    "end": 98.08,
    "text": "也常会的不一样"
  },
  {
    "start": 98.08,
    "end": 98.96,
    "text": "你只要是一遍"
  },
  {
    "start": 98.96,
    "end": 101.2,
    "text": "变成了手握流量分发权的装甲了"
  },
  {
    "start": 101.2,
    "end": 101.84,
    "text": "希望不可以说了"
  }
]