[
  {
    "start": 0.24,
    "end": 2.8,
    "text": "我發現中邊人一個最大的困境是"
  },
  {
    "start": 2.8,
    "end": 4.4,
    "text": "房子是你的車是你的"
  },
  {
    "start": 4.4,
    "end": 5.24,
    "text": "還是你的"
  },
  {
    "start": 5.24,
    "end": 8.0,
    "text": "但是銀行卡里的錢好像不是你的"
  },
  {
    "start": 8.0,
    "end": 10.72,
    "text": "明明兩口子捏收入加起來2310萬"
  },
  {
    "start": 10.72,
    "end": 12.88,
    "text": "卻沒有一筆錢可以自由支配"
  },
  {
    "start": 12.88,
    "end": 15.44,
    "text": "公子一道上就被系統自動情況"
  },
  {
    "start": 15.44,
    "end": 17.12,
    "text": "這不是你們家自己的問題"
  },
  {
    "start": 17.12,
    "end": 19.24,
    "text": "這是很多中量人正在經歷的"
  },
  {
    "start": 19.24,
    "end": 20.48,
    "text": "中產困境"
  },
  {
    "start": 20.48,
    "end": 21.88,
    "text": "看起來像中產"
  },
  {
    "start": 21.88,
    "end": 23.52,
    "text": "過去來卻想越公族"
  },
  {
    "start": 23.52,
    "end": 25.32,
    "text": "這類人有一個詐心的名字"
  },
  {
    "start": 25.32,
    "end": 27.12,
    "text": "引型平困中產"
  },
  {
    "start": 27.12,
    "end": 29.24,
    "text": "引型平困中產不是窮"
  },
  {
    "start": 29.24,
    "end": 32.0,
    "text": "而是沒有現金流支配權的體面人"
  },
  {
    "start": 32.0,
    "end": 34.04,
    "text": "他們通常有三種特徵"
  },
  {
    "start": 34.04,
    "end": 35.64,
    "text": "第一就是收入不低"
  },
  {
    "start": 35.64,
    "end": 37.16,
    "text": "但是重款席國"
  },
  {
    "start": 37.16,
    "end": 38.28,
    "text": "你問他年輕多少"
  },
  {
    "start": 38.28,
    "end": 39.32,
    "text": "實際20萬"
  },
  {
    "start": 39.32,
    "end": 40.92,
    "text": "你問他銀行卡予額"
  },
  {
    "start": 40.92,
    "end": 43.08,
    "text": "小幾萬塊錢都不一定有"
  },
  {
    "start": 43.08,
    "end": 45.56,
    "text": "越越有盡脹單賬少永遠間地"
  },
  {
    "start": 45.56,
    "end": 46.68,
    "text": "不令溫亂花錢"
  },
  {
    "start": 46.68,
    "end": 48.44,
    "text": "而是家庭之出想黑洞"
  },
  {
    "start": 48.44,
    "end": 49.0,
    "text": "第二"
  },
  {
    "start": 49.0,
    "end": 49.88,
    "text": "資產多少"
  },
  {
    "start": 49.88,
    "end": 51.0,
    "text": "但流動性差"
  },
  {
    "start": 51.0,
    "end": 51.76,
    "text": "有房"
  },
  {
    "start": 51.76,
    "end": 53.48,
    "text": "有車也有"
  },
  {
    "start": 53.48,
    "end": 55.16,
    "text": "但房不能賣車不能洞"
  },
  {
    "start": 55.16,
    "end": 56.44,
    "text": "手裡卻連一萬塊的"
  },
  {
    "start": 56.44,
    "end": 57.64,
    "text": "被用經濟逃不出"
  },
  {
    "start": 57.64,
    "end": 58.76,
    "text": "表面光線"
  },
  {
    "start": 58.76,
    "end": 60.36,
    "text": "十則日意帥九歲"
  },
  {
    "start": 60.36,
    "end": 60.76,
    "text": "第三"
  },
  {
    "start": 60.76,
    "end": 61.76,
    "text": "情緒交律"
  },
  {
    "start": 61.76,
    "end": 62.76,
    "text": "風箭機高"
  },
  {
    "start": 62.76,
    "end": 63.44,
    "text": "怕蔡雲"
  },
  {
    "start": 63.44,
    "end": 64.16,
    "text": "怕生病"
  },
  {
    "start": 64.16,
    "end": 65.48,
    "text": "怕父母突然有事"
  },
  {
    "start": 65.48,
    "end": 66.76,
    "text": "怕孩子學費交不上"
  },
  {
    "start": 66.76,
    "end": 68.44,
    "text": "怕過不了下個月"
  },
  {
    "start": 68.44,
    "end": 69.24,
    "text": "有錢的生活"
  },
  {
    "start": 69.24,
    "end": 70.04,
    "text": "靠富戰城"
  },
  {
    "start": 70.04,
    "end": 72.2,
    "text": "人沒錢的日子卻不能說過"
  },
  {
    "start": 72.2,
    "end": 73.6,
    "text": "能為什麼會這樣"
  },
  {
    "start": 73.6,
    "end": 75.16,
    "text": "這並不是個人的懶奪"
  },
  {
    "start": 75.16,
    "end": 76.88,
    "text": "而是一種結構心錯位"
  },
  {
    "start": 76.88,
    "end": 78.76,
    "text": "首先是家庭之出超佩"
  },
  {
    "start": 78.76,
    "end": 80.12,
    "text": "孩子的教育投資"
  },
  {
    "start": 80.12,
    "end": 82.76,
    "text": "家裡的住房大塊車帶老人善養"
  },
  {
    "start": 82.76,
    "end": 84.52,
    "text": "甚至家上不斷上漲的水電"
  },
  {
    "start": 84.52,
    "end": 85.4,
    "text": "人氣費"
  },
  {
    "start": 85.4,
    "end": 87.08,
    "text": "必須花的日子越多"
  },
  {
    "start": 87.08,
    "end": 88.68,
    "text": "能留住的越來越少"
  },
  {
    "start": 88.68,
    "end": 90.92,
    "text": "其次身份交律驅動消費"
  },
  {
    "start": 90.92,
    "end": 91.76,
    "text": "不能說"
  },
  {
    "start": 91.76,
    "end": 92.76,
    "text": "要穿的體面"
  },
  {
    "start": 92.76,
    "end": 93.64,
    "text": "孩子不能差"
  },
  {
    "start": 93.64,
    "end": 95.84,
    "text": "要配上高端手機品牌包包"
  },
  {
    "start": 95.84,
    "end": 97.56,
    "text": "可這些之出最多才發現"
  },
  {
    "start": 97.56,
    "end": 98.84,
    "text": "換來的不是安全感"
  },
  {
    "start": 98.84,
    "end": 100.0,
    "text": "而是疲備感"
  },
  {
    "start": 100.0,
    "end": 101.8,
    "text": "第三收入結果過於單一"
  },
  {
    "start": 101.8,
    "end": 103.12,
    "text": "一個工作養全家"
  },
  {
    "start": 103.12,
    "end": 105.0,
    "text": "一旦變顧就全面談話"
  },
  {
    "start": 105.0,
    "end": 105.88,
    "text": "沒有復收入"
  },
  {
    "start": 105.88,
    "end": 107.64,
    "text": "或被動收入都底的能力"
  },
  {
    "start": 107.64,
    "end": 108.68,
    "text": "那該怎麼辦呢"
  },
  {
    "start": 108.68,
    "end": 109.56,
    "text": "可以找個實際上"
  },
  {
    "start": 109.56,
    "end": 110.84,
    "text": "好好地理理思路"
  },
  {
    "start": 110.84,
    "end": 112.36,
    "text": "先從現金流體解"
  },
  {
    "start": 112.36,
    "end": 114.6,
    "text": "才輸離你家的所有之出"
  },
  {
    "start": 114.6,
    "end": 116.36,
    "text": "區分鋼區與面子"
  },
  {
    "start": 116.36,
    "end": 117.8,
    "text": "建立三到六個月的"
  },
  {
    "start": 117.8,
    "end": 119.16,
    "text": "印級經責戶"
  },
  {
    "start": 119.16,
    "end": 121.36,
    "text": "其實很多人沒有預備經的概念"
  },
  {
    "start": 121.36,
    "end": 122.04,
    "text": "不介紹"
  },
  {
    "start": 122.04,
    "end": 122.72,
    "text": "不預算"
  },
  {
    "start": 122.72,
    "end": 124.2,
    "text": "也沒有印級儲備"
  },
  {
    "start": 124.2,
    "end": 125.8,
    "text": "理財不是投資報復"
  },
  {
    "start": 125.8,
    "end": 127.52,
    "text": "而是降低口距"
  },
  {
    "start": 127.52,
    "end": 129.68,
    "text": "安全感不是來自正多少"
  },
  {
    "start": 129.68,
    "end": 130.76,
    "text": "而是漲過多少"
  },
  {
    "start": 130.76,
    "end": 132.72,
    "text": "慢慢夠見多個收入區"
  },
  {
    "start": 132.72,
    "end": 134.16,
    "text": "別把全家安全感"
  },
  {
    "start": 134.16,
    "end": 135.92,
    "text": "壓在一個工資單上"
  },
  {
    "start": 135.92,
    "end": 137.16,
    "text": "這事不能極"
  },
  {
    "start": 137.16,
    "end": 137.88,
    "text": "不能想著"
  },
  {
    "start": 137.88,
    "end": 138.92,
    "text": "重經買股票"
  },
  {
    "start": 138.92,
    "end": 140.84,
    "text": "或者是搞個不熟悉的投資項目"
  },
  {
    "start": 140.84,
    "end": 142.04,
    "text": "換搭業報復"
  },
  {
    "start": 142.04,
    "end": 142.96,
    "text": "那風險太大"
  },
  {
    "start": 142.96,
    "end": 144.04,
    "text": "對於普通家定來說"
  },
  {
    "start": 144.04,
    "end": 144.76,
    "text": "沒有必要"
  },
  {
    "start": 144.76,
    "end": 145.84,
    "text": "而且看原這事"
  },
  {
    "start": 145.84,
    "end": 147.24,
    "text": "不能及著一部道位"
  },
  {
    "start": 147.24,
    "end": 148.6,
    "text": "主要是機少成多"
  },
  {
    "start": 148.6,
    "end": 150.64,
    "text": "要根據實際情況慢慢來"
  },
  {
    "start": 150.64,
    "end": 152.16,
    "text": "那現在有沒有感覺"
  },
  {
    "start": 152.16,
    "end": 153.52,
    "text": "表面過的群內心"
  },
  {
    "start": 153.52,
    "end": 154.68,
    "text": "卻越來越累"
  },
  {
    "start": 154.68,
    "end": 156.28,
    "text": "你有沒有認真算過"
  },
  {
    "start": 156.28,
    "end": 157.88,
    "text": "如果斷收入三個月"
  },
  {
    "start": 157.88,
    "end": 159.48,
    "text": "你們家還能成多久呢"
  }
]