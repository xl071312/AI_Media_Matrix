[
  {
    "start": 0.0,
    "end": 1.44,
    "text": "一个13最女孩"
  },
  {
    "start": 1.44,
    "end": 2.56,
    "text": "女后不会变成"
  },
  {
    "start": 2.56,
    "end": 5.08,
    "text": "靠Ai34天做出一个产品"
  },
  {
    "start": 5.08,
    "end": 6.8,
    "text": "3天上了1.8万了"
  },
  {
    "start": 6.8,
    "end": 8.76,
    "text": "我觉得这件事真正大的"
  },
  {
    "start": 8.76,
    "end": 10.44,
    "text": "不是一个小孩会赚钱"
  },
  {
    "start": 10.44,
    "end": 11.8,
    "text": "而是Ai10代"
  },
  {
    "start": 11.8,
    "end": 13.28,
    "text": "我同样做产品的门坛"
  },
  {
    "start": 13.28,
    "end": 14.72,
    "text": "正在被直接打穿"
  },
  {
    "start": 14.72,
    "end": 16.16,
    "text": "你看他做的这个网页"
  },
  {
    "start": 16.16,
    "end": 17.76,
    "text": "上产品让妈妈的照片"
  },
  {
    "start": 17.76,
    "end": 18.96,
    "text": "题目里就做了一个"
  },
  {
    "start": 18.96,
    "end": 19.72,
    "text": "区你家的"
  },
  {
    "start": 19.72,
    "end": 21.04,
    "text": "你偷偷玩手机"
  },
  {
    "start": 21.04,
    "end": 22.08,
    "text": "他会提醒你"
  },
  {
    "start": 22.08,
    "end": 23.12,
    "text": "你离开作为"
  },
  {
    "start": 23.12,
    "end": 23.96,
    "text": "他也知道"
  },
  {
    "start": 23.96,
    "end": 25.48,
    "text": "一场刺激结束以后"
  },
  {
    "start": 25.48,
    "end": 27.44,
    "text": "还能生成一份专注力报告"
  },
  {
    "start": 27.44,
    "end": 28.96,
    "text": "做出这个产品的人"
  },
  {
    "start": 28.96,
    "end": 30.04,
    "text": "不是程序原"
  },
  {
    "start": 30.04,
    "end": 31.2,
    "text": "也不是创演老手"
  },
  {
    "start": 31.2,
    "end": 34.32,
    "text": "而是上海一个刚上创了13最女孩"
  },
  {
    "start": 34.32,
    "end": 35.04,
    "text": "前几天"
  },
  {
    "start": 35.04,
    "end": 36.36,
    "text": "他在国内参加了一场"
  },
  {
    "start": 36.36,
    "end": 37.8,
    "text": "很特别的Ai比赛"
  },
  {
    "start": 37.8,
    "end": 39.16,
    "text": "这张比赛没有平委"
  },
  {
    "start": 39.16,
    "end": 41.52,
    "text": "不看PBT也不听你讲故事"
  },
  {
    "start": 41.52,
    "end": 43.08,
    "text": "唯一的财务就是用户"
  },
  {
    "start": 43.08,
    "end": 44.84,
    "text": "谁能让真实用户套钱"
  },
  {
    "start": 44.84,
    "end": 45.64,
    "text": "谁就赢"
  },
  {
    "start": 45.64,
    "end": 47.6,
    "text": "结果50多个团队一期比赛"
  },
  {
    "start": 47.6,
    "end": 48.52,
    "text": "他拿了进军"
  },
  {
    "start": 48.52,
    "end": 50.52,
    "text": "产品3天卖出进90分"
  },
  {
    "start": 50.52,
    "end": 52.32,
    "text": "并收入超过1.8万元"
  },
  {
    "start": 52.32,
    "end": 53.8,
    "text": "是市场真金白银"
  },
  {
    "start": 53.8,
    "end": 54.4,
    "text": "投的票"
  },
  {
    "start": 54.4,
    "end": 55.8,
    "text": "对别把这当成一个"
  },
  {
    "start": 55.8,
    "end": 57.36,
    "text": "神同做作业的故事"
  },
  {
    "start": 57.36,
    "end": 58.36,
    "text": "他为什么会想到"
  },
  {
    "start": 58.36,
    "end": 59.08,
    "text": "这个产品"
  },
  {
    "start": 59.08,
    "end": 60.52,
    "text": "据说原因他被检单"
  },
  {
    "start": 60.52,
    "end": 61.76,
    "text": "因为他自己写作业"
  },
  {
    "start": 61.76,
    "end": 62.72,
    "text": "也会分寻"
  },
  {
    "start": 62.72,
    "end": 64.2,
    "text": "也会忍不住玩手机"
  },
  {
    "start": 64.2,
    "end": 65.36,
    "text": "父母又不可能一直做了"
  },
  {
    "start": 65.36,
    "end": 66.2,
    "text": "旁边冰人"
  },
  {
    "start": 66.2,
    "end": 67.12,
    "text": "于是他就想"
  },
  {
    "start": 67.12,
    "end": 68.92,
    "text": "能不能让Ai替父母"
  },
  {
    "start": 68.92,
    "end": 69.72,
    "text": "做在旁边"
  },
  {
    "start": 69.72,
    "end": 70.92,
    "text": "更返常时的是"
  },
  {
    "start": 70.92,
    "end": 72.36,
    "text": "他几乎不会变成"
  },
  {
    "start": 72.36,
    "end": 74.92,
    "text": "他只是把想法用自然语言告诉Ai"
  },
  {
    "start": 74.92,
    "end": 76.0,
    "text": "我要一个网练"
  },
  {
    "start": 76.0,
    "end": 77.48,
    "text": "可以上层父母照片"
  },
  {
    "start": 77.48,
    "end": 78.28,
    "text": "这样头判的"
  },
  {
    "start": 78.28,
    "end": 79.4,
    "text": "我有沒有玩手机"
  },
  {
    "start": 79.4,
    "end": 80.44,
    "text": "一开作为"
  },
  {
    "start": 80.44,
    "end": 81.92,
    "text": "分析了就温柔提醒"
  },
  {
    "start": 81.92,
    "end": 82.76,
    "text": "学习节素"
  },
  {
    "start": 82.76,
    "end": 84.8,
    "text": "再生成一份专注力报告"
  },
  {
    "start": 84.8,
    "end": 86.16,
    "text": "Ai帮他拆邏机"
  },
  {
    "start": 86.16,
    "end": 86.76,
    "text": "协代嘛"
  },
  {
    "start": 86.76,
    "end": 87.6,
    "text": "改功能"
  },
  {
    "start": 87.6,
    "end": 89.16,
    "text": "他在根据自己的体验"
  },
  {
    "start": 89.16,
    "end": 90.4,
    "text": "一轮一轮调整"
  },
  {
    "start": 90.4,
    "end": 91.28,
    "text": "同一个念头"
  },
  {
    "start": 91.28,
    "end": 92.36,
    "text": "到核心功能"
  },
  {
    "start": 92.36,
    "end": 93.32,
    "text": "真正跑起来"
  },
  {
    "start": 93.32,
    "end": 94.52,
    "text": "只用了三四天"
  },
  {
    "start": 94.52,
    "end": 95.4,
    "text": "帮他以前"
  },
  {
    "start": 95.4,
    "end": 97.2,
    "text": "一个普通人有了产品想法"
  },
  {
    "start": 97.2,
    "end": 98.48,
    "text": "可能第一步就卡在"
  },
  {
    "start": 98.48,
    "end": 99.44,
    "text": "不会写代嘛"
  },
  {
    "start": 99.44,
    "end": 100.24,
    "text": "但今天"
  },
  {
    "start": 100.24,
    "end": 101.6,
    "text": "这篤墙开始怕了"
  },
  {
    "start": 101.6,
    "end": 102.64,
    "text": "不会写代嘛"
  },
  {
    "start": 102.64,
    "end": 103.72,
    "text": "Ai帮你写"
  },
  {
    "start": 103.72,
    "end": 105.48,
    "text": "不会设定Ai帮你搭"
  },
  {
    "start": 105.48,
    "end": 106.56,
    "text": "功能不会拆"
  },
  {
    "start": 106.56,
    "end": 107.72,
    "text": "Ai陪你输立"
  },
  {
    "start": 107.72,
    "end": 108.72,
    "text": "所以我一直说"
  },
  {
    "start": 108.72,
    "end": 111.16,
    "text": "Ai不是让每个人都变成成绩"
  },
  {
    "start": 111.16,
    "end": 112.8,
    "text": "而是让更多人不当成绩"
  },
  {
    "start": 112.8,
    "end": 113.84,
    "text": "也能做产品"
  },
  {
    "start": 113.84,
    "end": 115.16,
    "text": "但他真正厉害的"
  },
  {
    "start": 115.16,
    "end": 117.04,
    "text": "是从自己的生活里抓到了"
  },
  {
    "start": 117.04,
    "end": 118.36,
    "text": "写作业容易分析"
  },
  {
    "start": 118.36,
    "end": 120.56,
    "text": "父母又没法一直陪这个真实问题"
  },
  {
    "start": 120.56,
    "end": 122.36,
    "text": "但因为Ai快速做成产品"
  },
  {
    "start": 122.36,
    "end": 124.28,
    "text": "被我直接认给市场验证"
  },
  {
    "start": 124.28,
    "end": 126.84,
    "text": "对的是我觉得他最值得学习的一点"
  },
  {
    "start": 126.84,
    "end": 127.68,
    "text": "Ai实在"
  },
  {
    "start": 127.68,
    "end": 129.52,
    "text": "真正变直前的不在这"
  },
  {
    "start": 129.52,
    "end": 130.52,
    "text": "我会不会做"
  },
  {
    "start": 130.52,
    "end": 131.88,
    "text": "而是该做什么"
  },
  {
    "start": 131.88,
    "end": 133.56,
    "text": "所以看到一个13岁女孩"
  },
  {
    "start": 133.56,
    "end": 134.96,
    "text": "三天赚1.8万"
  },
  {
    "start": 134.96,
    "end": 136.44,
    "text": "成年人现在最不该做的"
  },
  {
    "start": 136.44,
    "end": 139.04,
    "text": "就是去焦虑现在连小孩都捷不过了"
  },
  {
    "start": 139.04,
    "end": 141.68,
    "text": "而是当一个几乎不会变成的出中生"
  },
  {
    "start": 141.68,
    "end": 143.6,
    "text": "一定开始拿Ai做产品"
  },
  {
    "start": 143.6,
    "end": 144.28,
    "text": "我们还在"
  },
  {
    "start": 144.28,
    "end": 145.72,
    "text": "是拿Ai问问体"
  },
  {
    "start": 145.72,
    "end": 146.52,
    "text": "写周报"
  },
  {
    "start": 146.52,
    "end": 147.68,
    "text": "这才是差距"
  },
  {
    "start": 147.68,
    "end": 149.72,
    "text": "这不是让所有孩子都去创业"
  },
  {
    "start": 149.72,
    "end": 152.64,
    "text": "而是说明Ai正在把过去属于少数"
  },
  {
    "start": 152.64,
    "end": 154.32,
    "text": "专业人士的创造能力"
  },
  {
    "start": 154.32,
    "end": 156.16,
    "text": "叫到越来越多普通人手里"
  },
  {
    "start": 156.16,
    "end": 157.76,
    "text": "你自己有个产品想法"
  },
  {
    "start": 157.76,
    "end": 159.44,
    "text": "也可以先升给那米握"
  },
  {
    "start": 159.44,
    "end": 161.08,
    "text": "让市场专家帮你看看"
  },
  {
    "start": 161.08,
    "end": 162.32,
    "text": "有没有真实需求"
  },
  {
    "start": 162.32,
    "end": 164.12,
    "text": "产品专家帮你拆功能"
  },
  {
    "start": 164.12,
    "end": 165.72,
    "text": "开发专家直接做出"
  },
  {
    "start": 165.72,
    "end": 166.64,
    "text": "能跑的版本"
  },
  {
    "start": 166.64,
    "end": 168.28,
    "text": "再拿给真实用工具市"
  },
  {
    "start": 168.28,
    "end": 170.24,
    "text": "Ai Air降低的是技术门坎"
  },
  {
    "start": 170.24,
    "end": 172.28,
    "text": "但没有降低好想法的价值"
  },
  {
    "start": 172.28,
    "end": 173.24,
    "text": "恰恰相反"
  },
  {
    "start": 173.24,
    "end": 174.76,
    "text": "当做出来越来越容易"
  },
  {
    "start": 174.76,
    "end": 176.08,
    "text": "想清楚做什么"
  },
  {
    "start": 176.08,
    "end": 177.52,
    "text": "反而会越来越值钱"
  },
  {
    "start": 177.52,
    "end": 179.16,
    "text": "最后想问大家一个问题"
  },
  {
    "start": 179.16,
    "end": 181.72,
    "text": "当一个几乎不会变成的13最女孩"
  },
  {
    "start": 181.72,
    "end": 183.84,
    "text": "都能靠Ai把想法变成产品"
  },
  {
    "start": 183.84,
    "end": 184.96,
    "text": "你有什么想法"
  },
  {
    "start": 184.96,
    "end": 186.76,
    "text": "想要借助智能体实现"
  },
  {
    "start": 186.76,
    "end": 187.84,
    "text": "产品论区聊聊"
  }
]