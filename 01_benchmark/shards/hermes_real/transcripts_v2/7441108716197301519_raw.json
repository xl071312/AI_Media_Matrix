[
  {
    "start": 0.02,
    "end": 2.86,
    "text": "創業是反平的首要因素"
  },
  {
    "start": 2.86,
    "end": 5.26,
    "text": "這句話聽起來或許有些刺耳"
  },
  {
    "start": 5.26,
    "end": 9.78,
    "text": "但背後卻隱藏著無數創業者的心酸與教學"
  },
  {
    "start": 9.78,
    "end": 10.98,
    "text": "一可能不信"
  },
  {
    "start": 10.98,
    "end": 12.74,
    "text": "但我還是要告訴你"
  },
  {
    "start": 12.74,
    "end": 13.98,
    "text": "現實中的創業"
  },
  {
    "start": 13.98,
    "end": 16.38,
    "text": "原比我們想像的更加殘酷"
  },
  {
    "start": 16.38,
    "end": 17.54,
    "text": "對於數據統計"
  },
  {
    "start": 17.54,
    "end": 18.82,
    "text": "創業的失敗率"
  },
  {
    "start": 18.82,
    "end": 20.74,
    "text": "高達70%以上"
  },
  {
    "start": 20.74,
    "end": 22.66,
    "text": "中國平均的企業的收兵"
  },
  {
    "start": 22.66,
    "end": 23.66,
    "text": "不足3年"
  },
  {
    "start": 23.66,
    "end": 25.34,
    "text": "跟令人震驚的是"
  },
  {
    "start": 25.34,
    "end": 26.94,
    "text": "有7成的企業"
  },
  {
    "start": 26.94,
    "end": 28.94,
    "text": "甚至年1年都毆不過"
  },
  {
    "start": 28.94,
    "end": 30.82,
    "text": "而對於馬懷基金"
  },
  {
    "start": 30.82,
    "end": 32.82,
    "text": "與夢想的大學生創業來說"
  },
  {
    "start": 32.82,
    "end": 33.62,
    "text": "失敗率"
  },
  {
    "start": 33.62,
    "end": 36.34,
    "text": "更是高達90%以上"
  },
  {
    "start": 36.34,
    "end": 38.02,
    "text": "面對這樣的數據"
  },
  {
    "start": 38.02,
    "end": 39.42,
    "text": "你是否都創業"
  },
  {
    "start": 39.42,
    "end": 41.62,
    "text": "才是一絲猶豫與恐懼"
  },
  {
    "start": 41.62,
    "end": 43.5,
    "text": "所以我想告訴你"
  },
  {
    "start": 43.5,
    "end": 45.7,
    "text": "千萬不要馬物創業"
  },
  {
    "start": 45.7,
    "end": 48.1,
    "text": "不然只會是一條不歸路"
  },
  {
    "start": 48.1,
    "end": 48.86,
    "text": "但是"
  },
  {
    "start": 48.86,
    "end": 50.7,
    "text": "如果你懷著對於財富"
  },
  {
    "start": 50.7,
    "end": 53.1,
    "text": "和打破接策的無限的可望"
  },
  {
    "start": 53.1,
    "end": 54.62,
    "text": "你必須要創業"
  },
  {
    "start": 54.62,
    "end": 55.82,
    "text": "那我確定"
  },
  {
    "start": 55.82,
    "end": 58.62,
    "text": "一定要讓人帶著你的帶"
  },
  {
    "start": 58.62,
    "end": 60.94,
    "text": "可不是簡單的資金原住"
  },
  {
    "start": 60.94,
    "end": 62.42,
    "text": "或是口頭鼓勵"
  },
  {
    "start": 62.42,
    "end": 64.66,
    "text": "而是只擁有成功的經驗"
  },
  {
    "start": 64.66,
    "end": 66.34,
    "text": "成熟的體系的合作"
  },
  {
    "start": 66.34,
    "end": 67.38,
    "text": "我辦的贏力"
  },
  {
    "start": 67.38,
    "end": 69.78,
    "text": "那些擁有成功經驗的創業者"
  },
  {
    "start": 69.78,
    "end": 72.1,
    "text": "經歷過的創業的種種計算"
  },
  {
    "start": 72.1,
    "end": 73.14,
    "text": "他們知道"
  },
  {
    "start": 73.14,
    "end": 74.94,
    "text": "在創業的不同階段"
  },
  {
    "start": 74.94,
    "end": 76.94,
    "text": "應該如何調整策略"
  },
  {
    "start": 76.94,
    "end": 78.58,
    "text": "如何優化團隊"
  },
  {
    "start": 78.58,
    "end": 80.22,
    "text": "如何托著市場"
  },
  {
    "start": 80.22,
    "end": 81.42,
    "text": "他們的體系"
  },
  {
    "start": 81.42,
    "end": 83.06,
    "text": "是無所謂試驗"
  },
  {
    "start": 83.06,
    "end": 85.14,
    "text": "與跌帶後的結果"
  },
  {
    "start": 85.14,
    "end": 87.58,
    "text": "能夠幫助你走過太多的溫度"
  },
  {
    "start": 87.58,
    "end": 89.18,
    "text": "所以當你決定"
  },
  {
    "start": 89.18,
    "end": 90.86,
    "text": "他上創業之入時"
  },
  {
    "start": 90.86,
    "end": 92.66,
    "text": "不防先尋找一位"
  },
  {
    "start": 92.66,
    "end": 93.78,
    "text": "這樣的導師"
  },
  {
    "start": 93.78,
    "end": 94.78,
    "text": "或者合作後半"
  },
  {
    "start": 94.78,
    "end": 96.58,
    "text": "他們可以順利的朋友"
  },
  {
    "start": 96.58,
    "end": 97.46,
    "text": "前輩"
  },
  {
    "start": 97.46,
    "end": 99.62,
    "text": "也可以是行業力的專家"
  },
  {
    "start": 99.62,
    "end": 100.46,
    "text": "記住"
  },
  {
    "start": 100.46,
    "end": 102.38,
    "text": "不要害怕向他人請教"
  },
  {
    "start": 102.38,
    "end": 104.66,
    "text": "不要休一展示自己的步促"
  },
  {
    "start": 104.66,
    "end": 106.66,
    "text": "因為真正的成長"
  },
  {
    "start": 106.66,
    "end": 109.06,
    "text": "往往來自於不斷的學習"
  },
  {
    "start": 109.06,
    "end": 109.9,
    "text": "與改進"
  },
  {
    "start": 109.9,
    "end": 112.42,
    "text": "創業是一場漫長的旅程"
  },
  {
    "start": 112.42,
    "end": 114.54,
    "text": "也是一隻深刻的自我探索"
  },
  {
    "start": 114.54,
    "end": 115.46,
    "text": "有人帶"
  },
  {
    "start": 115.46,
    "end": 116.9,
    "text": "你可以走得更穩"
  },
  {
    "start": 116.9,
    "end": 117.94,
    "text": "走得更遠"
  },
  {
    "start": 117.94,
    "end": 118.94,
    "text": "非等更高"
  },
  {
    "start": 118.94,
    "end": 119.98,
    "text": "願每一位"
  },
  {
    "start": 119.98,
    "end": 121.86,
    "text": "懷拳夢想的創業者"
  },
  {
    "start": 121.86,
    "end": 123.86,
    "text": "都能在創意的道路上"
  },
  {
    "start": 123.86,
    "end": 126.54,
    "text": "尋找到屬於自己的旅行者"
  },
  {
    "start": 126.54,
    "end": 128.78,
    "text": "共同實相成功的比案"
  }
]