    "end": 236.64,
    "text": "发到各个平台"
  },
  {
    "start": 236.64,
    "end": 238.52,
    "text": "占号内可以接管变现"
  },
  {
    "start": 238.52,
    "end": 239.36,
    "text": "也可以卖书"
  },
  {
    "start": 239.36,
    "end": 240.88,
    "text": "然后自己是没有什么问题的"
  },
  {
    "start": 240.88,
    "end": 241.84,
    "text": "18检视频"
  },
  {
    "start": 241.84,
    "end": 242.48,
    "text": "短视频时道"
  },
  {
    "start": 242.48,
    "end": 243.88,
    "text": "做剑机很有前几"
  },
  {
    "start": 243.88,
    "end": 245.12,
    "text": "每一个博主都需要"
  },
  {
    "start": 245.12,
    "end": 246.48,
    "text": "我们公司临利后"
  },
  {
    "start": 246.48,
    "end": 248.32,
    "text": "净净是也是越入一万家"
  },
  {
    "start": 248.32,
    "end": 249.84,
    "text": "还有粉丝做我们的芡片"
  },
  {
    "start": 249.84,
    "end": 251.24,
    "text": "单约长粉一万多"
  },
  {
    "start": 251.24,
    "end": 251.56,
    "text": "每天就说"
  },
  {
    "start": 251.56,
    "end": 252.52,
    "text": "花个百小时"
  },
  {
    "start": 252.52,
    "end": 254.92,
    "text": "一个视频能可以进时到几百的收入不等"
  },
  {
    "start": 254.92,
    "end": 255.96,
    "text": "十足卖佛珠"
  },
  {
    "start": 255.96,
    "end": 256.96,
    "text": "我看到江阵一点"
  },
  {
    "start": 256.96,
    "end": 258.2,
    "text": "有人直播四面的名义"
  },
  {
    "start": 258.2,
    "end": 258.8,
    "text": "一些情况"
  },
  {
    "start": 258.8,
    "end": 260.68,
    "text": "然后能用佛珠穿着手脸"
  },
  {
    "start": 260.68,
    "end": 261.48,
    "text": "或者说散练"
  },
  {
    "start": 261.48,
    "end": 263.24,
    "text": "能够卖100多块钱一条"
  },
  {
    "start": 263.24,
    "end": 263.96,
    "text": "一无这个东西"
  },
  {
    "start": 263.96,
    "end": 265.56,
    "text": "成本也都实惯先不断了"
  },
  {
    "start": 265.56,
    "end": 266.16,
    "text": "二十"
  },
  {
    "start": 266.16,
    "end": 266.8,
    "text": "做带构"
  },
  {
    "start": 266.8,
    "end": 267.96,
    "text": "分享各部过程"
  },
  {
    "start": 267.96,
    "end": 268.76,
    "text": "每天当就翻译"
  },
  {
    "start": 268.76,
    "end": 269.84,
    "text": "去买的视频笔记"
  },
  {
    "start": 269.84,
    "end": 270.92,
    "text": "然后把闻完洗好"
  },
  {
    "start": 270.92,
    "end": 272.08,
    "text": "再发发十拍图"
  },
  {
    "start": 272.08,
    "end": 272.84,
    "text": "既然当之后"
