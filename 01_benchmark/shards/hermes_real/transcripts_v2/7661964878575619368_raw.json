[
  {
    "start": 0.0,
    "end": 2.52,
    "text": "存錢比政權重要一萬倍"
  },
  {
    "start": 2.52,
    "end": 5.04,
    "text": "如果你不會存錢只會正錢的話"
  },
  {
    "start": 5.04,
    "end": 5.88,
    "text": "那便如同"
  },
  {
    "start": 5.88,
    "end": 8.4,
    "text": "猴子下山加育米邊摘邊丟"
  },
  {
    "start": 8.4,
    "end": 10.04,
    "text": "到最後什麼也留不住"
  },
  {
    "start": 10.04,
    "end": 11.88,
    "text": "只能成為財富的過渴"
  },
  {
    "start": 11.88,
    "end": 14.96,
    "text": "錢一旦花出去就很難再回到你的口袋"
  },
  {
    "start": 14.96,
    "end": 17.6,
    "text": "就像一頭活著被送進腳肉機"
  },
  {
    "start": 17.6,
    "end": 19.52,
    "text": "出來以後變成了肉腸"
  },
  {
    "start": 19.52,
    "end": 22.88,
    "text": "你永遠不可能再把肉腸還原成一頭豬"
  },
  {
    "start": 22.88,
    "end": 25.92,
    "text": "花錢容易在錢卻越來越難"
  },
  {
    "start": 25.92,
    "end": 28.28,
    "text": "尤其是在當下的經濟環境裡"
  },
  {
    "start": 28.28,
    "end": 30.24,
    "text": "真正存下十萬塊錢"
  },
  {
    "start": 30.24,
    "end": 32.72,
    "text": "很多時候比賺到十萬塊錢更難"
  },
  {
    "start": 32.72,
    "end": 34.4,
    "text": "因為賺錢靠能力"
  },
  {
    "start": 34.4,
    "end": 35.84,
    "text": "存錢靠自律"
  },
  {
    "start": 35.84,
    "end": 38.68,
    "text": "而真正拉開人與人財富差距的"
  },
  {
    "start": 38.68,
    "end": 39.92,
    "text": "往往不是收入"
  },
  {
    "start": 39.92,
    "end": 41.88,
    "text": "而是能不能把錢留下"
  },
  {
    "start": 41.88,
    "end": 43.68,
    "text": "所以衣服協子還能穿"
  },
  {
    "start": 43.68,
    "end": 45.08,
    "text": "就別急著換新的"
  },
  {
    "start": 45.08,
    "end": 46.72,
    "text": "一日三餐能自己做"
  },
  {
    "start": 46.72,
    "end": 48.28,
    "text": "就盡量少點外賣"
  },
  {
    "start": 48.28,
    "end": 50.12,
    "text": "所有不是剛需的消費"
  },
  {
    "start": 50.12,
    "end": 51.92,
    "text": "都盡可能往後放放"
  },
  {
    "start": 51.92,
    "end": 54.16,
    "text": "把每一筆不必要的支出砍掉"
  },
  {
    "start": 54.16,
    "end": 55.88,
    "text": "你的錢包才會越來越厚"
  },
  {
    "start": 55.88,
    "end": 56.96,
    "text": "家裡有存款"
  },
  {
    "start": 56.96,
    "end": 58.72,
    "text": "遇到風險才不會慌"
  },
  {
    "start": 58.72,
    "end": 59.92,
    "text": "賬戶有餘兒"
  },
  {
    "start": 59.92,
    "end": 61.84,
    "text": "面對機會才有底氣"
  },
  {
    "start": 61.84,
    "end": 63.76,
    "text": "存錢從來都不是消息"
  },
  {
    "start": 63.76,
    "end": 65.6,
    "text": "而是再給未來的自己"
  },
  {
    "start": 65.6,
    "end": 66.8,
    "text": "激勵選擇權"
  },
  {
    "start": 66.8,
    "end": 67.96,
    "text": "更重要的是"
  },
  {
    "start": 67.96,
    "end": 69.56,
    "text": "存錢不是終點"
  },
  {
    "start": 69.56,
    "end": 71.96,
    "text": "而是財富增長的企業"
  },
  {
    "start": 71.96,
    "end": 74.2,
    "text": "你今天審下來的每一份錢"
  },
  {
    "start": 74.2,
    "end": 77.04,
    "text": "都可能成為未來產生收益的本金"
  },
  {
    "start": 77.04,
    "end": 78.48,
    "text": "當本金越來越大"
  },
  {
    "start": 78.48,
    "end": 81.36,
    "text": "負力才有機會真正發揮作誼"
  },
  {
    "start": 81.36,
    "end": 83.2,
    "text": "所以真正厲害的人"
  },
  {
    "start": 83.2,
    "end": 84.6,
    "text": "不只會賺錢"
  },
  {
    "start": 84.6,
    "end": 86.16,
    "text": "更懂得手助錢"
  },
  {
    "start": 86.16,
    "end": 88.36,
    "text": "能夠刻志越往控制消費"
  },
  {
    "start": 88.36,
    "end": 90.12,
    "text": "理性管理每一份錢"
  },
  {
    "start": 90.12,
    "end": 91.72,
    "text": "本身就是一種吸缺"
  },
  {
    "start": 91.72,
    "end": 93.0,
    "text": "且高級的能力"
  }
]