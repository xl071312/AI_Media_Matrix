    "start": 616.68,
    "end": 617.76,
    "text": "是来搞钱的"
  },
  {
    "start": 617.76,
    "end": 619.08,
    "text": "不是来读命的"
  },
  {
    "start": 619.08,
    "end": 620.08,
    "text": "不要听那种"
  },
  {
    "start": 620.08,
    "end": 621.04,
    "text": "什么不可以不乐"
  },
  {
    "start": 621.04,
    "end": 623.24,
    "text": "单车变名的拖的这种说辞"
  },
  {
    "start": 623.24,
    "end": 624.48,
    "text": "讲到这里"
  },
  {
    "start": 624.48,
    "end": 627.04,
    "text": "估计平常局劲有人要开盆了"
  },
  {
    "start": 627.04,
    "end": 628.44,
    "text": "很多人可能要说"
  },
  {
    "start": 628.44,
    "end": 630.56,
    "text": "说你看我十年前买的这个金市"
  },
  {
    "start": 630.56,
    "end": 632.12,
    "text": "现在也翻贝了对吧"
  },
  {
    "start": 632.12,
    "end": 633.24,
    "text": "对于这种言论"
  },
  {
    "start": 633.24,
    "end": 634.0,
    "text": "我只能说"
  },
  {
    "start": 634.0,
    "end": 635.64,
    "text": "那你回到十年前去吧"
  },
  {
    "start": 635.64,
    "end": 637.6,
    "text": "此一时比一时对吧"
  },
  {
    "start": 637.6,
    "end": 638.96,
    "text": "如果你当时买金条"
  },
  {
    "start": 638.96,
    "end": 639.76,
    "text": "那你现在呢"
  },
  {
    "start": 639.76,
    "end": 641.4,
    "text": "赚出一辆车了可能"
  },
  {
    "start": 641.4,
    "end": 643.24,
    "text": "收到这好问你个问题"
  },
  {
    "start": 643.24,
    "end": 645.36,
    "text": "如果你手里有50克的黄金"
  },
  {
    "start": 645.36,
    "end": 646.04,
    "text": "你是选择"
  },
  {
    "start": 646.04,
    "end": 646.96,
    "text": "把他卖掉"
  },
  {
    "start": 646.96,
    "end": 647.84,
    "text": "落代为安"
  },
  {
    "start": 647.84,
    "end": 649.12,
    "text": "还是继续拿着赌"
  },
  {
    "start": 649.12,
    "end": 651.56,
    "text": "赌他还能往上冲到六千"
  },
  {
    "start": 651.56,
    "end": 653.12,
    "text": "我们来接着留一下"
  },
  {
    "start": 653.12,
    "end": 654.72,
    "text": "最后送大家一段话"
  },
  {
    "start": 654.72,
    "end": 656.68,
    "text": "就是在这个动荡时代"
  },
  {
    "start": 656.68,
    "end": 658.44,
    "text": "黄金不仅仅是金属"
  },
  {
    "start": 658.44,
    "end": 661.92,
    "text": "还是人性坦南跟恐惧的宁节物"
  },
  {
    "start": 661.92,
    "end": 663.6,
    "text": "我们努力赚钱不是为了"
  },
  {
    "start": 663.6,
    "end": 666.24,
    "text": "追逐那些虚无飘秒的数字有限"
  },
  {
    "start": 666.24,
    "end": 668.08,
    "text": "而是为了这场播风雨"
  },
  {
    "start": 668.08,
    "end": 669.52,
    "text": "避免他在来的时候"
  },
  {
    "start": 669.52,
    "end": 670.04,
    "text": "对吧"
  },
  {
    "start": 670.04,
    "end": 672.24,
    "text": "我们手里没有什么东西"
  },
  {
    "start": 672.24,
    "end": 673.96,
    "text": "可以这个风党雨"
  },
  {
    "start": 673.96,
    "end": 676.96,
    "text": "不要做那个潮水退去的时候"
  },
  {
    "start": 676.96,
    "end": 678.04,
    "text": "罗永的人"
  },
  {
    "start": 678.04,
    "end": 679.52,
    "text": "我们要看清局势"
  },
  {
    "start": 679.52,
    "end": 680.6,
    "text": "无仅口袋"
  },
  {
    "start": 680.6,
    "end": 682.12,
    "text": "继续结果被收割"
  },
  {
    "start": 682.12,
    "end": 683.16,
    "text": "好 我是爱与系"
  },
  {
    "start": 683.16,
    "end": 684.84,
    "text": "带你能用机一融四位"
  },
  {
    "start": 684.84,
    "end": 686.72,
    "text": "差点更多的底层逻辑"
  },
  {
    "start": 686.72,
    "end": 687.48,
    "text": "点了关注"
  },
  {
    "start": 687.48,
    "end": 689.32,
    "text": "带你看透更多的真相"
  },
  {
    "start": 689.32,
    "end": 690.2,
    "text": "下期视频"
  },
  {
    "start": 690.2,
    "end": 691.96,
    "text": "我会告诉你除了黄金"
  },
  {
    "start": 691.96,
    "end": 693.32,
    "text": "还有哪一样东西"
  },
  {
    "start": 693.32,
    "end": 696.2,
    "text": "正在敲敲的把中产细节一空"
  },
  {
    "start": 696.2,
    "end": 697.04,
    "text": "而你呢"
  },
  {
    "start": 697.04,
    "end": 698.2,
    "text": "每天都在用它"
  }
]