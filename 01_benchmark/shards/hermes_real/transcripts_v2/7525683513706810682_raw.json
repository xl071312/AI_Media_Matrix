[
  {
    "start": 0.0,
    "end": 2.44,
    "text": "七个关于赚钱的铁率"
  },
  {
    "start": 2.44,
    "end": 5.08,
    "text": "是我们几代温州人的心血"
  },
  {
    "start": 5.08,
    "end": 6.84,
    "text": "有一点点露鼓"
  },
  {
    "start": 6.84,
    "end": 8.32,
    "text": "希望"
  },
  {
    "start": 8.32,
    "end": 10.96,
    "text": "希望你可以记下新来认真的"
  },
  {
    "start": 10.96,
    "end": 11.92,
    "text": "今晚"
  },
  {
    "start": 11.92,
    "end": 13.6,
    "text": "如果听不懂"
  },
  {
    "start": 13.6,
    "end": 16.6,
    "text": "可以多来几次"
  },
  {
    "start": 16.6,
    "end": 18.8,
    "text": "可以多听几次"
  },
  {
    "start": 21.8,
    "end": 22.96,
    "text": "一"
  },
  {
    "start": 22.96,
    "end": 24.560000000000002,
    "text": "读书和学习"
  },
  {
    "start": 24.560000000000002,
    "end": 27.52,
    "text": "是两号完全不永不一样的逻辑"
  },
  {
    "start": 27.52,
    "end": 28.92,
    "text": "你会发现"
  },
  {
    "start": 29.080000000000002,
    "end": 32.440000000000005,
    "text": "那些考试非常厉害的释放"
  },
  {
    "start": 32.440000000000005,
    "end": 33.84,
    "text": "读书会以后"
  },
  {
    "start": 33.84,
    "end": 35.04,
    "text": "赚钱的能力"
  },
  {
    "start": 35.04,
    "end": 37.0,
    "text": "还不如那些写账"
  },
  {
    "start": 37.0,
    "end": 40.120000000000005,
    "text": "学校和社会最大的区别就是"
  },
  {
    "start": 40.120000000000005,
    "end": 42.2,
    "text": "学校里面考试是毕端的"
  },
  {
    "start": 42.2,
    "end": 43.760000000000005,
    "text": "不允许潮"
  },
  {
    "start": 43.760000000000005,
    "end": 46.480000000000004,
    "text": "社会这个考场"
  },
  {
    "start": 46.480000000000004,
    "end": 48.2,
    "text": "好事实开简的"
  },
  {
    "start": 48.2,
    "end": 50.0,
    "text": "你可以随时是去潮"
  },
  {
    "start": 50.0,
    "end": 52.32000000000001,
    "text": "优等深的那个答案"
  },
  {
    "start": 52.32000000000001,
    "end": 53.32000000000001,
    "text": "可以"
  },
  {
    "start": 53.32000000000001,
    "end": 55.120000000000005,
    "text": "所有做生意的朋友们"
  },
  {
    "start": 55.120000000000005,
    "end": 56.160000000000004,
    "text": "请记住"
  },
  {
    "start": 57.160000000000004,
    "end": 61.36000000000001,
    "text": "你最好的老师"
  },
  {
    "start": 61.36000000000001,
    "end": 63.36000000000001,
    "text": "都是什么经济学大师"
  },
  {
    "start": 63.36000000000001,
    "end": 64.96000000000001,
    "text": "不是采金国主"
  },
  {
    "start": 64.96000000000001,
    "end": 65.68,
    "text": "而是那个"
  },
  {
    "start": 65.68,
    "end": 67.0,
    "text": "在你的行业里面"
  },
  {
    "start": 67.0,
    "end": 69.08,
    "text": "做得比您好的"
  },
  {
    "start": 69.08,
    "end": 71.88000000000001,
    "text": "赚钱比你更多的同好"
  },
  {
    "start": 71.88000000000001,
    "end": 72.88,
    "text": "朝他"
  },
  {
    "start": 72.88,
    "end": 74.0,
    "text": "学他"
  },
  {
    "start": 74.0,
    "end": 75.84,
    "text": "朝越他"
  },
  {
    "start": 77.84,
    "end": 79.2,
    "text": "历认和风险"
  },
  {
    "start": 79.2,
    "end": 81.76,
    "text": "永远是困绑到一块的"
  },
  {
    "start": 81.76,
    "end": 83.04,
    "text": "历认越高"
  },
  {
    "start": 83.04,
    "end": 84.32000000000001,
    "text": "风险越大"
  },
  {
    "start": 84.32000000000001,
    "end": 85.2,
    "text": "相反"
  },
  {
    "start": 85.2,
    "end": 86.28,
    "text": "历认越低"
  },
  {
    "start": 86.28,
    "end": 87.76,
    "text": "风险越低"
  },
  {
    "start": 87.76,
    "end": 89.80000000000001,
    "text": "这就是为什么"
  },
  {
    "start": 89.80000000000001,
    "end": 91.12,
    "text": "老板不理"
  },
  {
    "start": 91.12,
    "end": 92.28,
    "text": "这就是为什么"
  },
  {
    "start": 92.28,
    "end": 94.52000000000001,
    "text": "大功永远包不了材"
  },
  {
    "start": 94.52000000000001,
    "end": 95.48,
    "text": "因为风险"
  },
  {
    "start": 95.48,
    "end": 97.4,
    "text": "都被老板承担了"
  },
  {
    "start": 97.4,
    "end": 100.44000000000001,
    "text": "所以你再做任何投资之前"
  },
  {
    "start": 100.44000000000001,
    "end": 101.60000000000001,
    "text": "一定不要"
  },
  {
    "start": 101.60000000000001,
    "end": 103.76,
    "text": "只看能赚多少钱"
  },
  {
    "start": 103.76,
    "end": 107.80000000000001,
    "text": "而是应该认真且严肃的去评估"
  },
  {
    "start": 107.80000000000001,
    "end": 110.2,
    "text": "相应的风险和代价"
  },
  {
    "start": 110.2,
    "end": 111.60000000000001,
    "text": "是否在我们自己能"
  },
  {
    "start": 111.60000000000001,
    "end": 114.04,
    "text": "努力的承受范围之内"
  },
  {
    "start": 114.08000000000001,
    "end": 115.44000000000001,
    "text": "赚钱是为了"
  },
  {
    "start": 115.44000000000001,
    "end": 117.64,
    "text": "让我们更好的生活"
  },
  {
    "start": 117.64,
    "end": 119.68,
    "text": "不是去莫命的"
  },
  {
    "start": 119.68,
    "end": 122.44000000000001,
    "text": "当你抱着那种"
  },
  {
    "start": 122.44000000000001,
    "end": 123.52000000000001,
    "text": "要么成功"
  },
  {
    "start": 123.52000000000001,
    "end": 125.36000000000001,
    "text": "要么承认的心态"
  },
  {
    "start": 125.36000000000001,
    "end": 126.96000000000001,
    "text": "去赚钱的时候"
  },
  {
    "start": 126.96000000000001,
    "end": 128.0,
    "text": "请假当场"
  },
  {
    "start": 128.0,
    "end": 131.28,
    "text": "已经是注定的结果了"
  },
  {
    "start": 131.28,
    "end": 132.48000000000002,
    "text": "来"
  },
  {
    "start": 132.48000000000002,
    "end": 134.24,
    "text": "圈子"
  },
  {
    "start": 134.24,
    "end": 136.48000000000002,
    "text": "圈子真的很重要"
  },
  {
    "start": 136.48000000000002,
    "end": 138.12,
    "text": "跟着富人婚"
  },
  {
    "start": 138.12,
    "end": 140.16,
    "text": "那你会越婚业婚"
  },
  {
    "start": 140.16,
    "end": 141.76,
    "text": "那就我认婚"
  },
  {
    "start": 141.76,
    "end": 143.76,
    "text": "那只会越婚业从"
  },
  {
    "start": 143.76,
    "end": 144.56,
    "text": "若有"
  },
  {
    "start": 144.56,
    "end": 146.56,
    "text": "或者说是贫穷"
  },
  {
    "start": 146.56,
    "end": 148.23999999999998,
    "text": "看起来只是两种"
  },
  {
    "start": 148.23999999999998,
    "end": 150.23999999999998,
    "text": "就是不同的结果"
  },
  {
    "start": 150.23999999999998,
    "end": 151.76,
    "text": "但实际上"
  },
  {
    "start": 151.76,
    "end": 156.39999999999998,
    "text": "是两种人不同的思维方式和习惯者"
  },
  {
    "start": 156.39999999999998,
    "end": 157.79999999999998,
    "text": "从人讲道义"
  },
  {
    "start": 157.79999999999998,
    "end": 159.44,
    "text": "富人讲病"
  },
  {
    "start": 159.44,
    "end": 160.6,
    "text": "从人哀念"
  },
  {
    "start": 160.6,
    "end": 163.32,
    "text": "只忽然来个脸子"
  },
  {
    "start": 163.32,
    "end": 165.68,
    "text": "和人相信自己看见"
  },
  {
    "start": 165.68,
    "end": 169.16,
    "text": "但是富人会看见自己相信的"
  },
  {
    "start": 169.16,
    "end": 171.0,
    "text": "从人拿时间贯钱"
  },
  {
    "start": 171.0,
    "end": 172.12,
    "text": "富人把钱"
  },
  {
    "start": 172.12,
    "end": 174.0,
    "text": "你时间"
  },
  {
    "start": 174.0,
    "end": 176.0,
    "text": "从人为钱工作"
  },
  {
    "start": 176.0,
    "end": 181.0,
    "text": "富人让钱可以自己工作"
  },
  {
    "start": 181.0,
    "end": 183.16,
    "text": "可能他完上面这一条"
  },
  {
    "start": 183.16,
    "end": 184.68,
    "text": "你会问着了吧"
  },
  {
    "start": 184.68,
    "end": 185.44,
    "text": "着了吧"
  },
  {
    "start": 185.44,
    "end": 187.96,
    "text": "我也想要去跟富人结交"
  },
  {
    "start": 187.96,
    "end": 192.44,
    "text": "可是这个富人他就不理我"
  },
  {
    "start": 192.44,
    "end": 193.24,
    "text": "朋友"
  },
  {
    "start": 193.24,
    "end": 194.96,
    "text": "请记住"
  },
  {
    "start": 194.96,
    "end": 197.28,
    "text": "你要学会"
  },
  {
    "start": 197.28,
    "end": 199.28,
    "text": "并且养成一种习惯"
  },
  {
    "start": 199.28,
    "end": 201.4,
    "text": "那就是"
  },
  {
    "start": 201.4,
    "end": 203.92000000000002,
    "text": "越终于被利用"
  },
  {
    "start": 203.92000000000002,
    "end": 205.48,
    "text": "人性都是自私的"
  },
  {
    "start": 205.48,
    "end": 207.16,
    "text": "所以你是有机会的"
  },
  {
    "start": 207.16,
    "end": 209.32,
    "text": "你要想尽一切办法"
  },
  {
    "start": 209.32,
    "end": 211.76,
    "text": "让有钱人利用"
  },
  {
    "start": 211.76,
    "end": 214.4,
    "text": "当然前提是你的有用"
  },
  {
    "start": 214.4,
    "end": 215.88,
    "text": "想要跟大哥和他"
  },
  {
    "start": 215.88,
    "end": 217.4,
    "text": "愿者先想明白"
  },
  {
    "start": 217.4,
    "end": 219.56,
    "text": "大哥想要什么"
  },
  {
    "start": 219.56,
    "end": 221.56,
    "text": "然后利用规则"
  },
  {
    "start": 221.56,
    "end": 224.84,
    "text": "可能会好大哥"
  },
  {
    "start": 224.84,
    "end": 227.20000000000002,
    "text": "因为这个社会就是"
  },
  {
    "start": 227.20000000000002,
    "end": 229.20000000000002,
    "text": "制定规则的人利用"
  },
  {
    "start": 229.20000000000002,
    "end": 231.24,
    "text": "利用规则的人管理"
  },
  {
    "start": 231.24,
    "end": 233.28,
    "text": "申守规则的人"
  },
  {
    "start": 236.44,
    "end": 238.36,
    "text": "五"
  },
  {
    "start": 238.36,
    "end": 240.08,
    "text": "另一交换的本质"
  },
  {
    "start": 240.08,
    "end": 242.16,
    "text": "其实就是妈没有的"
  },
  {
    "start": 242.16,
    "end": 243.52,
    "text": "况且你要"
  },
  {
    "start": 243.52,
    "end": 245.48000000000002,
    "text": "这个道理大家都很好理解"
  },
  {
    "start": 245.48000000000002,
    "end": 248.8,
    "text": "但是除了把现在想要跟你说的是什么"
  },
  {
    "start": 248.8,
    "end": 252.72,
    "text": "如果说你现在什么都没有"
  },
  {
    "start": 252.72,
    "end": 254.52,
    "text": "没有一个好的出身"
  },
  {
    "start": 254.52,
    "end": 256.28000000000003,
    "text": "没有一个好的学历"
  },
  {
    "start": 256.28000000000003,
    "end": 257.68,
    "text": "没有一个好的机会"
  },
  {
    "start": 257.68,
    "end": 259.08,
    "text": "或者说是背景"
  },
  {
    "start": 259.08,
    "end": 261.08,
    "text": "要怎样去跟别人交换"
  },
  {
    "start": 262.2,
    "end": 263.36,
    "text": "却跳"
  },
  {
    "start": 263.36,
    "end": 266.72,
    "text": "就在一个戒指上面"
  },
  {
    "start": 266.72,
    "end": 269.76,
    "text": "所谓资源整合其实本质上"
  },
  {
    "start": 269.76,
    "end": 271.44,
    "text": "就是戒令"
  },
  {
    "start": 271.44,
    "end": 272.40000000000003,
    "text": "戒施"
  },
  {
    "start": 272.40000000000003,
    "end": 275.2,
    "text": "戒资源的一个过程"
  },
  {
    "start": 275.2,
    "end": 276.6,
    "text": "其实有很多的想要"
  },
  {
    "start": 276.6,
    "end": 278.92,
    "text": "往往上他的第一步"
  },
  {
    "start": 278.92,
    "end": 281.52,
    "text": "就是从这里开始的"
  },
  {
    "start": 281.52,
    "end": 283.0,
    "text": "这种别人有的"
  },
  {
    "start": 283.0,
    "end": 284.76,
    "text": "往往他人想到"
  },
  {
    "start": 284.76,
    "end": 286.71999999999997,
    "text": "得到你要的"
  },
  {
    "start": 286.71999999999997,
    "end": 288.44,
    "text": "六"
  },
  {
    "start": 288.44,
    "end": 289.47999999999996,
    "text": "谈生意"
  },
  {
    "start": 289.47999999999996,
    "end": 290.28,
    "text": "对"
  },
  {
    "start": 290.28,
    "end": 291.47999999999996,
    "text": "如果生意也好"
  },
  {
    "start": 291.47999999999996,
    "end": 292.56,
    "text": "谈生意也好"
  },
  {
    "start": 292.56,
    "end": 294.32,
    "text": "其实真的不是说"
  },
  {
    "start": 294.32,
    "end": 296.59999999999997,
    "text": "会说有多重要"
  },
  {
    "start": 296.59999999999997,
    "end": 299.59999999999997,
    "text": "想法要学会去清清楚"
  },
  {
    "start": 299.59999999999997,
    "end": 300.76,
    "text": "听什么"
  },
  {
    "start": 300.76,
    "end": 302.68,
    "text": "听四点"
  },
  {
    "start": 302.68,
    "end": 305.35999999999996,
    "text": "听动机"
  },
  {
    "start": 305.35999999999996,
    "end": 306.64,
    "text": "听入住"
  },
  {
    "start": 306.64,
    "end": 307.91999999999996,
    "text": "听需求"
  },
  {
    "start": 307.91999999999996,
    "end": 309.88,
    "text": "听顾虑"
  },
  {
    "start": 309.88,
    "end": 312.4,
    "text": "动机是对方的出发点"
  },
  {
    "start": 312.4,
    "end": 315.08,
    "text": "目的是对方的中点"
  },
  {
    "start": 315.08,
    "end": 316.68,
    "text": "连接这两个点"
  },
  {
    "start": 316.68,
    "end": 318.4,
    "text": "中间的部分其实"
  },
  {
    "start": 318.4,
    "end": 320.96,
    "text": "就是生意的机会"
  },
  {
    "start": 320.96,
    "end": 323.96,
    "text": "需求是对方想要什么"
  },
  {
    "start": 323.96,
    "end": 325.12,
    "text": "目的"
  },
  {
    "start": 325.12,
    "end": 325.88,
    "text": "顾虑"
  },
  {
    "start": 325.88,
    "end": 328.6,
    "text": "就说对方怕收取什么"
  },
  {
    "start": 328.6,
    "end": 329.92,
    "text": "你听懂这两个点"
  },
  {
    "start": 329.92,
    "end": 331.32,
    "text": "你就能够从"
  },
  {
    "start": 331.32,
    "end": 332.15999999999997,
    "text": "运往"
  },
  {
    "start": 332.15999999999997,
    "end": 332.96,
    "text": "和恐惧"
  },
  {
    "start": 332.96,
    "end": 335.4,
    "text": "这两个人性的落点出发"
  },
  {
    "start": 335.4,
    "end": 336.48,
    "text": "然后呢"
  },
  {
    "start": 336.48,
    "end": 337.48,
    "text": "你能够自己"
  },
  {
    "start": 337.48,
    "end": 341.48,
    "text": "想让我的结果"
  },
  {
    "start": 341.48,
    "end": 343.48,
    "text": "行"
  },
  {
    "start": 343.48,
    "end": 344.48,
    "text": "最后一跑"
  },
  {
    "start": 344.48,
    "end": 345.48,
    "text": "也是"
  },
  {
    "start": 345.48,
    "end": 346.48,
    "text": "也就是"
  },
  {
    "start": 346.48,
    "end": 347.48,
    "text": "很多人"
  },
  {
    "start": 347.48,
    "end": 348.48,
    "text": "不能够理解的一点"
  },
  {
    "start": 348.48,
    "end": 350.48,
    "text": "首先你得明白"
  },
  {
    "start": 350.48,
    "end": 351.48,
    "text": "财富"
  },
  {
    "start": 351.48,
    "end": 353.48,
    "text": "从来都不是"
  },
  {
    "start": 353.48,
    "end": 355.48,
    "text": "现心增长了"
  },
  {
    "start": 355.48,
    "end": 356.48,
    "text": "打入一个富豪"
  },
  {
    "start": 356.48,
    "end": 357.48,
    "text": "他有一个意"
  },
  {
    "start": 357.48,
    "end": 359.48,
    "text": "一定不是"
  },
  {
    "start": 359.48,
    "end": 361.48,
    "text": "每年正他个500万"
  },
  {
    "start": 361.48,
    "end": 363.48,
    "text": "连续正他20年"
  },
  {
    "start": 363.48,
    "end": 365.48,
    "text": "而是他抓住了一波机会"
  },
  {
    "start": 365.48,
    "end": 366.48,
    "text": "这么三千万"
  },
  {
    "start": 366.48,
    "end": 367.48,
    "text": "然后呢"
  },
  {
    "start": 367.48,
    "end": 368.48,
    "text": "又抓住了一波机会"
  },
  {
    "start": 368.48,
    "end": 370.48,
    "text": "这么七千万"
  },
  {
    "start": 370.48,
    "end": 371.48,
    "text": "所以呢"
  },
  {
    "start": 371.48,
    "end": 373.48,
    "text": "他才有了一个意"
  },
  {
    "start": 373.48,
    "end": 374.48,
    "text": "所以"
  },
  {
    "start": 374.48,
    "end": 377.48,
    "text": "那在这两个机会中间"
  },
  {
    "start": 377.48,
    "end": 380.48,
    "text": "这样的人做了什么事呢"
  },
  {
    "start": 380.48,
    "end": 382.48,
    "text": "为所发育着"
  },
  {
    "start": 382.48,
    "end": 386.48,
    "text": "不做任何的"
  },
  {
    "start": 386.48,
    "end": 387.48,
    "text": "瞎折腾"
  },
  {
    "start": 387.48,
    "end": 388.48,
    "text": "也不会乱做"
  },
  {
    "start": 388.48,
    "end": 390.48,
    "text": "任何的大投资"
  },
  {
    "start": 390.48,
    "end": 391.48,
    "text": "是难来的"
  },
  {
    "start": 391.48,
    "end": 392.48,
    "text": "收取而为"
  },
  {
    "start": 392.48,
    "end": 393.48,
    "text": "解释而起"
  },
  {
    "start": 393.48,
    "end": 394.48,
    "text": "是能不再"
  },
  {
    "start": 394.48,
    "end": 396.48,
    "text": "就老老实实的"
  },
  {
    "start": 396.48,
    "end": 398.48,
    "text": "冷静的观察趋势"
  },
  {
    "start": 398.48,
    "end": 399.48,
    "text": "赚钱"
  },
  {
    "start": 399.48,
    "end": 400.48,
    "text": "真的"
  },
  {
    "start": 400.48,
    "end": 401.48,
    "text": "就是"
  },
  {
    "start": 401.48,
    "end": 402.48,
    "text": "尽可能的"
  },
  {
    "start": 402.48,
    "end": 403.48,
    "text": "根据规律"
  },
  {
    "start": 403.48,
    "end": 404.48,
    "text": "去刑求"
  },
  {
    "start": 404.48,
    "end": 405.48,
    "text": "确定性"
  },
  {
    "start": 405.48,
    "end": 407.48,
    "text": "如果说是"
  },
  {
    "start": 407.48,
    "end": 408.48,
    "text": "不运气"
  },
  {
    "start": 408.48,
    "end": 409.48,
    "text": "只会让你"
  },
  {
    "start": 409.48,
    "end": 411.48,
    "text": "亲家当产"
  },
  {
    "start": 413.48,
    "end": 414.48,
    "text": "当初继"
  },
  {
    "start": 414.48,
    "end": 415.48,
    "text": "当初继"
  },
  {
    "start": 415.48,
    "end": 416.48,
    "text": "是不会乱推的"
  },
  {
    "start": 416.48,
    "end": 417.48,
    "text": "既然"
  },
  {
    "start": 417.48,
    "end": 418.48,
    "text": "你能够"
  },
  {
    "start": 418.48,
    "end": 419.48,
    "text": "安静静地看到这里"
  },
  {
    "start": 419.48,
    "end": 421.48,
    "text": "说明你真的"
  },
  {
    "start": 421.48,
    "end": 422.48,
    "text": "要启示了"
  },
  {
    "start": 422.48,
    "end": 423.48,
    "text": "对"
  },
  {
    "start": 423.48,
    "end": 424.48,
    "text": "没了"
  },
  {
    "start": 424.48,
    "end": 426.48,
    "text": "等一下你丢话"
  },
  {
    "start": 426.48,
    "end": 428.48,
    "text": "顺风"
  },
  {
    "start": 428.48,
    "end": 429.48,
    "text": "顺水"
  },
  {
    "start": 429.48,
    "end": 430.48,
    "text": "顺台身"
  },
  {
    "start": 430.48,
    "end": 431.48,
    "text": "送给"
  },
  {
    "start": 431.48,
    "end": 432.48,
    "text": "你们"
  },
  {
    "start": 432.48,
    "end": 433.48,
    "text": "也"
  },
  {
    "start": 433.48,
    "end": 434.48,
    "text": "信用自己"
  },
  {
    "start": 434.48,
    "end": 435.48,
    "text": "加油"
  }
]