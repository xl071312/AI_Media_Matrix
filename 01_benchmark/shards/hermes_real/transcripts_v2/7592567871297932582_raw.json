[
  {
    "start": 0.0,
    "end": 2.56,
    "text": "現在最慘的人根本不是"
  },
  {
    "start": 2.56,
    "end": 3.68,
    "text": "搬轉打羅斯的"
  },
  {
    "start": 3.68,
    "end": 4.56,
    "text": "知道是誰嗎"
  },
  {
    "start": 4.56,
    "end": 6.12,
    "text": "是那些手的小掉"
  },
  {
    "start": 6.12,
    "end": 7.68,
    "text": "被生活暗在地上"
  },
  {
    "start": 7.68,
    "end": 8.88,
    "text": "反復摸差的"
  },
  {
    "start": 8.88,
    "end": 10.08,
    "text": "個體會小老板"
  },
  {
    "start": 10.08,
    "end": 11.76,
    "text": "大功能至少還有個判頭"
  },
  {
    "start": 11.76,
    "end": 12.4,
    "text": "看個周末"
  },
  {
    "start": 12.4,
    "end": 13.2,
    "text": "判個價期"
  },
  {
    "start": 13.2,
    "end": 14.24,
    "text": "到第二下班"
  },
  {
    "start": 14.24,
    "end": 15.76,
    "text": "天他了有老板頂著"
  },
  {
    "start": 15.76,
    "end": 16.56,
    "text": "可小老板"
  },
  {
    "start": 16.56,
    "end": 18.08,
    "text": "他哪里是在做生意"
  },
  {
    "start": 18.08,
    "end": 19.88,
    "text": "分明是在拿自己的命"
  },
  {
    "start": 19.88,
    "end": 21.24,
    "text": "跟日子在四顆"
  },
  {
    "start": 21.24,
    "end": 21.76,
    "text": "你想想"
  },
  {
    "start": 21.76,
    "end": 22.4,
    "text": "大公式"
  },
  {
    "start": 22.4,
    "end": 23.12,
    "text": "996"
  },
  {
    "start": 23.12,
    "end": 24.64,
    "text": "小老板是070"
  },
  {
    "start": 24.64,
    "end": 25.52,
    "text": "365天"
  },
  {
    "start": 25.52,
    "end": 26.48,
    "text": "全年五休"
  },
  {
    "start": 26.48,
    "end": 27.44,
    "text": "自從當晚老板"
  },
  {
    "start": 27.44,
    "end": 28.6,
    "text": "日例對我們來說"
  },
  {
    "start": 28.6,
    "end": 29.68,
    "text": "他就是個本事"
  },
  {
    "start": 29.68,
    "end": 30.68,
    "text": "逛街沒時間"
  },
  {
    "start": 30.68,
    "end": 31.44,
    "text": "聚會沒時間"
  },
  {
    "start": 31.44,
    "end": 32.6,
    "text": "連生病都不敢"
  },
  {
    "start": 32.6,
    "end": 33.76,
    "text": "一關門就發貨"
  },
  {
    "start": 33.76,
    "end": 34.44,
    "text": "可開了門"
  },
  {
    "start": 34.44,
    "end": 35.72,
    "text": "看著空當大人的地"
  },
  {
    "start": 35.72,
    "end": 36.4,
    "text": "行更量"
  },
  {
    "start": 36.4,
    "end": 37.44,
    "text": "你說得窮吧"
  },
  {
    "start": 37.44,
    "end": 38.6,
    "text": "他好在有個產業"
  },
  {
    "start": 38.6,
    "end": 39.44,
    "text": "你說得付吧"
  },
  {
    "start": 39.44,
    "end": 40.6,
    "text": "都比臉還乾淨"
  },
  {
    "start": 40.6,
    "end": 41.44,
    "text": "天哪去了"
  },
  {
    "start": 41.44,
    "end": 42.44,
    "text": "進獲取"
  },
  {
    "start": 42.44,
    "end": 43.16,
    "text": "獲賣了"
  },
  {
    "start": 43.16,
    "end": 44.76,
    "text": "錢又得拿去進獲了"
  },
  {
    "start": 44.76,
    "end": 46.16,
    "text": "就像無線循環"
  },
  {
    "start": 46.16,
    "end": 47.2,
    "text": "那個倉屬式的"
  },
  {
    "start": 47.2,
    "end": 47.72,
    "text": "跑鑪"
  },
  {
    "start": 47.72,
    "end": 49.08,
    "text": "手裡永遠留不住現金"
  },
  {
    "start": 49.08,
    "end": 49.72,
    "text": "手隔地"
  },
  {
    "start": 49.72,
    "end": 51.04,
    "text": "他們比手骨還難"
  },
  {
    "start": 51.04,
    "end": 51.84,
    "text": "手骨這手"
  },
  {
    "start": 51.84,
    "end": 52.84,
    "text": "還能出門走走"
  },
  {
    "start": 52.84,
    "end": 53.44,
    "text": "手隔地"
  },
  {
    "start": 53.44,
    "end": 55.36,
    "text": "你就像當局人被汗死在那兒"
  },
  {
    "start": 55.36,
    "end": 56.44,
    "text": "我見過最詐性的"
  },
  {
    "start": 56.44,
    "end": 57.6,
    "text": "有人為了不錯過"
  },
  {
    "start": 57.6,
    "end": 58.48,
    "text": "任何一個"
  },
  {
    "start": 58.48,
    "end": 59.84,
    "text": "有可能上門的客人"
  },
  {
    "start": 59.84,
    "end": 60.44,
    "text": "一拋你"
  },
  {
    "start": 60.44,
    "end": 61.52,
    "text": "分三四上"
  },
  {
    "start": 61.52,
    "end": 62.44,
    "text": "有時候在電力"
  },
  {
    "start": 62.44,
    "end": 63.44,
    "text": "從找做到吧"
  },
  {
    "start": 63.44,
    "end": 64.68,
    "text": "但都都包疆了"
  },
  {
    "start": 64.68,
    "end": 65.84,
    "text": "一個顧客都沒有"
  },
  {
    "start": 65.84,
    "end": 66.8,
    "text": "那種做餐飲"
  },
  {
    "start": 66.8,
    "end": 67.72,
    "text": "那種劑境"
  },
  {
    "start": 67.72,
    "end": 69.8,
    "text": "他們都能聽到自己心碎的聲音"
  },
  {
    "start": 69.8,
    "end": 70.4,
    "text": "所以你看"
  },
  {
    "start": 70.4,
    "end": 71.8,
    "text": "這根本不是一份工作"
  },
  {
    "start": 71.8,
    "end": 73.04,
    "text": "那是花了幾十萬"
  },
  {
    "start": 73.04,
    "end": 74.04,
    "text": "甚至上百萬"
  },
  {
    "start": 74.04,
    "end": 75.12,
    "text": "給自己買了個"
  },
  {
    "start": 75.12,
    "end": 76.52,
    "text": "月星三千的老龍"
  },
  {
    "start": 76.52,
    "end": 77.72,
    "text": "沒有上下吧"
  },
  {
    "start": 77.72,
    "end": 78.68,
    "text": "沒有接家日"
  },
  {
    "start": 78.68,
    "end": 79.6,
    "text": "別人在生活"
  },
  {
    "start": 79.6,
    "end": 80.56,
    "text": "他去再做了"
  },
  {
    "start": 80.56,
    "end": 81.36,
    "text": "別人在成長"
  },
  {
    "start": 81.36,
    "end": 82.24,
    "text": "他在手套"
  },
  {
    "start": 82.24,
    "end": 83.0,
    "text": "沒開電"
  },
  {
    "start": 83.0,
    "end": 84.0,
    "text": "頂多是個群"
  },
  {
    "start": 84.0,
    "end": 84.72,
    "text": "開的電"
  },
  {
    "start": 84.72,
    "end": 85.92,
    "text": "是又群又類"
  },
  {
    "start": 85.92,
    "end": 87.68,
    "text": "還打上所有的自由和希望"
  },
  {
    "start": 87.68,
    "end": 89.0,
    "text": "這其中的心算"
  },
  {
    "start": 89.0,
    "end": 91.28,
    "text": "只有那些真正熬惠的人才懂"
  },
  {
    "start": 91.28,
    "end": 93.0,
    "text": "如果你也正在經歷"
  },
  {
    "start": 93.0,
    "end": 93.92,
    "text": "或者你身邊有"
  },
  {
    "start": 93.92,
    "end": 95.0,
    "text": "這樣的家人朋友"
  },
  {
    "start": 95.0,
    "end": 95.84,
    "text": "咱就點讚"
  },
  {
    "start": 95.84,
    "end": 96.64,
    "text": "轉發出去"
  },
  {
    "start": 96.64,
    "end": 97.84,
    "text": "要更多人看到這些"
  },
  {
    "start": 97.84,
    "end": 99.24,
    "text": "實體店小老闆的"
  },
  {
    "start": 99.24,
    "end": 100.08,
    "text": "真實困境"
  },
  {
    "start": 100.08,
    "end": 101.8,
    "text": "他的需要的不是同情"
  },
  {
    "start": 101.8,
    "end": 102.96,
    "text": "是一份看見"
  },
  {
    "start": 102.96,
    "end": 103.76,
    "text": "一份理解"
  }
]