[
  {
    "start": 0.0,
    "end": 2.4,
    "text": "你知道我們服服人越新"
  },
  {
    "start": 2.4,
    "end": 3.8,
    "text": "到底什麼水平"
  },
  {
    "start": 3.8,
    "end": 5.0,
    "text": "這些話啊"
  },
  {
    "start": 5.8,
    "end": 6.8,
    "text": "每個月"
  },
  {
    "start": 6.8,
    "end": 8.8,
    "text": "如果能整個五千塊錢"
  },
  {
    "start": 8.8,
    "end": 10.2,
    "text": "放在全國"
  },
  {
    "start": 10.2,
    "end": 12.2,
    "text": "到底能排地集"
  },
  {
    "start": 12.2,
    "end": 13.2,
    "text": "能排地集啊"
  },
  {
    "start": 13.2,
    "end": 14.4,
    "text": "看完這個視頻啊"
  },
  {
    "start": 14.4,
    "end": 15.2,
    "text": "你可能啊"
  },
  {
    "start": 15.2,
    "end": 16.6,
    "text": "就不會那麼焦慮了"
  },
  {
    "start": 16.6,
    "end": 18.2,
    "text": "原來要很多人跟你一樣"
  },
  {
    "start": 18.2,
    "end": 19.8,
    "text": "甚至不如一"
  },
  {
    "start": 19.8,
    "end": 21.0,
    "text": "我們不會吧"
  },
  {
    "start": 21.0,
    "end": 22.6,
    "text": "國家統計不滿了"
  },
  {
    "start": 22.6,
    "end": 24.6,
    "text": "把十四億人的月收入"
  },
  {
    "start": 24.6,
    "end": 27.0,
    "text": "分成了十億個黨籍"
  },
  {
    "start": 27.0,
    "end": 29.0,
    "text": "你看看自己在哪一集"
  },
  {
    "start": 29.0,
    "end": 29.8,
    "text": "是不是很厲害的"
  },
  {
    "start": 29.8,
    "end": 31.6,
    "text": "可是你閃下的不太一樣"
  },
  {
    "start": 31.6,
    "end": 32.56,
    "text": "來說說"
  },
  {
    "start": 32.56,
    "end": 33.4,
    "text": "第一集呢"
  },
  {
    "start": 33.4,
    "end": 34.8,
    "text": "越收入為零"
  },
  {
    "start": 34.8,
    "end": 35.8,
    "text": "這主要是"
  },
  {
    "start": 35.8,
    "end": 38.8,
    "text": "沒有收入的老娘的孩子"
  },
  {
    "start": 38.8,
    "end": 39.6,
    "text": "大約呢"
  },
  {
    "start": 39.6,
    "end": 42.0,
    "text": "有五百四十六萬人"
  },
  {
    "start": 42.0,
    "end": 42.8,
    "text": "第二集呢"
  },
  {
    "start": 42.8,
    "end": 43.8,
    "text": "越收入啊"
  },
  {
    "start": 43.8,
    "end": 45.8,
    "text": "在零到五百塊錢之間"
  },
  {
    "start": 45.8,
    "end": 46.8,
    "text": "這個集結啊"
  },
  {
    "start": 46.8,
    "end": 49.0,
    "text": "有二點一五一人"
  },
  {
    "start": 49.0,
    "end": 50.2,
    "text": "在那種人口的"
  },
  {
    "start": 50.2,
    "end": 52.6,
    "text": "將近七分之一人"
  },
  {
    "start": 52.6,
    "end": 53.8,
    "text": "那第三集呢"
  },
  {
    "start": 53.8,
    "end": 57.0,
    "text": "越收入在五百到八百塊錢"
  },
  {
    "start": 57.0,
    "end": 60.0,
    "text": "全國有兩點零二一人在著"
  },
  {
    "start": 60.0,
    "end": 60.4,
    "text": "對啊"
  },
  {
    "start": 60.4,
    "end": 62.4,
    "text": "很多都是物弄的香清"
  },
  {
    "start": 62.4,
    "end": 64.4,
    "text": "就在這個區點啊"
  },
  {
    "start": 64.4,
    "end": 65.6,
    "text": "第四集呢"
  },
  {
    "start": 65.6,
    "end": 68.8,
    "text": "就是越收入八百到一千塊錢的"
  },
  {
    "start": 68.8,
    "end": 70.4,
    "text": "一點二四一人"
  },
  {
    "start": 70.4,
    "end": 71.0,
    "text": "不少呢"
  },
  {
    "start": 71.0,
    "end": 73.0,
    "text": "退休老人的楊老金啊"
  },
  {
    "start": 73.0,
    "end": 74.8,
    "text": "就在這個水平了"
  },
  {
    "start": 74.8,
    "end": 75.6,
    "text": "你看啊"
  },
  {
    "start": 75.6,
    "end": 77.4,
    "text": "前面這四集加起來"
  },
  {
    "start": 77.4,
    "end": 78.4,
    "text": "總共呢"
  },
  {
    "start": 78.4,
    "end": 81.0,
    "text": "是五點四六一人"
  },
  {
    "start": 81.0,
    "end": 82.2,
    "text": "這個印象呢"
  },
  {
    "start": 82.2,
    "end": 82.8,
    "text": "什麼呢"
  },
  {
    "start": 82.8,
    "end": 83.6,
    "text": "你這個嗎"
  },
  {
    "start": 83.6,
    "end": 85.0,
    "text": "是不是之前工作"
  },
  {
    "start": 85.0,
    "end": 87.2,
    "text": "報告裡面提到的數據啊"
  },
  {
    "start": 87.2,
    "end": 88.8,
    "text": "全國有六一人"
  },
  {
    "start": 88.8,
    "end": 90.0,
    "text": "每月的收入啊"
  },
  {
    "start": 90.0,
    "end": 92.0,
    "text": "就在一千塊錢左右"
  },
  {
    "start": 93.0,
    "end": 95.8,
    "text": "他們呢生活在最底前"
  },
  {
    "start": 95.8,
    "end": 99.0,
    "text": "很多呢是靠著重地維持生活的"
  },
  {
    "start": 99.0,
    "end": 100.4,
    "text": "那第五集呢"
  },
  {
    "start": 100.4,
    "end": 104.0,
    "text": "越收入一千到一千五百塊"
  },
  {
    "start": 104.0,
    "end": 105.6,
    "text": "這個成績的人數啊"
  },
  {
    "start": 105.6,
    "end": 106.8,
    "text": "是最多的"
  },
  {
    "start": 106.8,
    "end": 110.0,
    "text": "有二點四三一人"
  },
  {
    "start": 110.0,
    "end": 111.2,
    "text": "那第六集呢"
  },
  {
    "start": 111.2,
    "end": 114.2,
    "text": "是一千五百塊錢到兩千塊錢"
  },
  {
    "start": 114.2,
    "end": 116.2,
    "text": "有一點三八一人"
  },
  {
    "start": 116.2,
    "end": 118.2,
    "text": "那第七集呢"
  },
  {
    "start": 118.2,
    "end": 120.6,
    "text": "兩千到三千塊錢"
  },
  {
    "start": 120.6,
    "end": 122.8,
    "text": "有兩點零三一人"
  },
  {
    "start": 122.8,
    "end": 124.0,
    "text": "這個呢"
  },
  {
    "start": 124.0,
    "end": 126.2,
    "text": "也差不多是目前很多地方"
  },
  {
    "start": 126.2,
    "end": 128.2,
    "text": "最低工資的標準"
  },
  {
    "start": 128.2,
    "end": 129.8,
    "text": "那第八集呢"
  },
  {
    "start": 129.8,
    "end": 131.6,
    "text": "三千到五千塊錢"
  },
  {
    "start": 131.6,
    "end": 133.4,
    "text": "有一點火六一人"
  },
  {
    "start": 133.4,
    "end": 134.8,
    "text": "我剛畢業的那一本"
  },
  {
    "start": 134.8,
    "end": 137.2,
    "text": "工資呢就是這個黨啊"
  },
  {
    "start": 137.2,
    "end": 140.2,
    "text": "你說是不是很多打工人的現狀"
  },
  {
    "start": 140.2,
    "end": 141.0,
    "text": "沒錯"
  },
  {
    "start": 141.0,
    "end": 141.8,
    "text": "八一上啊"
  },
  {
    "start": 141.8,
    "end": 144.0,
    "text": "這八個成績全都加起來啊"
  },
  {
    "start": 144.6,
    "end": 147.2,
    "text": "越收入第五千塊錢的人啊"
  },
  {
    "start": 147.2,
    "end": 150.4,
    "text": "主族有十三點二六一人"
  },
  {
    "start": 150.4,
    "end": 151.4,
    "text": "怎麼過"
  },
  {
    "start": 151.4,
    "end": 153.2,
    "text": "大了重人口的"
  },
  {
    "start": 153.2,
    "end": 156.0,
    "text": "百分之九十四點八七啊"
  },
  {
    "start": 156.0,
    "end": 157.4,
    "text": "也就是說呢"
  },
  {
    "start": 157.4,
    "end": 158.4,
    "text": "你的越收入啊"
  },
  {
    "start": 158.4,
    "end": 160.4,
    "text": "要是超過了五千塊錢"
  },
  {
    "start": 160.4,
    "end": 164.6,
    "text": "就已經超過了全國將近百分之九十五的人了"
  },
  {
    "start": 164.6,
    "end": 165.8,
    "text": "那是這樣啊"
  },
  {
    "start": 165.8,
    "end": 167.2,
    "text": "你別不信啊"
  },
  {
    "start": 167.2,
    "end": 170.4,
    "text": "國家碎物總局早都披露過了"
  },
  {
    "start": 170.4,
    "end": 172.4,
    "text": "去年十四一人裡面"
  },
  {
    "start": 172.4,
    "end": 175.8,
    "text": "只有一一人交了個人所的碎物"
  },
  {
    "start": 175.8,
    "end": 177.6,
    "text": "而且鄭點呢"
  },
  {
    "start": 177.6,
    "end": 179.4,
    "text": "就是五千塊錢"
  },
  {
    "start": 179.4,
    "end": 180.8,
    "text": "好好好"
  },
  {
    "start": 180.8,
    "end": 184.4,
    "text": "你看數據五萬全身對的上大"
  },
  {
    "start": 184.4,
    "end": 185.2,
    "text": "沒錯"
  },
  {
    "start": 185.2,
    "end": 187.4,
    "text": "那在往後三個等級呢"
  },
  {
    "start": 187.4,
    "end": 190.0,
    "text": "就屬於高收入的那圈啊"
  },
  {
    "start": 190.0,
    "end": 191.4,
    "text": "那也那我還得高收入啊"
  },
  {
    "start": 191.4,
    "end": 192.4,
    "text": "對啊"
  },
  {
    "start": 192.4,
    "end": 193.4,
    "text": "看看了"
  },
  {
    "start": 193.4,
    "end": 194.8,
    "text": "你再不再裏面"
  },
  {
    "start": 194.8,
    "end": 196.2,
    "text": "第九集"
  },
  {
    "start": 196.2,
    "end": 199.2,
    "text": "越收入五千到一萬塊錢的"
  },
  {
    "start": 199.2,
    "end": 202.2,
    "text": "有六千三百二十八萬人"
  },
  {
    "start": 202.2,
    "end": 203.6,
    "text": "不少呢"
  },
  {
    "start": 203.6,
    "end": 205.2,
    "text": "小公司的中層名道"
  },
  {
    "start": 205.2,
    "end": 206.2,
    "text": "就在這個範圍"
  },
  {
    "start": 206.2,
    "end": 207.6,
    "text": "還有第十集啊"
  },
  {
    "start": 207.6,
    "end": 210.2,
    "text": "越收入五萬到兩萬的"
  },
  {
    "start": 210.2,
    "end": 213.8,
    "text": "全國只有七百八十四萬人"
  },
  {
    "start": 213.8,
    "end": 215.2,
    "text": "那你發現沒有"
  },
  {
    "start": 215.2,
    "end": 216.2,
    "text": "很多女生啊"
  },
  {
    "start": 216.2,
    "end": 217.4,
    "text": "早對象要求"
  },
  {
    "start": 217.4,
    "end": 219.2,
    "text": "越新過萬"
  },
  {
    "start": 219.2,
    "end": 220.2,
    "text": "對"
  },
  {
    "start": 220.2,
    "end": 222.0,
    "text": "現在看這個條件啊"
  },
  {
    "start": 222.0,
    "end": 223.2,
    "text": "其實是很可可"
  },
  {
    "start": 223.2,
    "end": 224.2,
    "text": "來幹什麼的"
  },
  {
    "start": 224.2,
    "end": 225.2,
    "text": "對啊"
  },
  {
    "start": 225.2,
    "end": 226.2,
    "text": "那你想想"
  },
  {
    "start": 226.2,
    "end": 228.2,
    "text": "這七百八十四萬人裡面"
  },
  {
    "start": 228.2,
    "end": 229.6,
    "text": "還有女性的"
  },
  {
    "start": 229.6,
    "end": 231.2,
    "text": "還有以婚的呢"
  },
  {
    "start": 231.2,
    "end": 233.8,
    "text": "真正是領單身的男性啊"
  },
  {
    "start": 233.8,
    "end": 235.2,
    "text": "其實非常..."
  },
  {
    "start": 235.2,
    "end": 236.2,
    "text": "沒錯"
  },
  {
    "start": 236.2,
    "end": 237.2,
    "text": "百萬人單身的條一個"
  },
  {
    "start": 237.2,
    "end": 238.2,
    "text": "對啊"
  },
  {
    "start": 238.2,
    "end": 239.2,
    "text": "當然我也領講"
  },
  {
    "start": 239.2,
    "end": 240.2,
    "text": "現在呢"
  },
  {
    "start": 240.2,
    "end": 242.2,
    "text": "在二三線城市啊"
  },
  {
    "start": 242.2,
    "end": 243.2,
    "text": "年輕人啊"
  },
  {
    "start": 243.2,
    "end": 244.2,
    "text": "越新不過萬啊"
  },
  {
    "start": 244.2,
    "end": 245.2,
    "text": "可能啊"
  },
  {
    "start": 245.2,
    "end": 247.2,
    "text": "真的只能念長的生活"
  },
  {
    "start": 247.2,
    "end": 248.2,
    "text": "開箱開箱"
  },
  {
    "start": 248.2,
    "end": 249.2,
    "text": "對"
  },
  {
    "start": 249.2,
    "end": 250.2,
    "text": "那最後一集呢"
  },
  {
    "start": 250.2,
    "end": 251.2,
    "text": "第十一集"
  },
  {
    "start": 251.2,
    "end": 254.2,
    "text": "越收入兩萬以上的"
  },
  {
    "start": 254.2,
    "end": 257.2,
    "text": "全國只有七十萬人"
  },
  {
    "start": 257.2,
    "end": 258.0,
    "text": "這麼一點"
  },
  {
    "start": 258.0,
    "end": 260.0,
    "text": "你沒有聽錯"
  },
  {
    "start": 260.0,
    "end": 262.0,
    "text": "就是七十萬"
  },
  {
    "start": 262.0,
    "end": 264.0,
    "text": "你是不是覺得難以之心啊"
  },
  {
    "start": 264.0,
    "end": 265.0,
    "text": "畢竟在網上啊"
  },
  {
    "start": 265.0,
    "end": 266.0,
    "text": "好像呢"
  },
  {
    "start": 266.0,
    "end": 267.0,
    "text": "人人年輕百萬"
  },
  {
    "start": 267.0,
    "end": 268.0,
    "text": "感覺到距離"
  },
  {
    "start": 268.0,
    "end": 269.0,
    "text": "是開的"
  },
  {
    "start": 269.0,
    "end": 270.0,
    "text": "開的"
  },
  {
    "start": 270.0,
    "end": 271.0,
    "text": "就是開的"
  },
  {
    "start": 271.0,
    "end": 273.0,
    "text": "但是其實啊"
  },
  {
    "start": 273.0,
    "end": 275.0,
    "text": "真正越入兩萬以上的"
  },
  {
    "start": 275.0,
    "end": 276.0,
    "text": "只有七十萬"
  },
  {
    "start": 276.0,
    "end": 278.0,
    "text": "這其實就是啊"
  },
  {
    "start": 278.0,
    "end": 280.0,
    "text": "幸存者的偏家"
  },
  {
    "start": 280.0,
    "end": 283.0,
    "text": "我們很容易把自己的圈子的情況啊"
  },
  {
    "start": 283.0,
    "end": 286.0,
    "text": "當成整個社會的長態"
  },
  {
    "start": 286.0,
    "end": 287.0,
    "text": "而實際上啊"
  },
  {
    "start": 287.0,
    "end": 289.0,
    "text": "還有很多我們看不見的人"
  },
  {
    "start": 289.0,
    "end": 290.0,
    "text": "人在為了溫島"
  },
  {
    "start": 290.0,
    "end": 291.0,
    "text": "我們不離沒錯"
  },
  {
    "start": 291.0,
    "end": 293.0,
    "text": "只是他們不上網發生的"
  },
  {
    "start": 293.0,
    "end": 295.0,
    "text": "也不被算法推薦"
  },
  {
    "start": 295.0,
    "end": 296.0,
    "text": "所以啊"
  },
  {
    "start": 296.0,
    "end": 297.0,
    "text": "真的別交流"
  },
  {
    "start": 297.0,
    "end": 298.0,
    "text": "你每個月的公子啊"
  },
  {
    "start": 298.0,
    "end": 299.0,
    "text": "不管是之前"
  },
  {
    "start": 299.0,
    "end": 301.0,
    "text": "都已經是中國前幾的"
  },
  {
    "start": 301.0,
    "end": 303.0,
    "text": "耐疲人了"
  },
  {
