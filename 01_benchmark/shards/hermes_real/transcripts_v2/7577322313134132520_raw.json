[
  {
    "start": 0.0,
    "end": 1.28,
    "text": "超全校廢市傻瓜的"
  },
  {
    "start": 1.28,
    "end": 3.96,
    "text": "普通家庭最初民台市傻瓜的"
  },
  {
    "start": 3.96,
    "end": 6.64,
    "text": "什麼就民台你買不起這叫社市品"
  },
  {
    "start": 6.64,
    "end": 9.48,
    "text": "富豪人家人家買個集團塊"
  },
  {
    "start": 9.48,
    "end": 11.2,
    "text": "包那是叫日常消費"
  },
  {
    "start": 11.2,
    "end": 12.8,
    "text": "跟你買個馬家大食一樣的"
  },
  {
    "start": 12.8,
    "end": 14.08,
    "text": "所以你不要認為人家是社市的"
  },
  {
    "start": 14.08,
    "end": 16.08,
    "text": "只能家不是人家有100塊錢"
  },
  {
    "start": 16.08,
    "end": 17.92,
    "text": "花一塊錢去買個包很正常"
  },
  {
    "start": 17.92,
    "end": 19.12,
    "text": "你就兩塊錢"
  },
  {
    "start": 19.12,
    "end": 20.56,
    "text": "你就花一塊錢去買個包"
  },
  {
    "start": 20.56,
    "end": 21.76,
    "text": "那就叫傻差"
  },
  {
    "start": 21.76,
    "end": 22.96,
    "text": "而且你只有兩塊錢"
  },
  {
    "start": 22.96,
    "end": 24.4,
    "text": "你還再去借兩塊錢"
  },
  {
    "start": 24.4,
    "end": 25.44,
    "text": "那個超全消費"
  },
  {
    "start": 25.44,
    "end": 26.88,
    "text": "去買個四塊錢的包"
  },
  {
    "start": 26.88,
    "end": 28.32,
    "text": "你傻得沒有救了"
  },
  {
    "start": 28.32,
    "end": 29.16,
    "text": "我還在去買"
  },
  {
    "start": 29.16,
    "end": 30.12,
    "text": "我一千塊錢的時候"
  },
  {
    "start": 30.12,
    "end": 31.72,
    "text": "我還一千塊錢的時候去消費"
  },
  {
    "start": 31.72,
    "end": 32.96,
    "text": "我不室母那個馬"
  },
  {
    "start": 32.96,
    "end": 33.76,
    "text": "因為我知道"
  },
  {
    "start": 33.76,
    "end": 34.6,
    "text": "為了買那個馬"
  },
  {
    "start": 34.6,
    "end": 36.04,
    "text": "我要犧牲很多別的消費"
  },
  {
    "start": 36.04,
    "end": 36.64,
    "text": "不值得"
  },
  {
    "start": 36.64,
    "end": 38.32,
    "text": "我侵限吃吃點好的藏粉"
  },
  {
    "start": 38.32,
    "end": 39.04,
    "text": "這個我比"
  },
  {
    "start": 39.04,
    "end": 41.2,
    "text": "令的這個包更讓我開啟"
  },
  {
    "start": 41.2,
    "end": 42.72,
    "text": "那個包不能證明我什麼的"
  },
  {
    "start": 42.72,
    "end": 44.96,
    "text": "我今天開了什麼本次來"
  },
  {
    "start": 44.96,
    "end": 46.32,
    "text": "你們會覺得我是大老闆嗎"
  },
  {
    "start": 46.32,
    "end": 46.84,
    "text": "不會吧"
  },
  {
    "start": 46.84,
    "end": 47.52,
    "text": "你們還知道"
  },
  {
    "start": 47.52,
    "end": 49.68,
    "text": "現在我原來是個銀行打工的"
  },
  {
    "start": 49.68,
    "end": 50.88,
    "text": "我今天其實還自信出來"
  },
  {
    "start": 50.88,
    "end": 52.28,
    "text": "你們也不會覺得我破產吧"
  },
  {
    "start": 52.28,
    "end": 53.92,
    "text": "那宣言還不是不窮的"
  },
  {
    "start": 53.92,
    "end": 54.32,
    "text": "對吧"
  },
  {
    "start": 54.32,
    "end": 56.04,
    "text": "原來打工還打得滿好的"
  },
  {
    "start": 56.04,
    "end": 57.72,
    "text": "我不要靠外才的東西"
  },
  {
    "start": 57.72,
    "end": 58.52,
    "text": "還要證明我什麼"
  },
  {
    "start": 58.52,
    "end": 59.52,
    "text": "當你還要靠這個"
  },
  {
    "start": 59.52,
    "end": 60.68,
    "text": "包來證明的的時候"
  },
  {
    "start": 60.68,
    "end": 61.68,
    "text": "你是很可憐"
  },
  {
    "start": 61.68,
    "end": 64.2,
    "text": "你還要再靠別人來定義你"
  },
  {
    "start": 64.2,
    "end": 64.92,
    "text": "為什麼呢"
  },
  {
    "start": 64.92,
    "end": 66.12,
    "text": "我現在查那個名牌"
  },
  {
    "start": 66.12,
    "end": 67.08,
    "text": "看見了沒有"
  },
  {
    "start": 67.08,
    "end": 67.96,
    "text": "路可路可"
  },
  {
    "start": 67.96,
    "end": 68.84,
    "text": "這叫名牌"
  },
  {
    "start": 68.84,
    "end": 70.56,
    "text": "我還希望從你的眼神裡"
  },
  {
    "start": 70.56,
    "end": 71.6,
    "text": "我得到一點自信"
  },
  {
    "start": 71.6,
    "end": 73.32,
    "text": "你還活在別人的眼神裡"
  },
  {
    "start": 73.32,
    "end": 74.28,
    "text": "這是很可憐的"
  },
  {
    "start": 74.28,
    "end": 75.32,
    "text": "所以說超前消費"
  },
  {
    "start": 75.32,
    "end": 76.52,
    "text": "這件事情是年輕人"
  },
  {
    "start": 76.52,
    "end": 78.2,
    "text": "我當然不能指索你什麼"
  },
  {
    "start": 78.2,
    "end": 79.36,
    "text": "你自己正前"
  },
  {
    "start": 79.36,
    "end": 80.48,
    "text": "你自己借錢"
  },
  {
    "start": 80.48,
    "end": 81.16,
    "text": "你消費"
  },
  {
    "start": 81.16,
    "end": 82.32,
    "text": "我尊重你"
  },
  {
    "start": 82.32,
    "end": 83.96,
    "text": "但是我不鼓勵你這樣"
  },
  {
    "start": 83.96,
    "end": 85.08,
    "text": "你又請你超前消費"
  },
  {
    "start": 85.08,
    "end": 85.84,
    "text": "你父母的錢"
  },
  {
    "start": 85.84,
    "end": 86.6,
    "text": "你更不道德"
  },
  {
    "start": 86.6,
    "end": 87.56,
    "text": "就像我女兒"
  },
  {
    "start": 87.56,
    "end": 89.12,
    "text": "他要花我的位置跟他說"
  },
  {
    "start": 89.12,
    "end": 90.32,
    "text": "你要做公務餐"
  },
  {
    "start": 90.32,
    "end": 91.4,
    "text": "可以的自己正"
  },
  {
    "start": 91.4,
    "end": 92.92,
    "text": "爸爸保證的油檔機票"
  },
  {
    "start": 92.92,
    "end": 94.52,
    "text": "但你做經濟廠處"
  },
  {
    "start": 94.52,
    "end": 95.72,
    "text": "我可以做公務餐"
  },
  {
    "start": 95.72,
    "end": 96.52,
    "text": "我自己正的錢"
  },
  {
    "start": 96.52,
    "end": 97.4,
    "text": "我可以做公務餐"
  },
  {
    "start": 97.4,
    "end": 99.24,
    "text": "你再往後弄一弄"
  },
  {
    "start": 99.24,
    "end": 100.96,
    "text": "你不能超前消費"
  },
  {
    "start": 100.96,
    "end": 101.52,
    "text": "我的錢"
  },
  {
    "start": 101.52,
    "end": 102.28,
    "text": "那了"
  },
  {
    "start": 102.28,
    "end": 103.16,
    "text": "陪父不認的"
  },
  {
    "start": 103.16,
    "end": 104.72,
    "text": "我們不要為品牌付錢"
  },
  {
    "start": 104.72,
    "end": 105.72,
    "text": "錢不容易的"
  },
  {
    "start": 105.72,
    "end": 106.76,
    "text": "這樣的消費"
  },
  {
    "start": 106.76,
    "end": 107.44,
    "text": "不性感的"
  },
  {
    "start": 107.44,
    "end": 108.24,
    "text": "也不聰明"
  },
  {
    "start": 108.24,
    "end": 109.76,
    "text": "買自己買的錢的東西"
  },
  {
    "start": 109.76,
    "end": 110.76,
    "text": "尤其在消費上"
  },
  {
    "start": 110.76,
    "end": 112.08,
    "text": "我們不要做一個傳人"
  },
  {
    "start": 112.08,
    "end": 114.56,
    "text": "不要做一個活在別人眼睛裡的人"
  }
]