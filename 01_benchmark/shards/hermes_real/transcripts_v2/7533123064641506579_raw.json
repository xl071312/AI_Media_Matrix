[
  {
    "start": 0.0,
    "end": 1.54,
    "text": "到底要等你怎么不进公司"
  },
  {
    "start": 1.54,
    "end": 2.4,
    "text": "同时时到呢"
  },
  {
    "start": 2.4,
    "end": 3.4,
    "text": "我们等得起时到"
  },
  {
    "start": 3.4,
    "end": 4.1,
    "text": "为什么"
  },
  {
    "start": 4.1,
    "end": 5.04,
    "text": "我意思来了"
  },
  {
    "start": 5.04,
    "end": 5.88,
    "text": "没事已经把他走"
  },
  {
    "start": 5.88,
    "end": 6.66,
    "text": "大雨"
  },
  {
    "start": 6.66,
    "end": 7.68,
    "text": "你钱让大家那一拳"
  },
  {
    "start": 7.68,
    "end": 8.7,
    "text": "比谁干的更多"
  },
  {
    "start": 8.7,
    "end": 10.24,
    "text": "结果是工作量越来越多"
  },
  {
    "start": 10.24,
    "end": 11.34,
    "text": "要扯越越来越高"
  },
  {
    "start": 11.34,
    "end": 12.54,
    "text": "所以我们有外卷"
  },
  {
    "start": 12.54,
    "end": 13.58,
    "text": "晚上都留下家老板"
  },
  {
    "start": 13.58,
    "end": 14.84,
    "text": "不会不会是下不了"
  },
  {
    "start": 14.84,
    "end": 16.14,
    "text": "你不干有的事人干"
  },
  {
    "start": 16.14,
    "end": 17.4,
    "text": "他搞不了我们也干"
  },
  {
    "start": 17.4,
    "end": 17.92,
    "text": "干"
  },
  {
    "start": 17.92,
    "end": 20.22,
    "text": "要彻底度觉你不干有的事人干这种现象"
  },
  {
    "start": 20.22,
    "end": 21.24,
    "text": "给老板您到一种"
  },
  {
    "start": 21.24,
    "end": 22.78,
    "text": "你不干大家都不干的攻击干"
  },
  {
    "start": 22.78,
    "end": 23.68,
    "text": "老板"
  },
  {
    "start": 23.68,
    "end": 25.08,
    "text": "偏偏我做文件经常太慢了"
  },
  {
    "start": 25.08,
    "end": 26.62,
    "text": "大家老板也都过上了"
  },
  {
    "start": 26.62,
    "end": 28.08,
    "text": "回家一起空气感觉"
  },
  {
    "start": 28.08,
    "end": 29.44,
    "text": "你不干吗包在一起"
  },
  {
    "start": 29.44,
    "end": 32.52,
    "text": "你干好啊闹闹你你你你你你你你你你你你你你怎么保重外卷呢"
  },
  {
    "start": 32.52,
    "end": 34.44,
    "text": "你永远像最差的同时看起"
  },
  {
    "start": 34.44,
    "end": 35.24,
    "text": "谁做得不好"
  },
  {
    "start": 35.24,
    "end": 36.48,
    "text": "我们就和他一样不好"
  },
  {
    "start": 36.48,
    "end": 37.88,
    "text": "这样团队就没有短板了"
  },
  {
    "start": 37.88,
    "end": 38.92,
    "text": "因为都是短板"
  },
  {
    "start": 38.92,
    "end": 41.12,
    "text": "共同阶势主体现在才能提升整体的雨啊"
  },
  {
    "start": 41.12,
    "end": 43.28,
    "text": "内卷最后的机会就是越绝带越差"
  },
  {
    "start": 43.28,
    "end": 44.56,
    "text": "内卷是不得算功的"
  },
  {
    "start": 44.56,
    "end": 45.56,
    "text": "内卷才能提升功的"
  },
  {
    "start": 45.56,
    "end": 46.96,
    "text": "我看老板在这儿什么呢"
  },
  {
    "start": 46.96,
    "end": 48.08,
    "text": "我看他倒不见了"
  },
  {
    "start": 48.08,
    "end": 48.92,
    "text": "他这一上"
  },
  {
    "start": 48.92,
    "end": 49.6,
    "text": "好远"
  },
  {
    "start": 49.6,
    "end": 51.72,
    "text": "这又这样这场环境才能得到改善"
  },
  {
    "start": 51.72,
    "end": 53.24,
    "text": "一些竟然不如一起合作"
  },
  {
    "start": 53.24,
    "end": 54.52,
    "text": "我电脑自己了"
  },
  {
    "start": 54.52,
    "end": 57.82,
    "text": "没事我跟佩妮一起死"
  },
  {
    "start": 57.98,
    "end": 59.22,
    "text": "得做到尽快同步啊"
  },
  {
    "start": 59.22,
    "end": 60.78,
    "text": "同时时到大家一起陪似到"
  },
  {
    "start": 60.78,
    "end": 61.98,
    "text": "请假的话大家一起醒假"
  },
  {
    "start": 61.98,
    "end": 62.7,
    "text": "水边拉起"
  },
  {
    "start": 62.7,
    "end": 63.86,
    "text": "我前下会一步个叫"
  },
  {
    "start": 63.86,
    "end": 65.3,
    "text": "昨晚洗一步等亮完开水就"
  },
  {
    "start": 65.3,
    "end": 66.14,
    "text": "太被海水减了"
  },
  {
    "start": 66.14,
    "end": 67.26,
    "text": "你早说啊"
  },
  {
    "start": 67.26,
    "end": 68.9,
    "text": "洗无快机的洗得很干净啊"
  },
  {
    "start": 68.9,
    "end": 70.5,
    "text": "像我用的蓝月的制度洗一净"
  },
  {
    "start": 70.5,
    "end": 71.5,
    "text": "非常饰都快洗"
  },
  {
    "start": 71.5,
    "end": 72.66,
    "text": "水量配方一秒容点"
  },
  {
    "start": 72.66,
    "end": 73.58,
    "text": "采用低刀技术"
  },
  {
    "start": 73.58,
    "end": 74.74,
    "text": "只需飘洗一到两次"
  },
  {
    "start": 74.74,
    "end": 75.5,
    "text": "而且不残留"
  },
  {
    "start": 75.5,
    "end": 77.18,
    "text": "我心无辜弄度高达40起"
  },
  {
    "start": 77.18,
    "end": 78.5,
    "text": "所以事势无辜弄也能洗干净"
  },
  {
    "start": 78.5,
    "end": 79.66,
    "text": "不用为洗一会花时间"
  },
  {
    "start": 79.66,
    "end": 81.02,
    "text": "这包装一看就挺高几的"
  },
  {
    "start": 81.02,
    "end": 81.7,
    "text": "那好了"
  },
  {
    "start": 81.86,
    "end": 83.3,
    "text": "大家思想多久抽钱吧"
  },
  {
    "start": 83.3,
    "end": 83.58,
    "text": "嗯"
  },
  {
    "start": 83.58,
    "end": 84.18,
    "text": "为什么"
  },
  {
    "start": 84.18,
    "end": 85.58,
    "text": "大家不光给自己们复理"
  },
  {
    "start": 85.58,
    "end": 86.46,
    "text": "还给没电公司的"
  },
  {
    "start": 86.46,
    "end": 87.5,
    "text": "这场人带来好处"
  },
  {
    "start": 87.5,
    "end": 89.14,
    "text": "很像人是在照片软件上"
  },
  {
    "start": 89.14,
    "end": 90.1,
    "text": "挂出一样高于通行"
  },
  {
    "start": 90.1,
    "end": 91.14,
    "text": "价格的照人心子"
  },
  {
    "start": 91.14,
    "end": 92.42,
    "text": "给其他公司的照片压力"
  },
  {
    "start": 92.42,
    "end": 93.86,
    "text": "然后我们会在照片软件上"
  },
  {
    "start": 93.86,
    "end": 94.62,
    "text": "定期投减力"
  },
  {
    "start": 94.62,
    "end": 95.82,
    "text": "当他们学义机王心思的时候"
  },
  {
    "start": 95.82,
    "end": 96.38,
    "text": "不晚多少"
  },
  {
    "start": 96.38,
    "end": 97.18,
    "text": "都会告诉他们"
  },
  {
    "start": 97.18,
    "end": 98.42,
    "text": "你们公司实在太低了"
  },
  {
    "start": 98.42,
    "end": 99.7,
    "text": "给照公司的人模许复理"
  },
  {
    "start": 99.7,
    "end": 100.7,
    "text": "你们还挺团结的"
  },
  {
    "start": 100.7,
    "end": 101.94,
    "text": "大家本来就是一家人"
  },
  {
    "start": 101.94,
    "end": 103.46,
    "text": "打工人和别媒家打工人"
  },
  {
    "start": 103.46,
    "end": 104.18,
    "text": "虽然不认识"
  },
  {
    "start": 104.18,
    "end": 105.66,
    "text": "确想见可能帮助大家"
  },
  {
    "start": 105.66,
    "end": 106.06,
    "text": "来"
  },
  {
    "start": 106.06,
    "end": 107.22,
    "text": "这个项目你们复理一下"
  },
  {
    "start": 108.02,
    "end": 109.02,
    "text": "你知道我不会啊"
  },
  {
    "start": 109.02,
    "end": 109.46,
    "text": "你不会不会"
  },
  {
    "start": 109.46,
    "end": 110.54,
    "text": "我不会"
  },
  {
    "start": 110.54,
    "end": 111.38,
    "text": "到底会不会"
  },
  {
    "start": 111.38,
    "end": 112.38,
    "text": "会不会"
  }
]