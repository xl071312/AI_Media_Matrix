[
  {
    "start": 0.0,
    "end": 2.54,
    "text": "只需要这三部一定可以财务自由"
  },
  {
    "start": 2.54,
    "end": 4.04,
    "text": "按我说的方法去做"
  },
  {
    "start": 4.04,
    "end": 4.84,
    "text": "第一部"
  },
  {
    "start": 4.84,
    "end": 6.84,
    "text": "你要有一个稳定的收入来源"
  },
  {
    "start": 6.84,
    "end": 8.5,
    "text": "也就说你必须得有一份工作"
  },
  {
    "start": 8.5,
    "end": 10.5,
    "text": "而不是靠投资报复"
  },
  {
    "start": 10.5,
    "end": 12.0,
    "text": "报复的钱你根本拿不住"
  },
  {
    "start": 12.0,
    "end": 12.94,
    "text": "上班也好"
  },
  {
    "start": 12.94,
    "end": 14.1,
    "text": "公务员世界边也好"
  },
  {
    "start": 14.1,
    "end": 16.28,
    "text": "民营企业或者是自己开个小商店"
  },
  {
    "start": 16.28,
    "end": 17.64,
    "text": "卖烧烤百几天"
  },
  {
    "start": 17.64,
    "end": 18.64,
    "text": "这些都不重要"
  },
  {
    "start": 18.64,
    "end": 19.56,
    "text": "重要的是"
  },
  {
    "start": 19.56,
    "end": 21.64,
    "text": "你必须要有稳定的收入"
  },
  {
    "start": 21.64,
    "end": 22.44,
    "text": "当然"
  },
  {
    "start": 22.44,
    "end": 23.14,
    "text": "发尔戴出来"
  },
  {
    "start": 23.14,
    "end": 24.64,
    "text": "发尔戴直接跳到最后一部"
  },
  {
    "start": 24.64,
    "end": 25.44,
    "text": "第二部"
  },
  {
    "start": 25.44,
    "end": 27.92,
    "text": "你要尽可能的存更多的钱"
  },
  {
    "start": 27.92,
    "end": 29.4,
    "text": "你赚到了稳定的收入"
  },
  {
    "start": 29.4,
    "end": 30.66,
    "text": "钱也会出去"
  },
  {
    "start": 30.66,
    "end": 32.26,
    "text": "你会有开销花费"
  },
  {
    "start": 32.26,
    "end": 34.26,
    "text": "买一些商家营销给你的东西"
  },
  {
    "start": 34.26,
    "end": 35.42,
    "text": "商家告诉你"
  },
  {
    "start": 35.42,
    "end": 36.84,
    "text": "你必须得买我的东西"
  },
  {
    "start": 36.84,
    "end": 37.92,
    "text": "人生才完整"
  },
  {
    "start": 37.92,
    "end": 38.92,
    "text": "你就去买"
  },
  {
    "start": 38.92,
    "end": 40.42,
    "text": "钱就这样留事掉了"
  },
  {
    "start": 40.42,
    "end": 42.52,
    "text": "你根本没有财务可以化的能力"
  },
  {
    "start": 42.52,
    "end": 43.98,
    "text": "不知道要很存的存钱"
  },
  {
    "start": 43.98,
    "end": 44.98,
    "text": "就存不下钱"
  },
  {
    "start": 44.98,
    "end": 46.08,
    "text": "所以第二部"
  },
  {
    "start": 46.08,
    "end": 47.62,
    "text": "规格结底是什么"
  },
  {
    "start": 47.62,
    "end": 49.98,
    "text": "存近可能大比例的钱"
  },
  {
    "start": 49.98,
    "end": 51.92,
    "text": "比如一个月这一万"
  },
  {
    "start": 51.92,
    "end": 53.58,
    "text": "你至少给我存五千"
  },
  {
    "start": 53.58,
    "end": 54.62,
    "text": "存一半"
  },
  {
    "start": 54.62,
    "end": 55.62,
    "text": "要学会存钱"
  },
  {
    "start": 55.62,
    "end": 57.92,
    "text": "每个月尽可能多的存钱"
  },
  {
    "start": 57.92,
    "end": 58.92,
    "text": "第三部"
  },
  {
    "start": 58.92,
    "end": 59.92,
    "text": "也就是最后一部"
  },
  {
    "start": 59.92,
    "end": 61.12,
    "text": "要学会投资"
  },
  {
    "start": 61.12,
    "end": 62.42,
    "text": "因为你存的钱"
  },
  {
    "start": 62.42,
    "end": 64.42,
    "text": "不是让你花的"
  },
  {
    "start": 64.42,
    "end": 65.92,
    "text": "你的钱是你的兵"
  },
  {
    "start": 65.92,
    "end": 66.72,
    "text": "让你的兵"
  },
  {
    "start": 66.72,
    "end": 68.02,
    "text": "去为你工作"
  },
  {
    "start": 68.02,
    "end": 69.72,
    "text": "那么所以你有了营离之后"
  },
  {
    "start": 69.72,
    "end": 71.22,
    "text": "直接去做定头"
  },
  {
    "start": 71.22,
    "end": 72.82,
    "text": "不要乱七八糟的去买什么"
  },
  {
    "start": 72.82,
    "end": 74.52,
    "text": "比加尢尴做短线"
  },
  {
    "start": 74.52,
    "end": 76.12,
    "text": "都不要"
  },
  {
    "start": 76.12,
    "end": 77.62,
    "text": "你只要做那些"
  },
  {
    "start": 77.62,
    "end": 79.02,
    "text": "信心苦苦赚的钱"
  },
  {
    "start": 79.02,
    "end": 80.42,
    "text": "都会恢复一眼灭"
  },
  {
    "start": 80.42,
    "end": 81.42,
    "text": "甚至会复占"
  },
  {
    "start": 81.42,
    "end": 82.62,
    "text": "你不要复占"
  },
  {
    "start": 82.62,
    "end": 83.82,
    "text": "就做定头听我的"
  },
  {
    "start": 83.82,
    "end": 85.12,
    "text": "不要去买各股"
  },
  {
    "start": 85.12,
    "end": 87.52,
    "text": "就做指数基金的定头"
  },
  {
    "start": 87.52,
    "end": 88.32,
    "text": "你如果不会"
  },
  {
    "start": 88.32,
    "end": 89.82,
    "text": "下期我出个教程"
  },
  {
    "start": 89.82,
    "end": 90.72,
    "text": "你这样做"
  },
  {
    "start": 90.72,
    "end": 92.02,
    "text": "几乎百分之百"
  },
  {
    "start": 92.02,
    "end": 93.02,
    "text": "就可以财务自由"
  },
  {
    "start": 93.02,
    "end": 94.32,
    "text": "你玩的些比加尢尔"
  },
  {
    "start": 94.32,
    "end": 96.62,
    "text": "有可能百分之十提前让你自由"
  },
  {
    "start": 96.62,
    "end": 98.52,
    "text": "但是有百分的90"
  },
  {
    "start": 98.52,
    "end": 99.92,
    "text": "你可能会一无所有"
  },
  {
    "start": 99.92,
    "end": 101.32,
    "text": "定头是第一风险"
  },
  {
    "start": 101.32,
    "end": 103.32,
    "text": "很多人觉得第一收益"
  },
  {
    "start": 103.32,
    "end": 104.72,
    "text": "但是我跟你说个数字"
  },
  {
    "start": 104.72,
    "end": 105.82,
    "text": "那死打可以百"
  },
  {
    "start": 105.82,
    "end": 107.72,
    "text": "和标铺百大家听说过吧"
  },
  {
    "start": 107.72,
    "end": 109.62,
    "text": "那么平均定头的收益率"
  },
  {
    "start": 109.62,
    "end": 111.52,
    "text": "大概有百分之十"
  },
  {
    "start": 111.52,
    "end": 112.52,
    "text": "这可不定了"
  },
  {
    "start": 112.52,
    "end": 114.72,
    "text": "而且是复理年化百分之十"
  },
  {
    "start": 114.72,
    "end": 115.92,
    "text": "你头实亡快钱"
  },
  {
    "start": 115.92,
    "end": 117.62,
    "text": "比如你现在25岁"
  },
  {
    "start": 117.62,
    "end": 118.42,
    "text": "等20年后"
  },
  {
    "start": 118.42,
    "end": 119.32,
    "text": "你45"
  },
  {
    "start": 119.32,
    "end": 120.52,
    "text": "你可以算一算"
  },
  {
    "start": 120.52,
    "end": 122.12,
    "text": "一点意的24房"
  },
  {
    "start": 122.12,
    "end": 124.02,
    "text": "大概就翻了7倍左右"
  },
  {
    "start": 124.02,
    "end": 125.52,
    "text": "那么你的10万快钱"
  },
  {
    "start": 125.52,
    "end": 127.22,
    "text": "就大概变成了70万"
  },
  {
    "start": 127.22,
    "end": 129.72,
    "text": "这就是复理的历害"
  },
  {
    "start": 129.72,
    "end": 130.92,
    "text": "我们现在要做的"
  },
  {
    "start": 130.92,
    "end": 132.12,
    "text": "就是努力存钱"
  },
  {
    "start": 132.12,
    "end": 133.12,
    "text": "等350年"
  },
  {
    "start": 133.12,
    "end": 133.92,
    "text": "到那时候"
  },
  {
    "start": 133.92,
    "end": 134.92,
    "text": "你手里有一笔钱"
  },
  {
    "start": 134.92,
    "end": 135.42,
    "text": "拿一些钱"
  },
  {
    "start": 135.42,
    "end": 136.32,
    "text": "定头进去"
  },
  {
    "start": 136.32,
    "end": 137.42,
    "text": "到2025年"
  },
  {
    "start": 137.42,
    "end": 138.22,
    "text": "再过20年"
  },
  {
    "start": 138.22,
    "end": 139.92,
    "text": "你就才不最有了"
  },
  {
    "start": 139.92,
    "end": 141.32,
    "text": "这才是真的才不最有"
  },
  {
    "start": 141.32,
    "end": 142.32,
    "text": "定头续很简单"
  },
  {
    "start": 142.32,
    "end": 143.12,
    "text": "你愿意问"
  },
  {
    "start": 143.12,
    "end": 144.72,
    "text": "曾五千拿一部分"
  },
  {
    "start": 144.72,
    "end": 145.72,
    "text": "比如一千块钱"
  },
  {
    "start": 145.72,
    "end": 146.44,
    "text": "每个月"
  },
  {
    "start": 146.44,
    "end": 147.12,
    "text": "所定头"
  },
  {
    "start": 147.12,
    "end": 148.32,
    "text": "或者每天"
  },
  {
    "start": 148.32,
    "end": 149.92,
    "text": "或者每周都可以"
  },
  {
    "start": 149.92,
    "end": 150.72,
    "text": "通什么呢"
  },
  {
    "start": 150.72,
    "end": 152.72,
    "text": "只数几间听好了"
  },
  {
    "start": 152.72,
    "end": 154.12,
    "text": "不是听小当消息说"
  },
  {
    "start": 154.12,
    "end": 155.12,
    "text": "谁要找消跌"
  },
  {
    "start": 155.12,
    "end": 156.72,
    "text": "我就去追掌啥跌"
  },
  {
    "start": 156.72,
    "end": 159.12,
    "text": "而是要买全市场的指出几几"
  },
  {
    "start": 159.12,
    "end": 160.92,
    "text": "除非系统性的风险"
  },
  {
    "start": 160.92,
    "end": 161.72,
    "text": "地球毁灭"
  },
  {
    "start": 161.72,
    "end": 162.52,
    "text": "经济崩潰"
  },
  {
    "start": 162.52,
    "end": 163.52,
    "text": "国家分裂"
  },
  {
    "start": 163.52,
    "end": 165.52,
    "text": "这种极低概率的时间"
  },
  {
    "start": 165.52,
    "end": 168.52,
    "text": "否则他永远会稳定的上场"
  },
  {
    "start": 168.52,
    "end": 170.12,
    "text": "赚钱就这么简单"
  },
  {
    "start": 170.12,
    "end": 172.52,
    "text": "但第一步你要做好稳定工作"
  },
  {
    "start": 172.52,
    "end": 173.32,
    "text": "稳定收入"
  },
  {
    "start": 173.32,
    "end": 174.52,
    "text": "然后不断的分钱"
  },
  {
    "start": 174.52,
    "end": 175.52,
    "text": "不断的投资"
  },
  {
    "start": 175.52,
    "end": 176.72,
    "text": "像滚雪球一样"
  },
  {
    "start": 176.72,
    "end": 177.92,
    "text": "慢慢的变大"
  },
  {
    "start": 177.92,
    "end": 179.52,
    "text": "一边有现金流进来"
  },
  {
    "start": 179.52,
    "end": 181.32,
    "text": "一边有背动的收入进来"
  },
  {
    "start": 181.32,
    "end": 182.32,
    "text": "你永远在花"
  },
  {
    "start": 182.32,
    "end": 183.12,
    "text": "你的利息"
  },
  {
    "start": 183.12,
    "end": 184.52,
    "text": "本金根本就花不到"
  },
  {
    "start": 184.52,
    "end": 185.92,
    "text": "这就是才不自由"
  },
  {
    "start": 185.92,
    "end": 187.32,
    "text": "关注下期"
  },
  {
    "start": 187.32,
    "end": 189.12,
    "text": "我教你具体怎么去做"
  }
]