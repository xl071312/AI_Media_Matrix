  {
    "start": 371.6,
    "end": 372.36,
    "text": "獲得了利潤"
  },
  {
    "start": 372.36,
    "end": 373.6,
    "text": "國家拉動了消費"
  },
  {
    "start": 373.6,
    "end": 374.40000000000003,
