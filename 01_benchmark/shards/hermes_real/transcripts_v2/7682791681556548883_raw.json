  },
  {
    "start": 426.28000000000003,
    "end": 427.48,
    "text": "他們也能夠從時代"
  },
  {
    "start": 427.48,
    "end": 428.6,
    "text": "轉型的浪潮當中"
  },
  {
    "start": 428.6,
    "end": 430.00000000000006,
    "text": "找到屬於自己的基於"
  },
  {
    "start": 430.00000000000006,
    "end": 431.04,
    "text": "請掉記住"
  },
  {
    "start": 431.04,
    "end": 432.16,
    "text": "靠自己的雙手"
  },
  {
    "start": 432.16,
    "end": 433.48,
