  {
    "start": 414.36,
    "end": 415.08000000000004,
    "text": "不停的感嘆"
  },
  {
    "start": 415.08000000000004,
    "end": 416.96000000000004,
    "text": "為何吃不到時代的紅麗"
  },
  {
    "start": 416.96000000000004,
    "end": 417.76000000000005,
