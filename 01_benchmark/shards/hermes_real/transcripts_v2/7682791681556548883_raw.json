  {
    "start": 420.20000000000005,
    "end": 421.64000000000004,
    "text": "未來十年的財富"
  },
  {
    "start": 421.64000000000004,
    "end": 422.84000000000003,
    "text": "不會全部留給做"
  },
  {
    "start": 422.84000000000003,
    "end": 424.08000000000004,
