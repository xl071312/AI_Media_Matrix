[
  {
    "start": 0.11,
    "end": 1.35,
    "text": "大哥"
  },
  {
    "start": 1.83,
    "end": 3.35,
    "text": "你不得了呀"
  },
  {
    "start": 3.35,
    "end": 4.87,
    "text": "有一道灵光"
  },
  {
    "start": 4.87,
    "end": 7.23,
    "text": "从你的天灵构配了出来"
  },
  {
    "start": 7.23,
    "end": 10.07,
    "text": "一看就是大夫大规的命呀"
  },
  {
    "start": 10.47,
    "end": 11.95,
    "text": "你别带着去"
  },
  {
    "start": 12.23,
    "end": 13.35,
    "text": "三命的话"
  },
  {
    "start": 13.35,
    "end": 14.67,
    "text": "给我烤不去"
  },
  {
    "start": 14.67,
    "end": 16.43,
    "text": "你无辜吗"
  },
  {
    "start": 16.43,
    "end": 17.87,
    "text": "我就是问问你"
  },
  {
    "start": 17.87,
    "end": 19.83,
    "text": "想不想加木根奶茶店"
  },
  {
    "start": 19.83,
    "end": 21.55,
    "text": "創意也到老板"
  },
  {
    "start": 22.55,
    "end": 24.47,
    "text": "我是靠脸吃饭"
  },
  {
    "start": 24.71,
    "end": 26.15,
    "text": "創意脸和饭"
  },
  {
    "start": 26.15,
    "end": 27.71,
    "text": "是对我最大的"
  },
  {
    "start": 27.71,
    "end": 30.31,
    "text": "靠脸吃的是清吹饭"
  },
  {
    "start": 30.31,
    "end": 32.15,
    "text": "你长得睡不觉"
  },
  {
    "start": 32.15,
    "end": 33.67,
    "text": "可等你60岁了"
  },
  {
    "start": 33.67,
    "end": 35.63,
    "text": "谁还愿意看你这招脸"
  },
  {
    "start": 35.63,
    "end": 37.31,
    "text": "到时候你靠杀吃饭"
  },
  {
    "start": 37.31,
    "end": 39.43,
    "text": "你说得有点道理"
  },
  {
    "start": 39.43,
    "end": 41.63,
    "text": "你刚才说让我加木杀"
  },
  {
    "start": 41.63,
    "end": 43.71,
    "text": "千杯不醉奶茶店"
  },
  {
    "start": 43.71,
    "end": 44.63,
    "text": "在全国"
  },
  {
    "start": 44.63,
    "end": 46.27,
    "text": "便不两家份店"
  },
  {
    "start": 46.27,
    "end": 47.63,
    "text": "非常有名"
  },
  {
    "start": 47.63,
    "end": 49.47,
    "text": "加蒙这碗"
  },
  {
    "start": 49.47,
    "end": 50.67,
    "text": "能动多少钱"
  },
  {
    "start": 50.67,
    "end": 53.27,
    "text": "营丽国色天香的气质"
  },
  {
    "start": 53.27,
    "end": 55.51,
    "text": "加上我们品牌的影响力"
  },
  {
    "start": 55.95,
    "end": 57.59,
    "text": "一年这个四五百万"
  },
  {
    "start": 57.59,
    "end": 58.79,
    "text": "不成为体"
  },
  {
    "start": 58.79,
    "end": 60.19,
    "text": "能赚这么多"
  },
  {
    "start": 60.19,
    "end": 61.23,
    "text": "对呀"
  },
  {
    "start": 61.23,
    "end": 62.07,
    "text": "我给你看看"
  },
  {
    "start": 62.07,
    "end": 68.12,
    "text": "我们奶茶店的火爆凝炒面"
  },
  {
    "start": 68.12,
    "end": 70.0,
    "text": "这些人全是同"
  },
  {
    "start": 70.0,
    "end": 71.96,
    "text": "都是充着我们品牌来的"
  },
  {
    "start": 71.96,
    "end": 74.28,
    "text": "每天24小时开对购面"
  },
  {
    "start": 74.28,
    "end": 75.64,
    "text": "都公布19"
  },
  {
    "start": 76.12,
    "end": 77.04,
    "text": "不错"
  },
  {
    "start": 78.04,
    "end": 79.44,
    "text": "加木费多少"
  },
  {
    "start": 79.44,
    "end": 80.44,
    "text": "你不得"
  },
  {
    "start": 80.44,
    "end": 81.6,
    "text": "五万八"
  },
  {
    "start": 81.6,
    "end": 83.48,
    "text": "只要你交了加木费"
  },
  {
    "start": 83.48,
    "end": 85.48,
    "text": "我给你提供奶茶色费"
  },
  {
    "start": 85.48,
    "end": 86.72,
    "text": "勾兑配方"
  },
  {
    "start": 86.72,
    "end": 88.6,
    "text": "会帮你宣传也留"
  },
  {
    "start": 88.6,
    "end": 90.0,
    "text": "开店选值"
  },
  {
    "start": 90.0,
    "end": 92.0,
    "text": "祝你走上人生电风"
  },
  {
    "start": 92.0,
    "end": 93.68,
    "text": "开店选值很重要"
  },
  {
    "start": 93.68,
    "end": 94.8,
    "text": "如果选不好了"
  },
  {
    "start": 94.8,
    "end": 96.6,
    "text": "投多少钱都得打出票"
  },
  {
    "start": 96.6,
    "end": 98.0,
    "text": "你打算让我把电"
  },
  {
    "start": 98.0,
    "end": 99.0,
    "text": "开到哪儿"
  },
  {
    "start": 99.64,
    "end": 101.4,
    "text": "那边有个公测"
  },
  {
    "start": 101.4,
    "end": 103.28,
    "text": "把电开到公测旁边"
  },
  {
    "start": 103.28,
    "end": 104.88,
    "text": "人家上面上外测索"
  },
  {
    "start": 104.88,
    "end": 106.52,
    "text": "肯定又可以力"
  },
  {
    "start": 106.52,
    "end": 108.44,
    "text": "这时喝上一杯奶茶"
  },
  {
    "start": 108.44,
    "end": 109.44,
    "text": "多好"
  },
  {
    "start": 109.84,
    "end": 111.6,
    "text": "我还是自己选值吧"
  },
  {
    "start": 111.6,
    "end": 113.4,
    "text": "你自己会选吗"
  },
  {
    "start": 113.4,
    "end": 114.6,
    "text": "我不会"
  },
  {
    "start": 114.6,
    "end": 116.2,
    "text": "但我有上上餐猫"
  },
  {
    "start": 116.2,
    "end": 117.52,
    "text": "他上门的光得"
  },
  {
    "start": 117.52,
    "end": 119.16,
    "text": "赏茶数据茶品牌"
  },
  {
    "start": 119.16,
    "end": 120.8,
    "text": "特资和我们想开店的人"
  },
  {
    "start": 120.8,
    "end": 121.36,
    "text": "客流量"
  },
  {
    "start": 121.36,
    "end": 122.12,
    "text": "整体画像"
  },
  {
    "start": 122.12,
    "end": 122.92,
    "text": "竞争情况"
  },
  {
    "start": 122.92,
    "end": 124.36,
    "text": "都能一件事从报告"
  },
  {
    "start": 124.36,
    "end": 125.76,
    "text": "上面还有找迫功能"
  },
  {
    "start": 125.76,
    "end": 126.8,
    "text": "提供位置屏幕"
  },
  {
    "start": 126.8,
    "end": 128.4,
    "text": "可以帮我们省很多时间"
  },
  {
    "start": 128.4,
    "end": 129.64,
    "text": "遇了不省坑"
  },
  {
    "start": 129.64,
    "end": 130.44,
    "text": "用上上餐猫"
  },
  {
    "start": 130.44,
    "end": 131.76,
    "text": "选对项目和位置"
  },
  {
    "start": 131.76,
    "end": 133.16,
    "text": "才不会稅不如乌归"
  },
  {
    "start": 133.16,
    "end": 134.36,
    "text": "推荐你也就这样"
  },
  {
    "start": 134.36,
    "end": 135.4,
    "text": "行"
  },
  {
    "start": 135.4,
    "end": 137.0,
    "text": "既然选值定好了"
  },
  {
    "start": 137.0,
    "end": 138.84,
    "text": "那就把加木费交一下吧"
  },
  {
    "start": 138.84,
    "end": 140.48,
    "text": "我给你办手去"
  },
  {
    "start": 140.48,
    "end": 142.24,
    "text": "说起加木费"
  },
  {
    "start": 142.24,
    "end": 144.48,
    "text": "我想起了我36书"
  },
  {
    "start": 144.48,
    "end": 146.12,
    "text": "人家说他头长的大"
  },
  {
    "start": 146.12,
    "end": 147.4,
    "text": "加木猫费店"
  },
  {
    "start": 147.4,
    "end": 148.56,
    "text": "实定能发裁"
  },
  {
    "start": 148.56,
    "end": 150.68,
    "text": "还说会帮忙宣传引人"
  },
  {
    "start": 150.68,
    "end": 151.84,
    "text": "合作精英"
  },
  {
    "start": 151.84,
    "end": 152.4,
    "text": "嘿"
  },
  {
    "start": 152.4,
    "end": 153.56,
    "text": "我36书"
  },
  {
    "start": 153.56,
    "end": 154.72,
    "text": "脑子一日了"
  },
  {
    "start": 154.72,
    "end": 157.0,
    "text": "加木费店就交了8万"
  },
  {
    "start": 157.0,
    "end": 158.56,
    "text": "然后又借钱"
  },
  {
    "start": 158.56,
    "end": 159.76,
    "text": "投了40万"
  },
  {
    "start": 159.76,
    "end": 161.28,
    "text": "还没等开一眼呢"
  },
  {
    "start": 161.28,
    "end": 162.4,
    "text": "人家品牌方"
  },
  {
    "start": 162.4,
    "end": 163.76,
    "text": "批工跑路了"
  },
  {
    "start": 163.76,
    "end": 165.6,
    "text": "批工跑路了吗"
  },
  {
    "start": 166.6,
    "end": 168.32,
    "text": "被到同行呢"
  },
  {
    "start": 168.32,
    "end": 169.76,
    "text": "后来才知道"
  },
  {
    "start": 169.76,
    "end": 171.88,
    "text": "人家就是收购加木费"
  },
  {
    "start": 171.88,
    "end": 174.12,
    "text": "说好的系统管理宣传引人"
  },
  {
    "start": 174.12,
    "end": 175.56,
    "text": "加根不存在"
  },
  {
    "start": 175.56,
    "end": 177.16,
    "text": "可连我36书"
  },
  {
    "start": 177.16,
    "end": 178.4,
    "text": "赔了个金光"
  },
  {
    "start": 178.4,
    "end": 179.52,
    "text": "只能拿着骨"
  },
  {
    "start": 179.52,
    "end": 181.04,
    "text": "到处要犯事"
  },
  {
    "start": 181.04,
    "end": 182.4,
    "text": "我36书"
  },
  {
    "start": 182.4,
    "end": 183.72,
    "text": "也生气改价"
  },
  {
    "start": 183.72,
    "end": 184.96,
    "text": "那就一个惨"
  },
  {
    "start": 186.44,
    "end": 187.56,
    "text": "来"
  },
  {
    "start": 187.56,
    "end": 190.12,
    "text": "你不会也是骗加木费的吧"
  },
  {
    "start": 190.12,
    "end": 191.36,
    "text": "是"
  },
  {
    "start": 191.36,
    "end": 192.84,
    "text": "不是"
  },
  {
    "start": 192.84,
    "end": 195.0,
    "text": "我做的是梁星美美"
  },
  {
    "start": 195.0,
    "end": 197.2,
    "text": "你赶紧把加木费交一下吧"
  },
  {
    "start": 197.2,
    "end": 198.72,
    "text": "不急"
  },
  {
    "start": 198.72,
    "end": 199.88,
    "text": "加木头子"
  },
  {
    "start": 199.88,
    "end": 201.12,
    "text": "不是小事"
  },
  {
    "start": 201.12,
    "end": 203.24,
    "text": "我再做儿子上那上去"
  },
  {
    "start": 203.24,
    "end": 205.84,
    "text": "给你儿子少量"
  },
  {
    "start": 205.84,
    "end": 207.56,
    "text": "你儿子都大了"
  },
  {
    "start": 207.56,
    "end": 208.56,
    "text": "我是"
  },
  {
    "start": 208.56,
    "end": 210.52,
    "text": "你睡了"
  },
  {
    "start": 210.52,
    "end": 212.08,
    "text": "该上大雪了吧"
  },
  {
    "start": 212.08,
    "end": 213.68,
    "text": "你已经上大二"
  },
  {
    "start": 213.68,
    "end": 214.68,
    "text": "再有一年了"
  },
  {
    "start": 214.68,
    "end": 215.76,
    "text": "就毕竟了"
  },
  {
    "start": 215.76,
    "end": 217.92,
    "text": "你儿子真有出血"
  },
  {
    "start": 217.92,
    "end": 219.56,
    "text": "我儿子也无睡了"
  },
  {
    "start": 219.56,
    "end": 221.2,
    "text": "一天哭闹好几回"
  },
  {
    "start": 221.2,
    "end": 222.88,
    "text": "一家一度不会"
  },
  {
    "start": 222.88,
    "end": 224.8,
    "text": "那是你儿子没开车了"
  },
  {
    "start": 224.8,
    "end": 225.72,
    "text": "我在那边"
  },
  {
    "start": 225.72,
    "end": 227.12,
    "text": "开了一家屁股机构"
  },
  {
    "start": 227.12,
    "end": 228.08,
    "text": "关门从事儿"
  },
  {
    "start": 228.08,
    "end": 229.44,
    "text": "从打到看大工作"
  },
  {
    "start": 229.44,
    "end": 231.04,
    "text": "从我这儿走出去的孩子"
  },
  {
    "start": 231.04,
    "end": 233.28,
    "text": "最低也是称花北大的水平"
  },
  {
    "start": 233.28,
    "end": 234.16,
    "text": "真的"
  },
  {
    "start": 234.16,
    "end": 235.68,
    "text": "我骗你干吗"
  },
  {
    "start": 235.68,
    "end": 236.8,
    "text": "你听我呢"
  },
  {
    "start": 236.8,
    "end": 238.64,
    "text": "你每一个六万六的可充"
  },
  {
    "start": 238.64,
    "end": 240.24,
    "text": "给孩子开起天眼"
  },
  {
    "start": 240.24,
    "end": 241.24,
    "text": "几活打到"
  },
  {
    "start": 241.24,
    "end": 242.84,
    "text": "赴于无限钱的"
  },
  {
    "start": 242.84,
    "end": 243.76,
    "text": "你的孩子"
  },
  {
    "start": 243.76,
    "end": 245.32,
    "text": "就是下一个马斯克"
  },
  {
    "start": 245.32,
    "end": 246.68,
    "text": "钱通不了"
  },
  {
    "start": 246.68,
    "end": 248.48,
    "text": "真的吗"
  },
  {
    "start": 248.48,
    "end": 249.84,
    "text": "我的孩子"
  },
  {
    "start": 249.84,
    "end": 251.32,
    "text": "真的可以吗"
  },
  {
    "start": 251.32,
    "end": 252.72,
    "text": "你要消息孩子"
  },
  {
    "start": 252.72,
    "end": 253.84,
    "text": "他一定可以"
  },
  {
    "start": 253.84,
    "end": 254.44,
    "text": "走"
  },
  {
    "start": 254.44,
    "end": 255.76,
    "text": "我带你去办手区"
  },
  {
    "start": 255.76,
    "end": 256.76,
    "text": "孩子是"
  },
  {
    "start": 256.76,
    "end": 257.76,
    "text": "带我"
  },
  {
    "start": 257.76,
    "end": 260.76,
    "text": "干了"
  },
  {
    "start": 260.76,
    "end": 262.76,
    "text": "六万六的可充"
  },
  {
    "start": 262.76,
    "end": 264.76,
    "text": "是不是有点跪呀"
  },
  {
    "start": 264.76,
    "end": 266.76,
    "text": "相比于孩子钱脱"
  },
  {
    "start": 266.76,
    "end": 267.76,
    "text": "一点都不跪"
  },
  {
    "start": 267.76,
    "end": 269.76,
    "text": "你确实为了孩子吗"
  },
  {
    "start": 269.76,
    "end": 274.19,
    "text": "你确实为了孩子"
  },
  {
    "start": 274.19,
    "end": 275.19,
    "text": "那你走吧"
  },
  {
    "start": 275.19,
    "end": 279.08,
    "text": "你这儿相比你还说可"
  },
  {
    "start": 279.08,
    "end": 281.08,
    "text": "资料警的行"
  },
  {
    "start": 281.08,
    "end": 282.08,
    "text": "就已经没吃到钱了"
  },
  {
    "start": 282.08,
    "end": 284.08,
    "text": "你没钱呀"
  },
  {
    "start": 284.08,
    "end": 285.08,
    "text": "没事"
  },
  {
    "start": 285.08,
    "end": 286.08,
    "text": "你回家来办事"
  },
  {
    "start": 286.08,
    "end": 287.08,
    "text": "你回家来办事"
  },
  {
    "start": 287.08,
    "end": 288.08,
    "text": "我回家去"
  }
]