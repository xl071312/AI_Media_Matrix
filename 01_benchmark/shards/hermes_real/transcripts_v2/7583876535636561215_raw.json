[
  {
    "start": 0.0,
    "end": 1.6,
    "text": "不上班但是赚钱的方法"
  },
  {
    "start": 1.6,
    "end": 4.88,
    "text": "今天交给你记住在这个时代最大的片去"
  },
  {
    "start": 4.88,
    "end": 7.84,
    "text": "就是让你以为只有上班才能够活下去"
  },
  {
    "start": 7.84,
    "end": 10.24,
    "text": "很多人一辈子拿着可遇见的工资"
  },
  {
    "start": 10.24,
    "end": 11.68,
    "text": "过着可遇见的人生"
  },
  {
    "start": 11.68,
    "end": 13.2,
    "text": "却从来没有想过"
  },
  {
    "start": 13.2,
    "end": 17.08,
    "text": "为什么有的人不上班却活得比你资认时辈"
  },
  {
    "start": 17.08,
    "end": 18.48,
    "text": "那打案只有一句话"
  },
  {
    "start": 18.48,
    "end": 20.4,
    "text": "别把时间卖给一个老板"
  },
  {
    "start": 20.4,
    "end": 22.88,
    "text": "把技能卖给100个客户"
  },
  {
    "start": 22.88,
    "end": 25.52,
    "text": "这个就是富裔的真正的底层国际"
  },
  {
    "start": 25.52,
    "end": 26.56,
    "text": "你不是打灵工"
  },
  {
    "start": 26.56,
    "end": 29.28,
    "text": "你现在搭建一个属于自己的变现的系统"
  },
  {
    "start": 29.28,
    "end": 32.24,
    "text": "为什么要去做富裔上班的模式"
  },
  {
    "start": 32.24,
    "end": 33.84,
    "text": "是工业时代的厂物"
  },
  {
    "start": 33.84,
    "end": 36.96,
    "text": "你把八个小时卖给公司看四文定"
  },
  {
    "start": 36.96,
    "end": 39.76,
    "text": "但所有的风险都压在一个蓝子里边"
  },
  {
    "start": 39.76,
    "end": 41.2,
    "text": "老板不爽了"
  },
  {
    "start": 41.2,
    "end": 42.48,
    "text": "行业下滑了"
  },
  {
    "start": 42.48,
    "end": 44.08,
    "text": "你立刻实验"
  },
  {
    "start": 44.08,
    "end": 46.8,
    "text": "富裔的思维是分散风险"
  },
  {
    "start": 46.8,
    "end": 47.84,
    "text": "放大收益"
  },
  {
    "start": 47.84,
    "end": 50.48,
    "text": "你可以同时拥有多个收入的入口"
  },
  {
    "start": 50.48,
    "end": 52.96,
    "text": "不再被依费公资铁死命运"
  },
  {
    "start": 52.96,
    "end": 55.12,
    "text": "为什么大多数人做富裔"
  },
  {
    "start": 55.12,
    "end": 56.56,
    "text": "做得多的就死了"
  },
  {
    "start": 56.56,
    "end": 58.32,
    "text": "就三个致命点"
  },
  {
    "start": 58.32,
    "end": 59.76,
    "text": "一跟增"
  },
  {
    "start": 59.76,
    "end": 61.52,
    "text": "而不是去盘点价值"
  },
  {
    "start": 61.52,
    "end": 62.56,
    "text": "比如做自命体段钱"
  },
  {
    "start": 62.56,
    "end": 63.36,
    "text": "你就跟着做"
  },
  {
    "start": 63.36,
    "end": 64.72,
    "text": "看比如做电商专钱"
  },
  {
    "start": 64.72,
    "end": 65.76,
    "text": "你也去几"
  },
  {
    "start": 65.76,
    "end": 67.28,
    "text": "但是做富裔的钱"
  },
  {
    "start": 67.28,
    "end": 67.92,
    "text": "体制"
  },
  {
    "start": 67.92,
    "end": 69.92,
    "text": "你也能提供什么价值"
  },
  {
    "start": 69.92,
    "end": 71.76,
    "text": "你的籌碼是什么"
  },
  {
    "start": 71.76,
    "end": 72.4,
    "text": "二"
  },
  {
    "start": 72.4,
    "end": 74.64,
    "text": "继续用上班的四维去做富裔"
  },
  {
    "start": 74.64,
    "end": 75.8,
    "text": "等着安排"
  },
  {
    "start": 75.8,
    "end": 76.64,
    "text": "等着知道"
  },
  {
    "start": 76.64,
    "end": 78.0,
    "text": "等着工资"
  },
  {
    "start": 78.0,
    "end": 80.08,
    "text": "富裔没有人带你非"
  },
  {
    "start": 80.08,
    "end": 81.76,
    "text": "只有主动的寻找需求"
  },
  {
    "start": 81.76,
    "end": 83.44,
    "text": "主动的成交的人"
  },
  {
    "start": 83.44,
    "end": 84.72,
    "text": "他才能活"
  },
  {
    "start": 84.72,
    "end": 85.36,
    "text": "三"
  },
  {
    "start": 85.36,
    "end": 87.2,
    "text": "想白条成功"
  },
  {
    "start": 87.2,
    "end": 88.08,
    "text": "不想花钱"
  },
  {
    "start": 88.08,
    "end": 89.04,
    "text": "不想花时间"
  },
  {
    "start": 89.04,
    "end": 90.64,
    "text": "不想成熟失败"
  },
  {
    "start": 90.64,
    "end": 91.68,
    "text": "结果就是"
  },
  {
    "start": 91.68,
    "end": 92.88,
    "text": "富裔还没起步"
  },
  {
    "start": 92.88,
    "end": 94.4,
    "text": "抱怨的是最積極的"
  },
  {
    "start": 94.4,
    "end": 95.68,
    "text": "现实情况就是"
  },
  {
    "start": 95.68,
    "end": 97.44,
    "text": "不复出就别指望回报"
  },
  {
    "start": 97.44,
    "end": 98.48,
    "text": "富裔最值得做的"
  },
  {
    "start": 98.48,
    "end": 99.2,
    "text": "是什么"
  },
  {
    "start": 99.2,
    "end": 100.16,
    "text": "一句话"
  },
  {
    "start": 100.16,
    "end": 101.52,
    "text": "可持续几累的"
  },
  {
    "start": 101.52,
    "end": 102.48,
    "text": "你今天做了"
  },
  {
    "start": 102.48,
    "end": 104.56,
    "text": "明天还能再产生价值"
  },
  {
    "start": 104.56,
    "end": 105.6,
    "text": "写作"
  },
  {
    "start": 105.6,
    "end": 107.6,
    "text": "内容持续的稀留料"
  },
  {
    "start": 107.6,
    "end": 109.04,
    "text": "刻成路一次"
  },
  {
    "start": 109.04,
    "end": 110.24,
    "text": "可以卖很多次"
  },
  {
    "start": 110.24,
    "end": 111.28,
    "text": "个人品牌"
  },
  {
    "start": 111.28,
    "end": 113.04,
    "text": "信任变现最晚"
  },
  {
    "start": 113.04,
    "end": 113.84,
    "text": "记住"
  },
  {
    "start": 113.84,
    "end": 114.64,
    "text": "送外卖"
  },
  {
    "start": 114.64,
    "end": 115.2,
    "text": "跑投"
  },
  {
    "start": 115.2,
    "end": 115.76,
    "text": "大灵工"
  },
  {
    "start": 115.76,
    "end": 116.8,
    "text": "今天干一百单"
  },
  {
    "start": 116.8,
    "end": 117.72,
    "text": "明天依然"
  },
  {
    "start": 117.72,
    "end": 118.8,
    "text": "从零开始"
  },
  {
    "start": 118.8,
    "end": 120.24,
    "text": "不记得就没有未来"
  },
  {
    "start": 120.24,
    "end": 121.28,
    "text": "选队的赛道"
  },
  {
    "start": 121.28,
    "end": 122.56,
    "text": "努力才有意义"
  },
  {
    "start": 122.56,
    "end": 123.92,
    "text": "你在错误的方向"
  },
  {
    "start": 123.92,
    "end": 124.8,
    "text": "赛拼"
  },
  {
    "start": 124.8,
    "end": 126.08,
    "text": "他也只是平用"
  },
  {
    "start": 126.08,
    "end": 127.28,
    "text": "有一点点的优势"
  },
  {
    "start": 127.28,
    "end": 128.72,
    "text": "你就会放大场"
  },
  {
    "start": 128.72,
    "end": 129.52,
    "text": "会写"
  },
  {
    "start": 129.52,
    "end": 130.64,
    "text": "就写到几制"
  },
  {
    "start": 130.64,
    "end": 131.92,
    "text": "会说会拍"
  },
  {
    "start": 131.92,
    "end": 133.28,
    "text": "你就拍到几制"
  },
  {
    "start": 133.28,
    "end": 134.4,
    "text": "董某哥领域"
  },
  {
    "start": 134.4,
    "end": 134.96,
    "text": "你就讲"
  },
  {
    "start": 134.96,
    "end": 135.84,
    "text": "这个记得的变现"
  },
  {
    "start": 135.84,
    "end": 136.64,
    "text": "到位"
  },
  {
    "start": 136.64,
    "end": 137.84,
    "text": "别的什么都不做"
  },
  {
    "start": 137.84,
    "end": 138.96,
    "text": "只做一个点"
  },
  {
    "start": 138.96,
    "end": 140.56,
    "text": "做到让人离不开你"
  },
  {
    "start": 140.56,
    "end": 141.92,
    "text": "最后不上班"
  },
  {
    "start": 141.92,
    "end": 142.88,
    "text": "但能赚钱"
  },
  {
    "start": 142.88,
    "end": 144.96,
    "text": "但不是靠天安教训二平"
  },
  {
    "start": 144.96,
    "end": 146.12,
    "text": "是你一点一滴"
  },
  {
    "start": 146.12,
    "end": 147.44,
    "text": "看出来的自由"
  },
  {
    "start": 147.44,
    "end": 148.4,
    "text": "你要不然是忍住"
  },
  {
    "start": 148.4,
    "end": 149.2,
    "text": "现在的苦"
  },
  {
    "start": 149.2,
    "end": 150.4,
    "text": "要不然就接受"
  },
  {
    "start": 150.4,
    "end": 151.6,
    "text": "一辈子平用"
  }
]