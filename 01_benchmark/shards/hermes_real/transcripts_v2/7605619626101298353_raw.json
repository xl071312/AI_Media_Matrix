  {
    "start": 238.44,
    "end": 240.4,
    "text": "和技能上限低战最踏实"
  },
  {
    "start": 240.4,
    "end": 242.24,
    "text": "强盗模式站的是资源和入口"
  },
  {
    "start": 242.24,
    "end": 243.44,
    "text": "躺着就能收钱"
  },
  {
    "start": 243.44,
    "end": 244.24,
    "text": "老头模式"
  },
  {
    "start": 244.24,
    "end": 245.6,
    "text": "偷的是注意力和数据"
  },
  {
    "start": 245.6,
    "end": 246.56,
    "text": "客户毫无差距"
  },
  {
    "start": 246.56,
    "end": 248.6,
    "text": "马扁模式玩的是信息差和心理"
  },
  {
    "start": 248.6,
    "end": 250.12,
    "text": "让客户自己税幅自己"
  },
  {
    "start": 250.12,
    "end": 251.68,
    "text": "你以为那些约入十万的人"
  },
  {
    "start": 251.68,
    "end": 252.44,
    "text": "比你更努力"
  },
  {
    "start": 252.44,
    "end": 254.6,
    "text": "不他们只是比你更懂的切换模式"
  },
  {
    "start": 254.6,
    "end": 255.88,
    "text": "一个成熟的生意人"
  },
  {
    "start": 255.88,
    "end": 257.28000000000003,
    "text": "会把四种模式混着用"
  },
  {
    "start": 257.28000000000003,
    "end": 258.28000000000003,
    "text": "用小姐模式"
  },
  {
    "start": 258.28000000000003,
    "end": 258.88,
    "text": "建立新人"
  },
  {
    "start": 258.88,
    "end": 259.8,
    "text": "用强盗模式"
  },
  {
    "start": 259.8,
    "end": 260.52,
    "text": "索定客户"
  },
  {
    "start": 260.52,
    "end": 261.4,
    "text": "用小头模式"
  },
  {
    "start": 261.4,
    "end": 262.12,
    "text": "收割流量"
  },
  {
    "start": 262.12,
    "end": 263.0,
    "text": "用马扁模式"
  },
  {
    "start": 263.0,
    "end": 263.96,
    "text": "拉高克弹价"
  },
  {
    "start": 263.96,
    "end": 264.96000000000004,
    "text": "而普通人"
  },
  {
    "start": 264.96000000000004,
    "end": 266.84000000000003,
    "text": "一辈子都困在小姐模式里"
  },
  {
    "start": 266.84000000000003,
    "end": 267.8,
    "text": "用时间换钱"
  },
  {
    "start": 267.8,
    "end": 268.8,
    "text": "用苦力换工资"
  },
  {
    "start": 268.8,
    "end": 270.08000000000004,
    "text": "不是说这种模式不好"
  },
  {
    "start": 270.08000000000004,
    "end": 272.28000000000003,
    "text": "而是他的天花板太低了"
  },
  {
    "start": 272.28000000000003,
    "end": 273.28000000000003,
    "text": "真正的破局"
  },
  {
    "start": 273.28000000000003,
    "end": 274.8,
    "text": "是跳出卖时间的陷阱"
  },
  {
    "start": 274.8,
    "end": 276.28000000000003,
    "text": "学会设计交易结构"
  },
  {
    "start": 276.28000000000003,
    "end": 276.92,
    "text": "你得明白"
  },
  {
    "start": 276.92,
    "end": 278.28000000000003,
    "text": "资源比努力更之前"
  },
  {
    "start": 278.28000000000003,
    "end": 278.96000000000004,
    "text": "强盗模式"
  },
  {
    "start": 278.96000000000004,
    "end": 280.48,
    "text": "信息差比苦力更赚钱"
  },
  {
    "start": 280.48,
    "end": 281.12,
    "text": "马扁模式"
  },
  {
    "start": 281.12,
    "end": 282.48,
    "text": "注意力比商品更之前"
  },
  {
    "start": 282.48,
    "end": 283.36,
    "text": "小头模式"
  },
  {
    "start": 283.36,
    "end": 285.56000000000006,
    "text": "当你理解了这四种模式的底层逻辑"
  },
  {
    "start": 285.56000000000006,
    "end": 286.52000000000004,
    "text": "你才能真正看懂"
  },
  {
    "start": 286.52000000000004,
    "end": 287.8,
    "text": "这个世界的游戏规则"
  }
]