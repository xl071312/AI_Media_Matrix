[
  {
    "start": 0.0,
    "end": 1.84,
    "text": "我从来没见过比资更轮椅的强"
  },
  {
    "start": 1.84,
    "end": 2.48,
    "text": "心塞几"
  },
  {
    "start": 2.48,
    "end": 4.12,
    "text": "我本以为我还能带着AK小姐"
  },
  {
    "start": 4.12,
    "end": 4.76,
    "text": "再领号打吧"
  },
  {
    "start": 4.76,
    "end": 5.52,
    "text": "无法无天"
  },
  {
    "start": 5.52,
    "end": 6.16,
    "text": "但片面"
  },
  {
    "start": 6.16,
    "end": 7.8,
    "text": "她突然很空出事"
  },
  {
    "start": 7.8,
    "end": 9.32,
    "text": "所以看她已经被我碎头了"
  },
  {
    "start": 9.32,
    "end": 10.8,
    "text": "就在我要射出第二发的时候"
  },
  {
    "start": 10.8,
    "end": 11.8,
    "text": "啊"
  },
  {
    "start": 11.8,
    "end": 13.32,
    "text": "0.1秒我就被秒了"
  },
  {
    "start": 13.32,
    "end": 15.76,
    "text": "比赛打不过就很很加入的基本原则"
  },
  {
    "start": 15.76,
    "end": 17.0,
    "text": "我也改了一把她模型出来"
  },
  {
    "start": 17.0,
    "end": 18.48,
    "text": "听到了响强和稀罗的脚步"
  },
  {
    "start": 18.48,
    "end": 19.48,
    "text": "直接回来"
  },
  {
    "start": 19.48,
    "end": 20.56,
    "text": "以前我一直不觉得"
  },
  {
    "start": 20.56,
    "end": 22.0,
    "text": "塞有的时候会有轮椅是个东西"
  },
  {
    "start": 22.0,
    "end": 23.32,
    "text": "直到我拿上了手里这一把"
  },
  {
    "start": 23.32,
    "end": 24.6,
    "text": "搖射能够稳壓20米"
  },
  {
    "start": 24.6,
    "end": 26.24,
    "text": "开机能够稳壓百米的她模型"
  },
  {
    "start": 26.24,
    "end": 27.36,
    "text": "而且更重要的是"
  },
  {
    "start": 27.36,
    "end": 28.56,
    "text": "她完全是配无弥"
  },
  {
    "start": 28.56,
    "end": 30.2,
    "text": "基本上不会给敌人反应的时间"
  },
  {
    "start": 32.84,
    "end": 34.68,
    "text": "罗拉到底她的队友正如特多感恩"
  },
  {
    "start": 34.68,
    "end": 35.36,
    "text": "一元一进"
  },
  {
    "start": 35.36,
    "end": 36.24,
    "text": "只要对象是1v"
  },
  {
    "start": 36.24,
    "end": 37.24,
    "text": "你就不用怕直接上"
  },
  {
    "start": 38.96,
    "end": 39.84,
    "text": "谈地双方散"
  },
  {
    "start": 39.84,
    "end": 40.88,
    "text": "三到谁的"
  },
  {
    "start": 42.4,
    "end": 43.6,
    "text": "怪不得追过人那么赶重"
  },
  {
    "start": 43.6,
    "end": 44.44,
    "text": "原来是全装割"
  },
  {
    "start": 44.44,
    "end": 45.56,
    "text": "但是我们的伤害太高了"
  },
  {
    "start": 45.56,
    "end": 46.64,
    "text": "她还得分析被秒了"
  },
  {
    "start": 47.72,
    "end": 48.68,
    "text": "对面还是一个安兰"
  },
  {
    "start": 48.68,
    "end": 49.8,
    "text": "她两个队友倒进脑袍"
  },
  {
    "start": 49.8,
    "end": 50.6,
    "text": "她会怎么做"
  },
  {
    "start": 50.6,
    "end": 52.4,
    "text": "我想她的手里肯定会留一个非凡"
  },
  {
    "start": 52.4,
    "end": 53.2,
    "text": "然后就对有"
  },
  {
    "start": 53.2,
    "end": 55.2,
    "text": "等我上门就请我吃一个谈强非凡"
  },
  {
    "start": 55.32,
    "end": 56.8,
    "text": "因为我实在是太了解安兰了"
  },
  {
    "start": 56.8,
    "end": 57.72,
    "text": "我知道她的想法"
  },
  {
    "start": 57.72,
    "end": 58.72,
    "text": "所以将机修集"
  },
  {
    "start": 58.72,
    "end": 59.8,
    "text": "在她旧队的时候"
  },
  {
    "start": 59.8,
    "end": 61.08,
    "text": "我在非常里出牌"
  },
  {
    "start": 63.0,
    "end": 63.48,
    "text": "来了"
  },
  {
    "start": 63.48,
    "end": 64.28,
    "text": "今儿现在"
  },
  {
    "start": 64.28,
    "end": 65.96,
    "text": "她现在肯定居心会神的想"
  },
  {
    "start": 65.96,
    "end": 66.92,
    "text": "听着我采信部"
  },
  {
    "start": 66.92,
    "end": 68.8,
    "text": "就由如一直进攻之途"
  },
  {
    "start": 68.8,
    "end": 70.04,
    "text": "所以接下来这样将"
  },
  {
    "start": 70.04,
    "end": 70.84,
    "text": "会可能疯狂"
  },
  {
    "start": 71.48,
    "end": 72.92,
    "text": "又一头安兰被吓死了"
  },
  {
    "start": 72.92,
    "end": 74.6,
    "text": "其实这把枪还一个更疯狂的点"
  },
  {
    "start": 74.6,
    "end": 75.68,
    "text": "她虽然是双方枪"
  },
  {
    "start": 75.68,
    "end": 76.4,
    "text": "但是在野外"
  },
  {
    "start": 76.4,
    "end": 77.68,
    "text": "她不压运任何一款不枪"
  },
  {
    "start": 79.12,
    "end": 80.12,
    "text": "你虽然是一把大局"
  },
  {
    "start": 80.12,
    "end": 81.28,
    "text": "但是我的探母运输入"
  },
  {
    "start": 81.28,
    "end": 82.2,
    "text": "也未尝不停"
  },
  {
    "start": 82.2,
    "end": 82.84,
    "text": "注意细节"
  },
  {
    "start": 82.84,
    "end": 83.92,
    "text": "对面这把是双枪"
  },
  {
    "start": 83.96,
    "end": 84.8,
    "text": "他们是猛攻队"
  },
  {
    "start": 84.8,
    "end": 85.84,
    "text": "并且还看到这边"
  },
  {
    "start": 85.84,
    "end": 86.64,
    "text": "只有我一个人"
  },
  {
    "start": 86.64,
    "end": 87.4,
    "text": "关于多是你"
  },
  {
    "start": 87.4,
    "end": 88.4,
    "text": "你会放过我吗"
  },
  {
    "start": 88.4,
    "end": 89.68,
    "text": "答案肯定是不会"
  },
  {
    "start": 89.68,
    "end": 90.68,
    "text": "所以那边"
  },
  {
    "start": 90.68,
    "end": 91.16,
    "text": "站"
  },
  {
    "start": 91.16,
    "end": 91.68,
    "text": "听脚步"
  },
  {
    "start": 91.68,
    "end": 92.44,
    "text": "他们来得很快"
  },
  {
    "start": 92.44,
    "end": 93.2,
    "text": "我们想出去"
  },
  {
    "start": 93.2,
    "end": 93.84,
    "text": "是不可能的"
  },
  {
    "start": 93.84,
    "end": 94.68,
    "text": "前面没有颜体了"
  },
  {
    "start": 94.68,
    "end": 95.32,
    "text": "就拿着个草"
  },
  {
    "start": 95.32,
    "end": 95.84,
    "text": "过度一下"
  },
  {
    "start": 97.68,
    "end": 98.6,
    "text": "自个性收下判断"
  },
  {
    "start": 98.6,
    "end": 99.48,
    "text": "我得同理完"
  },
  {
    "start": 102.88,
    "end": 104.12,
    "text": "对面也有一个人的位置暴露"
  },
  {
    "start": 104.12,
    "end": 104.96,
    "text": "还丢我比较远"
  },
  {
    "start": 104.96,
    "end": 105.56,
    "text": "先打状态"
  },
  {
    "start": 105.56,
    "end": 106.24,
    "text": "打状态同时"
  },
  {
    "start": 106.24,
    "end": 107.36,
    "text": "收集最后一个人的信息"
  },
  {
    "start": 107.36,
    "end": 108.2,
    "text": "注意字一听"
  },
  {
    "start": 109.24,
    "end": 110.4,
    "text": "就在前面的卖小红后面"
  },
  {
    "start": 110.4,
    "end": 111.16,
    "text": "有一座石头"
  },
  {
    "start": 111.8,
    "end": 112.64,
    "text": "他站上跳不过来"
  },
  {
    "start": 112.64,
    "end": 113.4,
    "text": "我们去打状态"
  },
  {
    "start": 114.88,
    "end": 115.92,
    "text": "看了他的箱线了"
  },
  {
    "start": 115.92,
    "end": 116.92,
    "text": "离我很近"
  },
  {
    "start": 116.92,
    "end": 117.92,
    "text": "在这个时候"
  },
  {
    "start": 117.92,
    "end": 118.92,
    "text": "腰色可以发地了"
  },
  {
    "start": 120.92,
    "end": 121.92,
    "text": "所以假大棚"
  },
  {
    "start": 121.92,
    "end": 122.92,
    "text": "但是原理有红闹给他加枪"
  },
  {
    "start": 122.92,
    "end": 123.92,
    "text": "这个时候没办法对象"
  },
  {
    "start": 123.92,
    "end": 125.92,
    "text": "几层潮水用非盘去找机会"
  },
  {
    "start": 126.92,
    "end": 127.92,
    "text": "非盘依照就朗"
  },
  {
    "start": 127.92,
    "end": 129.92,
    "text": "是不感觉这个枪的出发速度太离步了"
  },
  {
    "start": 129.92,
    "end": 131.92,
    "text": "而且刚刚我还用的指示腰色"
  },
  {
    "start": 131.92,
    "end": 133.92,
    "text": "这个时候对面还是应该红闹了"
  },
  {
    "start": 133.92,
    "end": 134.92,
    "text": "不明至少情况下"
  },
  {
    "start": 134.92,
    "end": 135.92,
    "text": "跟任何感觉一回忆"
  },
  {
    "start": 135.92,
    "end": 136.92,
    "text": "都会久益开"
  },
  {
    "start": 136.92,
    "end": 137.92,
    "text": "这个时候我拿的似头某些"
  },
  {
    "start": 137.92,
    "end": 138.92,
    "text": "你跟他就是实力开了"
  },
  {
    "start": 138.92,
    "end": 139.92,
    "text": "记住"
  },
  {
    "start": 139.92,
    "end": 141.92,
    "text": "只要你打状态"
  },
  {
    "start": 141.92,
    "end": 142.92,
    "text": "就算他运气好打一点小头"
  },
  {
    "start": 142.92,
    "end": 143.92,
    "text": "也没有你打他快"
  },
  {
    "start": 144.92,
    "end": 145.92,
    "text": "他的脚不到脸上了"
  },
  {
    "start": 145.92,
    "end": 146.92,
    "text": "很近"
  },
  {
    "start": 146.92,
    "end": 147.92,
    "text": "大概是在加关柱子不停"
  },
  {
    "start": 147.92,
    "end": 148.92,
    "text": "这个时候"
  },
  {
    "start": 148.92,
    "end": 149.92,
    "text": "见面极开火的腰色"
  },
  {
    "start": 149.92,
    "end": 150.92,
    "text": "又可以发地了"
  },
  {
    "start": 151.92,
    "end": 152.92,
    "text": "他基本反应不过来"
  },
  {
    "start": 152.92,
    "end": 153.92,
    "text": "回来"
  },
  {
    "start": 153.92,
    "end": 154.92,
    "text": "当他以为我还会在那个口子上"
  },
  {
    "start": 154.92,
    "end": 155.92,
    "text": "那时候"
  },
  {
    "start": 155.92,
    "end": 156.92,
    "text": "我右脑"
  },
  {
    "start": 156.92,
    "end": 157.92,
    "text": "就是改下马"
  },
  {
    "start": 157.92,
    "end": 158.92,
    "text": "右上他很容易飞进去"
  },
  {
    "start": 158.92,
    "end": 159.92,
    "text": "吧"
  }
]