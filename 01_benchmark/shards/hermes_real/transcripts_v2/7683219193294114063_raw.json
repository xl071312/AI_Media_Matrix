[
  {
    "start": 0.0,
    "end": 1.8,
    "text": "38度期被我酸臭"
  },
  {
    "start": 1.8,
    "end": 3.96,
    "text": "今天你要体验的人生互本事"
  },
  {
    "start": 3.96,
    "end": 5.8,
    "text": "包装生PC得爱资的一生"
  },
  {
    "start": 5.8,
    "end": 7.16,
    "text": "周三凌晨2.5"
  },
  {
    "start": 7.16,
    "end": 9.04,
    "text": "宿舍的铁架床在你翻身时"
  },
  {
    "start": 9.04,
    "end": 10.6,
    "text": "发出一生尖锐的痴鸭"
  },
  {
    "start": 10.6,
    "end": 11.84,
    "text": "你把辈子拉到下吧"
  },
  {
    "start": 11.84,
    "end": 13.6,
    "text": "但汗还是从额头往下讨"
  },
  {
    "start": 13.6,
    "end": 15.72,
    "text": "体温机夹在夜下5分钟"
  },
  {
    "start": 15.72,
    "end": 18.0,
    "text": "抽出来对着走狼透进来的光看"
  },
  {
    "start": 18.0,
    "end": 19.2,
    "text": "38度期"
  },
  {
    "start": 19.2,
    "end": 20.44,
    "text": "这已经是第4天了"
  },
  {
    "start": 20.44,
    "end": 22.28,
    "text": "效益是开的感冒要吃完了"
  },
  {
    "start": 22.28,
    "end": 23.92,
    "text": "喉嚨还是向吞了碎玻璃"
  },
  {
    "start": 23.92,
    "end": 25.0,
    "text": "你怕在枕头上"
  },
  {
    "start": 25.0,
    "end": 27.12,
    "text": "闻到自己身上那股酸搜的汗味"
  },
  {
    "start": 27.12,
    "end": 29.24,
    "text": "混着宿舍里今年累月的美味"
  },
  {
    "start": 29.24,
    "end": 30.72,
    "text": "上铺的室友翻了个身"
  },
  {
    "start": 30.72,
    "end": 31.64,
    "text": "都闹了一句什么"
  },
  {
    "start": 31.64,
    "end": 32.44,
    "text": "又水过去了"
  },
  {
    "start": 32.44,
    "end": 34.28,
    "text": "你盯着天花板上的快水滋"
  },
  {
    "start": 34.28,
    "end": 35.8,
    "text": "形状像一张扭曲的脸"
  },
  {
    "start": 35.8,
    "end": 36.6,
    "text": "10天前"
  },
  {
    "start": 36.6,
    "end": 37.2,
    "text": "周三"
  },
  {
    "start": 37.2,
    "end": 39.24,
    "text": "玩自喜结束是9.40"
  },
  {
    "start": 39.24,
    "end": 40.84,
    "text": "你背着书包走出校门"
  },
  {
    "start": 40.84,
    "end": 42.44,
    "text": "在公交站等车的时候"
  },
  {
    "start": 42.44,
    "end": 43.68,
    "text": "打开了那个APP"
  },
  {
    "start": 43.68,
    "end": 46.2,
    "text": "头像亮着的是一个比你大几岁的男人"
  },
  {
    "start": 46.2,
    "end": 47.76,
    "text": "资料写着附近的人"
  },
  {
    "start": 47.76,
    "end": 48.88,
    "text": "距离1.2公里"
  },
  {
    "start": 48.88,
    "end": 49.88,
    "text": "你们聊了三天了"
  },
  {
    "start": 49.88,
    "end": 51.76,
    "text": "她说她是隔壁大学的学生"
  },
  {
    "start": 51.76,
    "end": 52.88,
    "text": "说觉得你可爱"
  },
  {
    "start": 52.88,
    "end": 53.96,
    "text": "你其实不太信"
  },
  {
    "start": 53.96,
    "end": 55.28,
    "text": "但那个绿色的对话框"
  },
  {
    "start": 55.28,
    "end": 56.88,
    "text": "一直在屏幕顶端亮着"
  },
  {
    "start": 56.88,
    "end": 58.92,
    "text": "你每隔几分钟就点开看眼"
  },
  {
    "start": 58.92,
    "end": 59.84,
    "text": "公交车来了"
  },
  {
    "start": 59.84,
    "end": 60.48,
    "text": "你没上"
  },
  {
    "start": 60.48,
    "end": 62.4,
    "text": "你沿着导航走过了三个路口"
  },
  {
    "start": 62.4,
    "end": 64.92,
    "text": "在一栋老小区的单元楼下停了脚步"
  },
  {
    "start": 64.92,
    "end": 66.32,
    "text": "楼道里的深空灯坏了"
  },
  {
    "start": 66.32,
    "end": 67.56,
    "text": "你摸黑上了四楼"
  },
  {
    "start": 67.56,
    "end": 68.24,
    "text": "敲了门"
  },
  {
    "start": 68.24,
    "end": 70.4,
    "text": "她开门的时候穿着灰色卫衣"
  },
  {
    "start": 70.4,
    "end": 71.36,
    "text": "头发是施的"
  },
  {
    "start": 71.36,
    "end": 72.2,
    "text": "刚洗过澡"
  },
  {
    "start": 72.2,
    "end": 73.52,
    "text": "你闻到牧鱼路的味道"
  },
  {
    "start": 73.52,
    "end": 74.28,
    "text": "您门味的"
  },
  {
    "start": 74.28,
    "end": 75.96,
    "text": "和她身上的腌味混在一起"
  },
  {
    "start": 75.96,
    "end": 76.76,
    "text": "她说进来吧"
  },
  {
    "start": 76.76,
    "end": 77.68,
    "text": "别站在门口"
  },
  {
    "start": 77.68,
    "end": 78.32,
    "text": "你进去了"
  },
  {
    "start": 78.32,
    "end": 79.76,
    "text": "那个晚上之后的一周"
  },
  {
    "start": 79.76,
    "end": 80.76,
    "text": "你什么都正常"
  },
  {
    "start": 80.76,
    "end": 81.4,
    "text": "上课"
  },
  {
    "start": 81.4,
    "end": 82.16,
    "text": "写作业"
  },
  {
    "start": 82.16,
    "end": 82.76,
    "text": "好操"
  },
  {
    "start": 82.76,
    "end": 83.56,
    "text": "一切如场"
  },
  {
    "start": 83.56,
    "end": 85.48,
    "text": "你甚至觉得那件事没发生过"
  },
  {
    "start": 85.48,
    "end": 86.28,
    "text": "你告诉自己"
  },
  {
    "start": 86.28,
    "end": 87.6,
    "text": "这只是一次好奇"
  },
  {
    "start": 87.6,
    "end": 88.56,
    "text": "一次放松"
  },
  {
    "start": 88.56,
    "end": 89.64,
    "text": "高三太累了"
  },
  {
    "start": 89.64,
    "end": 90.96,
    "text": "你只是想传口气"
  },
  {
    "start": 90.96,
    "end": 92.68,
    "text": "但周三凌晨的这场高烧"
  },
  {
    "start": 92.68,
    "end": 94.08,
    "text": "把所有东西都拽回来"
  },
  {
    "start": 94.08,
    "end": 96.16,
    "text": "你拿着手机躲在厕所隔间里"
  },
  {
    "start": 96.16,
    "end": 97.48,
    "text": "搜索正装发热"
  },
  {
    "start": 97.48,
    "end": 98.08,
    "text": "腌痛"
  },
  {
    "start": 98.08,
    "end": 98.64,
    "text": "披着"
  },
  {
    "start": 98.64,
    "end": 99.56,
    "text": "凌霸节种大"
  },
  {
    "start": 99.56,
    "end": 101.56,
    "text": "你看到极性七三个字的时候"
  },
  {
    "start": 101.56,
    "end": 102.96,
    "text": "手指将在屏幕上"
  },
  {
    "start": 102.96,
    "end": 103.84,
    "text": "你对自己说"
  },
  {
    "start": 103.84,
    "end": 105.16,
    "text": "不可能就一次"
  },
  {
    "start": 105.16,
    "end": 106.68,
    "text": "对方看起来那么健康"
  },
  {
    "start": 106.68,
    "end": 107.68,
    "text": "你关上手机"
  },
  {
    "start": 107.68,
    "end": 108.36,
    "text": "冲了水"
  },
  {
    "start": 108.36,
    "end": 109.08,
    "text": "洗了把脸"
  },
  {
    "start": 109.08,
    "end": 111.0,
    "text": "看着镜子里那张十七岁的脸"
  },
  {
    "start": 111.0,
    "end": 112.28,
    "text": "把手机塞回口袋"
  },
  {
    "start": 112.28,
    "end": 113.68,
    "text": "三天后烧腿了"
  },
  {
    "start": 113.68,
    "end": 114.72,
    "text": "你松了一口气"
  },
  {
    "start": 114.72,
    "end": 115.44,
    "text": "告诉自己"
  },
  {
    "start": 115.44,
    "end": 116.76,
    "text": "果然是普通感冒"
  },
  {
    "start": 116.76,
    "end": 117.68,
    "text": "你回到教室"
  },
  {
    "start": 117.68,
    "end": 119.24,
    "text": "坐在靠窗第三排的位置"
  },
  {
    "start": 119.24,
    "end": 120.44,
    "text": "翻开数学卷子"
  },
  {
    "start": 120.44,
    "end": 121.92,
    "text": "笔间划过纸面的声音"
  },
  {
    "start": 121.92,
    "end": 123.68,
    "text": "同桌翻书的沙沙声"
  },
  {
    "start": 123.68,
    "end": 124.56,
    "text": "前排男生"
  },
  {
    "start": 124.56,
    "end": 126.48,
    "text": "赚笔掉在桌上的批搭声"
  },
  {
    "start": 126.48,
    "end": 128.04,
    "text": "一切都和以前一样"
  },
  {
    "start": 128.04,
    "end": 129.64,
    "text": "你甚至做了两刀大提"
  },
  {
    "start": 129.64,
    "end": 131.08,
    "text": "觉得自己状态回来了"
  },
  {
    "start": 131.08,
    "end": 132.04,
    "text": "但无休的时候"
  },
  {
    "start": 132.04,
    "end": 132.96,
    "text": "你批在桌上"
  },
  {
    "start": 132.96,
    "end": 134.68,
    "text": "脖子侧面摸到一个硬块"
  },
  {
    "start": 134.68,
    "end": 135.72,
    "text": "你用手指按来"
  },
  {
    "start": 135.72,
    "end": 136.32,
    "text": "不疼"
  },
  {
    "start": 136.32,
    "end": 138.32,
    "text": "律斗大小在皮肤底下滚动"
  },
  {
    "start": 138.44,
    "end": 139.4,
    "text": "你把手放下来"
  },
  {
    "start": 139.4,
    "end": 140.28,
    "text": "闭上眼睛"
  },
  {
    "start": 140.28,
    "end": 141.16,
    "text": "你告诉自己"
  },
  {
    "start": 141.16,
    "end": 142.72,
    "text": "零八节种大很正常"
  },
  {
    "start": 142.72,
    "end": 143.56,
    "text": "上火而已"
  },
  {
    "start": 143.56,
    "end": 144.52,
    "text": "熬夜太多了"
  },
  {
    "start": 144.52,
    "end": 145.2,
    "text": "第二个月"
  },
  {
    "start": 145.2,
    "end": 146.4,
    "text": "月烤成绩出来了"
  },
  {
    "start": 146.4,
    "end": 147.4,
    "text": "你掉了十二米"
  },
  {
    "start": 147.4,
    "end": 149.0,
    "text": "班主任把你叫到办公室"
  },
  {
    "start": 149.0,
    "end": 150.44,
    "text": "说你最近状态不对"
  },
  {
    "start": 150.44,
    "end": 151.4,
    "text": "上课走神"
  },
  {
    "start": 151.4,
    "end": 152.48,
    "text": "作业质量下滑"
  },
  {
    "start": 152.48,
    "end": 153.76,
    "text": "你站在办公桌前"
  },
  {
    "start": 153.76,
    "end": 155.24,
    "text": "看着桌上那盆律罗的业子"
  },
  {
    "start": 155.24,
    "end": 155.96,
    "text": "垂下来"
  },
  {
    "start": 155.96,
    "end": 157.24,
    "text": "说你最近没睡好"
  },
  {
    "start": 157.24,
    "end": 158.32,
    "text": "班主任点点头"
  },
  {
    "start": 158.32,
    "end": 159.2,
    "text": "说高三了"
  },
  {
    "start": 159.2,
    "end": 159.96,
    "text": "自己调整"
  },
  {
    "start": 159.96,
    "end": 160.8,
    "text": "别让一次月烤"
  },
  {
    "start": 160.8,
    "end": 161.8,
    "text": "影响大局"
  },
  {
    "start": 161.8,
    "end": 162.36,
    "text": "你说"
  },
  {
    "start": 162.36,
    "end": 162.96,
    "text": "是的"
  },
  {
    "start": 162.96,
    "end": 163.48,
    "text": "老实"
  },
  {
    "start": 163.48,
    "end": 164.88,
    "text": "你走出办公室的时候"
  },
  {
    "start": 164.88,
    "end": 166.4,
    "text": "走狼镜头的窗户开着"
  },
  {
    "start": 166.4,
    "end": 167.64,
    "text": "10月的风吹进来"
  },
  {
    "start": 167.64,
    "end": 168.44,
    "text": "狼瘦瘦"
  },
  {
    "start": 168.44,
    "end": 169.88,
    "text": "你摸了摸脖子侧面"
  },
  {
    "start": 169.88,
    "end": 171.08,
    "text": "那个零八节还在"
  },
  {
    "start": 171.08,
    "end": 172.28,
    "text": "好像大力一点点"
  },
  {
    "start": 172.28,
    "end": 173.32,
    "text": "你把手放下来"
  },
  {
    "start": 173.32,
    "end": 174.56,
    "text": "快步走回教室"
  },
  {
    "start": 174.56,
    "end": 175.48,
    "text": "10月初"
  },
  {
    "start": 175.48,
    "end": 177.04,
    "text": "你身上开始出现皮疹"
  },
  {
    "start": 177.04,
    "end": 179.64,
    "text": "现实胸口一小片红色的班秋枕不养"
  },
  {
    "start": 179.64,
    "end": 180.56,
    "text": "你以为是过敏"
  },
  {
    "start": 180.56,
    "end": 182.12,
    "text": "去效益是开了绿雷踏定"
  },
  {
    "start": 182.12,
    "end": 183.32,
    "text": "吃了三天没销"
  },
  {
    "start": 183.32,
    "end": 185.04,
    "text": "反而蔓延到后背和手臂"
  },
  {
    "start": 185.04,
    "end": 185.92,
    "text": "你洗澡的时候"
  },
  {
    "start": 185.92,
    "end": 187.44,
    "text": "对着那面模糊的镜子看"
  },
  {
    "start": 187.44,
    "end": 188.24,
    "text": "红色的班点"
  },
  {
    "start": 188.24,
    "end": 188.92,
    "text": "从尖甲骨"
  },
  {
    "start": 188.92,
    "end": 190.2,
    "text": "一直延伸到腰剂"
  },
  {
    "start": 190.2,
    "end": 191.16,
    "text": "向某种地图"
  },
  {
    "start": 191.16,
    "end": 192.4,
    "text": "你用手掌错了错"
  },
  {
    "start": 196.4,
    "end": 197.2,
    "text": "你站在那儿"
  },
  {
    "start": 197.2,
    "end": 198.64,
    "text": "热水从身上往下躺"
  },
  {
    "start": 198.64,
    "end": 199.92,
    "text": "你想起那个APP上"
  },
  {
    "start": 199.92,
    "end": 201.2,
    "text": "她说的最后一句话"
  },
  {
    "start": 201.2,
    "end": 202.12,
    "text": "下次在约"
  },
  {
    "start": 202.12,
    "end": 203.08,
    "text": "你把它拉黑了"
  },
  {
    "start": 203.08,
    "end": 203.96,
    "text": "但聊天记录"
  },
  {
    "start": 203.96,
    "end": 204.64,
    "text": "你没山"
  },
  {
    "start": 204.64,
    "end": 205.96,
    "text": "你打开手机看了眼"
  },
  {
    "start": 205.96,
    "end": 207.4,
    "text": "三天前她上线路"
  },
  {
    "start": 207.4,
    "end": 208.36,
    "text": "你没发消息"
  },
  {
    "start": 208.36,
    "end": 209.08,
    "text": "12月中旬"
  },
  {
    "start": 209.08,
    "end": 210.0,
    "text": "你开始拉肚子"
  },
  {
    "start": 210.0,
    "end": 211.0,
    "text": "每天三次刺"
  },
  {
    "start": 211.0,
    "end": 211.92,
    "text": "不是特别严重"
  },
  {
    "start": 211.92,
    "end": 212.84,
    "text": "但持续不断"
  },
  {
    "start": 212.84,
    "end": 213.72,
    "text": "你妈打电话来"
  },
  {
    "start": 213.72,
    "end": 215.08,
    "text": "问你原蛋回不回家"
  },
  {
    "start": 215.08,
    "end": 216.12,
    "text": "你说要不客"
  },
  {
    "start": 216.12,
    "end": 217.88,
    "text": "她在电话内头探了口气"
  },
  {
    "start": 217.88,
    "end": 219.32,
    "text": "说那你自己注意身体"
  },
  {
    "start": 219.32,
    "end": 219.88,
    "text": "不要也"
  },
  {
    "start": 219.88,
    "end": 220.88,
    "text": "你说知道"
  },
  {
    "start": 220.88,
    "end": 221.48,
    "text": "挂了电话"
  },
  {
    "start": 221.48,
    "end": 222.52,
    "text": "你坐在床眼上"
  },
  {
    "start": 222.52,
    "end": 223.92,
    "text": "是我们都去上课了"
  },
  {
    "start": 223.92,
    "end": 225.32,
    "text": "宿舍里只有你一个人"
  },
  {
    "start": 225.32,
    "end": 226.72,
    "text": "窗外是灰白色的天"
  },
  {
    "start": 226.72,
    "end": 227.96,
    "text": "对面楼的亮衣省上"
  },
  {
    "start": 227.96,
    "end": 229.04,
    "text": "挂着时间笑服"
  },
  {
    "start": 229.04,
    "end": 229.8,
    "text": "在风里晃"
  },
  {
    "start": 229.8,
    "end": 230.84,
    "text": "你打开手机"
  },
  {
    "start": 230.84,
    "end": 232.16,
    "text": "搜索HI微试纸"
  },
  {
    "start": 232.16,
    "end": 232.8,
    "text": "下单了"
  },
  {
    "start": 232.8,
    "end": 234.0,
    "text": "快递第三天到的"
  },
  {
    "start": 234.0,
    "end": 235.12,
    "text": "你拆开包装的时候"
  },
  {
    "start": 235.12,
    "end": 235.76,
    "text": "手在抖"
  },
  {
    "start": 235.76,
    "end": 236.88,
    "text": "你按照说明操作"
  },
  {
    "start": 236.88,
    "end": 237.88,
    "text": "扎在纸尖血"
  },
  {
    "start": 237.88,
    "end": 239.0,
    "text": "几斤那个小孔里"
  },
  {
    "start": 239.0,
    "end": 239.8,
    "text": "20分钟"
  },
  {
    "start": 239.8,
    "end": 240.96,
    "text": "你坐在马桶盖上"
  },
  {
    "start": 240.96,
    "end": 241.96,
    "text": "盯着那根试纸"
  },
  {
    "start": 241.96,
    "end": 242.76,
    "text": "两条线"
  },
  {
    "start": 242.76,
    "end": 244.2,
    "text": "你把试纸扔进拉机桶"
  },
  {
    "start": 244.2,
    "end": 244.96,
    "text": "又检出来"
  },
  {
    "start": 244.96,
    "end": 245.72,
    "text": "再看一遍"
  },
  {
    "start": 245.72,
    "end": 246.56,
    "text": "两条线"
  },
  {
    "start": 246.56,
    "end": 247.32,
    "text": "你坐在那"
  },
  {
    "start": 247.32,
    "end": 248.48,
    "text": "马桶圈是冰的"
  },
  {
    "start": 248.48,
    "end": 249.76,
    "text": "你不知道做了多久"
  },
  {
    "start": 249.76,
    "end": 251.32,
    "text": "直到腿麻了才站起来"
  },
  {
    "start": 251.32,
    "end": 252.8,
    "text": "你把试纸用直筋包好"
  },
  {
    "start": 252.8,
    "end": 254.24,
    "text": "塞进书包最底层"
  },
  {
    "start": 254.24,
    "end": 256.04,
    "text": "你洗的手回到床上躺下"
  },
  {
    "start": 256.04,
    "end": 257.0,
    "text": "上步的床板里"
  },
  {
    "start": 257.0,
    "end": 258.04,
    "text": "你的脸不到一米"
  },
  {
    "start": 258.04,
    "end": 260.2,
    "text": "你能看见目板缝隙里机的灰"
  },
  {
    "start": 260.2,
    "end": 261.04,
    "text": "你闭上眼睛"
  },
  {
    "start": 261.04,
    "end": 262.4,
    "text": "脑子里只有一个念头"
  },
  {
    "start": 262.4,
    "end": 263.64,
    "text": "不能让任何人知道"
  },
  {
    "start": 263.64,
    "end": 265.24,
    "text": "原难过后是期末考试"
  },
  {
    "start": 265.24,
    "end": 266.32,
    "text": "你坐在考场上"
  },
  {
    "start": 266.32,
    "end": 267.48,
    "text": "比在打替考上写"
  },
  {
    "start": 267.48,
    "end": 268.84,
    "text": "但你的手一直在抖"
  },
  {
    "start": 268.84,
    "end": 269.88,
    "text": "监考老师走过来"
  },
  {
    "start": 269.88,
    "end": 270.56,
    "text": "看了你眼"
  },
  {
    "start": 270.56,
    "end": 271.24,
    "text": "没说话"
  },
  {
    "start": 271.24,
    "end": 273.4,
    "text": "你考完最后一颗走出教学楼"
  },
  {
    "start": 273.4,
    "end": 274.56,
    "text": "天已经黑了"
  },
  {
    "start": 274.56,
    "end": 275.48,
    "text": "路灯亮起来"
  },
  {
    "start": 275.48,
    "end": 276.52,
    "text": "照在水泥地上"
  },
  {
    "start": 276.52,
    "end": 278.2,
    "text": "你的影子被拉得很长"
  },
  {
    "start": 278.2,
    "end": 279.24,
    "text": "你站在校门口"
  },
  {
    "start": 279.24,
    "end": 281.28,
    "text": "看着那些家长来接孩子的车"
  },
  {
    "start": 281.28,
    "end": 282.28,
    "text": "一亮亮开走"
  },
  {
    "start": 282.28,
    "end": 283.28,
    "text": "你掏出手机"
  },
  {
    "start": 283.28,
    "end": 284.76,
    "text": "拨了集控中心的电话"
  },
  {
    "start": 284.76,
    "end": 286.4,
    "text": "接电话的人声音很平静"
  },
  {
    "start": 286.4,
    "end": 288.04,
    "text": "问你有什么可以帮助的"
  },
  {
    "start": 288.04,
    "end": 289.84,
    "text": "你说你想做HIV检测"
  },
  {
    "start": 289.84,
    "end": 291.76,
    "text": "对方问你有过高危行为吗"
  },
  {
    "start": 291.76,
    "end": 292.72,
    "text": "你说是的"
  },
  {
    "start": 292.72,
    "end": 294.16,
    "text": "对方说什么时候的事"
  },
  {
    "start": 294.16,
    "end": 295.6,
    "text": "你说三个月前"
  },
  {
    "start": 295.6,
    "end": 296.72,
    "text": "对方沉默了一秒"
  },
  {
    "start": 296.72,
    "end": 297.84,
    "text": "说你过来吧"
  },
  {
    "start": 297.84,
    "end": 298.84,
    "text": "地址我发给你"
  },
  {
    "start": 298.84,
    "end": 300.8,
    "text": "你挂了电话站在路灯底下"
  },
  {
    "start": 300.8,
    "end": 302.44,
    "text": "风从操场那边吹过来"
  },
  {
    "start": 302.44,
    "end": 304.0,
    "text": "带着塑膠跑道的气味"
  },
  {
    "start": 304.0,
    "end": 306.0,
    "text": "你看着手机屏幕上那个地址"
  },
  {
    "start": 306.0,
    "end": 307.36,
    "text": "把他存进了背望路"
  },
  {
    "start": 307.36,
    "end": 308.16,
    "text": "你锁了屏"
  },
  {
    "start": 308.16,
    "end": 309.44,
    "text": "把手机塞进口袋"
  },
  {
    "start": 309.44,
    "end": 310.56,
    "text": "往公交站走去"
  },
  {
    "start": 310.56,
    "end": 311.56,
    "text": "公交车来了"
  },
  {
    "start": 311.56,
    "end": 312.44,
    "text": "你上了车"
  },
  {
    "start": 312.44,
    "end": 314.28,
    "text": "坐在最后一排靠窗的位置"
  },
  {
    "start": 314.28,
    "end": 315.24,
    "text": "车窗外的路灯"
  },
  {
    "start": 315.24,
    "end": 316.56,
    "text": "一展一展往后退"
  },
  {
    "start": 316.56,
    "end": 317.64,
    "text": "你看着自己的脸"
  },
  {
    "start": 317.64,
    "end": 318.56,
    "text": "硬在玻璃上"
  },
  {
    "start": 318.56,
    "end": 320.2,
    "text": "和外面的颜色跌在一起"
  },
  {
    "start": 320.2,
    "end": 322.08,
    "text": "你知道明天早上6.20分"
  },
  {
    "start": 322.08,
    "end": 323.24,
    "text": "闹中还是会想"
  },
  {
    "start": 323.24,
    "end": 324.04,
    "text": "你会爬起来"
  },
  {
    "start": 324.04,
    "end": 324.8,
    "text": "穿上校服"
  },
  {
    "start": 324.8,
    "end": 325.56,
    "text": "刷了牙"
  },
  {
    "start": 325.56,
    "end": 326.28,
    "text": "背上书包"
  },
  {
    "start": 326.28,
    "end": 327.48,
    "text": "走进那间教室"
  },
  {
    "start": 327.48,
    "end": 328.56,
    "text": "你会坐在靠窗"
  },
  {
    "start": 328.56,
    "end": 329.64,
    "text": "第三排的位置"
  },
  {
    "start": 329.64,
    "end": 330.48,
    "text": "翻开课本"
  },
  {
    "start": 330.48,
    "end": 332.0,
    "text": "像什么都没发生一样"
  },
  {
    "start": 332.0,
    "end": 332.88,
    "text": "你会的"
  }
]