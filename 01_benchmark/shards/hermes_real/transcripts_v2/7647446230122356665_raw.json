[
  {
    "start": 0.0,
    "end": 1.4,
    "text": "穷人穿也必死"
  },
  {
    "start": 1.8,
    "end": 2.6,
    "text": "为什么"
  },
  {
    "start": 2.88,
    "end": 4.8,
    "text": "因为穷人最喜欢的穷人方式"
  },
  {
    "start": 4.8,
    "end": 6.28,
    "text": "恰恰是这个世界上"
  },
  {
    "start": 6.28,
    "end": 7.92,
    "text": "子王女最高的玩法"
  },
  {
    "start": 8.4,
    "end": 10.92,
    "text": "上个月我的大学老师给我说了一句话"
  },
  {
    "start": 11.32,
    "end": 14.2,
    "text": "真正会做生意的人认真像母子花一百块"
  },
  {
    "start": 14.92,
    "end": 16.8,
    "text": "那个瞬间我是母奶一百块"
  },
  {
    "start": 17.24,
    "end": 18.76,
    "text": "现在这个年代一百块"
  },
  {
    "start": 18.76,
    "end": 21.0,
    "text": "可能年吃多香的火锅都出不起吧"
  },
  {
    "start": 21.8,
    "end": 22.4,
    "text": "但是"
  },
  {
    "start": 22.6,
    "end": 25.16,
    "text": "她说穷人穷眼一上来就是欧英"
  },
  {
    "start": 25.4,
    "end": 28.48,
    "text": "那高手穿也得低不永远只是视频"
  },
  {
    "start": 29.12,
    "end": 30.72,
    "text": "这句话直接把我干成没了"
  },
  {
    "start": 31.08,
    "end": 32.2,
    "text": "因为我突然计识到"
  },
  {
    "start": 32.2,
    "end": 33.36,
    "text": "为什么普通人穿眼"
  },
  {
    "start": 33.6,
    "end": 34.48,
    "text": "像跳选业"
  },
  {
    "start": 34.96,
    "end": 36.6,
    "text": "而且有千人穿眼像下为其"
  },
  {
    "start": 37.44,
    "end": 38.92,
    "text": "普通人的穿眼选了计是什么"
  },
  {
    "start": 39.36,
    "end": 40.92,
    "text": "想到一个点子觉得能火"
  },
  {
    "start": 41.44,
    "end": 43.2,
    "text": "然后开始奉寒的感动自己"
  },
  {
    "start": 43.48,
    "end": 44.6,
    "text": "吃子带款"
  },
  {
    "start": 44.76,
    "end": 45.68,
    "text": "逐便装修"
  },
  {
    "start": 45.68,
    "end": 46.6,
    "text": "招人进货"
  },
  {
    "start": 47.04,
    "end": 48.04,
    "text": "千万没转到"
  },
  {
    "start": 48.04,
    "end": 49.0,
    "text": "十几万钱没了"
  },
  {
    "start": 49.44,
    "end": 51.0,
    "text": "最后每天坐在店里面发带"
  },
  {
    "start": 51.0,
    "end": 52.72,
    "text": "两个月后现金留段令"
  },
  {
    "start": 52.92,
    "end": 53.68,
    "text": "门口贴着"
  },
  {
    "start": 53.68,
    "end": 54.4,
    "text": "忘不转"
  },
  {
    "start": 54.96,
    "end": 56.72,
    "text": "很多人到时都没有想明白"
  },
  {
    "start": 56.72,
    "end": 58.28,
    "text": "自己不是输给的同行"
  },
  {
    "start": 58.76,
    "end": 59.96,
    "text": "他是数给的换响"
  },
  {
    "start": 60.08,
    "end": 61.36,
    "text": "穷人穿也为什么闭死"
  },
  {
    "start": 61.92,
    "end": 63.72,
    "text": "因为穷人最喜欢做的一件事"
  },
  {
    "start": 64.0,
    "end": 65.2,
    "text": "就是拿穷不得身家"
  },
  {
    "start": 65.32,
    "end": 66.28,
    "text": "去赌一个自己"
  },
  {
    "start": 66.28,
    "end": 67.72,
    "text": "根本没有验人国的东西"
  },
  {
    "start": 68.36,
    "end": 69.48,
    "text": "当高手穷不赌"
  },
  {
    "start": 69.92,
    "end": 71.12,
    "text": "高手指责一件事"
  },
  {
    "start": 71.12,
    "end": 71.84,
    "text": "验真"
  },
  {
    "start": 72.0,
    "end": 73.4,
    "text": "我的老师给我取了一个例子"
  },
  {
    "start": 73.6,
    "end": 74.88,
    "text": "比如你觉得在小局"
  },
  {
    "start": 74.88,
    "end": 76.08,
    "text": "开家高章水果店"
  },
  {
    "start": 76.24,
    "end": 77.12,
    "text": "你干得赚钱"
  },
  {
    "start": 77.44,
    "end": 78.24,
    "text": "普通人怎么干"
  },
  {
    "start": 78.44,
    "end": 79.32,
    "text": "马上盘店"
  },
  {
    "start": 79.52,
    "end": 80.64,
    "text": "留联 车例子"
  },
  {
    "start": 80.64,
    "end": 81.84,
    "text": "南美 进口层子"
  },
  {
    "start": 81.84,
    "end": 82.76,
    "text": "全部完看"
  },
  {
    "start": 82.92,
    "end": 84.52,
    "text": "那个登牌做的像爱马市"
  },
  {
    "start": 84.76,
    "end": 86.24,
    "text": "朋友圈一天发20条"
  },
  {
    "start": 86.36,
    "end": 87.36,
    "text": "排面直接拉门"
  },
  {
    "start": 87.76,
    "end": 88.96,
    "text": "结果开了三个月"
  },
  {
    "start": 89.08,
    "end": 91.08,
    "text": "每天只有三个老台的起来问家"
  },
  {
    "start": 91.4,
    "end": 93.84,
    "text": "最后自己把车例子吃到快的糖料冰了"
  },
  {
    "start": 94.56,
    "end": 96.0,
    "text": "但是高手不是这样"
  },
  {
    "start": 96.32,
    "end": 97.6,
    "text": "开会相花100块钱"
  },
  {
    "start": 97.96,
    "end": 99.2,
    "text": "40块打一传单"
  },
  {
    "start": 99.2,
    "end": 100.76,
    "text": "60块买水果四车"
  },
  {
    "start": 101.04,
    "end": 102.08,
    "text": "然后下班高风气"
  },
  {
    "start": 102.08,
    "end": 103.04,
    "text": "坐在小群门口"
  },
  {
    "start": 103.08,
    "end": 103.92,
    "text": "让人四车"
  },
  {
    "start": 104.36,
    "end": 105.48,
    "text": "最后只问一句"
  },
  {
    "start": 105.76,
    "end": 106.96,
    "text": "如果这种品质"
  },
  {
    "start": 106.96,
    "end": 107.8,
    "text": "松过上门"
  },
  {
    "start": 107.8,
    "end": 108.72,
    "text": "你愿意加微信吗"
  },
  {
    "start": 108.96,
    "end": 109.44,
    "text": "你看"
  },
  {
    "start": 109.44,
    "end": 110.16,
    "text": "就这么一句话"
  },
  {
    "start": 110.16,
    "end": 111.72,
    "text": "直接决定这个声音能不能做"
  },
  {
    "start": 112.16,
    "end": 113.12,
    "text": "十个人里面"
  },
  {
    "start": 113.12,
    "end": 114.16,
    "text": "五个人愿意加"
  },
  {
    "start": 114.16,
    "end": 115.36,
    "text": "说明需求存在"
  },
  {
    "start": 115.68,
    "end": 116.88,
    "text": "100个人都要求"
  },
  {
    "start": 116.96,
    "end": 118.28,
    "text": "这个项目能运动不要碰"
  },
  {
    "start": 118.92,
    "end": 120.6,
    "text": "因为市场已经告诉你干了"
  },
  {
    "start": 120.84,
    "end": 121.84,
    "text": "真正历害的人"
  },
  {
    "start": 121.84,
    "end": 123.24,
    "text": "从来不看我觉得"
  },
  {
    "start": 123.76,
    "end": 124.72,
    "text": "他们只看反馈"
  },
  {
    "start": 125.28,
    "end": 126.76,
    "text": "创业还有个自命问题"
  },
  {
    "start": 127.24,
    "end": 128.4,
    "text": "特别爱自我感动"
  },
  {
    "start": 129.12,
    "end": 130.24,
    "text": "视频还没做"
  },
  {
    "start": 130.4,
    "end": 131.24,
    "text": "下买相机"
  },
  {
    "start": 131.4,
    "end": 132.32,
    "text": "产品还没卖"
  },
  {
    "start": 132.32,
    "end": 133.44,
    "text": "先租办公室"
  },
  {
    "start": 133.44,
    "end": 134.04,
    "text": "招团队"
  },
  {
    "start": 134.44,
    "end": 135.2,
    "text": "一个客户"
  },
  {
    "start": 135.2,
    "end": 136.6,
    "text": "都还没有先招七八个人"
  },
  {
    "start": 137.04,
    "end": 138.16,
    "text": "最后创业没做成"
  },
  {
    "start": 138.16,
    "end": 139.44,
    "text": "倒是提前提言来一把"
  },
  {
    "start": 139.44,
    "end": 140.4,
    "text": "当老板的孤独"
  },
  {
    "start": 140.96,
    "end": 142.2,
    "text": "而高手永远相反"
  },
  {
    "start": 142.48,
    "end": 143.68,
    "text": "他们甚至扣得可怕"
  },
  {
    "start": 143.88,
    "end": 144.48,
    "text": "坐抖音"
  },
  {
    "start": 144.48,
    "end": 145.48,
    "text": "下班两间样品"
  },
  {
    "start": 145.48,
    "end": 146.4,
    "text": "拍几条视频"
  },
  {
    "start": 146.4,
    "end": 147.72,
    "text": "投25块钱的抖家"
  },
  {
    "start": 148.12,
    "end": 150.04,
    "text": "看数据播放量能不能破钱"
  },
  {
    "start": 150.24,
    "end": 150.96,
    "text": "有没有资许"
  },
  {
    "start": 150.96,
    "end": 151.84,
    "text": "有没有成角"
  },
  {
    "start": 152.0,
    "end": 153.0,
    "text": "有就继续干"
  },
  {
    "start": 153.0,
    "end": 153.84,
    "text": "没有立刻换"
  },
  {
    "start": 154.24,
    "end": 155.24,
    "text": "因为他们知道"
  },
  {
    "start": 155.24,
    "end": 156.48,
    "text": "这个世界最规的东西"
  },
  {
    "start": 156.48,
    "end": 157.28,
    "text": "不是流量"
  },
  {
    "start": 157.6,
    "end": 158.72,
    "text": "不是办公室"
  },
  {
    "start": 158.72,
    "end": 159.72,
    "text": "而是错无"
  },
  {
    "start": 160.0,
    "end": 161.4,
    "text": "尤其是低级错无"
  },
  {
    "start": 161.4,
    "end": 162.84,
    "text": "我的老师最后说了一句话"
  },
  {
    "start": 162.84,
    "end": 163.92,
    "text": "我到现在都记得"
  },
  {
    "start": 164.28,
    "end": 165.6,
    "text": "他说穷人作乡影"
  },
  {
    "start": 165.6,
    "end": 166.36,
    "text": "像谈恋爱"
  },
  {
    "start": 166.72,
    "end": 168.8,
    "text": "一上来就恨不得把命给出去"
  },
  {
    "start": 169.12,
    "end": 170.32,
    "text": "那高手作成影"
  },
  {
    "start": 170.32,
    "end": 171.28,
    "text": "像业滴音"
  },
  {
    "start": 171.64,
    "end": 172.92,
    "text": "结果没出来之前"
  },
  {
    "start": 172.92,
    "end": 174.04,
    "text": "绝对不投入感情"
  },
  {
    "start": 174.48,
    "end": 175.08,
    "text": "那天晚上"
  },
  {
    "start": 175.08,
    "end": 176.36,
    "text": "我突然就没卖一件事情"
  },
  {
    "start": 176.84,
    "end": 178.0,
    "text": "为什么很多有钱"
  },
  {
    "start": 178.0,
    "end": 179.24,
    "text": "让看起来单子特别少"
  },
  {
    "start": 179.72,
    "end": 181.16,
    "text": "因为他们不敢靠独"
  },
  {
    "start": 181.16,
    "end": 181.88,
    "text": "赚到钱"
  },
  {
    "start": 182.44,
    "end": 183.36,
    "text": "恰恰相反"
  },
  {
    "start": 183.36,
    "end": 184.52,
    "text": "真正赚到钱的人"
  },
  {
    "start": 184.52,
    "end": 185.8,
    "text": "往往最应用的风险"
  },
  {
    "start": 186.24,
    "end": 187.52,
    "text": "他们你要花100块钱"
  },
  {
    "start": 187.52,
    "end": 188.52,
    "text": "四座1000赐"
  },
  {
    "start": 189.2,
    "end": 190.4,
    "text": "也不用花10万块钱"
  },
  {
    "start": 190.4,
    "end": 191.2,
    "text": "就赌一个"
  },
  {
    "start": 191.4,
    "end": 192.24,
    "text": "看不清的未来"
  },
  {
    "start": 192.76,
    "end": 194.32,
    "text": "所以如果你现在也想创业"
  },
  {
    "start": 194.32,
    "end": 195.52,
    "text": "先别只是吃子"
  },
  {
    "start": 195.68,
    "end": 196.64,
    "text": "别急着逮换"
  },
  {
    "start": 196.88,
    "end": 197.76,
    "text": "更别急着换朋友"
  },
  {
    "start": 197.76,
    "end": 199.44,
    "text": "全部老子要立天赶命"
  },
  {
    "start": 199.96,
    "end": 201.08,
    "text": "你先问自己句"
  },
  {
    "start": 201.28,
    "end": 202.2,
    "text": "你有没有办法"
  },
  {
    "start": 202.2,
    "end": 203.04,
    "text": "只花100块钱"
  },
  {
    "start": 203.04,
    "end": 204.08,
    "text": "就验着那个生意"
  },
  {
    "start": 204.32,
    "end": 205.44,
    "text": "到底有没有人买单"
  },
  {
    "start": 205.68,
    "end": 206.48,
    "text": "因为很多时候"
  },
  {
    "start": 206.48,
    "end": 208.0,
    "text": "能用100块钱买单的教学"
  },
  {
    "start": 208.0,
    "end": 209.68,
    "text": "就别用办法的继续去吃完"
  },
  {
    "start": 209.92,
    "end": 210.68,
    "text": "以后对不对"
  }
]