[
  {
    "start": 0.0,
    "end": 1.2,
    "text": "尽量不要去打工",
    "segment_id": "S0001"
  },
  {
    "start": 1.2,
    "end": 1.92,
    "text": "实在不行",
    "segment_id": "S0002"
  },
  {
    "start": 1.92,
    "end": 2.92,
    "text": "你就一边打工",
    "segment_id": "S0003"
  },
  {
    "start": 2.92,
    "end": 5.72,
    "text": "一边找一个靠谱的产品去卖",
    "segment_id": "S0004"
  },
  {
    "start": 5.72,
    "end": 7.32,
    "text": "只要是开始卖东西",
    "segment_id": "S0005"
  },
  {
    "start": 7.32,
    "end": 10.36,
    "text": "你就会快速的进入到真实的社会的模式",
    "segment_id": "S0006"
  },
  {
    "start": 10.36,
    "end": 12.44,
    "text": "这句话是我花了十年的时间",
    "segment_id": "S0007"
  },
  {
    "start": 12.44,
    "end": 14.4,
    "text": "赚了无数次的南墙才误出来的",
    "segment_id": "S0008"
  },
  {
    "start": 14.4,
    "end": 16.2,
    "text": "那为什么不建议打工呢",
    "segment_id": "S0009"
  },
  {
    "start": 16.2,
    "end": 18.44,
    "text": "打工的本质就是你把你的时间体力",
    "segment_id": "S0010"
  },
  {
    "start": 18.44,
    "end": 20.64,
    "text": "情绪打包卖给了老板",
    "segment_id": "S0011"
  },
  {
    "start": 20.64,
    "end": 21.76,
    "text": "那么在这套体系里面",
    "segment_id": "S0012"
  },
  {
    "start": 21.76,
    "end": 24.2,
    "text": "你就是那个被保护起来的罗斯丁",
    "segment_id": "S0013"
  },
  {
    "start": 24.2,
    "end": 25.88,
    "text": "不用知道产品怎么卖",
    "segment_id": "S0014"
  },
  {
    "start": 25.88,
    "end": 26.68,
    "text": "不用懂客户",
    "segment_id": "S0015"
  },
  {
    "start": 26.68,
    "end": 27.88,
    "text": "为什么会离去",
    "segment_id": "S0016"
  },
  {
    "start": 27.88,
    "end": 30.16,
    "text": "你只要PPT写得好就可以了",
    "segment_id": "S0017"
  },
  {
    "start": 30.16,
    "end": 31.92,
    "text": "打工给你最大的毒药",
    "segment_id": "S0018"
  },
  {
    "start": 31.92,
    "end": 33.64,
    "text": "它就掉到确定性",
    "segment_id": "S0019"
  },
  {
    "start": 33.64,
    "end": 35.12,
    "text": "每个月到了日子",
    "segment_id": "S0020"
  },
  {
    "start": 35.12,
    "end": 37.08,
    "text": "那个工资雷打不动道仗",
    "segment_id": "S0021"
  },
  {
    "start": 37.08,
    "end": 38.68,
    "text": "这种虚假的安全感",
    "segment_id": "S0022"
  },
  {
    "start": 38.68,
    "end": 39.92,
    "text": "会一点点废掉",
    "segment_id": "S0023"
  },
  {
    "start": 39.92,
    "end": 42.48,
    "text": "你这个感知真实时间的能力",
    "segment_id": "S0024"
  },
  {
    "start": 42.48,
    "end": 44.04,
    "text": "等到了35岁",
    "segment_id": "S0025"
  },
  {
    "start": 44.04,
    "end": 44.84,
    "text": "你被优化",
    "segment_id": "S0026"
  },
  {
    "start": 44.84,
    "end": 46.12,
    "text": "被扔回了社会",
    "segment_id": "S0027"
  },
  {
    "start": 46.12,
    "end": 47.6,
    "text": "你才发现除了内号",
    "segment_id": "S0028"
  },
  {
    "start": 47.6,
    "end": 49.36,
    "text": "会写这个周报",
    "segment_id": "S0029"
  },
  {
    "start": 49.36,
    "end": 52.4,
    "text": "你根本就看不懂这个社会是怎么运转的",
    "segment_id": "S0030"
  },
  {
    "start": 52.4,
    "end": 54.6,
    "text": "那么什么才是真实的社会模式呢",
    "segment_id": "S0031"
  },
  {
    "start": 54.6,
    "end": 56.56,
    "text": "就是交易",
    "segment_id": "S0032"
  },
  {
    "start": 56.56,
    "end": 58.32,
    "text": "市场不认你的头显",
    "segment_id": "S0033"
  },
  {
    "start": 58.32,
    "end": 61.08,
    "text": "只认你能不能够把产品卖出去",
    "segment_id": "S0034"
  },
  {
    "start": 61.08,
    "end": 61.8,
    "text": "很多人跟我说",
    "segment_id": "S0035"
  },
  {
    "start": 61.8,
    "end": 62.8,
    "text": "我不敢辞职",
    "segment_id": "S0036"
  },
  {
    "start": 62.8,
    "end": 65.0,
    "text": "让我没有本金用怕失败",
    "segment_id": "S0037"
  },
  {
    "start": 65.0,
    "end": 66.52,
    "text": "所以我才跟你们讲嘛",
    "segment_id": "S0038"
  },
  {
    "start": 66.52,
    "end": 67.32,
    "text": "实在不行",
    "segment_id": "S0039"
  },
  {
    "start": 67.32,
    "end": 69.96,
    "text": "你就边打工边卖东西",
    "segment_id": "S0040"
  },
  {
    "start": 69.96,
    "end": 71.04,
    "text": "保留你的工资",
    "segment_id": "S0041"
  },
  {
    "start": 71.04,
    "end": 72.12,
    "text": "那个是你的底线",
    "segment_id": "S0042"
  },
  {
    "start": 72.12,
    "end": 73.36,
    "text": "让你没有业绩的时候",
    "segment_id": "S0043"
  },
  {
    "start": 73.36,
    "end": 74.2,
    "text": "也不用慌",
    "segment_id": "S0044"
  },
  {
    "start": 74.2,
    "end": 77.16,
    "text": "但是你把下班刷短视频的时间",
    "segment_id": "S0045"
  },
  {
    "start": 77.16,
    "end": 78.76,
    "text": "拿出来去给我卖东西",
    "segment_id": "S0046"
  },
  {
    "start": 78.76,
    "end": 79.88,
    "text": "那卖什么",
    "segment_id": "S0047"
  },
  {
    "start": 79.88,
    "end": 82.52,
    "text": "找你自己觉得不错的",
    "segment_id": "S0048"
  },
  {
    "start": 82.52,
    "end": 85.0,
    "text": "敢推荐给你身边朋友的东西",
    "segment_id": "S0049"
  },
  {
    "start": 85.0,
    "end": 86.28,
    "text": "就可以了",
    "segment_id": "S0050"
  },
  {
    "start": 86.28,
    "end": 87.48,
    "text": "咱们社群里边有一个",
    "segment_id": "S0051"
  },
  {
    "start": 87.48,
    "end": 89.92,
    "text": "就是从事工厂至今远的",
    "segment_id": "S0052"
  },
  {
    "start": 89.92,
    "end": 91.68,
    "text": "他每天内的都要死了",
    "segment_id": "S0053"
  },
  {
    "start": 91.68,
    "end": 95.24,
    "text": "他发现场边有大量的优质委惑通庄",
    "segment_id": "S0054"
  },
  {
    "start": 95.24,
    "end": 97.76,
    "text": "他下来班就拍照片发到网上",
    "segment_id": "S0055"
  },
  {
    "start": 97.76,
    "end": 98.96,
    "text": "就不断地去卖",
    "segment_id": "S0056"
  },
  {
    "start": 98.96,
    "end": 99.92,
    "text": "就展示这个衣服",
    "segment_id": "S0057"
  },
  {
    "start": 99.92,
    "end": 101.2,
    "text": "怎么系列不变形",
    "segment_id": "S0058"
  },
  {
    "start": 101.2,
    "end": 103.12,
    "text": "或者是各种其他的优势",
    "segment_id": "S0059"
  },
  {
    "start": 103.12,
    "end": 105.24,
    "text": "一开始一个月只能赚几百块钱",
    "segment_id": "S0060"
  },
  {
    "start": 105.24,
    "end": 107.96,
    "text": "后来他就摸透了这个流量的规则",
    "segment_id": "S0061"
  },
  {
    "start": 107.96,
    "end": 108.88,
    "text": "副业的收入",
    "segment_id": "S0062"
  },
  {
    "start": 108.88,
    "end": 110.64,
    "text": "直接超过了他主业的三倍",
    "segment_id": "S0063"
  },
  {
    "start": 110.64,
    "end": 113.52,
    "text": "他这个时候他才敢去离职",
    "segment_id": "S0064"
  },
  {
    "start": 113.52,
    "end": 114.6,
    "text": "因为那个时候他已经",
    "segment_id": "S0065"
  },
  {
    "start": 114.6,
    "end": 116.36,
    "text": "不但是一没小小的罗斯丁了",
    "segment_id": "S0066"
  },
  {
    "start": 116.36,
    "end": 117.56,
    "text": "他是一个董选品",
    "segment_id": "S0067"
  },
  {
    "start": 117.56,
    "end": 119.88,
    "text": "董流量董成交的生意人",
    "segment_id": "S0068"
  },
  {
    "start": 119.88,
    "end": 120.8,
    "text": "理解吧",
    "segment_id": "S0069"
  },
  {
    "start": 120.8,
    "end": 123.68,
    "text": "那为什么卖东西会是成长最快的",
    "segment_id": "S0070"
  },
  {
    "start": 123.68,
    "end": 125.76,
    "text": "因为你要去指面忍性",
    "segment_id": "S0071"
  },
  {
    "start": 125.76,
    "end": 127.56,
    "text": "被熟人炒粉",
    "segment_id": "S0072"
  },
  {
    "start": 127.56,
    "end": 127.8,
    "text": "哎呦",
    "segment_id": "S0073"
  },
  {
    "start": 127.8,
    "end": 130.6,
    "text": "你怎么变得这么同仇人了",
    "segment_id": "S0074"
  },
  {
    "start": 130.6,
    "end": 132.68,
    "text": "被那个默熟人直接转账",
    "segment_id": "S0075"
  },
  {
    "start": 132.68,
    "end": 134.32,
    "text": "你难递指的不合对",
    "segment_id": "S0076"
  },
  {
    "start": 134.32,
    "end": 135.36,
    "text": "被放隔子",
    "segment_id": "S0077"
  },
  {
    "start": 135.36,
    "end": 136.8,
    "text": "被比价格",
    "segment_id": "S0078"
  },
  {
    "start": 136.8,
    "end": 138.64,
    "text": "被拒绝1000次",
    "segment_id": "S0079"
  },
  {
    "start": 138.64,
    "end": 139.44,
    "text": "理解这个意思吗",
    "segment_id": "S0080"
  },
  {
    "start": 139.44,
    "end": 140.96,
    "text": "当你的这个玻璃心碎了一地",
    "segment_id": "S0081"
  },
  {
    "start": 140.96,
    "end": 142.88,
    "text": "然后又重新沾起来的时候",
    "segment_id": "S0082"
  },
  {
    "start": 142.88,
    "end": 145.36,
    "text": "他就变成了防弹玻璃了",
    "segment_id": "S0083"
  },
  {
    "start": 145.36,
    "end": 146.24,
    "text": "这种锻炼",
    "segment_id": "S0084"
  },
  {
    "start": 146.24,
    "end": 148.72,
    "text": "你坐在办公室里面三年连练不出来",
    "segment_id": "S0085"
  },
  {
    "start": 148.72,
    "end": 150.6,
    "text": "所以说别再把这个希望",
    "segment_id": "S0086"
  },
  {
    "start": 150.6,
    "end": 152.12,
    "text": "继托在长心姿",
    "segment_id": "S0087"
  },
  {
    "start": 152.12,
    "end": 154.04,
    "text": "什么500块1000块钱上了",
    "segment_id": "S0088"
  },
  {
    "start": 154.04,
    "end": 154.8,
    "text": "今天开始",
    "segment_id": "S0089"
  },
  {
    "start": 154.8,
    "end": 156.32,
    "text": "你就开始发一套碰圈",
    "segment_id": "S0090"
  },
  {
    "start": 156.32,
    "end": 157.52,
    "text": "告诉所有人",
    "segment_id": "S0091"
  },
  {
    "start": 157.52,
    "end": 160.24,
    "text": "你在卖一个真的不错的东西",
    "segment_id": "S0092"
  },
  {
    "start": 160.24,
    "end": 161.12,
    "text": "哪怕你第一个月",
    "segment_id": "S0093"
  },
  {
    "start": 161.12,
    "end": 161.96,
    "text": "一分钱没有赚",
    "segment_id": "S0094"
  },
  {
    "start": 161.96,
    "end": 164.52,
    "text": "只要你开始站在这个卖家的视角",
    "segment_id": "S0095"
  },
  {
    "start": 164.52,
    "end": 166.08,
    "text": "去看待这个社会",
    "segment_id": "S0096"
  },
  {
    "start": 166.08,
    "end": 167.64,
    "text": "那么你的思维方式",
    "segment_id": "S0097"
  },
  {
    "start": 167.64,
    "end": 169.68,
    "text": "就已经开始列表了",
    "segment_id": "S0098"
  },
  {
    "start": 169.68,
    "end": 170.2,
    "text": "RISPER",
    "segment_id": "S0099"
  }
]