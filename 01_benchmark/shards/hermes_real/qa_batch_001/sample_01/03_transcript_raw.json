[
  {
    "start": 0.0,
    "end": 2.04,
    "text": "從一到一百萬"
  },
  {
    "start": 2.04,
    "end": 5.32,
    "text": "普通人該怎麼賺到自己的第一桶"
  },
  {
    "start": 5.32,
    "end": 7.28,
    "text": "這個視頻你吸收的約多"
  },
  {
    "start": 7.28,
    "end": 10.52,
    "text": "大概率在三十歲以內就能賺到"
  },
  {
    "start": 10.52,
    "end": 11.52,
    "text": "一定要記得"
  },
  {
    "start": 11.52,
    "end": 14.92,
    "text": "從零到一的考驗是你的個人能力"
  },
  {
    "start": 14.92,
    "end": 17.68,
    "text": "從一到一百則考驗的是團隊能力"
  },
  {
    "start": 17.68,
    "end": 18.52,
    "text": "總之能力"
  },
  {
    "start": 18.52,
    "end": 19.8,
    "text": "所以從零到一"
  },
  {
    "start": 19.8,
    "end": 22.32,
    "text": "你要不停的學習做跌帶"
  },
  {
    "start": 22.32,
    "end": 24.0,
    "text": "打開自己的思想"
  },
  {
    "start": 24.0,
    "end": 26.28,
    "text": "首先如果你不是富二代"
  },
  {
    "start": 26.28,
    "end": 29.2,
    "text": "你的第一筆錢只有三個來源的方向"
  },
  {
    "start": 29.2,
    "end": 32.0,
    "text": "打工 借錢 帶塊"
  },
  {
    "start": 32.0,
    "end": 33.68,
    "text": "如果你不靠後兩者"
  },
  {
    "start": 33.68,
    "end": 35.48,
    "text": "那你第一筆錢一定是靠"
  },
  {
    "start": 35.48,
    "end": 37.24,
    "text": "積累擋下來的"
  },
  {
    "start": 37.24,
    "end": 39.72,
    "text": "比如你還是一個上班級"
  },
  {
    "start": 39.72,
    "end": 42.92,
    "text": "就一定要學會客具自己的臺項"
  },
  {
    "start": 42.92,
    "end": 44.36,
    "text": "把數字降下來"
  },
  {
    "start": 44.36,
    "end": 46.120000000000005,
    "text": "你省出來的這一部分錢"
  },
  {
    "start": 46.120000000000005,
    "end": 47.72,
    "text": "會積少省多"
  },
  {
    "start": 47.72,
    "end": 49.56,
    "text": "千萬不要小開數字"
  },
  {
    "start": 49.56,
    "end": 50.56,
    "text": "你的工資"
  },
  {
    "start": 50.56,
    "end": 54.16,
    "text": "信用卡 花貝 戒備 儘量 謹慎一點"
  },
  {
    "start": 54.16,
    "end": 56.04,
    "text": "因為沒有任何人會給你"
  },
  {
    "start": 56.24,
    "end": 59.2,
    "text": "偽裝出來的大方而買的"
  },
  {
    "start": 59.2,
    "end": 59.879999999999995,
    "text": "第二"
  },
  {
    "start": 59.879999999999995,
    "end": 61.44,
    "text": "當你手裡說錢"
  },
  {
    "start": 61.44,
    "end": 63.16,
    "text": "積累到一定的額路口子"
  },
  {
    "start": 63.16,
    "end": 65.2,
    "text": "比如說你身上有十萬"
  },
  {
    "start": 65.2,
    "end": 66.96,
    "text": "三十萬 五十萬"
  },
  {
    "start": 66.96,
    "end": 68.48,
    "text": "不要去買車買吧"
  },
  {
    "start": 68.48,
    "end": 69.8,
    "text": "首先"
  },
  {
    "start": 69.8,
    "end": 71.6,
    "text": "如果不是必要帶路"
  },
  {
    "start": 71.6,
    "end": 73.28,
    "text": "這次錢根本不足以"
  },
  {
    "start": 73.28,
    "end": 75.84,
    "text": "能讓你買量很好的車"
  },
  {
    "start": 75.84,
    "end": 78.2,
    "text": "而買方在大城市有可能"
  },
  {
    "start": 78.2,
    "end": 80.64,
    "text": "點一間廁所都買不到"
  },
  {
    "start": 80.64,
    "end": 82.84,
    "text": "這個時候你就會去借錢"
  },
  {
    "start": 82.84,
    "end": 85.6,
    "text": "家裡只挽廣袋各種路"
  },
  {
    "start": 85.60000000000001,
    "end": 87.16000000000001,
    "text": "這些對你這個階段來說"
  },
  {
    "start": 87.16000000000001,
    "end": 89.4,
    "text": "就是負債和家屬"
  },
  {
    "start": 89.4,
    "end": 90.24000000000001,
    "text": "說白了"
  },
  {
    "start": 90.24000000000001,
    "end": 92.24000000000001,
    "text": "你不一定能把握著我的住宅"
  },
  {
    "start": 92.24000000000001,
    "end": 94.00000000000001,
    "text": "而這個錢最好的用途"
  },
  {
    "start": 94.00000000000001,
    "end": 95.44000000000001,
    "text": "就是繼續勻掌"
  },
  {
    "start": 95.44000000000001,
    "end": 97.28,
    "text": "勻掌學習的機會"
  },
  {
    "start": 97.28,
    "end": 98.44000000000001,
    "text": "勻掌清資產"
  },
  {
    "start": 98.44000000000001,
    "end": 99.84,
    "text": "還有些小成本"
  },
  {
    "start": 99.84,
    "end": 101.84,
    "text": "賺錢的項目去貼繫"
  },
  {
    "start": 101.84,
    "end": 103.92000000000002,
    "text": "如果不前進你不成長"
  },
  {
    "start": 103.92000000000002,
    "end": 105.64000000000001,
    "text": "你二十歲的時候"
  },
  {
    "start": 105.64000000000001,
    "end": 107.48,
    "text": "一天只一千塊"
  },
  {
    "start": 107.48,
    "end": 108.64000000000001,
    "text": "能到了三十五歲"
  },
  {
    "start": 108.64000000000001,
    "end": 111.20000000000002,
    "text": "一天只值一半一半"
  },
  {
    "start": 111.20000000000002,
    "end": 113.12,
    "text": "這就是最簡單的道理"
  },
  {
    "start": 113.12,
    "end": 115.72,
    "text": "如果最後你想拿著積累的這個"
  },
  {
    "start": 115.72,
    "end": 117.08,
    "text": "錢來創意"
  },
  {
    "start": 117.08,
    "end": 119.4,
    "text": "你一定不要想得過一晚可放"
  },
  {
    "start": 119.4,
    "end": 120.96000000000001,
    "text": "一定要選擇低成本"
  },
  {
    "start": 120.96000000000001,
    "end": 122.60000000000001,
    "text": "可負債的項目"
  },
  {
    "start": 122.60000000000001,
    "end": 125.2,
    "text": "很多人創業喜歡搞店面"
  },
  {
    "start": 125.2,
    "end": 126.28,
    "text": "搞個小超市"
  },
  {
    "start": 126.28,
    "end": 127.2,
    "text": "小優官"
  },
  {
    "start": 127.2,
    "end": 128.72,
    "text": "或者那麼服裝店"
  },
  {
    "start": 128.72,
    "end": 130.4,
    "text": "就是抱著每天開門"
  },
  {
    "start": 130.4,
    "end": 132.6,
    "text": "等客與官們分享"
  },
  {
    "start": 132.6,
    "end": 133.48000000000002,
    "text": "有可能來了"
  },
  {
    "start": 133.48000000000002,
    "end": 134.48000000000002,
    "text": "直接來客人"
  },
  {
    "start": 134.48000000000002,
    "end": 136.0,
    "text": "沒有就玩手機"
  },
  {
    "start": 136.0,
    "end": 137.72,
    "text": "這種屬於偽創業"
  },
  {
    "start": 137.72,
    "end": 139.92000000000002,
    "text": "這根本不能算創業"
  },
  {
    "start": 139.92000000000002,
    "end": 141.92000000000002,
    "text": "衝擊量算個有點活幹"
  },
  {
    "start": 141.92000000000002,
    "end": 143.28000000000003,
    "text": "算給年生"
  },
  {
    "start": 143.28000000000003,
    "end": 144.76000000000002,
    "text": "比打工算得多一點"
  },
  {
    "start": 144.76000000000002,
    "end": 147.52,
    "text": "辛苦的也是服務自己"
  },
  {
    "start": 147.52,
    "end": 148.76000000000002,
    "text": "真正的創業"
  },
  {
    "start": 148.76000000000002,
    "end": 150.60000000000002,
    "text": "放的是一份事業"
  },
  {
    "start": 150.60000000000002,
    "end": 152.88000000000002,
    "text": "這份事業是可以讓你終身追求"
  },
  {
    "start": 152.88000000000002,
    "end": 154.60000000000002,
    "text": "它不是人來愛為自己"
  },
  {
    "start": 154.60000000000002,
    "end": 155.64000000000001,
    "text": "欺騙自己"
  },
  {
    "start": 155.64000000000001,
    "end": 157.84,
    "text": "讓自己覺得再做事情"
  },
  {
    "start": 157.84,
    "end": 160.00000000000003,
    "text": "愛定是可以持續的進步"
  },
  {
    "start": 160.00000000000003,
    "end": 161.08,
    "text": "不停裂變"
  },
  {
    "start": 161.08,
    "end": 162.8,
    "text": "持續做大的事情"
  },
  {
    "start": 162.8,
    "end": 165.08,
    "text": "由電商或者自媒體"
  },
  {
    "start": 165.08,
    "end": 167.08,
    "text": "電商百分之九十九個操作"
  },
  {
    "start": 167.08,
    "end": 169.4,
    "text": "流程都有標準的案子"
  },
  {
    "start": 169.4,
    "end": 171.32000000000002,
    "text": "會差了 會朝就是"
  },
  {
    "start": 171.32,
    "end": 172.28,
    "text": "而自媒體"
  },
  {
    "start": 172.28,
    "end": 174.0,
    "text": "不論尋找你的對標客戶"
  },
  {
    "start": 174.0,
    "end": 175.28,
    "text": "還是你自己做的"
  },
  {
    "start": 175.28,
    "end": 176.48,
    "text": "先訴"
  },
  {
    "start": 176.48,
    "end": 178.48,
    "text": "不要想要準備得多完畢"
  },
  {
    "start": 178.48,
    "end": 180.72,
    "text": "雖然現在已經進入到了一個"
  },
  {
    "start": 180.72,
    "end": 182.0,
    "text": "存量的時代"
  },
  {
    "start": 182.0,
    "end": 183.68,
    "text": "但優勝被探"
  },
  {
    "start": 183.68,
    "end": 185.28,
    "text": "不充新鮮血液的規則"
  },
  {
    "start": 185.28,
    "end": 187.28,
    "text": "永遠不可能變"
  },
  {
    "start": 187.28,
    "end": 188.28,
    "text": "這種低成本"
  },
  {
    "start": 188.28,
    "end": 189.6,
    "text": "可負這個項目"
  },
  {
    "start": 189.6,
    "end": 190.51999999999998,
    "text": "你不錯"
  },
  {
    "start": 190.51999999999998,
    "end": 191.84,
    "text": "非要投資大把"
  },
  {
    "start": 191.84,
    "end": 194.35999999999999,
    "text": "選擇一些西洋的產業"
  },
  {
    "start": 194.35999999999999,
    "end": 196.92,
    "text": "大老進去都能把從事"
  },
  {
    "start": 196.92,
    "end": 197.95999999999998,
    "text": "一個小白"
  },
  {
    "start": 197.95999999999998,
    "end": 199.35999999999999,
    "text": "能扛多久嗎"
  },
  {
    "start": 199.35999999999999,
    "end": 200.56,
    "text": "一定要進去"
  },
  {
    "start": 200.6,
    "end": 203.24,
    "text": "所有不可以負責的生意"
  },
  {
    "start": 203.24,
    "end": 205.24,
    "text": "都不是好事"
  }
]